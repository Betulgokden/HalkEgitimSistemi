@model HalkEgitimSistemi.Models.Application
@{
    ViewData["Title"] = "Başvuru Takip";
}

<div class="container py-5" style="min-height: 70vh; display: flex; align-items: center; justify-content: center;">
    <div class="row w-100 justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="glass-card animate-scaleIn overflow-hidden p-5 text-center" style="border-radius: 40px; background: rgba(197, 160, 89, 0.15) !important; border: 2px solid #C5A059 !important;">
                <div class="section-icon mx-auto mb-5" style="width: 100px; height: 100px; font-size: 3rem; background: transparent; color: #581C1C;">
                    <i class="bi bi-search"></i>
                </div>
                
                <h2 style="font-family: 'Outfit', sans-serif; font-weight: 900; color: #581C1C; margin-bottom: 1rem; font-size: 2.5rem; letter-spacing: -1px;">
                    Başvuru <span style="color: #C5A059;">Sorgula</span>
                </h2>
                <p style="color: #581C1C; margin-bottom: 3rem; font-size: 1.1rem; opacity: 0.8;">
                    Başvuru durumunuzu güvenle öğrenmek için lütfen T.C. Kimlik Numaranızı giriniz.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="animate-shake" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 20px; padding: 1.2rem; margin-bottom: 2rem; color: #ef4444; font-weight: 600;">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>@ViewBag.Error
                    </div>
                }

                <form asp-action="Track" method="post">
                    <div class="form-premium-group mb-5">
                        <div style="position: relative;">
                            <i class="bi bi-person-vcard position-absolute" style="top: 50%; left: 1.5rem; transform: translateY(-50%); color: #C5A059; font-size: 1.5rem;"></i>
                            <input type="text" name="tcNo" class="modern-control text-center" style="padding-left: 4rem !important; font-size: 1.5rem !important; letter-spacing: 0.3rem !important; font-family: 'Outfit', sans-serif; background: rgba(255,255,255,0.05) !important; border: 1px solid rgba(255,255,255,0.15) !important; color: white !important; border-radius: 20px !important;" placeholder="11 HANELİ T.C. NO" maxlength="11" required />
                        </div>
                    </div>
                    
                    <button type="submit" class="modern-submit-btn py-4" style="font-size: 1.3rem !important; background: linear-gradient(135deg, #C5A059, #581C1C) !important; border: none !important; color: white !important; border-radius: 20px !important; box-shadow: 0 10px 30px rgba(197, 160, 89, 0.4) !important; width: 100% !important;">
                        <i class="bi bi-search me-2"></i> DURUMU SORGULA
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


