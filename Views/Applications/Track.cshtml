@model HalkEgitimSistemi.Models.Application
@{
    ViewData["Title"] = "Başvuru Takip";
}

<div class="container py-5" style="min-height: 85vh; display: flex; align-items: center; justify-content: center;">
    <div class="row w-100 justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="glass-card-static track-container animate-scaleIn p-5 text-center">
                
                <!-- Icon Section -->
                <div class="track-icon-wrapper mb-4">
                    <div class="track-icon-bg">
                        <i class="bi bi-search"></i>
                    </div>
                </div>
                
                <h2 class="fw-black mb-3 track-title">
                    Başvuru <span class="gold-text">Sorgula</span>
                </h2>
                
                <p class="track-subtitle mb-5">
                    Başvuru durumunuzu anlık olarak öğrenmek için lütfen 11 haneli T.C. Kimlik Numaranızı giriniz.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert-premium mb-4 animate-shake">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                    </div>
                }

                <form asp-action="Track" method="post" class="mt-4">
                    <!-- Input Box -->
                    <div class="input-modern-group mb-4">
                        <div class="input-icon-box">
                            <i class="bi bi-person-vcard-fill"></i>
                        </div>
                        <input type="text" name="tcNo" 
                               class="form-control modern-track-input" 
                               placeholder="11 HANELİ T.C. NO" 
                               maxlength="11" 
                               required 
                               autocomplete="off" />
                    </div>
                    
                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-track-submit w-100 py-3 mb-5">
                        <i class="bi bi-shield-check me-2"></i> DURUMU SORGULA
                    </button>
                </form>

                <div class="track-footer pt-4 border-top border-glass">
                    <a asp-controller="Home" asp-action="Index" class="track-footer-link">
                        <i class="bi bi-house-door me-1"></i> Ana Sayfaya Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .track-container {
        border-radius: 40px;
        border: 1px solid var(--border-glass) !important;
        box-shadow: 0 25px 50px rgba(0,0,0,0.3) !important;
    }

    .track-icon-bg {
        width: 100px;
        height: 100px;
        background: radial-gradient(circle at center, #C5A059 0%, #581C1C 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 2.5rem;
        color: white;
        box-shadow: 0 10px 25px rgba(197, 160, 89, 0.3);
    }

    .track-title {
        font-family: 'Outfit', sans-serif;
        font-size: 2.8rem;
        letter-spacing: -1px;
        color: white;
    }
    .track-subtitle {
        color: rgba(255, 255, 255, 0.6);
        font-size: 1.1rem;
        line-height: 1.6;
    }

    /* Input Styling */
    .input-modern-group {
        display: flex;
        align-items: center;
        position: relative;
    }
    .input-icon-box {
        position: absolute;
        left: 20px;
        color: #C5A059;
        font-size: 1.5rem;
        z-index: 5;
    }
    .modern-track-input {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 2px solid rgba(197, 160, 89, 0.3) !important;
        color: white !important;
        height: 70px;
        border-radius: 20px;
        padding-left: 60px !important;
        font-size: 1.2rem;
        letter-spacing: 2px;
        text-align: center;
        transition: all 0.3s;
    }
    .modern-track-input:focus {
        border-color: #C5A059 !important;
        box-shadow: 0 0 20px rgba(197, 160, 89, 0.2);
        background: rgba(255, 255, 255, 0.08) !important;
    }
    .modern-track-input::placeholder { color: rgba(255, 255, 255, 0.3); }

    /* Button Styling */
    .btn-track-submit {
        background: transparent;
        color: #fdfaf1;
        border: 2px solid #fdfaf1;
        border-radius: 15px;
        font-weight: 700;
        letter-spacing: 1px;
        transition: all 0.3s;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .btn-track-submit:hover {
        background: #fdfaf1;
        color: #581C1C;
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(255, 255, 255, 0.1);
    }

    .track-footer-link {
        color: rgba(255, 255, 255, 0.5);
        text-decoration: none;
        transition: 0.3s;
    }
    .track-footer-link:hover { color: #C5A059; }

    /* Light Mode Overrides */
    [data-theme="light"] .track-container {
        background: #ffffff !important;
        box-shadow: 0 30px 60px rgba(88, 28, 28, 0.1) !important;
    }
    [data-theme="light"] .track-title { color: #581C1C; }
    [data-theme="light"] .track-subtitle { color: rgba(88, 28, 28, 0.6); }
    [data-theme="light"] .modern-track-input {
        background: #fdfaf1 !important;
        border-color: rgba(88, 28, 28, 0.1) !important;
        color: #581C1C !important;
    }
    [data-theme="light"] .modern-track-input::placeholder { color: rgba(88, 28, 28, 0.3); }
    [data-theme="light"] .btn-track-submit {
        border-color: #581C1C;
        color: #581C1C;
    }
    [data-theme="light"] .btn-track-submit:hover {
        background: #581C1C;
        color: #ffffff;
    }
    [data-theme="light"] .track-footer-link { color: rgba(88, 28, 28, 0.5); }
</style>
