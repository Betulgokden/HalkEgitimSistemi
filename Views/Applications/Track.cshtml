@model HalkEgitimSistemi.Models.Application
@{
    ViewData["Title"] = "Başvuru Takip";
}

<div class="container py-5" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
    <div class="row w-100 justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="glass-card-static animate-scaleIn overflow-hidden p-4 p-md-5 text-center" 
                 style="border-radius: 40px; border: 2px solid var(--theme-card-border);">
                
                <div class="tracking-icon-wrapper mb-4">
                    <div class="tracking-pulse"></div>
                    <div class="tracking-icon">
                        <i class="bi bi-search"></i>
                    </div>
                </div>
                
                <h2 class="fw-900 mb-2" style="font-family: 'Outfit', sans-serif; font-size: 2.5rem; letter-spacing: -1px;">
                    Başvuru <span class="gold-text">Sorgula</span>
                </h2>
                
                <p class="text-white-50 mb-4 px-lg-5" style="font-size: 1.1rem;">
                    Başvuru durumunuzu anlık olarak öğrenmek için lütfen 11 haneli T.C. Kimlik Numaranızı giriniz.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert-premium mb-4 animate-shake">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                    </div>
                }

                <form asp-action="Track" method="post" class="mt-4">
                    <div class="form-premium-group mb-4">
                        <div class="input-glow-wrapper">
                            <i class="bi bi-person-vcard input-icon-gold"></i>
                            <input type="text" name="tcNo" 
                                   class="form-premium-control text-center tracking-input" 
                                   placeholder="11 HANELİ T.C. NO" 
                                   maxlength="11" 
                                   required 
                                   autocomplete="off" />
                        </div>
                    </div>
                    
                    <button type="submit" class="btn-vibrant-glow w-100 py-4 rounded-20" style="font-size: 1.2rem !important;">
                        <i class="bi bi-shield-check me-2"></i> DURUMU SORGULA
                    </button>
                </form>

                <div class="mt-5 pt-3 border-top border-white-10">
                    <a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none hover-gold small">
                        <i class="bi bi-house-door me-1"></i> Ana Sayfaya Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .tracking-icon-wrapper {
            position: relative;
            width: 100px;
            height: 100px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .tracking-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--gold), var(--maroon));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: white;
            z-index: 2;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }
        .tracking-pulse {
            position: absolute;
            width: 100%;
            height: 100%;
            background: var(--gold);
            border-radius: 50%;
            opacity: 0.3;
            animation: tracking-ping 2s infinite;
        }
        @@keyframes tracking-ping {
            0% { transform: scale(1); opacity: 0.3; }
            100% { transform: scale(1.5); opacity: 0; }
        }

        .input-glow-wrapper {
            position: relative;
        }
        .input-icon-gold {
            position: absolute;
            left: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gold);
            font-size: 1.5rem;
            z-index: 10;
        }
        .tracking-input {
            padding-left: 4rem !important;
            font-size: 1.4rem !important;
            letter-spacing: 0.2rem !important;
            font-family: 'Outfit', sans-serif !important;
            height: 70px !important;
            border-radius: 20px !important;
        }
        .alert-premium {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #ef4444;
            padding: 1rem;
            border-radius: 15px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* Theme awareness */
        [data-theme="light"] .glass-card-static {
            background: white !important;
            box-shadow: 0 20px 60px rgba(88, 28, 28, 0.08) !important;
        }
        [data-theme="light"] .text-white-50 {
            color: rgba(88, 28, 28, 0.6) !important;
        }
        [data-theme="light"] .tracking-input {
            background: rgba(88, 28, 28, 0.03) !important;
            color: #581C1C !important;
        }
    </style>
}
