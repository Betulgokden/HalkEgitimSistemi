@model IEnumerable<HalkEgitimSistemi.Models.LibraryBook>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Eğitim Arşivi | Dijital Kütüphane";
    string currentCategory = ViewBag.CurrentCategory ?? "Hepsi";
}

<style>
    :root {
        --primary-vibrant: #C5A059;
        --secondary-vibrant: #581C1C;
        --glass-bg: rgba(255, 255, 255, 0.05);
        --glass-border: rgba(255, 255, 255, 0.1);
        --premium-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        --vibrant-gradient: linear-gradient(135deg, #581C1C 0%, #8b2d2d 100%);
        --gold-gradient: linear-gradient(135deg, #C5A059 0%, #ffd700 100%);
    }

    body {
        background: #0f111a !important;
    }

    .library-wrapper {
        min-height: 100vh;
        padding: 150px 0 100px 0;
        font-family: 'Outfit', 'Inter', sans-serif;
        position: relative;
    }

    /* Redesigned Header */
    .library-header { text-align: center; margin-bottom: 80px; }
    .library-header h1 { 
        font-size: 5rem; 
        font-weight: 900; 
        color: #581C1C;
        letter-spacing: -3px;
        line-height: 1;
        margin-bottom: 10px;
        text-shadow: 0 10px 20px rgba(88, 28, 28, 0.2);
    }
    .library-header .archive-word {
        color: #C5A059;
        position: relative;
        display: inline-block;
    }
    .library-header .archive-word::after {
        content: '';
        position: absolute;
        bottom: 10px;
        left: 0;
        width: 100%;
        height: 8px;
        background: #581C1C;
        z-index: -1;
        opacity: 0.3;
    }
    .library-header p { 
        color: #581C1C; 
        font-size: 1.4rem; 
        font-weight: 700;
        opacity: 0.8;
    }

    .sidebar-glass {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(25px);
        border: 1px solid rgba(197, 160, 89, 0.2);
        border-radius: 30px;
        padding: 30px;
        box-shadow: var(--premium-shadow);
    }

    /* Campaign Banner Fix */
    .campaign-banner {
        background: white !important;
        border-radius: 35px !important;
        box-shadow: 0 30px 60px rgba(0,0,0,0.1) !important;
        border: none !important;
        transition: 0.3s;
    }
    [data-theme="dark"] .campaign-banner {
        background: #0f172a !important;
        border: 1px solid rgba(197, 160, 89, 0.2) !important;
    }

    .btn-premium-action {
        background: linear-gradient(135deg, #C5A059 0%, #581C1C 100%);
        color: white !important;
        padding: 15px 35px;
        border-radius: 20px;
        font-weight: 900;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 10px 30px rgba(88, 28, 28, 0.3);
        transition: 0.4s;
        border: none;
        letter-spacing: 1px;
    }
    .btn-premium-action:hover {
        transform: translateY(-5px) scale(1.05);
        box-shadow: 0 15px 40px rgba(88, 28, 28, 0.5);
    }

    /* Search Box Fix */
    .search-container-boxy {
        background: white;
        border-radius: 25px;
        padding: 8px;
        display: flex;
        align-items: center;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        margin-bottom: 60px;
    }
    [data-theme="dark"] .search-container-boxy {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(255,255,255,0.05);
    }
    .search-container-boxy input {
        border: none;
        background: transparent;
        padding: 15px 25px;
        flex-grow: 1;
        font-weight: 600;
        color: #581C1C;
        outline: none;
    }
    [data-theme="dark"] .search-container-boxy input { color: white; }
    .btn-search-gold {
        background: #581C1C;
        color: white !important;
        padding: 15px 45px;
        border-radius: 20px;
        font-weight: 900;
        border: none;
        transition: 0.3s;
    }
    .btn-search-gold:hover {
        background: #C5A059;
        transform: scale(1.02);
    }

    /* Category Links */
    .category-link {
        display: flex;
        align-items: center;
        padding: 14px 20px;
        color: #581C1C !important;
        text-decoration: none;
        border-radius: 12px;
        margin-bottom: 10px;
        transition: all 0.4s;
        font-weight: 700;
    }
    [data-theme="dark"] .category-link { color: #94a3b8 !important; }
    .category-link:hover, .category-link.active {
        background: #581C1C;
        color: white !important;
        transform: translateX(10px);
    }

    /* Book Cards */
    .book-card-boxy {
        background: white;
        border-radius: 30px;
        overflow: hidden;
        border: 1px solid rgba(88, 28, 28, 0.1);
        transition: 0.4s;
        height: 100%;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    }
    [data-theme="dark"] .book-card-boxy {
        background: rgba(15, 23, 42, 0.6);
        border-color: rgba(197, 160, 89, 0.2);
    }
    .book-card-boxy:hover {
        transform: translateY(-15px);
        box-shadow: 0 30px 60px rgba(88, 28, 28, 0.15);
        border-color: #581C1C;
    }
    .book-thumb-box { height: 260px; overflow: hidden; position: relative; }
    .book-thumb-box img { width: 100%; height: 100%; object-fit: cover; transition: 0.6s; }
    .book-card-boxy:hover .book-thumb-box img { transform: scale(1.1); }
</style>

<div class="library-wrapper">
    <div class="container">
        <!-- Header -->
        <div class="library-header animate-in">
            <h1>Eğitim <span class="archive-word">Arşivi</span></h1>
            <p>Bilgi Paylaştıkça Çoğalır, Başarı Birlikte Gelir</p>
        </div>

        <!-- Campaign Banner -->
        <div class="campaign-banner mb-5 p-4 animate-in" style="animation-delay: 0.1s;">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-4">
                <div class="d-flex align-items-center">
                    <div style="background: #581C1C; color: #C5A059; width: 65px; height: 65px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 2rem; box-shadow: 0 10px 20px rgba(88,28,28,0.2);">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                    <div class="ms-4">
                        <h4 class="m-0 fw-black" style="color: #581C1C;">Yıldızların Yarışı!</h4>
                        <p class="m-0 text-muted-premium">En çok yıldız alan 3 not sahibine özel eğitim bursu verilecektir.</p>
                    </div>
                </div>
                <a asp-controller="Student" asp-action="UploadNote" class="btn-premium-action">NOTUNU PAYLAŞ VE YARIŞ</a>
            </div>
        </div>

        <!-- Search Bar -->
        <form asp-action="Virtual" method="get" class="search-container-boxy animate-in" style="animation-delay: 0.2s;">
            <i class="bi bi-search ms-4" style="color: #581C1C; font-size: 1.2rem;"></i>
            <input type="text" name="category" placeholder="Arşivde derinlemesine arama yapın..." value="@currentCategory">
            <button type="submit" class="btn-search-gold">KEŞFET</button>
        </form>

        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3 mb-5">
                <div class="sidebar-glass animate-in" style="animation-delay: 0.3s;">
                    <h5 class="mb-4 fw-black" style="color: #581C1C;"><i class="bi bi-grid-fill me-2"></i> KATEGORİLER</h5>
                    <a href="?category=Hepsi" class="category-link @(currentCategory == "Hepsi" ? "active" : "")"><i class="bi bi-layers-fill me-2"></i> Tüm Arşiv</a>
                    <a href="?category=Yazılım" class="category-link @(currentCategory == "Yazılım" ? "active" : "")"><i class="bi bi-cpu-fill me-2"></i> Yazılım & Teknoloji</a>
                    <a href="?category=Sanat" class="category-link @(currentCategory == "Sanat" ? "active" : "")"><i class="bi bi-palette-fill me-2"></i> Sanat & Tasarım</a>
                    <a href="?category=Dil Eğitimi" class="category-link @(currentCategory == "Dil Eğitimi" ? "active" : "")"><i class="bi bi-translate me-2"></i> Yabancı Diller</a>
                    <a href="?category=Aşçılık" class="category-link @(currentCategory == "Aşçılık" ? "active" : "")"><i class="bi bi-fire me-2"></i> Gastronomi</a>
                </div>
            </div>

            <!-- Content -->
            <div class="col-lg-9">
                <div class="row g-4">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var note in Model)
                        {
                            <div class="col-md-6 col-xl-4 animate-in">
                                <div class="book-card-boxy">
                                    <div class="book-thumb-box">
                                        <img src="@(string.IsNullOrEmpty(note.CoverImageUrl) ? "https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=600" : note.CoverImageUrl)" alt="@note.Title">
                                        <div style="position:absolute; top:20px; right:20px; background: #581C1C; color: white; padding: 5px 15px; border-radius: 10px; font-size: 0.7rem; font-weight: 900;">DERS NOTU</div>
                                    </div>
                                    <div class="p-4">
                                        <h5 class="fw-bold card-title-theme mb-2">@note.Title</h5>
                                        <div class="d-flex align-items-center mb-4">
                                            <span class="small text-muted"><i class="bi bi-person-fill me-1"></i> @note.Author</span>
                                            <span class="ms-auto text-gold fw-bold"><i class="bi bi-star-fill me-1"></i> @note.StarCount</span>
                                        </div>
                                        <a asp-action="Reader" asp-route-id="@note.Id" class="btn btn-premium-action w-100 py-2">
                                            İNCELE
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5">
                            <h3 class="text-white">Arşivde henüz not bulunmuyor.</h3>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
