@model HalkEgitimSistemi.Models.LibraryBook
@{
    ViewData["Title"] = "Yeni Kitap Ekle";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card-static animate-scaleIn p-5">
                <div class="text-center mb-5">
                    <div class="icon-circle mb-3 mx-auto" style="width: 80px; height: 80px; background: var(--primary-glow); color: white; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 2rem;">
                        <i class="bi bi-journal-plus"></i>
                    </div>
                    <h2 style="font-family: 'Outfit', sans-serif; font-weight: 800; color: var(--text-primary);">Kütüphaneye Yeni Kitap</h2>
                    <p class="text-muted-premium">PDF dosyasını ve kapak resmini yükleyerek kütüphaneyi zenginleştirin.</p>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <div class="form-premium-group">
                                <label class="form-premium-label"><i class="bi bi-type me-1"></i>Kitap Adı</label>
                                <input asp-for="Title" class="form-premium-control" placeholder="Örn: Nutuk" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-premium-group">
                                <label class="form-premium-label"><i class="bi bi-person me-1"></i>Yazar</label>
                                <input asp-for="Author" class="form-premium-control" placeholder="Yazar adı..." required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-premium-group">
                                <label class="form-premium-label"><i class="bi bi-tags me-1"></i>Kategori</label>
                                <input asp-for="Category" class="form-premium-control" placeholder="Edebiyat, Tarih vb." />
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-premium-group">
                                <label class="form-premium-label"><i class="bi bi-card-text me-1"></i>Açıklama</label>
                                <textarea asp-for="Description" rows="3" class="form-premium-control" placeholder="Kitap hakkında kısa bilgi..."></textarea>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-premium-group">
                                <label class="form-premium-label"><i class="bi bi-file-earmark-pdf me-1"></i>PDF Dosyası</label>
                                <input type="file" name="pdfFile" class="form-control bg-glass border-glass text-primary-theme" accept=".pdf" />
                                <small class="text-muted-premium">Opsiyonel: Flipbook sayfaları otomatik oluşacaktır.</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-premium-group">
                                <label class="form-premium-label"><i class="bi bi-image me-1"></i>Kapak Resmi</label>
                                <input type="file" name="coverImage" class="form-control bg-glass border-glass text-primary-theme" accept="image/*" />
                            </div>
                        </div>

                        <div class="col-md-12 mt-4">
                            <div class="d-flex gap-3">
                                <a asp-action="Virtual" class="btn btn-premium btn-secondary-glass flex-fill justify-content-center py-3">
                                    İptal
                                </a>
                                <button type="submit" class="btn btn-premium btn-primary-glow flex-fill justify-content-center py-3">
                                    <i class="bi bi-cloud-upload me-2"></i> Kitabı Kaydet
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

