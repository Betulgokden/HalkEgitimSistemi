@{
    Layout = "_Layout";
    ViewData["Title"] = "Güvenli Şifre Kurtarma";
}

<div class="container py-5 mt-5" style="min-height: 85vh; display: flex; align-items: center; justify-content: center;">
    <div class="glass-card p-5 animate-scaleIn shadow-vibrant" style="max-width: 500px; border-radius: 35px; background: rgba(15, 23, 42, 0.9) !important;">
        <div class="text-center mb-5">
            <div class="icon-box-lg bg-vibrant-purple mx-auto mb-4 shadow-lg pulse-animation">
                <i class="bi bi-shield-lock-fill text-white fs-1"></i>
            </div>
            <h2 class="text-white fw-bold hero-main-title tracking-tight">ŞİFRE <span class="text-info">KURTARMA</span></h2>
            <p class="text-white-50 x-small uppercase letter-spacing-1">Siber Güvenlik Katmanı - Doğrulama</p>
        </div>

        <div class="modern-login-body">
            @if (ViewBag.Error != null)
            {
                <div class="alert bg-danger-glass border-danger text-danger animate-shake mb-4 rounded-4" style="font-size: 0.9rem;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div class="mb-4">
                    <label class="text-white-50 small mb-2"><i class="bi bi-envelope-at-fill me-2 text-info"></i> Kayıtlı E-Posta Adresi</label>
                    <div class="input-group">
                        <input type="email" name="email" class="cyber-input py-3" placeholder="ornek@sirket.com" required autofocus />
                    </div>
                    <p class="text-white-25 x-small mt-2">Sisteme kayıtlı e-posta adresinizi girdiğinizde, kimliğiniz doğrulanacak ve şifre sıfırlama adımına aktarılacaksınız.</p>
                </div>

                <button type="submit" class="btn-cyber-submit w-100 py-3 fs-5 fw-bold mb-4">
                    KİMLİK DOĞRULAMAYI BAŞLAT <i class="bi bi-arrow-right-circle ms-2"></i>
                </button>
                
                <div class="text-center border-top border-glass pt-4 mt-2">
                    <a asp-action="Login" class="text-white-50 small fw-bold text-decoration-none hover-white transition-all">
                        <i class="bi bi-arrow-left-circle-fill me-2"></i> Giriş Portalı'na Dön
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .bg-vibrant-purple { background: linear-gradient(135deg, #C5A059, #3b82f6) !important; }
    .bg-danger-glass { background: rgba(220, 38, 38, 0.1); border: 1px solid rgba(220, 38, 38, 0.2); }
    
    .cyber-input {
        background: rgba(30, 41, 59, 0.5) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 15px !important;
        color: white !important;
        padding-left: 20px !important;
        width: 100%;
        transition: all 0.3s;
    }
    .cyber-input:focus {
        border-color: #0ea5e9 !important;
        box-shadow: 0 0 20px rgba(14, 165, 233, 0.2) !important;
        outline: none;
    }
    
    .btn-cyber-submit {
        background: linear-gradient(90deg, #3b82f6, #C5A059);
        color: white;
        border: none;
        border-radius: 15px;
        transition: all 0.3s;
    }
    .btn-cyber-submit:hover {
        box-shadow: 0 0 30px rgba(197, 160, 89, 0.4);
        transform: translateY(-2px);
    }
    
    .icon-box-lg {
        width: 90px;
        height: 90px;
        border-radius: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .pulse-animation {
        animation: pulse-glow 2s infinite;
    }
    @@keyframes pulse-glow {
        0% { box-shadow: 0 0 0 0 rgba(197, 160, 89, 0.4); }
        70% { box-shadow: 0 0 0 20px rgba(197, 160, 89, 0); }
        100% { box-shadow: 0 0 0 0 rgba(197, 160, 89, 0); }
    }
</style>


