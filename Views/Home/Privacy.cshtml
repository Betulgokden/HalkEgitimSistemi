@{
    ViewData["Title"] = "Gizlilik Politikası";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="text-center mb-5 animate-fadeInDown">
        <span class="badge-premium badge-primary mb-3"><i class="bi bi-shield-lock"></i> Güvenlik</span>
        <h1 style="font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 900;">
            <span class="section-title-gradient">Gizlilik Politikası</span>
        </h1>
        <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto; font-size: 1.05rem;">
            Kişisel verilerinizin güvenliği bizim için önemlidir.
        </p>
    </div>

    <div class="privacy-section">
        <div class="privacy-item animate-fadeInUp delay-100">
            <div class="d-flex align-items-start gap-3">
                <div class="section-icon section-icon-primary flex-shrink-0" style="width: 45px; height: 45px; font-size: 1.2rem;">
                    <i class="bi bi-database-lock"></i>
                </div>
                <div>
                    <h4 style="color: var(--text-primary); font-weight: 700; margin-bottom: 0.5rem;">Veri Toplama</h4>
                    <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem; line-height: 1.8;">
                        Halk Eğitim Sistemi üzerinden yapılan başvurularda yalnızca ad, soyad, telefon, e-posta ve kurs tercihi bilgileri toplanmaktadır.
                        Bu bilgiler yalnızca eğitim hizmetlerinin sunulması amacıyla kullanılmaktadır.
                    </p>
                </div>
            </div>
        </div>

        <div class="privacy-item animate-fadeInUp delay-200">
            <div class="d-flex align-items-start gap-3">
                <div class="section-icon section-icon-success flex-shrink-0" style="width: 45px; height: 45px; font-size: 1.2rem;">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <h4 style="color: var(--text-primary); font-weight: 700; margin-bottom: 0.5rem;">Veri Güvenliği</h4>
                    <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem; line-height: 1.8;">
                        Toplanan tüm kişisel veriler, modern şifreleme teknolojileri kullanılarak güvenli sunucularda saklanmaktadır. 
                        Yetkisiz erişime karşı sürekli izleme ve güvenlik önlemleri uygulanmaktadır.
                    </p>
                </div>
            </div>
        </div>

        <div class="privacy-item animate-fadeInUp delay-300">
            <div class="d-flex align-items-start gap-3">
                <div class="section-icon section-icon-warning flex-shrink-0" style="width: 45px; height: 45px; font-size: 1.2rem;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h4 style="color: var(--text-primary); font-weight: 700; margin-bottom: 0.5rem;">Üçüncü Taraf Paylaşımı</h4>
                    <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem; line-height: 1.8;">
                        Kişisel verileriniz, yasal zorunluluklar dışında hiçbir üçüncü tarafla paylaşılmamaktadır. 
                        Verileriniz yalnızca eğitim hizmetlerimizin iyileştirilmesi amacıyla kullanılmaktadır.
                    </p>
                </div>
            </div>
        </div>

        <div class="privacy-item animate-fadeInUp delay-400">
            <div class="d-flex align-items-start gap-3">
                <div class="section-icon section-icon-danger flex-shrink-0" style="width: 45px; height: 45px; font-size: 1.2rem;">
                    <i class="bi bi-cookie"></i>
                </div>
                <div>
                    <h4 style="color: var(--text-primary); font-weight: 700; margin-bottom: 0.5rem;">Çerez Kullanımı</h4>
                    <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem; line-height: 1.8;">
                        Sitemizde kullandığımız çerezler, yalnızca oturum yönetimi ve kullanıcı deneyimini iyileştirmek amacıyla kullanılmaktadır. 
                        Kişisel tanımlama amaçlı çerez kullanılmamaktadır.
                    </p>
                </div>
            </div>
        </div>

        <div class="privacy-item animate-fadeInUp delay-500">
            <div class="d-flex align-items-start gap-3">
                <div class="section-icon flex-shrink-0" style="width: 45px; height: 45px; font-size: 1.2rem; background: rgba(139,92,246,0.15); color: #C5A059;">
                    <i class="bi bi-envelope-at"></i>
                </div>
                <div>
                    <h4 style="color: var(--text-primary); font-weight: 700; margin-bottom: 0.5rem;">İletişim</h4>
                    <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem; line-height: 1.8;">
                        Gizlilik politikamız hakkında sorularınız için <strong style="color: var(--primary-light);">info@halkegitim.gov.tr</strong> adresinden 
                        veya <strong style="color: var(--primary-light);">(0312) 123 45 67</strong> numaralı telefondan bize ulaşabilirsiniz.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

