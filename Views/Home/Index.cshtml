    <!-- 5. Borçka'ya Değer -->
    <div class="row g-4 mb-5 animate-fadeInUp">
        <div class="col-12">
            <div class="glass-card-static p-4 border-danger" style="background: rgba(88, 28, 28, 0.05); border-radius: 40px;">
                <div class="row align-items-center">
                    <div class="col-lg-1 text-center mb-3 mb-lg-0">
                        <i class="bi bi-tree-fill text-danger fs-1"></i>
                    </div>
                    <div class="col-lg-7">
                        <h4 class="text-white fw-bold mb-1" data-i18n="home_value_title">BORÇKA'YA DEĞER: <span class="text-danger">Karagöl'ü Yeşertiyoruz!</span></h4>
                        @{
                            var progressVal = await Settings.GetSettingAsync("KaragolGoalProgress", "342");
                            var targetVal = await Settings.GetSettingAsync("KaragolGoalTarget", "500");
                            var progress = int.Parse(progressVal);
                            var target = int.Parse(targetVal);
                            var percent = (progress * 100) / target;
                        }
                        <p class="text-white-50 small mb-3">Hedef: <b>@target</b> kursiyerimiz siber güvenlik eğitimini tamamlarsa, Borçka Karagöl çevresine fidan dikilecektir.</p>
                        <div class="progress" style="height: 12px; border-radius: 6px; background: rgba(255,255,255,0.05);">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" role="progressbar" style="width: @percent%;"></div>
                        </div>
                    </div>
                    <div class="col-lg-4 text-end">
                        <div class="text-danger fw-bold h3 mb-0">@progress / @target</div>
                        <div class="text-white-50 x-small fw-bold uppercase">TAMAMLANAN EĞİTİM</div>
                    </div>
                </div>
            </div>
        </div>
