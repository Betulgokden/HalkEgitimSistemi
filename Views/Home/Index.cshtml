}
<!-- 💼 Job Application Modal -->
<div class="modal fade" id="jobModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0" style="background: #0f172a; border-radius: 40px; overflow: hidden;">
            <div class="modal-body p-0">
                <div class="row g-0">
                    <!-- Left Side: Details -->
                    <div class="col-lg-5 p-5" style="background: rgba(88, 28, 28, 0.3);">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2 class="text-white fw-bold m-0" id="mJobTitle">İş İlanı Detayı</h2>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        
                        <div class="mb-4">
                            <h6 class="text-gold fw-bold uppercase letter-spacing-1 mb-2" data-i18n="job_requirements">Şartlar</h6>
                            <p class="text-white-50" id="mJobRequirements">Yükleniyor...</p>
                        </div>

                        <div class="mb-4">
                            <h6 class="text-gold fw-bold uppercase letter-spacing-1 mb-2" data-i18n="job_salary">Maaş Aralığı</h6>
                            <p class="text-white" id="mJobSalary">Görüşülecek</p>
                        </div>

                        <div class="mt-5 p-4 rounded-4" style="background: rgba(197, 160, 89, 0.1); border: 1px dashed rgba(197, 160, 89, 0.3);">
