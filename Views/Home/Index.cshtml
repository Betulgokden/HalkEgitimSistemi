        .text-vibrant-purple { color: #C5A059 !important; }
        .text-vibrant-pink { color: #581C1C !important; }
        .bg-vibrant-purple { background: #C5A059 !important; }
        .bg-vibrant-pink { background: #581C1C !important; }
        
        .shadow-gold { box-shadow: 0 10px 30px rgba(197, 160, 89, 0.2); }
