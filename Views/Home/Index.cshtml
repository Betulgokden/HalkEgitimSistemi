        </div>
        <div class="col-lg-3 col-md-6">
            <div class="glass-card-static p-4 text-center border-primary h-100" style="border-radius: 30px;">
                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200" class="rounded-circle mb-3 border border-3 border-warning" style="width: 80px; height: 80px; object-fit: cover;">
                <h6 class="text-white fw-bold mb-1">Usta Eller Ahşap</h6>
