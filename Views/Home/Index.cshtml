        }
        .glass-card:hover { 
            transform: translateY(-10px); 
            border-color: #C5A059 !important;
            background: rgba(255, 255, 255, 0.05) !important;
        }
        
        .hero-main-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 900;
            letter-spacing: -1px;
        }

        .gold-text {
            color: #C5A059 !important;
            text-shadow: none !important;
