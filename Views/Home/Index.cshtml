        .spotlight-badge { position: absolute; top: 20px; right: -30px; background: #C5A059; color: white; padding: 5px 40px; transform: rotate(45deg); font-size: 0.6rem; font-weight: 900; letter-spacing: 1px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); }
