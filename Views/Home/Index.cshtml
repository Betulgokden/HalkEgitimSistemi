            <div class="glass-card-static p-4 text-center border-primary h-100" style="border-radius: 30px;">
                <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=200" class="rounded-circle mb-3 border border-3 border-danger" style="width: 80px; height: 80px; object-fit: cover;">
                <h6 class="text-white fw-bold mb-1">Artvin Yazılım</h6>
                <p class="x-small text-danger fw-bold mb-3">Web Geliştirme Mezunu</p>
                <p class="x-small text-white-50 mb-4">"Dünyaya yazılım ihraç ediyorum."</p>
