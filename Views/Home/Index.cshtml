    <!-- 📸 INTERACTIVE GALLERY PREVIEW -->
    <div class="row g-4 mb-5 animate-fadeInUp">
        <div class="col-12 text-center mb-4">
            <h2 class="text-white fw-bold hero-main-title" data-i18n="home_gallery_title">DİJİTAL <span class="gold-text">GALERİ</span></h2>
