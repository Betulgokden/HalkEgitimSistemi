            <div class="gallery-item-premium">
                <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=400" alt="Students" class="rounded-4 w-100">
                <div class="gallery-badge">EKİP ÇALIŞMASI</div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="gallery-item-premium">
                <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=400" alt="Tech" class="rounded-4 w-100">
                <div class="gallery-badge">TEKNOLOJİ</div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="gallery-item-premium">
                <img src="https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=400" alt="Design" class="rounded-4 w-100">
                <div class="gallery-badge">YARATICILIK</div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="gallery-item-premium">
                <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=400" alt="Lab" class="rounded-4 w-100">
                <div class="gallery-badge">SİBER KAMPÜS</div>
            </div>
        </div>
    </div>

    <style>
        .gallery-item-premium {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            border: 2px solid rgba(255,255,255,0.05);
            transition: all 0.3s ease;
        }
        .gallery-item-premium:hover {
            border-color: #C5A059;
            transform: scale(1.05);
            z-index: 5;
        }
        .gallery-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(197, 160, 89, 0.8);
            backdrop-filter: blur(5px);
            color: white;
            font-size: 0.6rem;
            font-weight: 900;
            padding: 5px 12px;
            border-radius: 20px;
            letter-spacing: 1px;
        }
    </style>

    <!-- 6. Borçka Dijital 3D Isı Haritası (Google Earth Style) -->
    <div class="row align-items-center mt-5 mb-5">
        <div class="col-lg-4 mb-4 mb-lg-0 animate-fadeInLeft">
            <div class="d-flex align-items-center mb-4">
                <div style="width: 12px; height: 12px; background: #581C1C; border-radius: 50%; box-shadow: 0 0 10px #581C1C;" class="me-3 animate-pulse"></div>
                <h2 class="text-white fw-bold hero-main-title m-0" data-i18n="home_map_title">BORÇKA <span class="gold-text">3D EARTH</span></h2>
            </div>
            
            <p class="text-white-50 mb-4" data-i18n="home_map_text">
                Borçka'nın mahallelerini 3D uydu teknolojisiyle keşfedin. 
                <b>@ViewBag.LeaderNeighborhood</b> bu hafta eğitimde zirvede!
            </p>

            <div class="glass-card-static p-4 mb-4" style="border-radius: 25px; background: rgba(197, 160, 89, 0.1); border: 1px solid rgba(197, 160, 89, 0.2);">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary rounded-circle p-2 me-3">
                        <i class="bi bi-star-fill text-white"></i>
                    </div>
                    <h6 class="text-white fw-bold m-0">MAHALLE GÖREVİ</h6>
                </div>
                <p class="x-small text-white-50">"Gündoğdu Mahallesi 100 kursiyer barajını geçerse, özel Robotik Atölyesi!"</p>
                <div class="progress mt-3" style="height: 6px; background: rgba(255,255,255,0.05);">
                    <div class="progress-bar bg-danger" style="width: 75%;"></div>
                </div>
            </div>

            <div class="neighborhood-rankings">
                @if (ViewBag.Neighborhoods != null)
                {
                    foreach (var n in ((IEnumerable<HalkEgitimSistemi.Models.Neighborhood>)ViewBag.Neighborhoods).OrderByDescending(x => x.ActiveStudents).Take(3))
                    {
                        <div class="glass-card-static p-3 mb-3 d-flex justify-content-between align-items-center" style="border-radius: 20px;">
                            <div>
                                <div class="text-white fw-bold small">@n.Name</div>
                                <div class="progress mt-2" style="height: 4px; width: 100px; background: rgba(255,255,255,0.05);">
                                    <div class="progress-bar bg-primary" style="width: @((n.Intensity * 100))%;"></div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="text-vibrant-purple fw-bold small">@n.ActiveStudents Kursiyer</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="col-lg-8 animate-fadeInRight">
            <div id="heatmap-container" class="glass-card-static p-2 border-primary-glow shadow-3xl" style="border-radius: 40px; height: 600px; position: relative; overflow: hidden; background: #000 !important;">
                <!-- 🌍 Google Earth / Maps Embed -->
                @{
                    var mapLat = await Settings.GetSettingAsync("Map_Lat", "41.363923");
                    var mapLng = await Settings.GetSettingAsync("Map_Lng", "41.679698");
                    var mapZoom = await Settings.GetSettingAsync("Map_Zoom", "18");
                    var mapUrl = $"https://maps.google.com/maps?q={mapLat},{mapLng}&t=k&z={mapZoom}&ie=UTF8&iwloc=&output=embed";
                }
                <iframe 
                    style="border:0; border-radius: 35px; width: 100%; height: 100%;" 
                    loading="lazy" 
                    allowfullscreen 
                    src="@mapUrl">
                </iframe>
                
                <!-- Floating Info Overlay -->
                <div class="map-overlay-badge" style="position: absolute; top: 25px; right: 25px; z-index: 10; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(10px); padding: 10px 20px; border-radius: 30px; border: 1px solid rgba(197, 160, 89, 0.3); color: white; font-size: 0.8rem; font-weight: 800;">
                    <i class="bi bi-broadcast text-danger me-2 animate-pulse"></i> CANLI 3D UYDU GÖRÜNTÜSÜ
                </div>

                <div class="map-legend" style="position: absolute; bottom: 30px; left: 30px; z-index: 10; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(10px); padding: 15px; border-radius: 20px; border: 1px solid rgba(197, 160, 89, 0.2);">
                    <div class="text-white x-small fw-bold mb-2 uppercase">EĞİTİM YOĞUNLUĞU</div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="x-small text-white-50">Seyrek</span>
                        <div style="width: 100px; height: 8px; border-radius: 4px; background: linear-gradient(90deg, #C5A059, #581C1C);"></div>
                        <span class="x-small text-white-50">Yoğun</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

