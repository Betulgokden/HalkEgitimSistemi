@model List<HalkEgitimSistemi.Models.News>
@using HalkEgitimSistemi.Services
@using System.Linq
@inject ISiteSettingsService Settings
@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "_Layout";
}






<section class="hero-vibrant hero-huge" style="padding-top: 40px !important;">
    <div class="container hero-content text-center mt-5">
        <!-- Status Badge -->
        <div class="status-badge-wrapper animate-fadeIn">
            <span class="status-badge" style="background: rgba(197, 160, 89, 0.05); border: 1px solid rgba(197, 160, 89, 0.2); padding: 10px 25px; border-radius: 30px; font-weight: 700; color: #C5A059; box-shadow: 0 0 20px rgba(197, 160, 89, 0.2);">
                <i class="bi bi-patch-check-fill me-2"></i> <span data-i18n="hero_badge">✅ MEB Onaylı Sertifika • 🛡️ %100 Kurumsal Güvence</span>
            </span>
        </div>

        <!-- Main Heading -->
        <h1 class="hero-title animate-fadeInUp mt-4" style="animation-delay: 0.2s; font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.1; letter-spacing: -2px;">
            <span style="color: #C5A059;" data-i18n="hero_title_1">Potansiyelini Keşfet,</span><br>
            <span style="color: #581C1C;" data-i18n="hero_title_2">Kendi Geleceğinin Mimarı Ol</span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-subtitle animate-fadeInUp mx-auto mt-4" style="animation-delay: 0.4s; max-width: 800px; font-size: 1.25rem; opacity: 0.8; line-height: 1.6;" data-i18n="hero_subtitle">
            Eğitim sürecinizi resmi ve geçerli bir kariyere bağlayın. 
            Gelecek Atölyesi ve Fikir Bankası ile vizyonunuzu profesyonel hayata taşıyın, geleceğin mimarı olun.
        </p>

        <!-- CTA Buttons -->
        <div class="hero-cta animate-fadeInUp mt-5" style="animation-delay: 0.6s;">
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a asp-controller="Courses" asp-action="Browse" class="btn btn-lg px-5 py-3 rounded-pill shadow-lg" style="background: #581C1C !important; color: #C5A059 !important; border: 1px solid #C5A059 !important; font-weight: 800 !important; box-shadow: 0 10px 30px rgba(88, 28, 28, 0.4) !important;">
                    <i class="bi bi-rocket-takeoff me-2"></i> <span data-i18n="hero_btn_start">Hemen Başla</span>
                </a>
                <a href="#about" class="btn btn-lg px-5 py-3 rounded-pill" style="border: 2px solid #C5A059 !important; color: #C5A059 !important; background: rgba(197, 160, 89, 0.05) !important; font-weight: 700 !important; backdrop-filter: blur(10px);">
                    <i class="bi bi-info-circle me-2"></i> <span data-i18n="hero_btn_about">Kurumsal Güvence</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- KARİYER VE YETENEK MERKEZİ (UNIFIED HUB) -->
<section id="career-hub" class="py-4" style="background: radial-gradient(circle at center, rgba(128, 0, 0, 0.05), transparent 70%); border-bottom: 1px solid var(--border-color);">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <!-- Left: HalkPoint Leaderboard -->
            <div class="col-lg-4">
                <div class="glass-card p-4 h-100" style="border: 2px solid #C5A059; background: rgba(197, 160, 89, 0.1) !important; border-radius: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h4 class="gold-text" style="font-weight: 900; margin: 0;"><i class="bi bi-trophy-fill me-2"></i> <span data-i18n="home_leaderboard">Liderlik Tablosu</span></h4>
                            <span class="badge rounded-pill bg-maroon-theme text-gold px-3 py-2 fw-bold" style="background: var(--maroon); color: var(--gold); border: 1px solid var(--gold);">HalkPoint</span>
                        </div>
                        
                        <div class="table-responsive">
                            <table class="table w-100 m-0" style="border-collapse: separate; border-spacing: 0 10px;">
                                <tbody style="background: transparent !important;">
                                    @if (ViewBag.TopStudents != null)
                                    {
                                        int rank = 1;
                                        foreach (var student in (IEnumerable<HalkEgitimSistemi.Models.Student>)ViewBag.TopStudents)
                                        {
                                            <tr class="leaderboard-item animate-fadeIn" style="background: rgba(88, 28, 28, 0.15) !important; border-radius: 15px; border: 1px solid var(--theme-card-border) !important; transition: transform 0.3s ease;">
                                                <td style="padding: 15px; border: none; border-radius: 15px 0 0 15px; width: 60px;">
                                                    @if (rank == 1)
                                                    {
                                                        <div style="position: absolute; transform: translate(-20px, -25px) rotate(-15deg); font-size: 1.5rem; color: #ffd700; filter: drop-shadow(0 0 5px rgba(255,215,0,0.5));">
                                                            <i class="bi bi-crown-fill"></i>
                                                        </div>
                                                    }
                                                    <span class="badge" style="background: @(rank == 1 ? "linear-gradient(135deg, #FFD700, #C5A059)" : "var(--maroon)"); color: @(rank == 1 ? "#581C1C" : "var(--gold)"); border: 1px solid var(--gold); font-size: 0.9rem; padding: 10px 14px; font-weight: 900; border-radius: 12px; display: block; text-align: center;">@rank</span>
                                                </td>
                                                <td style="padding: 15px; border: none;">
                                                    <strong class="gold-text" style="font-size: 1.1rem; font-family: 'Outfit';">@student.FirstName @student.LastName</strong>
                                                    @if (rank <= 3) { <i class="bi bi-patch-check-fill ms-1" style="color: #C5A059; font-size: 0.8rem;"></i> }
                                                </td>
                                                <td class="text-end" style="padding: 15px; border: none; border-radius: 0 15px 15px 0;">
                                                    <span class="gold-text" style="font-size: 1.2rem; font-weight: 900;">@student.Points <small style="font-size: 0.7rem; opacity: 0.7;">HP</small></span>
                                                </td>
                                            </tr>
                                            rank++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4 p-3 rounded-4" style="background: rgba(197, 160, 89, 0.05); border: 1px dashed var(--gold);">
                            <h6 class="gold-text" style="font-weight: 800; font-size: 0.75rem; margin-bottom: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">NASIL KAZANILIR?</h6>
                            <div class="d-flex flex-column gap-2 x-small" style="color: var(--theme-text); opacity: 0.9; font-weight: 600;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-plus-circle-fill me-2 maroon-text" style="color: var(--maroon) !important;"></i>Derse Katılım</span>
                                    <strong class="gold-text">10 HP</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-plus-circle-fill me-2 maroon-text" style="color: var(--maroon) !important;"></i>Not Paylaşımı</span>
                                    <strong class="gold-text">50 HP</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-plus-circle-fill me-2 maroon-text" style="color: var(--maroon) !important;"></i>Quiz Başarısı</span>
                                    <strong class="gold-text">100 HP</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            <!-- Middle: Active Job Postings -->
            <div class="col-lg-5">
                <div class="glass-card p-4 h-100" style="border-radius: 30px; border: 2px solid #C5A059; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="gold-text" style="font-weight: 900; margin: 0;"><i class="bi bi-briefcase-fill me-2"></i> <span data-i18n="home_job_postings">Güncel İş İlanları</span></h4>
                        <a href="/Jobs" class="btn btn-link p-0 x-small fw-bold gold-text" style="text-decoration: none;">TÜMÜ <i class="bi bi-arrow-right"></i></a>
                    </div>
                    
                    <div class="row g-3">
                        @if (ViewBag.JobPostings != null && ((List<HalkEgitimSistemi.Models.JobPosting>)ViewBag.JobPostings).Any())
                        {
                            @foreach (var job in ((List<HalkEgitimSistemi.Models.JobPosting>)ViewBag.JobPostings).Take(2))
                            {
                                <div class="col-12">
                                    <div class="p-3 rounded-4 border transition-all job-card-light">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="text-white" style="font-weight: 800; margin: 0;">@job.Title</h6>
                                            <span class="badge" style="background: #581C1C; color: #C5A059; font-size: 0.7rem;">@job.RequiredCategory</span>
                                        </div>
                                        <div class="text-white-50" style="font-size: 0.8rem; margin-bottom: 1rem;"><i class="bi bi-geo-alt me-1"></i> @job.Location | <i class="bi bi-cash-stack me-1"></i> @job.SalaryRange</div>
                                        <button class="btn w-100 rounded-pill" style="background: #581C1C; color: #C5A059; font-weight: 800; font-size: 0.85rem;" onclick="openJobModal(@job.Id, '@job.Title', '@job.Requirements.Replace("'", "\\'")', '@job.SalaryRange')" data-i18n="home_examine_btn">İncele</button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Fallback Dummy Data -->
                            <div class="col-12">
                                <div class="p-3 rounded-4 border job-card-light" style="opacity: 0.8;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="text-white" style="font-weight: 800; margin: 0;">Grafik Tasarımcı</h6>
                                        <span class="badge" style="background: #581C1C; color: #C5A059; font-size: 0.7rem;">REKLAM</span>
                                    </div>
                                    <div class="text-white-50" style="font-size: 0.8rem; margin-bottom: 0.5rem;">Borçka Merkez | 35.000 TL - 45.000 TL</div>
                                    <button class="btn w-100 rounded-pill disabled" style="background: rgba(88, 28, 28, 0.1); color: #581C1C; font-weight: 700; border: none;">Sistem Kaydı Bekleniyor</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Career Matrix & Stats -->
            <div class="col-lg-3">
                <div class="glass-card p-4 h-100" style="border-radius: 25px; border: 1px solid var(--border-color); box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
                    <h5 class="gold-text fw-black mb-3 text-center" data-i18n="home_career_matrix">KARİYER MATRİSİ</h5>
                    
                    <div class="d-grid gap-2">
                        <div class="matrix-item-mini p-2 rounded-3 border border-white-10 matrix-item-light" style="background: rgba(88, 28, 28, 0.05);">
                            <div class="d-flex justify-content-between x-small fw-bold">
                                <span class="text-white">Siber Güvenlik</span>
                                <span class="gold-text">500 HP</span>
                            </div>
                            <div class="progress mt-1" style="height: 4px; background: rgba(0,0,0,0.1);">
                                <div class="progress-bar bg-warning" style="width: 100%;"></div>
                            </div>
                        </div>
                        <div class="matrix-item-mini p-2 rounded-3 border border-white-10 opacity-50 matrix-item-light" style="background: rgba(88, 28, 28, 0.02);">
                            <div class="d-flex justify-content-between x-small fw-bold">
                                <span class="text-white">Yapay Zeka</span>
                                <span class="gold-text">3000 HP</span>
                            </div>
                            <div class="progress mt-1" style="height: 4px; background: rgba(0,0,0,0.1);">
                                <div class="progress-bar bg-warning" style="width: 30%;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top border-white-10">
                        <button type="button" class="btn btn-warning-glow btn-sm w-100 rounded-pill mb-2 fw-bold" style="background: #C5A059; color: #581C1C; border: none; box-shadow: 0 0 20px rgba(197,160,89,0.5);" data-bs-toggle="modal" data-bs-target="#talentMapModal">
                            <i class="bi bi-map-fill me-1"></i> Yetenek Haritası
                        </button>
                        <div class="form-check form-switch modern-switch d-flex align-items-center justify-content-center gap-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="readyToWorkSwitch" style="width: 35px; height: 18px;">
                            <label class="form-check-label text-white fw-bold x-small" for="readyToWorkSwitch" data-i18n="home_ready_to_work">ACİL İSTİHDAM</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .fw-black { font-weight: 900 !important; }
    .bg-bronze { background: linear-gradient(135deg, #cd7f32, #a0522d); }
    .matrix-item { transition: all 0.3s ease; }
    .matrix-item:hover { transform: translateY(-5px); background: rgba(197,160,89,0.15) !important; }
    .job-card-premium { transition: all 0.4s ease; cursor: pointer; }
    .job-card-premium:hover { transform: scale(1.02); box-shadow: 0 15px 35px rgba(197, 160, 89, 0.2) !important; }
    .fw-900 { font-weight: 900 !important; }
</style>

<!-- Job Detail Modal -->
<div class="modal fade" id="jobModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-gold">
            <div class="modal-header border-0">
                <h5 class="modal-title text-gold" id="jobModalTitle"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-white">
                <p><strong>Gereksinimler:</strong> <span id="jobModalReqs"></span></p>
                <p><strong>Maaş:</strong> <span id="jobModalSalary"></span></p>
            </div>
            <div class="modal-footer border-0">
                <a href="/Application/Apply" class="btn btn-primary">Başvuru Yap</a>
            </div>
        </div>
    </div>
</div>

<script>
    function openJobModal(id, title, reqs, salary) {
        document.getElementById('jobModalTitle').innerText = title;
        document.getElementById('jobModalReqs').innerText = reqs;
        document.getElementById('jobModalSalary').innerText = salary;
        new bootstrap.Modal(document.getElementById('jobModal')).show();
    }
</script>

<style>
    .showcase-card {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: pointer;
    }
    .showcase-card:hover {
        transform: scale(1.03) translateY(-10px);
        box-shadow: 0 20px 40px rgba(197, 160, 89, 0.3);
    }
    .showcase-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 30px 20px 20px;
        background: linear-gradient(to top, rgba(15, 23, 42, 0.9), transparent);
        color: white;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.4s ease;
    }
    .showcase-card:hover .showcase-overlay {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<!-- MAIN CONTENT WRAPPER -->
<main class="container py-5">
    
    <!-- 1. Announcements & Gamification -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="fw-bold mb-0 gold-text" style="font-size: 2.2rem;" data-i18n="home_announcements">Son Duyurular</h2>
                    <div style="width: 60px; height: 4px; background: #C5A059; border-radius: 10px; margin-top: 8px;"></div>
                </div>
                <a asp-controller="News" asp-action="Index" class="btn btn-link text-primary text-decoration-none p-0 fw-bold"><span data-i18n="home_view_all">Tümünü Gör</span> <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    @foreach (var news in Model.Take(2))
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border-0 glass-card shadow-lg" style="border-radius: 25px; overflow: hidden; background: var(--bg-card); transition: 0.4s;">
                                @if (!string.IsNullOrEmpty(news.ImageUrl)) {
                                    <img src="@news.ImageUrl" class="card-img-top" style="height: 160px; object-fit: cover;" alt="@news.Title">
                                }
                                <div class="card-body p-4">
                                    <div class="text-primary small mb-2 fw-bold"><i class="bi bi-calendar-event me-2"></i> @news.Date.ToShortDateString()</div>
                                    <h5 class="card-title fw-bold text-white mb-2">@news.Title</h5>
                                    <p class="card-text text-white-50 small mb-3">@(news.Content?.Length > 100 ? news.Content.Substring(0, 100) + "..." : news.Content)</p>
                                    <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id" class="btn btn-outline-light btn-sm rounded-pill px-4" data-i18n="home_read">Devamını Oku</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-card-static p-4 h-100 border-primary-glow animate-fadeInRight" style="background: var(--bg-card) !important; border-radius: 30px;">
                <div class="badge bg-primary mb-3" data-i18n="home_new_gen">YENİ NESİL ÖĞRENME</div>
                <h3 class="fw-bold text-white mb-3" data-i18n="home_quiz_title">Bilgini Göster, <span class="gold-text">Ücretsiz Kurs</span> Kazan!</h3>
                <p class="text-white-50 small mb-4" data-i18n="home_quiz_text">Yarışmaya katılın, puanları toplayın ve dilediğiniz kursa ücretsiz kayıt olma şansı yakalayın.</p>
                <div class="points-preview mb-4">
                    <div class="d-flex justify-content-between text-white small mb-1">
                        <span data-i18n="home_points_target">Hedef Puan</span>
                        <span>450/500</span>
                    </div>
                    <div class="progress bg-dark" style="height: 10px; border-radius: 5px;">
                        <div class="progress-bar bg-primary" style="width: 90%;"></div>
                    </div>
                </div>
                <a asp-controller="Quiz" asp-action="Index" class="btn btn-primary w-100 py-3 rounded-pill">
                    <i class="bi bi-controller me-2"></i> <span data-i18n="home_join_quiz">Yarışmaya Katıl</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 2. Bilgi Kilidi -->
    <div class="row g-4 mb-5">
        <div class="col-12">
            <div class="glass-card-static p-5 animate-fadeInUp shadow-3xl" style="background: var(--bg-card) !important; border: 1px solid var(--border-color) !important; border-radius: 40px; position: relative; overflow: hidden;">
                <div class="row align-items-center">
                    <div class="col-lg-2 text-center mb-4 mb-lg-0">
                        <i class="bi bi-safe2-fill text-primary" style="font-size: 5rem; filter: drop-shadow(0 0 20px rgba(197, 160, 89, 0.5));"></i>
                    </div>
                    <div class="col-lg-6">
                        <h2 class="text-white fw-900 mb-2" style="font-family: 'Outfit';" data-i18n="home_vault_title">BİLGİ KİLİDİ: <span class="gold-text">Hazineyi Açın!</span></h2>
                        <p class="text-white-50 mb-4" data-i18n="home_vault_text">Her onaylı ders notu, bu dijital kasanın kilidini biraz daha açar. Topluluk olarak %100'e ulaştığımızda, ayın en popüler kursu herkese <span class="text-warning fw-bold">ücretsiz</span> olacak!</p>
                        <div class="vault-progress-wrapper mb-3">
                            <div class="d-flex justify-content-between text-white-50 small mb-2">
                                <span class="fw-bold"><i class="bi bi-unlock-fill me-1"></i> Kilit Açılma Oranı</span>
                                <span class="fw-bold text-primary">@((ViewBag.VaultProgress ?? 42))% Tamamlandı</span>
                            </div>
                            <div class="progress" style="height: 20px; border-radius: 10px; background: rgba(255,255,255,0.05);">
                                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: @((ViewBag.VaultProgress ?? 42))%; background: linear-gradient(90deg, #C5A059, #581C1C) !important;"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 text-center">
                        <div class="p-4 rounded-30" style="background: rgba(197, 160, 89, 0.05); border: 1px dashed rgba(197, 160, 89, 0.3);">
                            <p class="text-white small mb-3 fw-bold" data-i18n="home_vault_hint">Not yükle ve kasanın kilidini aç!</p>
                            <a asp-controller="Library" asp-action="Virtual" class="btn btn-primary w-100 py-3 rounded-pill" data-i18n="home_vault_btn">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i> NOT YÜKLE
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Freelance & İşveren -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="glass-card-static p-4 h-100" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 35px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="text-white fw-bold m-0" data-i18n="home_freelance_title"><i class="bi bi-rocket-takeoff-fill text-success me-2"></i> FREELANCE KÖPRÜSÜ</h4>
                    <span class="badge bg-success text-white small">2026 KAZANÇ REHBERİ</span>
                </div>
                <div class="row g-3 text-center">
                    <div class="col-md-4">
                        <div class="p-3 bg-glass rounded-4 border border-secondary">
                            <i class="bi bi-code-slash text-info fs-3"></i>
                            <div class="text-white fw-bold">₺25.000+</div>
                            <div class="x-small text-white-50">Yazılım</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-glass rounded-4 border border-secondary">
                            <i class="bi bi-palette text-danger fs-3"></i>
                            <div class="text-white fw-bold">₺22.000+</div>
                            <div class="x-small text-white-50">Tasarım</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-glass rounded-4 border border-secondary">
                            <i class="bi bi-translate text-warning fs-3"></i>
                            <div class="text-white fw-bold">₺18.500+</div>
                            <div class="x-small text-white-50">Çeviri</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="glass-card-static p-4 h-100" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 35px;">
