<style>
    .job-card-premium { transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    .job-card-premium:hover { transform: translateY(-10px); background: rgba(197, 160, 89, 0.05); }
    .job-badge { position: absolute; top: 0; right: 0; background: #C5A059; color: #581C1C; padding: 5px 20px; font-weight: 800; font-size: 0.7rem; border-bottom-left-radius: 20px; text-transform: uppercase; }
    .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    
    .signature-wrapper canvas { display: block; }
</style>

<script>
    let signaturePad;

    document.addEventListener("DOMContentLoaded", function() {
        const canvas = document.getElementById('signature-pad');
        signaturePad = new SignaturePad(canvas);
        
        // Resize canvas correctly
        function resizeCanvas() {
            const ratio =  Math.max(window.devicePixelRatio || 1, 1);
            canvas.width = canvas.offsetWidth * ratio;
            canvas.height = canvas.offsetHeight * ratio;
            canvas.getContext("2d").scale(ratio, ratio);
            signaturePad.clear();
        }
        window.onresize = resizeCanvas;
        resizeCanvas();
    });

    function openJobModal(id, title, req, salary) {
        document.getElementById('mJobId').value = id;
        document.getElementById('mJobTitle').innerText = title;
        document.getElementById('mJobRequirements').innerText = req;
        document.getElementById('mJobSalary').innerText = salary;
        
        const myModal = new bootstrap.Modal(document.getElementById('jobModal'));
        myModal.show();
        
        // Timeout to ensure canvas is visible before resizing
        setTimeout(() => {
            const canvas = document.getElementById('signature-pad');
            const ratio =  Math.max(window.devicePixelRatio || 1, 1);
            canvas.width = canvas.offsetWidth * ratio;
            canvas.height = canvas.offsetHeight * ratio;
            canvas.getContext("2d").scale(ratio, ratio);
            signaturePad.clear();
        }, 300);
    }

    function clearSignature() {
        signaturePad.clear();
    }

    async function submitApplication() {
        if (signaturePad.isEmpty()) {
            alert("Lütfen başvuruyu dijital olarak imzalayın.");
            return;
        }

        const name = document.getElementById('appFullName').value;
        const email = document.getElementById('appEmail').value;
        const experience = document.getElementById('appExperience').value;
        const jobTitle = document.getElementById('mJobTitle').innerText;
        
        if (!name || !email || !experience) {
            alert("Lütfen tüm alanları doldurun.");
            return;
        }

        const signatureData = signaturePad.toDataURL();

        // 📄 Generate PDF using jsPDF
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        // PDF Styling
        doc.setFillColor(88, 28, 28);
        doc.rect(0, 0, 210, 40, 'F');
        
        doc.setTextColor(255, 255, 255);
        doc.setFontSize(22);
        doc.text("BORCKA HALK EGITIM MERKEZI", 20, 20);
        doc.setFontSize(12);
        doc.text("KARIYER VE ISTIHDAM PORTALI - IS BASVURU FORMU", 20, 30);

        doc.setTextColor(0, 0, 0);
        doc.setFontSize(14);
        doc.text("ILAN BILGILERI", 20, 55);
        doc.setLineWidth(0.5);
        doc.line(20, 57, 190, 57);

        doc.setFontSize(11);
        doc.text("Pozisyon: " + jobTitle, 20, 65);
        doc.text("Tarih: " + new Date().toLocaleDateString(), 150, 65);

        doc.setFontSize(14);
        doc.text("ADAY BILGILERI", 20, 85);
        doc.line(20, 87, 190, 87);

        doc.setFontSize(11);
        doc.text("Ad Soyad: " + name, 20, 95);
        doc.text("E-Posta: " + email, 20, 105);
        
        doc.text("Deneyim Ozeti:", 20, 120);
        const splitExperience = doc.splitTextToSize(experience, 170);
        doc.text(splitExperience, 20, 127);

        doc.text("ADAY IMZASI", 40, 200);
        
        doc.text("KURUMSAL ONAY (KASE/MÜHÜR)", 130, 200);
        // Placeholder for Admin Stamp (Institutional Approval)
        doc.setDrawColor(197, 160, 89);
        doc.setLineWidth(1);
        doc.circle(160, 220, 15);
        doc.setFontSize(8);
        doc.text("BORCKA HEM", 152, 218);
        doc.text("ONAYLANDI", 153, 223);

        doc.save(`Borcka_HEM_Basvuru_${name.replace(" ", "_")}.pdf`);

        // Simulate sending to employer
        const sendToEmployer = confirm("Başvurunuz başarıyla tamamlandı ve PDF dosyanız oluşturuldu!\n\nBu PDF dosyasını işverene 'Mesaj Yoluyla' şimdi göndermek ister misiniz?");
        
        if (sendToEmployer) {
            alert("PDF Dosyası işverene güvenli mesaj kanalı üzerinden iletildi. İşveren profilindeki 'Gelen Başvurular' sekmesinden bu dosyaya erişebilecektir.");
        }

        bootstrap.Modal.getInstance(document.getElementById('jobModal')).hide();
        clearSignature();
        document.getElementById('jobAppForm').reset();
    }
</script>

