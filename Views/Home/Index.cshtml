                <a href="#" class="btn btn-sm btn-outline-warning rounded-pill px-4">Atölye</a>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="glass-card-static p-4 text-center border-primary h-100" style="border-radius: 30px;">
                <img src="https://images.unsplash.com/photo-1488590528505-98d2b5aba04b?w=200" class="rounded-circle mb-3 border border-3 border-primary" style="width: 80px; height: 80px; object-fit: cover;">
