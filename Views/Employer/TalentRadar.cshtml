@model IEnumerable<HalkEgitimSistemi.Models.Student>
@{
    ViewData["Title"] = "B2B Yetenek Radarı";
    Layout = "_Layout";
}

<div class="radar-page">
    <div class="radar-overlay"></div>
    
    <div class="container py-5" style="position: relative; z-index: 10;">
        <div class="text-center mb-5">
            <h1 class="radar-title animate-pulse-slow">B2B YETENEK RADARI</h1>
            <p class="text-muted-premium">"Geleceğin Yıldızlarını Anonim Olarak Keşfedin."</p>
        </div>

        <div class="radar-grid">
            @foreach (var student in Model)
            {
                var completionRate = student.Applications.Count(a => a.IsCompleted) * 20; // Basit bir hesaplama
                if (completionRate > 100) completionRate = 100;
                
                <div class="talent-node-card glass-card" onclick="showTalentDetail('@student.Id', '@completionRate')">
                    <div class="heatmap-dot" style="opacity: @(completionRate / 100.0); transform: scale(@(0.5 + completionRate / 100.0));"></div>
                    <div class="talent-info">
                        <span class="talent-id">#NODE-@student.Id.ToString("D4")</span>
                        <div class="talent-tags">
                            @if (student.Skills != null) {
                                foreach(var skill in student.Skills.Split(',').Take(2)) {
                                    <span class="skill-tag">@skill.Trim()</span>
                                }
                            }
                        </div>
                        <div class="talent-progress">
                            <div class="progress-bar" style="width: @(completionRate)%"></div>
                        </div>
                        <span class="progress-text">%@completionRate Yetenek Ağacı Tamamlandı</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Talent Detail Modal -->
<div class="modal fade" id="talentDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-0" style="background: rgba(15, 15, 35, 0.98); border-radius: 30px;">
            <div class="modal-body p-5">
                <div class="row align-items-center">
                    <div class="col-md-4 text-center">
                        <div class="anonymous-avatar">
                            <i class="bi bi-person-bounding-box display-1 text-primary-glow"></i>
                        </div>
                        <div class="mt-3 badge bg-primary-glow px-4 py-2">ANONİM YILDIZ</div>
                    </div>
                    <div class="col-md-8">
                        <h2 class="fw-900 text-white mb-2" id="detailTitle">#NODE-0000</h2>
                        <div id="detailSkills" class="mb-4"></div>
                        <div class="radar-stats mb-4">
                            <div class="radar-stat-item">
                                <span class="label">Yetenek Puanı</span>
                                <span class="value" id="detailScore">92</span>
                            </div>
                            <div class="radar-stat-item">
                                <span class="label">Tamamlanan Görevler</span>
                                <span class="value" id="detailTasks">12</span>
                            </div>
                        </div>
                        <p class="text-muted-premium" id="detailSummary">Bu kursiyer ASP.NET Core, Network ve İletişim yetenek ağaçlarını başarıyla tamamlamıştır.</p>
                        
                        <button class="btn btn-premium btn-warning-glow w-100 py-3 mt-4" onclick="sendInterviewInvite()">
                            <i class="bi bi-send-check-fill me-2"></i> MÜLAKATA DAVET ET (ALTIN BİLDİRİM)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .radar-page {
        min-height: 100vh;
        background: #050510;
        position: relative;
        overflow: hidden;
    }

    .radar-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at 50% 50%, rgba(88, 28, 28, 0.05) 0%, transparent 70%);
        background-image: 
            linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 50px 50px;
    }

    .radar-title {
        font-size: 3.5rem;
        font-weight: 900;
        letter-spacing: 5px;
        background: linear-gradient(90deg, #581C1C, #00E5FF);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .radar-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 30px;
        margin-top: 50px;
    }

    .talent-node-card {
        padding: 30px;
        border-radius: 24px;
        cursor: pointer;
        position: relative;
        display: flex;
        align-items: center;
        gap: 20px;
        transition: all 0.4s ease;
    }

    .talent-node-card:hover {
        transform: translateY(-10px) scale(1.02);
        border-color: #00E5FF;
        box-shadow: 0 0 30px rgba(0, 229, 255, 0.2);
    }

    .heatmap-dot {
        width: 60px;
        height: 60px;
        background: radial-gradient(circle, #00E5FF, transparent 70%);
        border-radius: 50%;
        box-shadow: 0 0 20px #00E5FF;
    }

    .talent-info { flex: 1; }
    .talent-id { font-family: monospace; font-weight: 700; color: #581C1C; font-size: 1.1rem; }
    .talent-tags { display: flex; gap: 8px; margin: 10px 0; }
    .skill-tag { background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 8px; font-size: 0.75rem; color: #94a3b8; }
    
    .talent-progress { height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; margin: 15px 0 5px; overflow: hidden; }
    .progress-bar { height: 100%; background: linear-gradient(90deg, #581C1C, #00E5FF); }
    .progress-text { font-size: 0.75rem; color: #64748b; }

    .radar-stats { display: flex; gap: 40px; }
    .radar-stat-item { display: flex; flex-direction: column; }
    .radar-stat-item .label { font-size: 0.8rem; color: #64748b; text-transform: uppercase; }
    .radar-stat-item .value { font-size: 1.8rem; font-weight: 800; color: #00E5FF; }

    @@keyframes pulse-slow {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }
    .animate-pulse-slow { animation: pulse-slow 4s infinite; }
</style>

<script>
    function showTalentDetail(id, rate) {
        document.getElementById('detailTitle').textContent = '#NODE-' + id.padStart(4, '0');
        document.getElementById('detailScore').textContent = (parseInt(rate) + 12);
        document.getElementById('detailTasks').textContent = Math.floor(parseInt(rate) / 10);
        
        var modal = new bootstrap.Modal(document.getElementById('talentDetailModal'));
        modal.show();
    }

    function sendInterviewInvite() {
        Swal.fire({
            icon: 'success',
            title: 'DAVET GÖNDERİLDİ!',
            text: 'Altın bildirim kursiyerin ekranına anında düştü. Geleceği inşa etmeye bir adım daha yaklaştınız.',
            background: '#0f0f23',
            color: '#fff',
            confirmButtonColor: '#f59e0b'
        });
        bootstrap.Modal.getInstance(document.getElementById('talentDetailModal')).hide();
    }
</script>


