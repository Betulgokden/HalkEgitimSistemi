@model IEnumerable<HalkEgitimSistemi.Models.Employer>

@{
    ViewData["Title"] = "İşveren Yönetimi";
}

<div class="container-fluid py-5 px-4">
    <div class="page-header animate-fadeInDown mb-5">
        <div class="page-header-content">
            <div class="d-flex align-items-center">
                <div class="page-header-icon" style="background: linear-gradient(135deg, #8b5cf6, #581C1C);">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <h1 class="page-header-title" data-i18n="employer_approval_system">İşveren Onay Sistemi</h1>
                    <p class="page-header-subtitle" data-i18n="employer_approval_subtitle">Kurumsal kayıtları ve vergi levhalarını doğrulayın.</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-16 animate-fadeInUp">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="glass-card-static p-4 animate-fadeInUp delay-200">
        <div class="table-responsive">
            <table class="table-premium w-100">
                <thead>
                    <tr>
                        <th data-i18n="company_info">Şirket Bilgileri</th>
                        <th data-i18n="authorized_person">Yetkili</th>
                        <th data-i18n="job_date">Kayıt Tarihi</th>
                        <th data-i18n="tax_plate">Belge</th>
                        <th data-i18n="job_status">Durum</th>
                        <th class="text-end" data-i18n="job_actions">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model.OrderByDescending(e => !e.IsApproved))
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-sm rounded-circle d-flex align-items-center justify-content-center bg-primary-glass" style="width: 40px; height: 40px;">
                                        <i class="bi bi-buildings-fill text-gold"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-white">@emp.CompanyName</h6>
                                        <small class="text-white-50">@emp.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-600 text-white">@emp.AuthorizedPerson</div>
                            </td>
                            <td class="text-white-50 small">@DateTime.Now.ToShortDateString()</td>
                            <td>
                                <a href="@emp.TaxPlatePath" target="_blank" class="btn btn-sm btn-outline-info rounded-pill">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> <span data-i18n="job_examine">Görüntüle</span>
                                </a>
                            </td>
                            <td>
                                @if (emp.IsApproved)
                                {
                                    <span class="badge bg-success-glass text-success p-2 px-3 rounded-pill border-success-subtle">
                                        <i class="bi bi-check-circle-fill me-1"></i> <span data-i18n="job_status_active">Onaylı</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-glass text-warning p-2 px-3 rounded-pill border-warning-subtle">
                                        <i class="bi bi-hourglass-split me-1"></i> <span data-i18n="job_status_pending">Bekliyor</span>
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!emp.IsApproved)
                                {
                                    <form asp-action="ApproveEmployer" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@emp.Id" />
                                        <button type="submit" class="btn btn-premium btn-success-glow btn-sm rounded-pill px-3" data-i18n="approve_btn">
                                            Onayla
                                        </button>
                                    </form>
                                }
                                <button class="btn btn-outline-danger btn-sm rounded-pill px-3 ms-2" onclick="alert('İşveren silme yetkisi kısıtlıdır.')">
                                    Sil
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-primary-glass { background: rgba(197, 160, 89, 0.1); border: 1px solid rgba(197, 160, 89, 0.2); }
    .bg-success-glass { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); }
    .bg-warning-glass { background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.2); }
    
    .table-premium tr {
        transition: all 0.3s ease;
    }
    .table-premium tr:hover {
        background: rgba(255,255,255,0.02) !important;
    }
</style>
