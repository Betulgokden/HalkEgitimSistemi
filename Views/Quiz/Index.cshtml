@model List<HalkEgitimSistemi.Models.Student>
@{
    ViewData["Title"] = "Bilgi Yarışması Hub";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var recentMatches = ViewBag.RecentMatches as List<HalkEgitimSistemi.Models.QuizMatch>;
}

<div class="quiz-hub-hero py-5 text-center position-relative overflow-hidden">
    <div class="container animate-fadeIn">
        <div class="badge bg-gold-glass-premium mb-3 rounded-pill px-4 py-2 fw-bold animate-pulse">
            <i class="bi bi-trophy-fill me-2"></i> SEZON 1: BİLGİ ŞAMPİYONASI
        </div>
        <h1 class="display-3 fw-bold quiz-hero-title mb-4">Kendini Kanıtla, <span class="text-gold">Eğitimi Kazan!</span></h1>
        <p class="lead quiz-hero-subtitle mb-5 mx-auto" style="max-width: 700px;">
            Halk Eğitim Bilgi Yarışması ile hem öğren hem de rekabet et. Puan topla, liderlik tablosuna gir ve ücretsiz kurs ödüllerini yakala.
        </p>
        
        <div class="d-flex justify-content-center gap-4">
            <button class="btn btn-gold-premium btn-lg px-5 py-3 rounded-pill shadow-lg fw-black" data-bs-toggle="modal" data-bs-target="#categoryModal">
                <i class="bi bi-play-circle-fill me-2"></i> YARIŞMAYA BAŞLA
            </button>
            <button class="btn btn-outline-gold btn-lg px-5 py-3 rounded-pill fw-bold" onclick="showLeaderboard()">
                <i class="bi bi-list-ol me-2"></i> LİDERLİK TABLOSU
            </button>
        </div>
    </div>
    
    <!-- Pattern Overlay -->
    <div class="quiz-pattern-overlay"></div>
</div>

<!-- Category Selection Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark-glass border-glass rounded-4 overflow-hidden">
            <div class="modal-header border-0 p-4">
                <h4 class="modal-title text-white fw-bold"><i class="bi bi-grid-fill me-2 gold-text"></i>Ders / Kategori Seçiniz</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    @foreach (var cat in ViewBag.Categories as List<string>)
                    {
                        <div class="col-md-6">
                            <div class="category-card p-4 rounded-4 text-center h-100 transition-base cursor-pointer" onclick="selectMode('@cat')">
                                <div class="category-icon mb-3">
                                    <i class="bi @(cat switch { "Bilişim Teknolojileri" => "bi-pc-display", "Yazılım Geliştirme" => "bi-code-slash", "Siber Güvenlik" => "bi-shield-lock", "Yapay Zeka" => "bi-cpu", _ => "bi-lightbulb" }) fs-1 gold-text"></i>
                                </div>
                                <h5 class="text-white fw-bold mb-0">@cat</h5>
                                <p class="small text-white-50 mt-2">100+ Zorlu Soru</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mode Selection Modal -->
<div class="modal fade" id="modeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark-glass border-glass rounded-4">
            <div class="modal-body p-5 text-center">
                <h3 class="text-white fw-bold mb-4" id="selectedCatTitle">Kategori</h3>
                <div class="d-grid gap-3">
                    <a id="soloLink" href="#" class="btn btn-gold-premium py-3 rounded-4 fw-bold">
                        <i class="bi bi-person-fill me-2"></i> TEKLİ YARIŞMA (SOLO)
                    </a>
                    <a id="versusLink" href="#" class="btn btn-outline-gold py-3 rounded-4 fw-bold">
                        <i class="bi bi-people-fill me-2"></i> KARŞILIKLI DÜELLO (VERSUS)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .category-card {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        cursor: pointer;
    }
    .category-card:hover {
        background: rgba(197, 160, 89, 0.1);
        border-color: #C5A059;
        transform: translateY(-5px);
    }
    .cursor-pointer { cursor: pointer; }
    .transition-base { transition: all 0.3s ease; }
</style>

<script>
    function selectMode(category) {
        bootstrap.Modal.getInstance(document.getElementById('categoryModal')).hide();
        document.getElementById('selectedCatTitle').innerText = category;
        document.getElementById('soloLink').href = '@Url.Action("StartMatch")?category=' + encodeURIComponent(category);
        document.getElementById('versusLink').href = '@Url.Action("Versus")?category=' + encodeURIComponent(category);
        new bootstrap.Modal(document.getElementById('modeModal')).show();
    }
</script>

<div class="container py-5">
    <div class="row g-5">
        <!-- Leaderboard -->
        <div class="col-lg-8 animate-fadeInLeft">
            <div class="glass-card-static p-4 border-0 shadow-lg">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0 quiz-section-title">En İyiler (Global ELO)</h3>
                    <i class="bi bi-stars text-warning fs-4"></i>
                </div>
                
                <div class="table-responsive">
                    <table class="table-dashboard-modern w-100 align-middle">
                        <thead>
                            <tr class="small uppercase">
                                <th style="width: 50px;">#</th>
                                <th>KULLANICI</th>
                                <th>ELO</th>
                                <th>PUAN</th>
                                <th>G/M</th>
                                <th>DURUM</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var s = Model[i];
                                <tr>
                                    <td class="fw-bold @(i < 3 ? "text-gold" : "opacity-50")">@(i + 1)</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-sm rounded-circle p-1" style="background: rgba(197, 160, 89, 0.1);">
                                                <img src="https://ui-avatars.com/api/?name=@s.FirstName+@s.LastName&background=random" class="rounded-circle w-100 shadow-sm" />
                                            </div>
                                            <span class="fw-bold">@s.FirstName @s.LastName</span>
                                        </div>
                                    </td>
                                    <td class="text-gold fw-bold">@s.EloRating</td>
                                    <td class="text-vibrant-glow fw-bold">@s.Points</td>
                                    <td class="small opacity-75">@s.Wins / @s.TotalMatches</td>
                                    <td>
                                        <span class="badge-status bg-success-soft text-success">Çevrimiçi</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- Live Activity -->
        <div class="col-lg-4 animate-fadeInRight">
            <div class="glass-card-static p-4 border-0 shadow-lg h-100 bg-maroon-dark-glass">
                <h4 class="fw-bold mb-4 quiz-section-title">Son Düellolar</h4>
                <div class="match-activity-list mb-4">
                    @foreach (var match in recentMatches.Take(5))
                    {
                        <div class="match-item p-3 rounded-4 mb-2 bg-dark-glass border-white-5">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="text-center">
                                    <div class="small fw-bold">@match.Student?.FirstName</div>
                                    <div class="text-success fw-bold">@match.Score</div>
                                </div>
                                <div class="px-3 opacity-25 italic small">VS</div>
                                <div class="text-center">
                                    <div class="small fw-bold">AI Bot</div>
                                    <div class="text-muted small">Bot</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <div class="reward-box-premium p-4 text-center">
                    <i class="bi bi-gift-fill fs-1 mb-2 d-block text-maroon"></i>
                    <h5 class="fw-black text-maroon mb-1">Büyük Ödül</h5>
                    <p class="x-small text-maroon-muted">400+ puan toplayan herkese bir sonraki kurs tamamen ücretsiz!</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .quiz-hub-hero { 
        background: linear-gradient(135deg, #420d0d 0%, #581C1C 50%, #2d0909 100%);
        min-height: 450px;
        display: flex;
        align-items: center;
        border-bottom: 2px solid #C5A059;
    }
    
    [data-theme="light"] .quiz-hub-hero {
        background: #fdfaf1;
        border-bottom: 2px solid #581C1C;
    }
    
    .quiz-pattern-overlay {
        position: absolute; top: 0; left: 0; right: 0; bottom: 0;
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23c5a059' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        opacity: 0.5;
        pointer-events: none;
    }

    .quiz-hero-title { color: #fdfaf1; text-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .quiz-hero-subtitle { color: rgba(253, 250, 241, 0.8); }
    .quiz-section-title { color: #fdfaf1; }
    
    [data-theme="light"] .quiz-hero-title { color: #581C1C !important; text-shadow: none; }
    [data-theme="light"] .quiz-hero-subtitle { color: rgba(88, 28, 28, 0.8) !important; }
    [data-theme="light"] .quiz-section-title { color: #581C1C !important; }

    /* Buttons */
    .btn-gold-premium {
        background: #C5A059;
        color: #581C1C !important;
        border: none;
        box-shadow: 0 10px 20px rgba(197, 160, 89, 0.3);
        transition: all 0.3s;
    }
    .btn-gold-premium:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(197, 160, 89, 0.5); background: #d4b57e; }
    
    .btn-outline-gold {
        background: transparent;
        color: #C5A059 !important;
        border: 2px solid #C5A059;
        transition: all 0.3s;
    }
    .btn-outline-gold:hover { background: rgba(197, 160, 89, 0.1); transform: translateY(-3px); }

    [data-theme="light"] .btn-gold-premium { background: #581C1C; color: #fdfaf1 !important; }
    [data-theme="light"] .btn-outline-gold { color: #581C1C !important; border-color: #581C1C; }

    /* Cards */
    .bg-maroon-dark-glass { background: rgba(88, 28, 28, 0.15) !important; border: 1px solid rgba(197, 160, 89, 0.2) !important; }
    .reward-box-premium { background: #C5A059; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
    .text-maroon { color: #581C1C; }
    .text-maroon-muted { color: rgba(88, 28, 28, 0.7); font-size: 0.7rem; font-weight: 700; }

    .bg-gold-glass-premium { background: rgba(197, 160, 89, 0.2); border: 1px solid #C5A059; color: #C5A059; }
    [data-theme="light"] .bg-gold-glass-premium { background: rgba(88, 28, 28, 0.1); border-color: #581C1C; color: #581C1C; }

    .text-gold { color: #C5A059; }
    .text-vibrant-glow { color: #fbbf24; text-shadow: 0 0 10px rgba(251, 191, 36, 0.3); }

    /* Table Fixes */
    .table-dashboard-modern th { color: var(--text-muted); border-bottom: 1px solid rgba(197, 160, 89, 0.2); padding: 15px 10px; }
    .table-dashboard-modern td { border-bottom: 1px solid rgba(255,255,255,0.05); padding: 15px 10px; }
</style>

<script>
    function showLeaderboard() {
        window.scrollTo({
            top: document.querySelector('.table-responsive').offsetTop - 100,
            behavior: 'smooth'
        });
    }
</script>
