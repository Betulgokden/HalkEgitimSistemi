@model HalkEgitimSistemi.Models.Certificate

@{
    ViewData["Title"] = "Sertifika Sorgulama";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div id="inquiryCard" class="p-5 animate-fadeInUp inquiry-premium-card">
                <div class="text-center mb-5">
                    <div class="display-icon mb-4">
                        <i class="bi bi-patch-check-fill cert-icon-gold"></i>
                    </div>
                    <h1 class="display-5 fw-black cert-title-gold mb-3" data-i18n="nav_cert">Sertifika Sorgulama Sistemi</h1>
                    <p class="cert-subtitle-light" data-i18n="inquiry_subtitle">T.C. Kimlik numaranız veya Sertifika kodunuz ile belgenizi doğrulayabilirsiniz.</p>
                </div>

                <div id="errorAlert" style="display: none;" class="alert-premium-danger mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><span id="errorMessage"></span>
                </div>

                <div class="e-devlet-badge animate-pulse-glow mb-5 mx-auto" style="width: fit-content;">
                    <div class="p-2 px-4 rounded-pill d-flex align-items-center gap-3 badge-edevlet-premium">
                        <i class="bi bi-shield-fill-check fs-4" style="color: #C5A059;"></i>
                        <span class="edevlet-text-premium">E-DEVLET ENTEGRE SİSTEM</span>
                    </div>
                </div>

                <form id="inquiryForm" class="mb-4">
                    <div class="search-box-premium-xl">
                        <i class="bi bi-search ms-4 search-icon-gold"></i>
                        <input type="text" id="searchTerm" name="searchTerm" 
                               class="form-control form-control-lg search-input-modern" 
                               placeholder="T.C. No veya Sertifika No giriniz..." 
                               required data-i18n-placeholder="inquiry_placeholder">
                        <button type="submit" class="btn btn-gold-action px-5">Sorgula</button>
                    </div>
                </form>
            </div>

            <!-- Terminal Illusion -->
            <div id="terminalBox" style="display: none;" class="terminal-modern">
                <div class="terminal-header">
                    <div class="terminal-dots">
                        <div class="dot red"></div>
                        <div class="dot yellow"></div>
                        <div class="dot green"></div>
                    </div>
                    <span class="terminal-label">SECURE CERTIFICATE VERIFIER V2.0</span>
                </div>
                <div id="terminalContent"></div>
                <div class="cursor"></div>
            </div>

            <!-- Certificate Result (Hidden initially) -->
            <div id="certificateResult" style="display: none;" class="animate-fadeIn">
                <div class="text-end mb-3 d-flex justify-content-end gap-2 no-print">
                     <button id="btnShare" class="btn btn-premium btn-primary-glass">
                         <i class="bi bi-share"></i> Geçici Bağlantı Oluştur
                     </button>
                     <button onclick="window.print()" class="btn btn-premium btn-secondary-glass">
                         <i class="bi bi-printer"></i> Yazdır / PDF
                     </button>
                </div>

                <div id="printable-certificate" 
                     class="sertifika-karti mx-auto" 
                     data-tilt data-tilt-glare data-tilt-max-glare="0.3" data-tilt-max="5">
                    
                    <!-- Decorative Corners -->
                    <div class="cert-corner top-left"></div>
                    <div class="cert-corner top-right"></div>
                    <div class="cert-corner bottom-left"></div>
                    <div class="cert-corner bottom-right"></div>

                    <div class="cert-content">
                        <div class="mb-4 d-flex justify-content-between align-items-center">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/cc/Ministry_of_National_Education_Turkey_logo.svg/1200px-Ministry_of_National_Education_Turkey_logo.svg.png" style="height: 80px;" />
                            <div style="text-align: right;">
                                <div class="cert-header-text">T.C. MİLLİ EĞİTİM BAKANLIĞI</div>
                                <div class="cert-subheader-text">Halk Eğitimi Merkezi Müdürlüğü</div>
                            </div>
                        </div>
                        
                        <h1 class="cert-main-title">SERTİFİKA</h1>

                        <p class="cert-label-text">Sayın</p>
                        <div id="certFullName" class="cert-user-name"></div>

                        <p class="cert-info-text">T.C. Kimlik No: <strong id="certTcNo"></strong></p>

                        <p class="cert-body-text">
                            Kurumumuz bünyesinde gerçekleştirilen <strong id="certDuration"></strong> teorik ve uygulamalı eğitimleri kapsayan <br/>
                            <strong id="certCourseName" class="cert-course-highlight"></strong>
                            programını başarıyla tamamlayarak bu sertifikayı almaya hak kazanmıştır.
                        </p>

                        <div class="row align-items-end mt-5 pt-4">
                            <div class="col-4 text-center">
                                <div class="cert-sign-label">Belge No</div>
                                <div id="certNoDisplay" class="cert-sign-value"></div>
                                <div class="cert-sign-line"></div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="cert-qr-wrapper">
                                    <img id="certQrCode" src="" width="100%" />
                                </div>
                                <div class="cert-qr-label">Belge Doğrulama Kodu</div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="cert-sign-label">Müdür İmza</div>
                                <div class="cert-signature-font">Betül Gökden</div>
                                <div class="cert-sign-line"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row justify-content-center g-4 my-5 no-print">
                    <div class="col-md-5">
                        <a id="linkedinBtn" href="" target="_blank" class="btn btn-linkedin btn-lg w-100 py-3 shadow-lg">
                            <i class="bi bi-linkedin me-2"></i> LinkedIn Profiline Ekle
                        </a>
                    </div>
                </div>

                <div id="journeyTimeline" class="max-w-700 mx-auto text-start no-print mb-5">
                    <h4 class="mb-4 journey-title">
                        <i class="bi bi-compass me-2 text-primary"></i> Eğitim Serüveni
                    </h4>
                    <div id="timelineList" class="timeline-container-premium position-relative ms-3">
                        <!-- Timeline items will be injected here -->
                    </div>
                </div>

                <div class="text-center mt-5 no-print">
                    <button onclick="window.location.reload()" class="btn btn-premium btn-secondary-glass">
                        <i class="bi bi-arrow-left"></i> Yeni Sorgulama
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Share Modal -->
<div class="modal fade" id="shareModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-glass border-glass">
            <div class="modal-header border-0">
                <h5 class="modal-title">Geçici Paylaşım Linki</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Bu link 24 saat boyunca geçerli kalacak ve sonra otomatik olarak imha edilecektir.</p>
                <div class="input-group">
                    <input type="text" id="shareUrlInput" class="form-control bg-dark border-secondary text-white" readonly>
                    <button class="btn btn-primary" onclick="copyShareUrl()">Kopyala</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .inquiry-premium-card {
        background: rgba(88, 28, 28, 0.1);
        border: 2px solid #C5A059;
        border-radius: 50px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.4);
    }
    .cert-icon-gold { color: #C5A059; }
    .cert-title-gold { 
        color: #C5A059; 
        font-family: 'Outfit', sans-serif; 
        text-shadow: 0 4px 15px rgba(197, 160, 89, 0.3);
    }
    .cert-subtitle-light { 
        color: rgba(255, 255, 255, 0.7); 
        font-size: 1.1rem;
    }
    [data-theme="light"] .cert-subtitle-light { color: rgba(88, 28, 28, 0.7); }
    [data-theme="light"] .inquiry-premium-card { background: #ffffff; border-color: #581C1C; }
    [data-theme="light"] .cert-title-gold { color: #581C1C; text-shadow: none; }
    [data-theme="light"] .cert-icon-gold { color: #581C1C; }

    .display-icon { 
        width: 100px; height: 100px; 
        background: rgba(197, 160, 89, 0.1); 
        border: 2px solid #C5A059; 
        border-radius: 30px; 
        display: flex; align-items: center; justify-content: center; 
        font-size: 3rem; margin: 0 auto; 
    }

    .badge-edevlet-premium { 
        background: #581C1C; 
        border: 2px solid #C5A059;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }
    .edevlet-text-premium { 
        color: #C5A059 !important; 
        font-weight: 900; 
        font-size: 0.85rem; 
        letter-spacing: 1.5px; 
    }

    /* Light Theme Enhancements for E-Devlet Badge */
    [data-theme="light"] .badge-edevlet-premium {
        background: #ffffff;
        border-color: #C5A059;
        box-shadow: 0 8px 25px rgba(197, 160, 89, 0.2);
    }
    [data-theme="light"] .edevlet-text-premium {
        color: #581C1C !important;
    }
    [data-theme="light"] .badge-edevlet-premium i {
        color: #581C1C !important;
    }

    .search-box-premium-xl { 
        display: flex; align-items: center; 
        background: rgba(255, 255, 255, 0.05); 
        border: 2px solid rgba(197, 160, 89, 0.4); 
        border-radius: 25px; padding: 10px; 
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
    }
    .search-box-premium-xl:focus-within { 
        border-color: #C5A059; 
        box-shadow: 0 0 40px rgba(197, 160, 89, 0.3); 
        background: rgba(255, 255, 255, 0.1); 
    }
    .search-input-modern { 
        background: transparent !important; 
        border: none !important; 
        color: white !important; 
        font-size: 1.3rem !important; 
        padding-left: 20px !important; 
    }
    [data-theme="light"] .search-input-modern { color: #581C1C !important; }
    .search-input-modern::placeholder { color: rgba(255,255,255,0.3); }
    [data-theme="light"] .search-input-modern::placeholder { color: rgba(88,28,28,0.3); }

    .btn-gold-action { 
        background: #C5A059; 
        color: #581C1C; 
        border: none; 
        border-radius: 18px; 
        font-weight: 900; 
        height: 60px; 
        transition: 0.3s; 
    }
    .btn-gold-action:hover { 
        background: #d4b57e; 
        transform: translateY(-2px); 
        box-shadow: 0 10px 20px rgba(197, 160, 89, 0.4); 
    }

    /* Terminal */
    .terminal-modern { 
        background: #0a0a0a; border: 1px solid #C5A059; border-radius: 20px; 
        padding: 30px; font-family: 'JetBrains Mono', monospace; color: #C5A059; 
        min-height: 250px; box-shadow: 0 40px 80px rgba(0,0,0,0.8); margin: 3rem 0; 
    }
    .terminal-header { display: flex; align-items: center; gap: 15px; margin-bottom: 25px; border-bottom: 1px solid rgba(197,160,89,0.2); padding-bottom: 15px; }
    .terminal-dots { display: flex; gap: 8px; }
    .dot { width: 12px; height: 12px; border-radius: 50%; }
    .red { background: #ff5f56; } .yellow { background: #ffbd2e; } .green { background: #27c93f; }
    .terminal-label { font-size: 0.75rem; letter-spacing: 1px; opacity: 0.6; }

    /* Certificate Card Styling */
    .sertifika-karti { 
        background: #fff; border-radius: 15px; border: 30px solid #1e293b; 
        padding: 5rem; position: relative; box-shadow: 0 60px 120px rgba(0,0,0,0.4); 
        color: #1a202c; text-align: center; font-family: 'Outfit', sans-serif; 
        max-width: 950px; 
    }
    .cert-corner { position: absolute; width: 80px; height: 80px; border-color: #C5A059; border-style: solid; }
    .top-left { top: 15px; left: 15px; border-width: 6px 0 0 6px; }
    .top-right { top: 15px; right: 15px; border-width: 6px 6px 0 0; }
    .bottom-left { bottom: 15px; left: 15px; border-width: 0 0 6px 6px; }
    .bottom-right { bottom: 15px; right: 15px; border-width: 0 6px 6px 0; }

    .cert-user-name { font-size: 3.2rem; font-weight: 900; color: #0f172a; border-bottom: 4px double #C5A059; display: inline-block; padding: 0 4rem 0.5rem; margin-bottom: 1.5rem; }
    .cert-course-highlight { color: #581C1C; font-size: 2.2rem; display: block; margin: 1.5rem 0; font-weight: 900; }
    .cert-signature-font { font-family: 'Brush Script MT', cursive; font-size: 3.2rem; color: #1e293b; line-height: 1; }
    .cert-sign-line { border-top: 2px solid #C5A059; margin-top: 0.5rem; width: 80%; margin-left: 10%; }

    .journey-title { color: white; font-weight: 900; font-size: 1.5rem; }
    [data-theme="light"] .journey-title { color: #581C1C; }

    .timeline-container-premium { border-left: 3px solid rgba(197, 160, 89, 0.3); padding-left: 30px; }
    .timeline-item { position: relative; margin-bottom: 2rem; }
    .timeline-item::before { 
        content: ''; position: absolute; left: -39px; top: 5px; 
        width: 16px; height: 16px; background: #0a0a12; 
        border: 3px solid #C5A059; border-radius: 50%; z-index: 2; 
    }
    
    @@media print { 
        .no-print { display: none !important; } 
        body { background: white !important; }
        .sertifika-karti { border: 10px solid #1e293b !important; box-shadow: none !important; }
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
    <script>
        let currentCertCode = "";

        $(document).ready(function() {
            $('#inquiryForm').on('submit', function(e) {
                e.preventDefault();
                const term = $('#searchTerm').val();
                const btn = $(this).find('button');
                const originalText = btn.text();
                
                btn.html('<span class="spinner-border spinner-border-sm"></span>').prop('disabled', true);

                $.ajax({
                    url: '/Certificates/Inquiry',
                    type: 'POST',
                    data: { searchTerm: term },
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function(response) {
                        if (response.success) {
                            currentCertCode = response.data.certCode;
                            populateCertificate(response);
                            $('#inquiryCard').fadeOut(300, function() {
                                $('#certificateResult').fadeIn(400);
                            });
                        } else {
                            $('#errorMessage').text(response.message);
                            $('#errorAlert').fadeIn();
                            btn.text(originalText).prop('disabled', false);
                        }
                    },
                    error: function() {
                        $('#errorMessage').text("Bağlantı hatası oluştu.");
                        $('#errorAlert').fadeIn();
                        btn.text(originalText).prop('disabled', false);
                    }
                });
            });

            function populateCertificate(res) {
                const d = res.data;
                $('#certFullName').text(d.fullName.toUpperCase());
                $('#certTcNo').text(d.tcNo);
                $('#certCourseName').text(d.courseName.toUpperCase());
                $('#certNoDisplay').text(d.certCode);
                $('#certQrCode').attr('src', 'https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + encodeURIComponent(d.qrUrl));
                $('#linkedinBtn').attr('href', d.linkedinUrl);
                
                if (res.type === "application") {
                    $('#certDuration').text(d.duration + " saatlik");
                    $('#journeyTimeline').show();
                    const timeline = $('#timelineList');
                    timeline.empty();
                    timeline.append(`
                        <div class="timeline-item"><div class="small opacity-50 text-gold">${d.applyDate}</div><div class="fw-bold">Eğitime Başladı</div></div>
                        <div class="timeline-item"><div class="small opacity-50 text-gold">Devam Durumu</div><div class="fw-bold">Katılım: %${Math.round(d.presentCount * 100 / d.attendanceCount)}</div></div>
                    `);
                    if (d.examGrade) {
                        timeline.append(`<div class="timeline-item"><div class="small opacity-50 text-gold">Başarı Puanı</div><div class="fw-bold">Sınav: ${d.examGrade} / 100</div></div>`);
                    }
                    timeline.append(`<div class="timeline-item"><div class="small text-success">Tamamlandı</div><div class="fw-bold text-success">Sertifika Hak Edildi</div></div>`);
                } else {
                    $('#certDuration').text("");
                    $('#journeyTimeline').hide();
                }
            }

            $('#btnShare').on('click', function() {
                $.post('/Certificates/GenerateTemporaryLink', { certificateCode: currentCertCode }, function(res) {
                    if(res.success) {
                        $('#shareUrlInput').val(res.link);
                        new bootstrap.Modal(document.getElementById('shareModal')).show();
                    }
                });
            });
        });

        function copyShareUrl() {
            const input = document.getElementById('shareUrlInput');
            input.select();
            document.execCommand('copy');
            alert('Link kopyalandı!');
        }
    </script>
}
