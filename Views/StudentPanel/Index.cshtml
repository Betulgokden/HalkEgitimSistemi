@model HalkEgitimSistemi.Models.Student

@{
    ViewData["Title"] = "Öğrenci Paneli";
}

<div class="container py-5">
    <!-- Welcome Header -->
    <div class="welcome-banner glass-card-main p-5 mb-5 animate-fadeInDown" style="border-radius: 35px; background: linear-gradient(135deg, rgba(88, 28, 28, 0.4) 0%, rgba(15, 23, 42, 0.4) 100%);">
        <div class="row align-items-center">
            <div class="col-md-auto text-center mb-4 mb-md-0">
                <div class="modern-avatar-xl">
                    @if (string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <div class="avatar-placeholder">@Model.FirstName[0]@Model.LastName[0]</div>
                    }
                    else
                    {
                        <img src="@Model.ProfilePicture" alt="Profile" class="img-fluid rounded-circle shadow-lg border border-3 border-gold" style="width: 120px; height: 120px; object-fit: cover;">
                    }
                </div>
            </div>
            <div class="col-md">
                <h1 class="display-4 fw-black mb-1">Hoş Geldin, <span class="gold-text">@Model.FirstName!</span></h1>
                <p class="lead text-white-70 mb-0">Eğitim yolculuğundaki gelişimini buradan takip edebilirsin.</p>
            </div>
            <div class="col-md-auto text-end mt-4 mt-md-0">
                <div class="d-flex gap-3">
                    <div class="stat-card-mini border-gold-glow">
                        <div class="stat-mini-value text-gold">@Model.Points</div>
                        <div class="stat-mini-label">PUAN</div>
                    </div>
                    <div class="stat-card-mini bg-vibrant-purple">
                        <div class="stat-mini-value text-white">@Model.SuccessScore</div>
                        <div class="stat-mini-label text-white-50">SKOR</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Course List -->
    <h3 class="fw-bold mb-4"><i class="bi bi-journal-bookmark-fill text-primary-light me-2"></i> Kurslarım</h3>
    
    <div class="row g-4">
        @if (!Model.Applications.Any())
        {
            <div class="col-12">
                <div class="glass-card-static p-5 text-center">
                    <p class="mb-0">Henüz bir kurs başvurunuz bulunmuyor. <a asp-controller="Courses" asp-action="Browse" class="text-primary-light fw-bold">Kurslara göz atın!</a></p>
                </div>
            </div>
        }
        else
        {
            @foreach (var app in Model.Applications)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="course-panel-card glass-card-static animate-fadeInUp">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge @(app.Status == ApplicationStatus.Approved ? "bg-success-glass" : app.Status == ApplicationStatus.Pending ? "bg-warning-glass" : "bg-danger-glass")">
                                @(app.Status == ApplicationStatus.Approved ? "Onaylandı" : app.Status == ApplicationStatus.Pending ? "Onay Bekliyor" : "Reddedildi")
                            </span>
                            @if (app.IsCompleted)
                            {
                                <span class="badge bg-primary-glass"><i class="bi bi-patch-check-fill me-1"></i> Sertifika Hazır</span>
                            }
                        </div>
                        
                        <h5 class="fw-bold mb-3">@(app.Course?.CourseName ?? "Bilinmeyen Kurs")</h5>
                        
                        <div class="progress mb-4" style="height: 8px; background: rgba(255,255,255,0.05);">
                            @{
                                var attendanceCount = app.Attendances?.Count(a => a.IsPresent) ?? 0;
                                var totalAttendance = app.Attendances?.Count ?? 1; // avoid div by zero
                                var progress = (attendanceCount * 100) / totalAttendance;
                            }
                            <div class="progress-bar bg-primary-glow" role="progressbar" style="width: @progress%" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <div class="d-flex justify-content-between text-muted small mb-4">
                            <span><i class="bi bi-person-check-fill me-1"></i> Devamsızlık: @(app.Attendances?.Count(a => !a.IsPresent) ?? 0) Gün</span>
                            <span>@(progress)% Katılım</span>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-action="CourseDetails" asp-route-id="@app.Id" class="btn btn-premium btn-secondary-glass">
                                Detayları Gör <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .stat-card-mini {
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--border-glass);
        padding: 15px 25px;
        border-radius: 20px;
        text-align: center;
        min-width: 110px;
        transition: all 0.3s ease;
    }
    .stat-card-mini:hover { transform: translateY(-5px); border-color: #C5A059; }
    .stat-mini-value { display: block; font-size: 1.8rem; font-weight: 900; line-height: 1; margin-bottom: 5px; }
    .stat-mini-label { font-size: 0.7rem; font-weight: 800; letter-spacing: 1px; color: rgba(255,255,255,0.4); text-transform: uppercase; }

    .modern-avatar-xl {
        width: 120px; height: 120px; margin: 0 auto;
    }
    .avatar-placeholder {
        width: 100%; height: 100%; background: linear-gradient(135deg, #C5A059, #581C1C);
        border-radius: 50%; display: flex; align-items: center; justify-content: center;
        font-size: 3rem; font-weight: 900; color: white; border: 3px solid #C5A059;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .course-panel-card {
        padding: 1.5rem;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border-radius: 24px;
        background: rgba(255,255,255,0.02) !important;
        border: 1px solid rgba(255,255,255,0.05) !important;
    }

    .course-panel-card:hover {
        transform: translateY(-10px);
        border-color: #C5A059 !important;
        background: rgba(255,255,255,0.05) !important;
        box-shadow: 0 20px 40px rgba(0,0,0,0.3) !important;
    }

    .bg-success-glass { background: rgba(16, 185, 129, 0.1); color: #C5A059; border: 1px solid rgba(16, 185, 129, 0.2); }
    .bg-warning-glass { background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); }
    .bg-danger-glass { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }
    .bg-primary-glass { background: rgba(197, 160, 89, 0.1); color: #C5A059; border: 1px solid rgba(197, 160, 89, 0.2); }

    .bg-primary-glow {
        background: #C5A059;
        box-shadow: 0 0 15px rgba(197, 160, 89, 0.4);
    }
    
    .text-gold { color: #C5A059 !important; }
    .border-gold-glow { border: 1px solid rgba(197, 160, 89, 0.4) !important; box-shadow: 0 0 15px rgba(197, 160, 89, 0.1); }
    
    .animate-pulse-slow {
        animation: pulse-slow 3s infinite;
    }
    @@keyframes pulse-slow {
        0% { opacity: 1; }
        50% { opacity: 0.7; }
        100% { opacity: 1; }
    }

    .fw-black { font-weight: 900 !important; }
    .gold-text {
        background: linear-gradient(90deg, #C5A059, #F5E0A0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .text-white-70 { color: rgba(255,255,255,0.7) !important; }
</style>

