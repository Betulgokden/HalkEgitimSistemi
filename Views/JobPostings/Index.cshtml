@model IEnumerable<HalkEgitimSistemi.Models.JobPosting>
@{
    ViewData["Title"] = "İş İlanları | Kariyer Kapısı";
}

<div class="page-header-premium animate-fadeInDown">
    <div class="container py-5">
        <div class="job-hero-box p-5 text-center">
            <span class="badge-premium mb-3"><i class="bi bi-briefcase"></i> KARİYER FIRSATLARI</span>
            <h1 class="display-3 fw-black mb-2 job-main-title">İş <span class="gold-text-glow">İlanları</span></h1>
            <p class="job-hero-subtitle mx-auto">Sertifikalı kursiyerlerimiz için en güncel ve güvenilir yerel iş fırsatları.</p>
            
            @if (User.IsInRole("Admin") || User.IsInRole("Employer"))
            {
                <div class="mt-4 d-flex justify-content-center gap-3">
                    <a asp-action="Create" class="btn btn-gold-pulse px-4 py-2">
                        <i class="bi bi-plus-circle me-2"></i> İLAN YAYINLA
                    </a>
                    <a asp-action="Manage" class="btn btn-outline-gold px-4 py-2">
                        <i class="bi bi-gear-fill me-2"></i> YÖNET
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-state-boxy p-5">
                    <i class="bi bi-search display-1 mb-4 opacity-20"></i>
                    <h3>Şu an aktif ilan bulunmuyor.</h3>
                    <p>Yeni ilanlar için lütfen daha sonra tekrar kontrol edin.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var job in Model)
            {
                <div class="col-md-6 col-xl-4 animate-fadeInUp">
                    <div class="job-card-boxy h-100 p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="company-tag">
                                <i class="bi bi-building me-1"></i> @job.CompanyName.ToUpper()
                            </div>
                            <div class="date-tag">
                                <i class="bi bi-calendar3 me-1"></i> @job.CreatedAt.ToString("dd MMM")
                            </div>
                        </div>
                        
                        <h4 class="job-title-theme fw-black mb-3">@job.Title</h4>
                        
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            <span class="info-pill info-pill-gold"><i class="bi bi-geo-alt-fill"></i> @job.Location</span>
                            <span class="info-pill info-pill-maroon"><i class="bi bi-clock-fill"></i> @job.JobType</span>
                        </div>
                        
                        <p class="job-desc-theme mb-4">@job.Description</p>
                        
                        <div class="mt-auto pt-4 border-top border-glass d-flex justify-content-between align-items-center">
                            <div class="salary-box">
                                <div class="salary-label">MAAŞ ARALIĞI</div>
                                <div class="salary-value">@job.SalaryRange</div>
                            </div>
                            <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-gold-outline-sm rounded-pill">
                                İncele
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    /* Hero Section */
    .job-hero-box {
        background: #0f172a !important;
        border: 2px solid #C5A059;
        border-radius: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.4);
    }
    .job-main-title { color: white; font-family: 'Outfit'; }
    .job-hero-subtitle { color: rgba(255,255,255,0.6); max-width: 600px; font-size: 1.1rem; }

    /* Job Card Boxy Design */
    .job-card-boxy {
        background: rgba(15, 23, 42, 0.6) !important;
        border: 1px solid rgba(197, 160, 89, 0.2) !important;
        border-radius: 30px;
        display: flex;
        flex-direction: column;
        transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    .job-card-boxy:hover {
        transform: translateY(-10px);
        border-color: #C5A059 !important;
        box-shadow: 0 20px 50px rgba(197, 160, 89, 0.15);
    }

    .company-tag { background: #581C1C; color: #C5A059; padding: 6px 15px; border-radius: 12px; font-weight: 800; font-size: 0.75rem; border: 1px solid rgba(197, 160, 89, 0.3); }
    .date-tag { color: rgba(255,255,255,0.4); font-size: 0.75rem; font-weight: 700; }
    .job-title-theme { color: white; font-size: 1.4rem; }
    .job-desc-theme { color: rgba(255,255,255,0.5); font-size: 0.95rem; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

    .info-pill { padding: 6px 12px; border-radius: 10px; font-size: 0.75rem; font-weight: 800; display: inline-flex; align-items: center; gap: 5px; }
    .info-pill-gold { background: rgba(197, 160, 89, 0.1); color: #C5A059; border: 1px solid rgba(197, 160, 89, 0.2); }
    .info-pill-maroon { background: rgba(88, 28, 28, 0.2); color: #8b2d2d; border: 1px solid rgba(88, 28, 28, 0.3); }

    .salary-label { font-size: 0.65rem; color: rgba(255,255,255,0.3); font-weight: 800; letter-spacing: 1px; }
    .salary-value { font-size: 1.1rem; color: #C5A059; font-weight: 900; }

    .btn-gold-outline-sm { border: 1.5px solid #C5A059; color: #C5A059; padding: 8px 25px; font-weight: 800; font-size: 0.85rem; text-decoration: none; transition: 0.3s; }
    .btn-gold-outline-sm:hover { background: #C5A059; color: #581C1C; }

    /* Gündüz Modu - Bej Kutucuklar */
    [data-theme="light"] .job-hero-box { background: white !important; border-color: #581C1C; box-shadow: 0 20px 40px rgba(88, 28, 28, 0.1); }
    [data-theme="light"] .job-main-title { color: #581C1C; }
    [data-theme="light"] .job-hero-subtitle { color: rgba(88, 28, 28, 0.6); }
    
    [data-theme="light"] .job-card-boxy {
        background: #fdfaf1 !important; /* BEJ KUTUCUK */
        border: 1px solid rgba(88, 28, 28, 0.1) !important;
        box-shadow: 0 15px 30px rgba(88, 28, 28, 0.05);
    }
    [data-theme="light"] .job-card-boxy:hover { border-color: #581C1C !important; }
    [data-theme="light"] .job-title-theme { color: #581C1C; }
    [data-theme="light"] .job-desc-theme { color: rgba(88, 28, 28, 0.6); }
    [data-theme="light"] .date-tag { color: rgba(88, 28, 28, 0.4); }
    [data-theme="light"] .salary-label { color: rgba(88, 28, 28, 0.4); }
    [data-theme="light"] .info-pill-gold { background: rgba(197, 160, 89, 0.05); }

    .fw-black { font-weight: 900 !important; }
</style>
