@model IEnumerable<HalkEgitimSistemi.Models.JobPosting>
@{
    ViewData["Title"] = "İş İlanları";
}

<div class="page-header animate-fadeIn">
    <div class="container-fluid px-4">
        <div class="page-header-content py-5" style="background: linear-gradient(135deg, rgba(88, 28, 28, 0.1), rgba(197, 160, 89, 0.1)); border-radius: 30px; border: 1px solid var(--theme-card-border);">
            <div class="text-center w-100">
                <h1 class="display-4 fw-900 gold-text mb-2" style="font-family: 'Outfit'; letter-spacing: -1px;">
                    <i class="bi bi-briefcase-fill me-3"></i>Kariyer Merkezi
                </h1>
                <p class="lead text-white-50 fw-600 mb-0">Borçka ve çevresindeki en güncel iş fırsatlarını keşfedin.</p>
                
                @if (User.IsInRole("Admin") || User.IsInRole("Employer"))
                {
                    <div class="mt-4">
                        <a asp-action="Create" class="btn btn-premium px-4 py-2">
                            <i class="bi bi-plus-circle me-2"></i>İLAN YAYINLA
                        </a>
                        <a asp-action="Manage" class="btn btn-outline-gold px-4 py-2 ms-2">
                            <i class="bi bi-gear-fill me-2"></i>İLANLARIMI YÖNET
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-5">
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="glass-card p-5 animate-bounce-slow" style="border-radius: 30px;">
                    <i class="bi bi-search display-1 gold-text opacity-25 mb-4"></i>
                    <h3 class="text-white-50 fw-700">Şu an aktif ilan bulunmuyor.</h3>
                    <p class="text-white-25">Yeni ilanlar için takipte kalın.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var job in Model)
            {
                <div class="col-md-6 col-xl-4 animate-scaleIn">
                    <div class="glass-card-static job-card h-100 p-4 shadow-xl transition-all hover-translate-y" 
                         style="border-radius: 25px; border: 1.5px solid var(--theme-card-border); background: rgba(255,255,255,0.03);">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="company-badge bg-maroon-theme px-3 py-1 rounded-pill border border-gold-20">
                                <span class="gold-text x-small fw-900">@job.CompanyName.ToUpper()</span>
                            </div>
                            <span class="text-white-50 x-small"><i class="bi bi-clock me-1"></i>@job.CreatedAt.ToString("dd MMM")</span>
                        </div>
                        
                        <h4 class="text-white fw-900 mb-2" style="font-family: 'Outfit';">@job.Title</h4>
                        <div class="d-flex gap-2 mb-4">
                            <span class="badge bg-gold-glass text-gold x-small"><i class="bi bi-geo-alt me-1"></i>@job.Location</span>
                            <span class="badge bg-maroon-glass gold-text x-small"><i class="bi bi-briefcase me-1"></i>@job.JobType</span>
                        </div>
                        
                        <p class="text-white-50 small mb-4 line-clamp-3">@job.Description</p>
                        
                        <div class="mt-auto pt-3 border-top border-white-10 d-flex justify-content-between align-items-center">
                            <span class="gold-text fw-800">@job.SalaryRange</span>
                            <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-outline-gold rounded-pill px-4">İncele</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .job-card:hover { border-color: var(--gold) !important; box-shadow: 0 15px 40px rgba(197, 160, 89, 0.15) !important; }
    .bg-gold-glass { background: rgba(197, 160, 89, 0.1); border: 1px solid rgba(197, 160, 89, 0.2); }
    .bg-maroon-glass { background: rgba(88, 28, 28, 0.1); border: 1px solid rgba(88, 28, 28, 0.2); }
    .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .x-small { font-size: 0.7rem; }
</style>
