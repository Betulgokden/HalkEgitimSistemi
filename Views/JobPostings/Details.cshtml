@model HalkEgitimSistemi.Models.JobPosting
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="glass-card-static p-5 mb-4" style="border-radius: 35px; border: 2px solid var(--theme-card-border); background: rgba(15, 23, 42, 0.4);">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="company-logo bg-maroon-theme d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 15px; border: 1px solid var(--gold);">
                            <i class="bi bi-building gold-text fs-3"></i>
                        </div>
                        <div>
                            <h2 class="text-white fw-900 mb-0" style="font-family: 'Outfit';">@Model.Title</h2>
                            <p class="gold-text fw-700 mb-0">@Model.CompanyName</p>
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-gold-glass text-gold px-3 py-2 rounded-pill"><i class="bi bi-clock me-1"></i>@Model.CreatedAt.ToString("dd MMMM yyyy")</span>
                    </div>
                </div>

                <div class="row g-3 mb-5">
                    <div class="col-md-4">
                        <div class="p-3 bg-white-5 rounded-4 border border-white-10">
                            <div class="text-white-25 x-small fw-800 mb-1">KONUM</div>
                            <div class="text-white small fw-700"><i class="bi bi-geo-alt me-2 gold-text"></i>@Model.Location</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white-5 rounded-4 border border-white-10">
                            <div class="text-white-25 x-small fw-800 mb-1">ÇALIŞMA TÜRÜ</div>
                            <div class="text-white small fw-700"><i class="bi bi-briefcase me-2 gold-text"></i>@Model.JobType</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white-5 rounded-4 border border-white-10">
                            <div class="text-white-25 x-small fw-800 mb-1">MAAŞ ARALIĞI</div>
                            <div class="text-white small fw-700"><i class="bi bi-cash-stack me-2 gold-text"></i>@(string.IsNullOrEmpty(Model.SalaryRange) ? "Belirtilmemiş" : Model.SalaryRange)</div>
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <h5 class="gold-text fw-900 mb-3 border-bottom border-white-10 pb-2">İş Tanımı</h5>
                    <div class="text-white-50" style="line-height: 1.8; white-space: pre-line;">@Model.Description</div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Requirements))
                {
                    <div class="mb-5">
                        <h5 class="gold-text fw-900 mb-3 border-bottom border-white-10 pb-2">Aranan Nitelikler</h5>
                        <div class="text-white-50" style="line-height: 1.8; white-space: pre-line;">@Model.Requirements</div>
                    </div>
                }

                @if (Model.Deadline.HasValue)
                {
                    <div class="alert alert-warning bg-maroon-glass border-gold-20 text-white small rounded-4">
                        <i class="bi bi-exclamation-triangle me-2 gold-text"></i>
                        Son Başvuru Tarihi: <strong>@Model.Deadline.Value.ToString("dd.MM.yyyy")</strong>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-card-static p-4 sticky-top" style="top: 100px; border-radius: 30px; border: 1.5px solid var(--theme-card-border); background: rgba(88, 28, 28, 0.05);">
                <h5 class="text-white fw-900 mb-4 border-bottom border-white-10 pb-3">Hızlı Başvuru</h5>
                
                <p class="text-white-50 small mb-4">Bu ilana başvurmak için aşağıdaki e-posta adresi üzerinden CV'nizi iletebilirsiniz.</p>
                
                <div class="p-3 bg-white-5 rounded-4 border border-white-10 mb-4">
                    <div class="text-white-25 x-small fw-800 mb-1">İLETİŞİM E-POSTA</div>
                    <div class="gold-text fw-900">@Model.ContactEmail</div>
                </div>

                <a href="mailto:@Model.ContactEmail?subject=@Model.Title İlanı Başvurusu" class="btn btn-premium w-100 py-3 mb-3 fw-900">
                    <i class="bi bi-envelope-paper-fill me-2"></i>E-POSTA İLE BAŞVUR
                </a>
                
                <button class="btn btn-outline-white w-100 py-3 rounded-4 small" onclick="window.print()">
                    <i class="bi bi-printer me-2"></i>İLANIN ÇIKTISINI AL
                </button>

                <div class="mt-4 pt-4 border-top border-white-10">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar-xs rounded-circle bg-gold-glow d-flex align-items-center justify-content-center" style="width:32px; height:32px; background: rgba(197, 160, 89, 0.2);">
                            <i class="bi bi-star-fill text-gold small"></i>
                        </div>
                        <div class="text-white-50 x-small">
                            <strong>Halk Point İpucu:</strong> Yüksek puan ve kurs başarılarınız, işverenler tarafından dijital CV'nizde bir <strong>güven ve yetkinlik kriteri</strong> olarak değerlendirilir.
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar-xs rounded-circle bg-gold-glow d-flex align-items-center justify-content-center" style="width:32px; height:32px; background: rgba(197, 160, 89, 0.2);">
                            <i class="bi bi-info-circle text-gold small"></i>
                        </div>
                        <div class="text-white-50 x-small">Lütfen başvurunuzda <strong>Halk Eğitim Portalı</strong> üzerinden ulaştığınızı belirtin.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gold-glass { background: rgba(197, 160, 89, 0.1); border: 1px solid rgba(197, 160, 89, 0.2); }
    .bg-maroon-glass { background: rgba(88, 28, 28, 0.15); border: 1px solid rgba(197, 160, 89, 0.2); }
    .x-small { font-size: 0.7rem; }
    .gold-text { color: #C5A059 !important; }
    .border-gold-20 { border-color: rgba(197, 160, 89, 0.2) !important; }
</style>
