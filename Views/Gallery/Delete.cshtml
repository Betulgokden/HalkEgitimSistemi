@model HalkEgitimSistemi.Models.GalleryItem

@{
    ViewData["Title"] = "Görseli Sil";
}

<!-- KURS ALETLERI YAGMURU -->
<div class="rain-container" id="rainContainer"></div>

<div class="container py-5" style="position: relative; z-index: 10;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="glass-card p-4 animate-fadeInUp">
                <div class="text-center mb-4">
                    <div class="section-icon section-icon-danger mx-auto mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                    </div>
                    <h3 style="color: var(--danger); font-family: 'Outfit'; font-weight: 700;">Görseli Silmek İstediğinize Emin Misiniz?</h3>
                    <p class="text-muted">Bu işlem geri alınamaz ve görsel sunucudan kalıcı olarak silinir.</p>
                </div>

                <div class="card mb-4" style="background: var(--bg-glass); border: 1px solid var(--border-glass);">
                    <div class="card-body text-center">
                        <h5 class="card-title text-white mb-2">@Model.Title</h5>
                        <p class="card-text text-muted mb-3">@Model.Description</p>
                        <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded" style="max-height: 300px;" />
                    </div>
                </div>

                <form asp-action="Delete" class="d-flex justify-content-between">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-secondary-glass">
                        <i class="bi bi-arrow-left me-2"></i>İptal ve Geri Dön
                    </a>
                    <button type="submit" class="btn btn-premium btn-danger-glow">
                        <i class="bi bi-trash-fill me-2"></i>Evet, Kalıcı Olarak Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
