@model HalkEgitimSistemi.Models.GalleryItem

@{
    ViewData["Title"] = "Görseli Düzenle";
}

<!-- KURS ALETLERI YAGMURU -->
<div class="rain-container" id="rainContainer"></div>

<div class="container py-5" style="position: relative; z-index: 10;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="glass-card p-4 animate-fadeInUp">
                <h3 class="mb-4" style="color: var(--text-primary); font-family: 'Outfit'; font-weight: 700;">
                    <i class="bi bi-pencil-square text-warning me-2"></i>Görseli Düzenle
                </h3>
                
                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="mb-4 text-center">
                        <p class="text-muted mb-2">Mevcut Görsel:</p>
                        <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded" style="max-height: 250px; border: 1px solid var(--border-glass);" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label" style="font-weight: 600; color: var(--text-secondary);">Başlık</label>
                        <input asp-for="Title" name="Title" class="form-control form-premium-control" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label" style="font-weight: 600; color: var(--text-secondary);">Açıklama</label>
                        <textarea asp-for="Description" name="Description" class="form-control form-premium-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" style="font-weight: 600; color: var(--text-secondary);">Yeni Görsel (İsteğe Bağlı)</label>
                        <input type="file" name="imageFile" class="form-control form-premium-control" accept="image/*" />
                        <small class="text-muted">Resmi değiştirmek istemiyorsanız boş bırakın.</small>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary-glass">
                            <i class="bi bi-arrow-left me-2"></i>Galeriyi Dön
                        </a>
                        <button type="submit" class="btn btn-premium btn-warning-glow">
                            <i class="bi bi-save me-2"></i>Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
