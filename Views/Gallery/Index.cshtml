@model List<HalkEgitimSistemi.Models.GalleryItem>

@{
    ViewData["Title"] = "Gelişmiş Etkinlik Galerisi";
    var photoOfTheDay = ViewBag.PhotoOfTheDay as HalkEgitimSistemi.Models.GalleryItem;
}

<!-- CSS Dependencies -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<div class="container-fluid px-lg-5 py-5">
    
    <!-- GÜNÜN KARESİ (Dinamik Algoritma Åovu) -->
    @if (photoOfTheDay != null)
    {
        <div class="featured-photo-section mb-5 animate-fadeIn">
            <div class="glass-card overflow-hidden position-relative featured-card">
                <div class="row g-0">
                    <div class="col-lg-8 position-relative overflow-hidden">
                        <img src="@photoOfTheDay.ImageUrl" class="featured-img" alt="@photoOfTheDay.Title">
                        <div class="featured-badge">GÜNÜN KARESİ</div>
                    </div>
                    <div class="col-lg-4 p-5 d-flex flex-column justify-content-center">
                        <span class="text-primary-theme fw-bold mb-2">#YapayZekaSeçimi</span>
                        <h2 class="display-5 fw-bold text-white mb-3">@photoOfTheDay.Title</h2>
                        <p class="text-white-50 mb-4">@photoOfTheDay.Description</p>
                        <div class="d-flex gap-3 align-items-center mb-4">
                            <div class="stat-item"><i class="bi bi-eye me-1"></i> @photoOfTheDay.ViewCount İzlenme</div>
                            <div class="stat-item"><i class="bi bi-heart-fill text-danger me-1"></i> @photoOfTheDay.Likes.Count Beğeni</div>
                        </div>
                        <button class="btn btn-premium btn-primary-glow btn-lg" onclick="openLightbox(@photoOfTheDay.Id, '@photoOfTheDay.ImageUrl', '@photoOfTheDay.Title', '@photoOfTheDay.Description', '@photoOfTheDay.ExifInfo', '@photoOfTheDay.Tags')">İncele</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Arama ve Filtreleme -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 gap-4">
        <div>
            <h1 class="section-title-gradient h2 fw-bold">Etkinlik Galerisi</h1>
            <p class="text-white-50 m-0">Yapay zeka etiketleri ile akıllı arama yapabilirsiniz.</p>
        </div>
        <div class="d-flex gap-3 w-100 w-md-auto">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="gallerySearch" class="form-control" placeholder="Arayın... (örn: sanat, yemek)">
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("Instructor"))
            {
                <button class="btn btn-premium btn-success-glow" data-bs-toggle="modal" data-bs-target="#addPhotoModal">
                    <i class="bi bi-plus-lg me-1"></i> Ekle
                </button>
            }
        </div>
    </div>

    <!-- Masonry Grid -->
    <div id="gallery-grid" class="masonry-grid stagger-children">
        @foreach (var item in Model)
        {
            <div class="masonry-item gallery-card-v2 animate-fadeInUp" data-id="@item.Id">
                <div class="card-inner glass-card">
                    <img src="@item.ImageUrl" alt="@item.Title" class="w-100" loading="lazy">
                    

                    <!-- Kategori Etiketi -->
                    <div class="category-badge-premium">
                        @item.Category
                    </div>

                    <!-- Fiyat Etiketi (Hepsini Ücretlendir) -->
                    <div class="price-badge-premium">
                        @(item.Price > 0 ? item.Price + " ₺" : "₺")
                    </div>

                    <div class="card-overlay p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="h6 fw-bold text-white mb-0">@item.Title</h4>
                            <div class="d-flex gap-2 text-white small">
                                <span><i class="bi bi-heart-fill text-danger me-1"></i> @item.Likes.Count</span>
                                <span><i class="bi bi-chat-fill text-primary me-1"></i> @item.Comments.Count</span>
                            </div>
                        </div>
                        <p class="text-white-50 small mb-3">@item.Description</p>
                        
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-warning-glow flex-grow-1 fw-bold" onclick="openLightbox(@item.Id, '@item.ImageUrl', '@item.Title', '@item.Description', '@item.ExifInfo', '@item.Tags', '@item.Price')">
                                <i class="bi bi-eye me-1"></i> İncele
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Yükleniyor Spinner -->
    <div id="loading-spinner" class="text-center py-5 d-none">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

</div>

<!-- LIGHTBOX MODAL (Gelişmiş Etkileşim Merkezi) -->
<div class="modal fade" id="galleryLightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark-theme border-0">
            <div class="modal-body p-0 d-flex flex-column flex-lg-row overflow-hidden">
                
                <!-- Sol Panel: Görsel ve Pinler -->
                    <div class="img-viewer-panel position-relative flex-grow-1 bg-black d-flex align-items-center justify-content-center">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-4" data-bs-dismiss="modal" style="z-index: 1000;"></button>
                    
                    <!-- Loading Spinner for Lightbox Image -->
                    <div id="lbImageLoader" class="position-absolute top-50 start-50 translate-middle text-center" style="z-index: 5;">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-white-50 small mt-2">Yüksek çözünürlük yükleniyor...</p>
                    </div>

                    <div class="img-container position-relative" id="pin-container" style="opacity: 0; transition: opacity 0.5s ease;">
                        <img id="lbMainImg" src="" class="img-fluid main-lightbox-img" ondblclick="animateLike(event)" onload="onLightboxImageLoad()">
                        <!-- Pinler JavaScript ile buraya eklenecek -->
                    </div>

                    <!-- Beğeni Åelalesi (SignalR) -->
                    <div id="heart-waterfall" class="position-absolute bottom-0 start-0 w-100 h-100 pointer-events-none" style="z-index: 10;"></div>
                </div>

                <!-- Sağ Panel: Bilgiler ve Yorumlar -->
                <div class="info-sidebar p-4 overflow-auto glass-sidebar">
                    <div class="mb-5">
                        <h2 id="lbTitle" class="h3 fw-bold text-white mb-2"></h2>
                        <p id="lbDesc" class="text-white-50 mb-4"></p>
                        
                        <!-- EXIF Verileri Åovu -->
                        <div class="exif-panel mb-4 p-3 glass-card">
                            <h6 class="text-primary-theme small fw-bold text-uppercase mb-3">Çekim Verileri (EXIF)</h6>
                            <div id="lbExif" class="row g-2">
                                <!-- JS ile dolacak -->
                            </div>
                        </div>

                        <!-- Fiyat ve Satın Al -->
                        <div class="d-flex justify-content-between align-items-center mb-4 p-3 glass-card" style="border-left: 5px solid #f59e0b;">
                            <div>
                                <span class="text-white-50 small d-block">Satış Fiyatı</span>
                                <h3 id="lbPrice" class="fw-bold text-warning m-0"></h3>
                            </div>
                            <button class="btn btn-success-glow btn-lg px-4 fw-bold rounded-pill">
                                <i class="bi bi-cart-check me-2"></i> SATIN AL
                            </button>
                        </div>

                        <!-- Clap Butonu (UX Åovu) -->
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <button class="btn-clap" onclick="triggerClap()">
                                <i class="bi bi-hand-thumbs-up-fill"></i>
                                <span id="clapCount">0</span>
                            </button>
                            <span class="text-white-50 small">Bu eseri alkışlayın!</span>
                        </div>
                    </div>

                    <!-- Yorumlar Bölümü -->
                    <div class="comments-section">
                        <h5 class="text-white mb-4"><i class="bi bi-chat-text me-2"></i> Yorumlar</h5>
                        <div id="lbComments" class="comment-list mb-4">
                            <!-- JS ile dolacak -->
                        </div>
                        <div class="add-comment-area mt-4">
                            <p class="text-white-50 small mb-2"><i class="bi bi-info-circle me-1"></i> Görselin üzerine tıklayarak spesifik bir noktaya yorum bırakabilirsiniz.</p>
                            <div class="input-group">
                                <input type="text" id="commentInput" class="form-control glass-input" placeholder="Yorumunuzu yazın...">
                                <button class="btn btn-primary-glow" onclick="submitPinComment()">Gönder</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Instructor"))
{
    <!-- Dosya Yükleme Modalı -->
    <div class="modal fade" id="addPhotoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card-static">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" style="font-family:'Outfit'; font-weight:800; color:var(--text-primary);">
                        <i class="bi bi-folder-plus text-success me-2"></i>Galeriyi Güncelle
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Gallery" asp-action="Add" method="post" enctype="multipart/form-data">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Görsel Dosyası</label>
                            <input class="form-control form-premium-control" type="file" name="imageFile" accept="image/*" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Başlık</label>
                            <input type="text" name="Title" class="form-control form-premium-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Açıklama</label>
                            <textarea name="Description" class="form-control form-premium-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary-glass" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-premium btn-success-glow"><i class="bi bi-upload me-2"></i>Yükle ve Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<style>
    /* Masonry & Layout */
    .masonry-grid { column-count: 4; column-gap: 20px; }
    .masonry-item { 
        break-inside: avoid; 
        margin-bottom: 20px; 
        cursor: pointer; 
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        will-change: transform;
        transform: translateZ(0); /* Force GPU Layer */
        backface-visibility: hidden;
        contain: layout;
    }
    .masonry-item:hover { transform: scale(1.02); }
    .card-inner { position: relative; overflow: hidden; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); }
    .card-inner img { transition: transform 0.6s ease; }
    .masonry-item:hover .card-inner img { transform: scale(1.1); filter: brightness(0.7); }
    .card-overlay { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(0,0,0,0.9), transparent); transform: translateY(100%); transition: transform 0.4s ease; }
    .masonry-item:hover .card-overlay { transform: translateY(0); }
    
    /* Featured Section */
    .featured-card { border-radius: 30px; border: 2px solid rgba(197, 160, 89, 0.3); }
    .featured-img { width: 100%; height: 500px; object-fit: cover; }
    .featured-badge { position: absolute; top: 30px; left: 30px; background: var(--primary); color: white; padding: 10px 20px; border-radius: 30px; font-weight: 800; font-size: 0.8rem; box-shadow: 0 5px 15px rgba(197, 160, 89, 0.4); }

    /* Lightbox Panels */
    .image-viewer-panel { height: 100vh; overflow: hidden; }
    .info-sidebar { width: 450px; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(20px); border-left: 1px solid rgba(255,255,255,0.1); height: 100vh; }
    .main-lightbox-img { max-height: 90vh; border-radius: 15px; box-shadow: 0 0 50px rgba(0,0,0,0.5); cursor: crosshair; }

    /* Hotspot Pins */
    .pin { position: absolute; width: 24px; height: 24px; background: var(--primary); border: 3px solid white; border-radius: 50%; cursor: pointer; transform: translate(-50%, -50%); box-shadow: 0 0 15px var(--primary); z-index: 100; transition: all 0.3s ease; }
    .pin:hover { transform: translate(-50%, -50%) scale(1.3); background: #fff; border-color: var(--primary); }
    .pin-comment { position: absolute; bottom: 35px; left: 50%; transform: translateX(-50%); background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(10px); color: white; padding: 10px 15px; border-radius: 12px; width: 200px; font-size: 0.85rem; pointer-events: none; opacity: 0; transition: opacity 0.3s; box-shadow: 0 10px 25px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); }
    .pin:hover .pin-comment { opacity: 1; }

    /* Clap Button */
    .btn-clap { width: 60px; height: 60px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white; font-size: 1.5rem; transition: all 0.2s; position: relative; }
    .btn-clap:active { transform: scale(0.9); background: var(--primary); }
    #clapCount { position: absolute; top: -5px; right: -5px; background: var(--primary); font-size: 0.75rem; padding: 2px 8px; border-radius: 10px; }

    /* Tags */
    .badge-tag { font-size: 0.7rem; color: var(--primary); margin-right: 5px; opacity: 0.8; }
    .search-box { position: relative; width: 300px; }
    .search-box i { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
    .search-box input { padding-left: 45px; border-radius: 30px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; }

    /* Pazar Yeri Badge Tasarımları */
    .category-badge-premium {
        position: absolute;
        top: 20px;
        left: 20px;
        background: rgba(30, 41, 59, 0.8);
        color: #fff;
        padding: 5px 15px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.75rem;
        z-index: 5;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.1);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .price-badge-premium {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #f59e0b;
        color: #000;
        padding: 5px 15px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.85rem;
        z-index: 5;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
    }
    .btn-success-glow {
        background: linear-gradient(135deg, #C5A059 0%, #C5A059 100%);
        color: white;
        border: none;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }
    .btn-success-glow:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.5);
        color: white;
    }

    @@media (max-width: 1200px) { .masonry-grid { column-count: 3; } }
    @@media (max-width: 992px) { .masonry-grid { column-count: 2; } .info-sidebar { width: 100%; height: auto; } }
    @@media (max-width: 576px) { .masonry-grid { column-count: 1; } }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        let currentItemId = 0;
        let lastPinX = 0, lastPinY = 0;
        let skipCount = 12;
        const takeCount = 12;
        let isFetching = false;

        // SignalR Bağlantısı
        const connection = new signalR.HubConnectionBuilder().withUrl("/galleryHub").build();
        connection.start().catch(err => console.error(err.toString()));

        connection.on("ReceiveLike", function (id) {
            if (currentItemId === id) {
                spawnFloatingHeart();
            }
        });

        connection.on("ReceiveComment", function (id, user, content, x, y) {
            if (currentItemId === id && x && y) {
                createPin(x, y, content, user, false);
            }
        });

        // Lightbox Açma
        function openLightbox(id, url, title, desc, exif, tags, price) {
            currentItemId = id;
            
            // Reset state
            const container = document.getElementById('pin-container');
            const loader = document.getElementById('lbImageLoader');
            container.style.opacity = '0';
            loader.style.display = 'block';
            
            document.getElementById('lbMainImg').src = url;
            document.getElementById('lbTitle').innerHTML = title;
            document.getElementById('lbDesc').innerText = desc;
            document.getElementById('lbPrice').innerText = price + " ₺";

            // Yorumları ve Pinleri Getir (AJAX)
            fetch(`/Gallery/GetItemDetails?id=${id}`)
                .then(r => r.json())
                .then(data => {
                    // Pinleri Temizle
                    document.querySelectorAll('.pin').forEach(p => p.remove());
                    const commentsList = document.getElementById('lbComments');
                    commentsList.innerHTML = '';
                    
                    document.getElementById('clapCount').innerText = data.likeCount;

                    data.comments.forEach(c => {
                        // Yan paneldeki listeye ekle
                        const cHtml = `
                            <div class="comment-item mb-3 p-2 rounded" style="background: rgba(255,255,255,0.05);">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-primary-theme fw-bold">${c.userEmail}</span>
                                    <span class="text-white-50">${c.date}</span>
                                </div>
                                <div class="text-white small">${c.content}</div>
                            </div>
                        `;
                        commentsList.insertAdjacentHTML('beforeend', cHtml);

                        // Eğer pin koordinatları varsa görsel üzerine ekle
                        if (c.x !== null && c.y !== null) {
                            createPin(c.x, c.y, c.content, c.userEmail, false);
                        }
                    });
                });
            
            // View Count Artır (AJAX)
            fetch(`/Gallery/IncrementView/${id}`, { method: 'POST' });

            new bootstrap.Modal(document.getElementById('galleryLightbox')).show();
        }

        function onLightboxImageLoad() {
            document.getElementById('lbImageLoader').style.display = 'none';
            document.getElementById('pin-container').style.opacity = '1';
        }

        // Pin Bırakma (Hotspot)
        document.getElementById('pin-container').addEventListener('click', function(e) {
            if (e.target.id !== 'lbMainImg') return;
            
            const rect = e.target.getBoundingClientRect();
            lastPinX = ((e.clientX - rect.left) / rect.width) * 100;
            lastPinY = ((e.clientY - rect.top) / rect.height) * 100;
            
            document.querySelectorAll('.pin-preview').forEach(p => p.remove());
            const preview = document.createElement('div');
            preview.className = 'pin pin-preview';
            preview.style.left = lastPinX + '%';
            preview.style.top = lastPinY + '%';
            this.appendChild(preview);
            
            document.getElementById('commentInput').focus();
        });

        function submitPinComment() {
            const content = document.getElementById('commentInput').value;
            if (!content) return;

            const formData = new FormData();
            formData.append('itemId', currentItemId);
            formData.append('content', content);
            formData.append('x', lastPinX);
            formData.append('y', lastPinY);

            fetch('/Gallery/AddComment', {
                method: 'POST',
                body: formData
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    if (!data.needsApproval) {
                        createPin(lastPinX, lastPinY, content, "Siz", true);
                    }
                    document.getElementById('commentInput').value = '';
                    document.querySelectorAll('.pin-preview').forEach(p => p.remove());
                }
            });
        }

        function createPin(x, y, content, user, isOwn) {
            const pin = document.createElement('div');
            pin.className = 'pin animate__animated animate__bounceIn';
            pin.style.left = x + '%';
            pin.style.top = y + '%';
            pin.innerHTML = `
                <div class="pin-comment">
                    <strong>${user}</strong><br>${content}
                </div>
            `;
            document.getElementById('pin-container').appendChild(pin);
        }

        // Çift Tıklama Beğeni Animasyonu
        function animateLike(e) {
            const heart = document.createElement('i');
            heart.className = 'bi bi-heart-fill text-danger position-absolute animate__animated animate__zoomInUp';
            heart.style.left = (e.offsetX - 40) + 'px';
            heart.style.top = (e.offsetY - 40) + 'px';
            heart.style.fontSize = '80px';
            heart.style.zIndex = '1000';
            e.target.parentElement.appendChild(heart);
            
            toggleLike();

            setTimeout(() => heart.remove(), 1000);
        }

        function toggleLike() {
            fetch(`/Gallery/ToggleLike?itemId=${currentItemId}`, { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    if (data.success) spawnFloatingHeart();
                });
        }

        function spawnFloatingHeart() {
            const waterfall = document.getElementById('heart-waterfall');
            const icons = ['â¤ï¸', 'ğŸ”¥', 'ğŸ‘', 'âœ¨'];
            for(let i=0; i<5; i++) {
                const heart = document.createElement('div');
                heart.className = 'floating-heart';
                heart.innerText = icons[Math.floor(Math.random() * icons.length)];
                heart.style.left = Math.random() * 100 + '%';
                heart.style.animationDelay = Math.random() * 0.5 + 's';
                waterfall.appendChild(heart);
                setTimeout(() => heart.remove(), 3000);
            }
        }

        // Sonsuz Kaydırma - Throttled (Performans için dizginlendi)
        let scrollTimeout;
        window.onscroll = function() {
            if (scrollTimeout) return;
            
            scrollTimeout = setTimeout(() => {
                if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 800) {
                    if (!isFetching) loadMoreItems();
                }
                scrollTimeout = null;
            }, 150); // 150ms'de bir kontrol et
        };


        function loadMoreItems() {
            isFetching = true;
            document.getElementById('loading-spinner').classList.remove('d-none');
            
            const search = document.getElementById('gallerySearch').value;
            fetch(`/Gallery/GetItems?skip=${skipCount}&take=${takeCount}&search=${search}`)
                .then(r => r.json())
                .then(data => {
                    if (data.length > 0) {
                        const grid = document.getElementById('gallery-grid');
                        data.forEach(item => {
                            const html = `
                                <div class="masonry-item gallery-card-v2 animate__animated animate__fadeInUp" onclick="openLightbox(${item.id}, '${item.imageUrl}', '${item.title}', '${item.description}', '', '${item.tags}')">
                                    <div class="card-inner glass-card">
                                        <img src="${item.imageUrl}" alt="${item.title}" class="w-100">
                                        <div class="card-overlay p-4">
                                            <h4 class="h6 fw-bold text-white">${item.title}</h4>
                                        </div>
                                    </div>
                                </div>
                            `;
                            grid.insertAdjacentHTML('beforeend', html);
                        });
                        skipCount += data.length;
                    }
                    isFetching = false;
                    document.getElementById('loading-spinner').classList.add('d-none');
                });
        }
    </script>
    <style>
        .floating-heart { position: absolute; bottom: 0; font-size: 24px; animation: floatUp 3s forwards; opacity: 0; }
        @@keyframes floatUp {
            0% { transform: translateY(0) scale(0.5); opacity: 0; }
            20% { opacity: 1; }
            100% { transform: translateY(-100vh) scale(1.5) rotate(20deg); opacity: 0; }
        }
