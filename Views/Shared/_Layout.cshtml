            .mic-btn { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; color: rgba(255,255,255,0.5); font-size: 1.2rem; cursor: pointer; transition: all 0.3s; }
            .mic-btn.active { color: #C5A059; animation: pulse-gold-mic 1.5s infinite; }
            @@keyframes pulse-red-mic { 0% { transform: translateY(-50%) scale(1); } 50% { transform: translateY(-50%) scale(1.2); } 100% { transform: translateY(-50%) scale(1); } }
            
            .chat-history::-webkit-scrollbar { width: 4px; }
            .chat-history::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }

            /* Floating Go Back Button */
            .btn-floating-back {
                position: fixed;
                bottom: 30px;
                left: 30px;
                z-index: 9998;
                width: 50px;
                height: 50px;
                border-radius: 15px;
                background: rgba(15, 23, 42, 0.8);
