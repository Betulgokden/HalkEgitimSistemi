                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-12 p-2 d-flex align-items-center gap-3" asp-controller="JobPostings" asp-action="Manage">
                                                <div class="icon-box-sm" style="color: #C5A059; width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; background: rgba(197,160,89,0.1);"><i class="bi bi-briefcase-fill"></i></div>
                                                <span class="fw-bold">İş İlanlarını Yönet</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-12 p-2 d-flex align-items-center gap-3" asp-controller="Admin" asp-action="InstructorApplications">
                                                <div class="icon-box-sm" style="color: #0ea5e9; width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; background: rgba(14, 165, 233, 0.1);"><i class="bi bi-shield-check"></i></div>
                                                <span>Panel Onayları</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-12 p-2 d-flex align-items-center gap-3" asp-controller="Admin" asp-action="MessageLog">
                                                <div class="icon-box-sm" style="color: #C5A059; width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; background: rgba(197, 160, 89, 0.1);"><i class="bi bi-archive-fill"></i></div>
                                                <span>Sohbet Arşivi</span>
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider border-white-10 my-2"></li>
                                        <li><h6 class="dropdown-header text-white-50 small fw-bold px-3 pt-1 mb-2" style="letter-spacing: 1px;">HIZLI ERİŞİM (KISAYOLLAR)</h6></li>
                                        <li>
                                            <a class="dropdown-item rounded-12 p-2 d-flex align-items-center gap-3" asp-controller="Admin" asp-action="StudentChat">
                                                <div class="icon-box-sm" style="color: #581C1C; width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; background: rgba(88, 28, 28, 0.1);"><i class="bi bi-chat-dots"></i></div>
                                                <span>Kursiyer Chat</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-12 p-2 d-flex align-items-center gap-3" asp-controller="Admin" asp-action="TeacherRoom">
                                                <div class="icon-box-sm" style="color: #581C1C; width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; background: rgba(88, 28, 28, 0.1);"><i class="bi bi-person-workspace"></i></div>
                                                <span>Öğretmen Odası</span>
