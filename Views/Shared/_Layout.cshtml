        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const robotInput = document.getElementById('robotInput');
                const chatHistory = document.getElementById('chatHistory');
                const aiRobotContainer = document.getElementById('aiRobotContainer');
                const micBtn = document.getElementById('micBtn');
                const typingIndicator = document.getElementById('typingIndicator');
                const sendRobotBtn = document.getElementById('sendRobotBtn');
                const chatBubbleEl = aiRobotContainer.querySelector('.robot-chat-bubble');
                const robotBody = aiRobotContainer.querySelector('.robot-body');

                let botOpen = false;

                function openBot() {
                    botOpen = true;
                    chatBubbleEl.style.display = 'block';
                    chatBubbleEl.getBoundingClientRect();
                    chatBubbleEl.classList.add('open');
                    aiRobotContainer.classList.add('focused');
                    setTimeout(() => robotInput.focus(), 300);
                }

                function closeBot() {
                    botOpen = false;
                    chatBubbleEl.classList.remove('open');
                    aiRobotContainer.classList.remove('focused');
                    setTimeout(() => { if (!botOpen) chatBubbleEl.style.display = 'none'; }, 400);
                }

                if (robotBody) {
                    robotBody.addEventListener('click', (e) => {
                        e.stopPropagation();
                        botOpen ? closeBot() : openBot();
                    });
                }

                // Global Go Back logic
                window.goBack = function() {
                    if (window.history.length > 1) {
                        window.history.back();
                    } else {
                        window.location.href = '/';
                    }
                };

                // AI Response
                window.processCommand = async function(val) {
                    val = val ? val.trim() : robotInput.value.trim();
                    if (!val) return;

                    const userMsg = document.createElement('div');
                    userMsg.className = "mt-2 text-end animate-fadeIn";
                    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
                    const innerBubble = document.createElement('div');
                    innerBubble.style.cssText = `display:inline-block; background:${isLight ? 'rgba(0,0,0,0.05)' : 'rgba(255,255,255,0.05)'}; color:${isLight ? '#1e293b' : 'rgba(255,255,255,0.7)'}; padding:8px 15px; border-radius:15px; font-size:0.9rem; border:1px solid ${isLight ? 'rgba(0,0,0,0.1)' : 'rgba(255,255,255,0.1)'};`;
                    innerBubble.textContent = val;
                    userMsg.appendChild(innerBubble);
                    chatHistory.appendChild(userMsg);
                    chatHistory.scrollTop = chatHistory.scrollHeight;

                    robotInput.value = '';
                    typingIndicator.classList.remove('d-none');

                    try {
                        const response = await fetch('/api/HalkBot/chat', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ message: val })
                        });
                        const data = await response.json();
                        
                        typingIndicator.classList.add('d-none');
                        
                        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
                        const botMsg = document.createElement('div');
                        botMsg.className = "mt-3 animate-fadeIn";
                        botMsg.innerHTML = `
                            <div style="background:${isLight ? 'rgba(0,0,0,0.02)' : 'rgba(255,255,255,0.03)'}; color:${isLight ? '#1e293b' : 'white'}; padding:12px 18px; border-radius:15px; border-left:3px solid #C5A059; font-size:0.95rem; line-height:1.6;">
                                ${data.text}
                            </div>
                        `;
                        chatHistory.appendChild(botMsg);

                        // --- HalkBot Actions ---
                        if (data.action === "RedirectToLogin") {
                            setTimeout(() => window.location.href = '/Account/Login', 2000);
                        } else if (data.action === "OpenAdminApplications") {
                            setTimeout(() => window.location.href = '/Applications/Index', 2000);
                        }
                        
                        // --- Voice Support (TTS) ---
                        if (data.voiceEnabled && window.speechSynthesis) {
                            const speakText = data.voiceText || data.text.replace(/<[^>]*>?/gm, '');
                            const utterance = new SpeechSynthesisUtterance(speakText);
                            const speakingIndicator = document.getElementById('speakingIndicator');
                            
                            utterance.lang = 'tr-TR';
                            utterance.rate = 1.0;
                            utterance.pitch = 1.1;

                            utterance.onstart = () => speakingIndicator?.classList.remove('d-none');
                            utterance.onend = () => speakingIndicator?.classList.add('d-none');
                            
                            window.speechSynthesis.speak(utterance);
                        }

                        // --- Data Processing (JSON handle) ---
                        if (data.data) {
                            console.log("HalkBot Data Payload:", data.data);
                        }

                    } catch (error) {
                        console.error("Bot error:", error);
                        typingIndicator.classList.add('d-none');
                        const botMsg = document.createElement('div');
                        botMsg.className = "mt-3 animate-fadeIn";
                        botMsg.innerHTML = `<div class="alert alert-danger-glass p-2 small">Bağlantı hatası oluştu.</div>`;
                        chatHistory.appendChild(botMsg);
                    }
                    chatHistory.scrollTop = chatHistory.scrollHeight;
                };


                robotInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') processCommand();
                });

                if (sendRobotBtn) {
                    sendRobotBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        processCommand();
                    });
                }

                if ('webkitSpeechRecognition' in window) {
                    const recognition = new webkitSpeechRecognition();
                    recognition.lang = 'tr-TR';
                    micBtn.addEventListener('click', () => {
                        recognition.start();
                        micBtn.classList.add('active');
                    });
                    recognition.onresult = (e) => {
                        const transcript = e.results[0][0].transcript;
                        robotInput.value = transcript;
                        processCommand(transcript);
                    };
                    recognition.onend = () => micBtn.classList.remove('active');
                }
            });

            // Global Icon Rain
            window.addEventListener('load', function() {
                // Delay animation start to ensure main content renders first
                setTimeout(() => {
                    const rainContainer = document.getElementById('globalRainContainer');
                    if (!rainContainer) return;

                    const iconTypes = ['bi-book', 'bi-pencil', 'bi-mortarboard', 'bi-palette', 'bi-laptop', 'bi-globe', 'bi-stars', 'bi-cpu'];
                    const icons = [];
                    const iconCount = 250; // High density for a massive rain effect

                    // Check for reduced motion preference
                    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    if (prefersReducedMotion) return;

                    for (let i = 0; i < iconCount; i++) {
                        const iconEl = document.createElement('i');
                        iconEl.className = `bi ${iconTypes[Math.floor(Math.random() * iconTypes.length)]} rain-icon`;
                        iconEl.style.color = '#C5A059'; // Solid Gold
                        iconEl.style.textShadow = '0 0 20px rgba(197, 160, 89, 0.9)';
                        iconEl.style.opacity = '0.45';
                        
                        const iconObj = { 
                            el: iconEl, 
                            x: Math.random() * 100, 
                            y: Math.random() * -1500, 
                            speed: 0.5 + Math.random() * 1.5, // Reduced speed
                            rotation: Math.random() * 360,
                            sway: Math.random() * 3,
                            swaySpeed: 0.02 + Math.random() * 0.05
                        };
                        
                        iconEl.style.willChange = 'transform';
                        iconEl.style.left = iconObj.x + '%';
                        rainContainer.appendChild(iconEl);
                        icons.push(iconObj);
                    }

                    let time = 0;
                    let isTabVisible = true;
                    document.addEventListener('visibilitychange', () => { isTabVisible = !document.hidden; });

                    function updateRain() {
                        if (!isTabVisible) {
                            requestAnimationFrame(updateRain);
                            return;
                        }
                        time += 0.05;
                        icons.forEach(icon => {
                            icon.y += icon.speed;
                            const currentSway = Math.sin(time * icon.swaySpeed + icon.x) * 15; 
                            
                            if (icon.y > window.innerHeight + 100) {
                                icon.y = -150;
                                icon.x = Math.random() * 100;
                                icon.el.style.left = icon.x + '%';
                            }
                            
                            icon.el.style.transform = `translate3d(${currentSway}px, ${icon.y}px, 0) rotate(${icon.rotation + icon.y/5}deg)`;
                        });
                        requestAnimationFrame(updateRain);
                    }
                    updateRain();
                }, 2000); // 2 second delay for max performance
            });
        </script>
