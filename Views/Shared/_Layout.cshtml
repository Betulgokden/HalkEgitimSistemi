    <script>
        // Jet Speed Loader Logic
        window.addEventListener('beforeunload', () => {
            const loader = document.getElementById('globalLoader');
            loader.style.width = '40%';
            loader.style.opacity = '1';
        });
        window.addEventListener('load', () => {
            const loader = document.getElementById('globalLoader');
            loader.style.width = '100%';
            setTimeout(() => { 
                loader.style.opacity = '0'; 
                // Delay heavy animations until loader is gone
                setTimeout(() => {
                    document.body.classList.add('ready-for-animations');
                }, 500);
            }, 300);
        });

        // Professional Fade-in for Main Content
        document.querySelector('main').classList.add('animate-fadeIn');

        // Visionary Module Functions
        window.openAIVizard = function() {
            // Interactive Course Wizard Simulation
            const wizardHtml = `
                <div id="aiWizard" class="bg-glass-strong position-fixed top-50 start-50 translate-middle rounded-4 p-5 text-center animate-scaleIn" style="z-index: 3000; border: 1px solid #C5A059; max-width: 500px; width: 90%;">
