                                    <li><a class="dropdown-item py-3 rounded-12 mb-1 login-item-student" style="color: #C5A059 !important; font-weight: 800;" asp-controller="Account" asp-action="Login" asp-route-role="Student"><i class="bi bi-mortarboard me-2" style="color: #C5A059 !important;"></i> <span style="color: #C5A059 !important;" data-i18n="login_student">Öğrenci Girişi</span></a></li>
                                    <li><a class="dropdown-item py-3 rounded-12 mb-1 login-item-instructor" style="color: #C5A059 !important; font-weight: 800;" asp-controller="Account" asp-action="Login" asp-route-role="Instructor"><i class="bi bi-person-workspace me-2" style="color: #C5A059 !important;"></i> <span style="color: #C5A059 !important;" data-i18n="login_instructor">Eğitmen Girişi</span></a></li>
                                    <li><a class="dropdown-item py-3 rounded-12 mb-1 login-item-employer" style="color: #C5A059 !important; font-weight: 800;" asp-controller="Account" asp-action="Login" asp-route-role="Employer"><i class="bi bi-buildings me-2" style="color: #C5A059 !important;"></i> <span style="color: #C5A059 !important;" data-i18n="login_employer">İşveren Girişi</span></a></li>
                                    <li><a class="dropdown-item py-3 rounded-12 login-item-admin" style="color: #C5A059 !important; font-weight: 800;" asp-controller="Account" asp-action="Login" asp-route-role="Admin"><i class="bi bi-shield-lock me-2" style="color: #C5A059 !important;"></i> <span style="color: #C5A059 !important;" data-i18n="login_admin">Yönetici Paneli</span></a></li>
                                </ul>
                            </div>
