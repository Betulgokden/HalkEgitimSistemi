<body class="bg-vibrant-dark @ViewData["BodyClass"]">
    <!-- GLOBAL ICON RAIN -->
    <div class="particles-bg rain-container" id="globalRainContainer" style="z-index: 100; pointer-events: none;"></div>

    <!-- Jet Speed Loading Indicator -->
    <div id="globalLoader" style="position:fixed; top:0; left:0; width:0%; height:3px; background:linear-gradient(90deg, #C5A059, #581C1C); z-index:9999; transition: width 0.3s ease;"></div>

    <!-- Premium Header & Navbar -->
    <!-- Ultra-Premium Compact Header -->
    <header class="main-header fixed-top" style="z-index: 2000 !important; background: var(--theme-card-bg); backdrop-filter: blur(4px); border-bottom: 1px solid var(--theme-card-border) !important; transition: all 0.3s ease;">
        <div class="container-fluid">
            <div class="row align-items-center py-2">
                <!-- Left: Theme Toggle Centered -->
                <div class="col-4 col-lg-3 d-flex align-items-center justify-content-center">
                    <button id="themeToggleBtn" class="btn-icon-glass" data-tooltip="Switch Theme" style="transform: scale(1.1); border: 1px solid var(--theme-card-border);">
                        <i class="bi bi-moon-stars-fill gold-text" id="themeIcon"></i>
                    </button>
                </div>

                <!-- Center: Branding -->
                <div class="col-4 col-lg-6 text-center">
                    <a class="header-logo" asp-controller="Home" asp-action="Index" style="text-decoration: none;">
                        <h1 class="m-0" style="font-family: 'Outfit', sans-serif; font-weight: 900; letter-spacing: 2px; font-size: 1.8rem; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-mortarboard-fill me-2 float-slow gold-text"></i>
                            <span class="gold-text" data-i18n="brand_name">Artvin / Borçka Halk Eğitim Merkezi</span>
                        </h1>
                    </a>
                </div>

                <!-- Right: Auth & Counter -->
                <div class="col-4 col-lg-3 text-end d-flex align-items-center justify-content-end gap-3">
                    <!-- Halk Point & Active Counter -->
                    <div class="header-status-group d-none d-md-flex align-items-center gap-2">
                        <!-- Halk Point Display (Only for Students) -->
                        @if (User.IsInRole("Student"))
                        {
                            var userPoints = User.Claims.FirstOrDefault(c => c.Type == "Points")?.Value ?? "0";
                            <div class="status-badge-premium hp-badge px-3 py-1 bg-glass-sm rounded-pill border-glass d-flex align-items-center gap-2" style="border-color: rgba(197, 160, 89, 0.4) !important; background: rgba(197, 160, 89, 0.1) !important;">
                                <i class="bi bi-coin gold-text" style="filter: drop-shadow(0 0 5px var(--primary-glow));"></i>
                                <span class="gold-text fw-900 small">@userPoints HP</span>
                            </div>
                        }

                        <div class="status-badge-premium active-badge px-3 py-1 bg-glass-sm rounded-pill border-glass d-flex align-items-center gap-2" style="border-color: rgba(16, 185, 129, 0.4) !important; background: rgba(16, 185, 129, 0.1) !important;">
                            <span class="pulse-dot-green" style="width: 8px; height: 8px; background: #10b981; border-radius: 50%; display: inline-block; box-shadow: 0 0 10px #10b981; animation: pulse-active 2s infinite;"></span>
                            <span class="small fw-900" style="color: #10b981; white-space: nowrap;">
                                <span id="liveActiveCount">144</span> <span data-i18n="nav_hp_aktif">Aktif</span>
                            </span>
                        </div>
                    </div>

                    <!-- Accessibility & Language Bar -->
                    <div class="accessibility-bar d-flex align-items-center gap-2 px-3 py-1 bg-glass-sm rounded-pill border-glass">
                        <button class="btn-icon-sm lang-btn" id="lang-btn-EN" title="English" onclick="changeLanguage('EN')"><img src="https://flagcdn.com/w20/gb.png" width="16" alt="EN"></button>
                        <button class="btn-icon-sm lang-btn" id="lang-btn-TR" title="Turkish" onclick="changeLanguage('TR')"><img src="https://flagcdn.com/w20/tr.png" width="16" alt="TR"></button>
                        <div class="vr mx-1 opacity-25"></div>
                        <button class="btn-icon-sm" title="High Contrast" onclick="toggleContrast()"><i class="bi bi-eye"></i></button>
                        <button class="btn-icon-sm" id="readAloudBtn" title="Sayfayı Sesli Dinle" onclick="toggleReadAloud()"><i class="bi bi-megaphone"></i></button>
                    </div>
                    <div class="login-wrapper">
                        @if (!User.Identity!.IsAuthenticated)
                        {
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-premium-sm" type="button" data-bs-toggle="dropdown" style="background: #581C1C !important; color: #C5A059 !important; border: 1px solid #C5A059 !important; border-radius: 8px !important; padding: 10px 22px !important; font-weight: 800 !important; box-shadow: 0 4px 15px rgba(88, 28, 28, 0.4) !important;">
                                    <i class="bi bi-person-lock me-1"></i> <span style="color: #C5A059 !important;" data-i18n="login_btn">Giriş Yap</span>
