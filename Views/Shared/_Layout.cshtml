    <!-- DYNAMIC CYBER-TICKER: Real-time Job & Neighborhood Pulse -->
    @if (ViewData["Title"]?.ToString() == "Ana Sayfa")
    {
        <div class="cyber-ticker-wrapper" style="position: relative; width: 100%; z-index: 1000; background: #581C1C; border-bottom: 2px solid #C5A059; height: 40px; display: flex; align-items: center; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
            <div class="ticker-label" style="background: #C5A059; color: #581C1C; height: 100%; display: flex; align-items: center; padding: 0 20px; font-weight: 900; font-size: 0.8rem; z-index: 10; white-space: nowrap; box-shadow: 5px 0 10px rgba(0,0,0,0.3);">
                <i class="bi bi-broadcast-pin me-2 animate-pulse"></i> CANLI AKIŞ
            </div>
            <marquee class="ticker-content w-100" behavior="scroll" direction="left" scrollamount="6" style="padding-top: 3px;" onmouseover="this.stop();" onmouseout="this.start();">
                @if (ViewBag.JobPostings != null)
                {
                    @foreach (var job in (List<HalkEgitimSistemi.Models.JobPosting>)ViewBag.JobPostings)
                    {
                        <span class="ticker-item" style="color: #ffffff; font-weight: 700; font-size: 0.85rem; padding: 0 30px; font-family: 'Outfit';">
                            <i class="bi bi-briefcase-fill text-warning me-2"></i> YENİ İLAN: <span style="color: #C5A059;">@job.Title</span> - @job.Location - @job.SalaryRange 💼
                        </span>
                    }
                }
                @if (ViewBag.NewestCourses != null)
                {
                    @foreach (var course in (List<HalkEgitimSistemi.Models.Course>)ViewBag.NewestCourses)
                    {
                        <span class="ticker-item" style="color: #ffffff; font-weight: 700; font-size: 0.85rem; padding: 0 30px; font-family: 'Outfit';">
                            <i class="bi bi-mortarboard-fill text-info me-2"></i> YENİ KURS: <span style="color: #C5A059;">@course.CourseName</span> kayıtları başladı! ⚡
                        </span>
                    }
                }
                <span class="ticker-item" style="color: #ffffff; font-weight: 700; font-size: 0.85rem; padding: 0 30px; font-family: 'Outfit';">
                    <i class="bi bi-pin-map-fill text-danger me-2"></i> GÜNDOĞDU MAHALLESİ: <span style="color: #C5A059;">Siber Güvenlik</span> zirvede! 📍
                </span>
                <span class="ticker-item" style="color: #ffffff; font-weight: 700; font-size: 0.85rem; padding: 0 30px; font-family: 'Outfit';">
                    <i class="bi bi-tree-fill text-success me-2"></i> KARAGÖL PROJESİ: <span style="color: #C5A059;">342 / 500</span> Fidan Hedefi! 🌲
                </span>
            </marquee>
        </div>
    }

