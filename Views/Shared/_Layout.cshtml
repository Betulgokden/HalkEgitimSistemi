                    <p class="text-white-50 mb-4">Let's build your future together. Our first question:</p>
                    <h4 class="text-white mb-4">In which area would you like to develop yourself?</h4>
                    <div class="d-grid gap-3">
                        <button class="btn btn-outline-light rounded-pill py-3" onclick="closeWizard()">Digital World & Software</button>
                        <button class="btn btn-outline-light rounded-pill py-3" onclick="closeWizard()">Handicrafts & Design</button>
                        <button class="btn btn-outline-light rounded-pill py-3" onclick="closeWizard()">Gastronomy & Kitchen</button>
                    </div>
                    <button class="btn btn-link text-muted mt-4" onclick="closeWizard()">Cancel</button>
                </div>
                <div id="wizardOverlay" class="position-fixed top-0 start-0 w-100 h-100 bg-dark opacity-75" style="z-index: 2999;" onclick="closeWizard()"></div>
            `;
            document.body.insertAdjacentHTML('beforeend', wizardHtml);
        }

        window.closeWizard = function() {
            document.getElementById('aiWizard')?.remove();
            document.getElementById('wizardOverlay')?.remove();
        }

        // Professional Theme Engine
        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            
            const icon = document.getElementById('themeIcon');
            if (icon) {
                if (theme === 'light') {
                    icon.className = 'bi bi-sun-fill';
                    icon.style.color = '#f59e0b';
                } else {
                    icon.className = 'bi bi-moon-stars-fill';
                    icon.style.color = '#C5A059';
                }
            }
            
            // Adjust body background immediately to prevent flicker
            if (theme === 'dark') {
                document.body.style.backgroundColor = '#030308';
            } else {
                document.body.style.backgroundColor = '#FDFCFB';
            }
        }

        document.getElementById('themeToggleBtn')?.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            applyTheme(current === 'dark' ? 'light' : 'dark');
        });

        // Initialize theme properly
        (function() {
            const saved = localStorage.getItem('theme') || 'dark';
            applyTheme(saved);
        })();
    </script>
