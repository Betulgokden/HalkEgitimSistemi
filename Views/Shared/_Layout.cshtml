            50% { transform: scale(1.4); opacity: 0.1; }
            100% { transform: scale(1); opacity: 0.3; }
        }
        .robot-chat-bubble {
            position: absolute !important;
            bottom: 100px !important;
            right: 0 !important;
            width: 400px !important; /* Enlarged from 320px */
            background: rgba(15, 17, 26, 0.98) !important;
            backdrop-filter: blur(4px) !important;
            border: 1px solid rgba(255,255,255,0.2) !important;
            border-radius: 25px !important;
            padding: 20px !important;
            box-shadow: 0 30px 80px rgba(0,0,0,1) !important;
            opacity: 0;
            transform: translateY(30px) scale(0.9);
            transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
            display: none;
            pointer-events: none;
            cursor: default !important;
            color: #ffffff !important;
        }
        [data-theme="light"] .robot-chat-bubble {
            background: rgba(253, 252, 251, 0.98) !important;
            border: 1px solid rgba(88, 28, 28, 0.2) !important;
            box-shadow: 0 30px 80px rgba(88, 28, 28, 0.15) !important;
            color: #581C1C !important;
        }
        [data-theme="light"] .robot-chat-bubble h5 {
            color: #581C1C !important;
        }
        [data-theme="light"] .robot-chat-bubble strong {
            color: #C5A059 !important;
        }
        [data-theme="light"] .robot-chat-bubble #robotMessage {
            color: #581C1C !important;
        }
        [data-theme="light"] .robot-chat-bubble .text-white-50 {
            color: rgba(88, 28, 28, 0.6) !important;
        }
        [data-theme="light"] .robot-chat-bubble .border-white-10 {
            border-color: rgba(88, 28, 28, 0.1) !important;
        }
        .robot-chat-bubble.open {
            display: block;
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all !important;
        }
        .ai-robot-floating.focused .robot-body {
            transform: scale(0.9);
            box-shadow: 0 0 50px var(--secondary) !important;
        }
        #robotInput {
            width: 100% !important;
            background: rgba(255,255,255,0.1) !important;
            border: 1px solid rgba(255,255,255,0.2) !important;
            color: white !important;
            border-radius: 15px !important;
            padding: 12px 15px !important;
            outline: none !important;
            transition: all 0.3s;
            font-size: 0.95rem;
            margin-top: 15px !important;
            display: block !important;
            pointer-events: all !important;
        }
        [data-theme="light"] #robotInput {
            background: rgba(88, 28, 28, 0.03) !important;
            border: 1px solid rgba(88, 28, 28, 0.2) !important;
            color: #581C1C !important;
        }
        #robotInput:focus {
            background: rgba(255,255,255,0.15) !important;
            border-color: var(--primary) !important;
            box-shadow: 0 0 15px var(--primary-glow) !important;
        }
        [data-theme="light"] #robotInput:focus {
            background: rgba(88, 28, 28, 0.05) !important;
            border-color: #581C1C !important;
            box-shadow: 0 0 15px rgba(88, 28, 28, 0.1) !important;
        }
        /* Fix for native dropdown (select option) visibility */
        select option {
            background-color: #1a1c24 !important;
            color: white !important;
        }
        .form-select:focus {
            box-shadow: 0 0 15px var(--primary-glow) !important;
            border-color: var(--primary) !important;
        }

        .rain-container {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 100% !important;
            overflow: hidden !important;
            z-index: 0 !important; /* Behind content */
            pointer-events: none !important;
        }
        .rain-icon {
            position: absolute !important;
            color: rgba(255, 255, 255, 0.4) !important; /* Maksimum gÃƒÂ¶rÃƒÂ¼nÃƒÂ¼rlÃƒÂ¼k */
            pointer-events: none !important;
            will-change: transform;
        }
        
        .content-wrapper {
            position: relative !important;
            z-index: 10 !important; /* Above rain */
        }
        .bg-vibrant-dark {
            background-color: var(--bg-dark) !important;
            color: var(--text-primary) !important;
            transition: background-color 0.4s ease, color 0.3s ease;
        }
        [data-theme="light"] body {
            background-color: #FDFCFB !important;
            color: #581C1C !important;
        }

        /* Visionary Component Styles */
        .btn-glow-premium {
            background: linear-gradient(135deg, #C5A059, #581C1C) !important;
            color: white !important;
            border: none !important;
            font-weight: 800 !important;
            box-shadow: 0 0 20px rgba(197, 160, 89, 0.4) !important;
            transition: all 0.3s ease !important;
            animation: pulse-glow-cyber 2s infinite !important;
        }
        .btn-glow-premium:hover {
            transform: scale(1.05) !important;
            box-shadow: 0 0 30px rgba(197, 160, 89, 0.6) !important;
        }
        @@keyframes pulse-glow-cyber {
            0% { box-shadow: 0 0 10px rgba(197, 160, 89, 0.4); }
            50% { box-shadow: 0 0 25px rgba(88, 28, 28, 0.7); }
            100% { box-shadow: 0 0 10px rgba(197, 160, 89, 0.4); }
        }
        @@keyframes pulse-active {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1.2); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }
        .login-item-student i { color: #581C1C; transition: 0.3s; }
        .login-item-instructor i { color: #581C1C; transition: 0.3s; }
        .login-item-admin i { color: #f59e0b; transition: 0.3s; }
        
        .login-item-student:hover { background: rgba(88, 28, 28, 0.15) !important; color: white !important; }
        .login-item-instructor:hover { background: rgba(88, 28, 28, 0.15) !important; color: white !important; }
        .login-item-admin:hover { background: rgba(245, 158, 11, 0.15) !important; color: white !important; }
        
        .login-item-student:hover i, .login-item-instructor:hover i, .login-item-admin:hover i { transform: scale(1.2); }

        .bg-glass-sm { background: rgba(255,255,255,0.05); backdrop-filter: blur(4px); }
        .btn-icon-sm { background: transparent; border: none; color: white; opacity: 0.8; transition: 0.3s; padding: 2px 5px; }
        .btn-icon-sm:hover { opacity: 1; transform: scale(1.2); color: #C5A059 !important; }

        /* User Role Button Vibrancy Fix */
        .btn-user-role-premium {
            background: #581C1C !important;
            color: #C5A059 !important;
            border: 2px solid #C5A059 !important;
            border-radius: 14px !important;
            padding: 8px 18px !important;
            font-weight: 900 !important;
            font-family: 'Outfit', sans-serif !important;
            box-shadow: 0 0 15px rgba(197, 160, 89, 0.3) !important;
            transition: 0.3s ease !important;
        }
        .btn-user-role-premium:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 0 25px rgba(197, 160, 89, 0.5) !important;
            color: white !important;
        }
        [data-theme="light"] .btn-user-role-premium {
            background: #C5A059 !important;
            color: #581C1C !important;
            border: 2px solid #581C1C !important;
            box-shadow: 0 5px 15px rgba(88, 28, 28, 0.15) !important;
        }
        [data-theme="light"] .btn-user-role-premium:hover {
            background: #581C1C !important;
            color: #C5A059 !important;
        }


