    <script>
        (function() {
            const savedLang = localStorage.getItem('language') || 'TR'; 
            document.documentElement.setAttribute('data-lang', savedLang);

            // Persistent Accessibility Modes
            if (localStorage.getItem('highContrast') === 'true') document.documentElement.classList.add('high-contrast');
            if (localStorage.getItem('dyslexiaMode') === 'true') document.documentElement.classList.add('dyslexia-mode');
        })();

        window.toggleContrast = function() {
            const isEnabled = document.documentElement.classList.toggle('high-contrast');
            localStorage.setItem('highContrast', isEnabled);
        }
        window.toggleDyslexia = function() {
            const isEnabled = document.documentElement.classList.toggle('dyslexia-mode');
            localStorage.setItem('dyslexiaMode', isEnabled);
        }
        window.openSoon = function(moduleName) {
            alert(moduleName + " modülü şu an geliştirme aşamasındadır. En kısa sürede aktif edilecektir.");
        }
        window.changeLanguage = function(lang) {
            const loader = document.getElementById('globalLoader');
            if (loader) {
                loader.style.opacity = '1';
                loader.style.width = '0%';
                setTimeout(() => { loader.style.width = '100%'; }, 10);
            }
            localStorage.setItem('language', lang);
            setTimeout(() => { location.reload(); }, 300);
        }

        // Text-to-Speech Logic
        let isReading = false;
        let speechInstance = null;

        window.toggleReadAloud = function() {
            if (isReading) {
                window.speechSynthesis.cancel();
                isReading = false;
                document.getElementById('readAloudBtn').querySelector('i').className = 'bi bi-megaphone';
                return;
            }

            const mainContent = document.querySelector('main') || document.body;
            const textToRead = mainContent.innerText;
            
            speechInstance = new SpeechSynthesisUtterance(textToRead);
            speechInstance.lang = 'tr-TR';
            speechInstance.rate = 1.0;
            
            speechInstance.onend = () => {
                isReading = false;
                document.getElementById('readAloudBtn').querySelector('i').className = 'bi bi-megaphone';
            };

            window.speechSynthesis.speak(speechInstance);
            isReading = true;
            document.getElementById('readAloudBtn').querySelector('i').className = 'bi bi-stop-circle-fill text-danger';
        }
    </script>
    <script>
        function applyLanguage(lang) {
            localStorage.setItem('language', lang);
            document.documentElement.setAttribute('data-lang', lang);
            
            const dict = translations[lang];
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) {
                    el.innerHTML = dict[key];
                }
            });

            document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
                const key = el.getAttribute('data-i18n-placeholder');
                if (dict[key]) {
                    el.placeholder = dict[key];
                }
            });

            // Update Active Language Indicator
            document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active-lang'));
            document.getElementById('lang-btn-' + lang)?.classList.add('active-lang');

            // Update Bot Placeholder if exists
            const robotInput = document.getElementById('robotInput');
            if (robotInput) robotInput.placeholder = dict['bot_placeholder'];
        }

        document.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('language') || 'TR';
            applyLanguage(savedLang);
        });
    </script>
