@{
    ViewData["Title"] = "Yetenek Radarı";
}

<div class="container py-5">
    <div class="glass-card p-5 text-center animate-fadeIn">
        <div class="radar-icon-wrapper mb-4">
            <div class="radar-pulse"></div>
            <i class="bi bi-radar display-1 text-primary"></i>
        </div>
        <h1 class="fw-bold mb-3">Yetenek Radarı</h1>
        <p class="lead text-muted mb-5">Öğrencilerimizin potansiyelini keşfedin, geleceğin yıldızlarını bugünden görün.</p>
        
        <div class="row g-4 text-start">
            <div class="col-md-4">
                <div class="card bg-glass border-0 p-3 h-100">
                    <h5 class="text-primary"><i class="bi bi-award me-2"></i> En İyi Sanatçılar</h5>
                    <p class="small text-muted">Sanal sergide en çok beğeni alan eser sahipleri.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-glass border-0 p-3 h-100">
                    <h5 class="text-success"><i class="bi bi-code-slash me-2"></i> Yazılım Dehaları</h5>
                    <p class="small text-muted">Kurs bitirme projelerinde üstün başarı gösterenler.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-glass border-0 p-3 h-100">
                    <h5 class="text-warning"><i class="bi bi-star-fill me-2"></i> Yükselen Yıldızlar</h5>
                    <p class="small text-muted">Eğitmenler tarafından özel olarak önerilen yetenekler.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .radar-icon-wrapper {
        position: relative;
        display: inline-block;
    }
    .radar-pulse {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100px;
        height: 100px;
        background: rgba(88, 28, 28, 0.2);
        border-radius: 50%;
        animation: radar-ping 2s infinite;
    }
    @@keyframes radar-ping {
        0% { transform: translate(-50%, -50%) scale(0.5); opacity: 1; }
        100% { transform: translate(-50%, -50%) scale(2.5); opacity: 0; }
    }
</style>


