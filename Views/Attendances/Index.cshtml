@model IEnumerable<HalkEgitimSistemi.Models.Course>
@{
    ViewData["Title"] = "Yoklama Yönetimi";
}

<div class="container py-5">
    <div class="page-header animate-fadeInDown">
        <div class="page-header-content">
            <div class="d-flex align-items-center">
                <div class="page-header-icon" style="background: var(--gradient-premium);">
                    <i class="bi bi-calendar-check-fill text-white"></i>
                </div>
                <div>
                    <h1 class="page-header-title" style="color: var(--primary) !important;">Yoklama Yönetimi</h1>
                    <p class="page-header-subtitle" style="color: var(--text-secondary) !important;">Kurs seçerek günlük yoklama işlemlerini gerçekleştirin.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 stagger-children">
        @foreach (var course in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="glass-card-static h-100 p-4 d-flex flex-column justify-content-between hover-lift" style="border: 1px solid var(--primary-glow) !important; background: rgba(197, 160, 89, 0.05) !important;">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge-premium" style="background: var(--secondary) !important; color: var(--primary) !important; border: 1px solid var(--primary) !important;">@course.Category?.CategoryName</span>
                            <i class="bi bi-journal-text fs-4" style="color: var(--primary);"></i>
                        </div>
                        <h4 style="font-family: 'Outfit'; font-weight: 800; color: var(--text-primary); margin-bottom: 1rem;">@course.CourseName</h4>
                        <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6;">@course.Description.Substring(0, Math.Min(course.Description.Length, 100))...</p>
                    </div>
                    
                    <div class="mt-4">
                        <a asp-action="Take" asp-route-courseId="@course.Id" class="btn btn-premium btn-warning-glow w-100">
                            <i class="bi bi-check2-square"></i> Yoklama Al
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
