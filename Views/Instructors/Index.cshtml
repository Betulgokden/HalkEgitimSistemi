@model IEnumerable<HalkEgitimSistemi.Models.Instructor>

@{
    ViewData["Title"] = "Eğitmen Kadromuz";
}


<div class="container py-5" style="position: relative; z-index: 10;">
    <!-- Hero Header -->
    <div class="animate-fadeInDown" style="padding: 3rem 0; margin-bottom: 3rem; text-align: center;">
        <span class="badge-premium badge-primary mb-3"><i class="bi bi-stars"></i> Uzman Kadro</span>
        <h1 style="font-family: 'Outfit', sans-serif; font-size: 2.8rem; font-weight: 900; margin-bottom: 0.8rem;">
            <span class="section-title-gradient">Uzman Eğitmenlerimiz</span>
        </h1>
        <p class="text-muted-premium mb-4" style="max-width: 600px; margin: 0 auto; font-size: 1.1rem; font-weight: 500;">
            Geleceği şekillendiren, alanında uzman eğitim kadromuzla tanışın. Her biri alanının en iyisi!
        </p>
        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-premium btn-primary-glow">
                <i class="bi bi-person-plus-fill"></i> Yeni Eğitmen Ekle
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state glass-card-static p-5 reveal-on-scroll">
            <div class="empty-state-icon">
                <i class="bi bi-people"></i>
            </div>
            <h3 style="color: var(--text-primary); font-weight: 700;">Henüz bir eğitmen kaydı bulunamadı.</h3>
            <p style="color: var(--text-muted);">Yöneticilerimiz eğitmen eklediğinde burada en güncel bilgileri göreceksiniz.</p>
        </div>
    }
    else
    {
        <div class="row g-5 stagger-children">
            @foreach (var item in Model) {
                <div class="col-md-6 col-lg-4">
                        <div class="instructor-card tilt-card h-100 p-5">
                            <!-- Avatar / Icon -->
                            <div class="instructor-avatar-modern mb-4" style="width: 80px; height: 80px; margin: 0 auto; background: linear-gradient(135deg, #C5A059, #581C1C); border-radius: 20px; display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; box-shadow: 0 10px 20px rgba(197, 160, 89, 0.3);">
                                <i class="bi bi-person-workspace"></i>
                            </div>
    
                            <h3 style="font-family: 'Outfit', sans-serif; font-weight: 900; margin-bottom: 0.5rem; font-size: 1.8rem; text-align: center;">@item.FullName</h3>
                        <p style="background: linear-gradient(135deg, #C5A059, #581C1C); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.85rem; font-weight: 800; text-align: center; margin-bottom: 2rem;">@item.Title</p>

                        <div class="d-flex flex-wrap gap-2 justify-content-center mb-5">
                            <span class="badge-premium py-2 px-3" style="background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; font-weight: 700;">
                                <i class="bi bi-book me-2"></i> @(item.Course?.CourseName ?? "Genel Branş")
                            </span>
                            
                            @{
                                var isBusy = (ViewBag.Availability as Dictionary<int, bool>)?[item.Id] ?? false;
                            }
                            @if (isBusy)
                            {
                                <span class="badge-premium py-2 px-3" style="background: rgba(239, 68, 68, 0.2); color: #ff4d4d; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px; font-weight: 700;">
                                    <i class="bi bi-clock-history me-2"></i> Derste
                                </span>
                            }
                            else
                            {
                                <span class="badge-premium py-2 px-3" style="background: rgba(197, 160, 89, 0.2); color: #C5A059; border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 12px; font-weight: 700;">
                                    <i class="bi bi-check-circle me-2"></i> Müsait
                                </span>
                            }
                        </div>

                        <div class="d-flex gap-3 mt-auto pt-4 border-top border-glass" style="border-top-color: rgba(255,255,255,0.1) !important;">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-premium btn-primary-glow flex-grow-1 py-3" style="background: linear-gradient(135deg, #C5A059, #581C1C) !important; color: #ffffff !important; border: none !important; font-weight: 800 !important; font-size: 1rem !important; border-radius: 15px !important; box-shadow: 0 10px 20px rgba(197, 160, 89, 0.4) !important; display: flex; align-items: center; justify-content: center; gap: 10px; text-decoration: none !important;">
                                <i class="bi bi-info-circle-fill"></i> DETAYLARI GÖR
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon btn-icon-primary" style="width: 55px; height: 55px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 15px; display: flex; align-items: center; justify-content: center; color: white; transition: all 0.3s ease;">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

