@model IEnumerable<HalkEgitimSistemi.Models.Instructor>

@{
    ViewData["Title"] = "Eğitmen Kadromuz";
}


<div class="container py-5" style="position: relative; z-index: 10;">
    <!-- Hero Header -->
    <div class="animate-fadeInDown" style="padding: 3rem 0; margin-bottom: 3rem; text-align: center;">
        <span class="badge-premium badge-primary mb-3"><i class="bi bi-stars"></i> Uzman Kadro</span>
        <h1 style="font-family: 'Outfit', sans-serif; font-size: 2.8rem; font-weight: 900; margin-bottom: 0.8rem;">
            <span class="section-title-gradient">Uzman Eğitmenlerimiz</span>
        </h1>
        <p class="text-muted-premium mb-4" style="max-width: 600px; margin: 0 auto; font-size: 1.1rem; font-weight: 500;">
            Geleceği şekillendiren, alanında uzman eğitim kadromuzla tanışın. Her biri alanının en iyisi!
        </p>
        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-premium btn-primary-glow">
                <i class="bi bi-person-plus-fill"></i> Yeni Eğitmen Ekle
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state glass-card-static p-5 reveal-on-scroll">
            <div class="empty-state-icon">
                <i class="bi bi-people"></i>
            </div>
            <h3 style="color: var(--text-primary); font-weight: 700;">Henüz bir eğitmen kaydı bulunamadı.</h3>
            <p style="color: var(--text-muted);">Yöneticilerimiz eğitmen eklediğinde burada en güncel bilgileri göreceksiniz.</p>
        </div>
    }
    else
    {
        <div class="row g-5 stagger-children">
            @foreach (var item in Model) {
                <div class="col-md-6 col-lg-4">
                        <div class="instructor-card h-100 p-5 position-relative overflow-hidden">
                            <!-- Avatar / Icon -->
                            <div class="instructor-avatar-modern mb-4">
                                <i class="bi bi-person-workspace"></i>
                            </div>
    
                            <h3 class="instructor-name">@item.FullName</h3>
                            <p class="instructor-title">@item.Title</p>

                            <div class="d-flex flex-wrap gap-2 justify-content-center mb-4 mt-2">
                                <span class="badge-premium py-2 px-3 instructor-badge-default">
                                    <i class="bi bi-book me-2"></i> @(item.Course?.CourseName ?? "Genel Branş")
                                </span>
                                
                                @{
                                    var isBusy = (ViewBag.Availability as Dictionary<int, bool>)?[item.Id] ?? false;
                                }
                                @if (isBusy)
                                {
                                    <span class="badge-premium py-2 px-3 instructor-badge-busy">
                                        <i class="bi bi-clock-history me-2"></i> Derste
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-premium py-2 px-3 instructor-badge-available">
                                        <i class="bi bi-check-circle me-2"></i> Müsait
                                    </span>
                                }
                            </div>

                            <div class="d-flex gap-3 mt-auto pt-4 instructor-actions-border">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn flex-grow-1 py-3 instructor-btn-details">
                                    <i class="bi bi-info-circle-fill"></i> DETAYLARI GÖR
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon instructor-btn-edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

<style>
    /* ORTAK KART STİLLERİ */
    .instructor-card {
        border-radius: 30px;
        transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.1) !important;
        box-shadow: 0 20px 40px rgba(0,0,0,0.2) !important;
    }
    .instructor-card:hover {
        transform: translateY(-15px) scale(1.02);
        box-shadow: 0 30px 60px rgba(0,0,0,0.4) !important;
    }
    .instructor-name {
        font-family: 'Outfit', sans-serif;
        font-weight: 900;
        margin-bottom: 0.5rem;
        font-size: 2rem;
        text-align: center;
        letter-spacing: -0.5px;
    }
    .instructor-title {
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.75rem;
        font-weight: 800;
        text-align: center;
        margin-bottom: 2rem;
        opacity: 0.8;
    }
    .instructor-avatar-modern {
        width: 100px; height: 100px; margin: 0 auto 1.5rem;
        border-radius: 28px; display: flex; align-items: center;
        justify-content: center; font-size: 2.5rem;
        transition: all 0.5s ease;
    }
    .instructor-card:hover .instructor-avatar-modern {
        transform: rotate(-5deg) scale(1.1);
    }

    /* GÜNDÜZ MODU (Modern Bej Cam) */
    [data-theme="light"] .instructor-card {
        background: rgba(253, 250, 241, 0.8) !important;
        border: 1px solid rgba(88, 28, 28, 0.1) !important;
    }
    [data-theme="light"] .instructor-name { color: #581C1C !important; }
    [data-theme="light"] .instructor-title { color: #8a2e2e !important; }
    [data-theme="light"] .instructor-avatar-modern {
        background: linear-gradient(135deg, #f5f0e1, #e2d3b3);
        color: #581C1C; 
        box-shadow: 0 10px 20px rgba(88, 28, 28, 0.05);
        border: 1px solid rgba(88, 28, 28, 0.1);
    }
    [data-theme="light"] .instructor-badge-default {
        background: rgba(88,28,28,0.05); color: #581C1C; border: 1px solid rgba(88,28,28,0.1); border-radius: 12px; font-weight: 700;
    }
    [data-theme="light"] .instructor-badge-busy {
        background: rgba(239, 68, 68, 0.1); color: #dc3545; border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 12px; font-weight: 700;
    }
    [data-theme="light"] .instructor-badge-available {
        background: rgba(16, 185, 129, 0.1); color: #198754; border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 12px; font-weight: 700;
    }
    [data-theme="light"] .instructor-actions-border { border-top: 1px solid rgba(88,28,28,0.05); }
    [data-theme="light"] .instructor-btn-details {
        background: linear-gradient(135deg, #581C1C, #3B0F0F) !important; 
        color: #C5A059 !important; 
        font-weight: 800; 
        border-radius: 18px; 
        box-shadow: 0 10px 20px rgba(88, 28, 28, 0.2);
    }
    [data-theme="light"] .instructor-btn-edit {
        width: 55px; height: 55px; background: #fff; border: 1px solid rgba(88,28,28,0.1); border-radius: 18px; display: flex; align-items: center; justify-content: center; color: #581C1C;
    }

    /* GECE MODU (Lüks Bordo Cam) */
    [data-theme="dark"] .instructor-card {
        background: linear-gradient(145deg, rgba(88, 28, 28, 0.4), rgba(59, 15, 15, 0.6)) !important;
        border: 1px solid rgba(197, 160, 89, 0.2) !important;
    }
    [data-theme="dark"] .instructor-name { color: #ffffff !important; }
    [data-theme="dark"] .instructor-title { color: #C5A059 !important; }
    [data-theme="dark"] .instructor-avatar-modern {
        background: rgba(197, 160, 89, 0.15);
        color: #C5A059; border: 1px solid rgba(197, 160, 89, 0.3);
    }
    [data-theme="dark"] .instructor-badge-default {
        background: rgba(255,255,255,0.05); color: #fdfaf1; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; font-weight: 700;
    }
    [data-theme="dark"] .instructor-badge-busy {
        background: rgba(239, 68, 68, 0.2); color: #ff8787; border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 12px; font-weight: 700;
    }
    [data-theme="dark"] .instructor-badge-available {
        background: rgba(197, 160, 89, 0.1); color: #C5A059; border: 1px solid rgba(197, 160, 89, 0.3); border-radius: 12px; font-weight: 700;
    }
    [data-theme="dark"] .instructor-actions-border { border-top: 1px solid rgba(197, 160, 89, 0.1); }
    [data-theme="dark"] .instructor-btn-details {
        background: linear-gradient(135deg, #C5A059, #A68041) !important; 
        color: #3B0F0F !important; 
        font-weight: 900; 
        border-radius: 18px; 
        box-shadow: 0 10px 20px rgba(197, 160, 89, 0.2);
    }
    [data-theme="dark"] .instructor-btn-edit {
        width: 55px; height: 55px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 18px; display: flex; align-items: center; justify-content: center; color: #C5A059;
    }
</style>

