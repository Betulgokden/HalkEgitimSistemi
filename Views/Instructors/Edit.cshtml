@model HalkEgitimSistemi.Models.Instructor

@{
    ViewData["Title"] = "Eğitmen Güncelle";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="glass-card-static animate-scaleIn overflow-hidden">
                <!-- Header -->
                <div style="padding: 2rem 2rem 1.5rem; border-bottom: 1px solid var(--border-glass); background: linear-gradient(135deg, rgba(79,70,229,0.1) 0%, rgba(139,92,246,0.05) 100%); text-align: center;">
                    <div class="instructor-avatar" style="width: 80px; height: 80px; margin-bottom: 1rem;">
                        <i class="bi bi-pencil-square" style="font-size: 2rem; color: var(--primary-light);"></i>
                    </div>
                    <h2 style="font-family: 'Outfit', sans-serif; font-weight: 800; margin: 0; color: var(--text-primary); font-size: 1.5rem;">Eğitmen Bilgilerini Güncelle</h2>
                    <p style="color: var(--text-muted); margin: 0.3rem 0 0; font-size: 0.85rem;">Eğitmen bilgilerinde gerekli değişiklikleri yapın.</p>
                </div>

                <!-- Form -->
                <div style="padding: 2rem;">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.85rem;"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="form-premium-group">
                            <label asp-for="FullName" class="form-premium-label">
                                <i class="bi bi-person me-1"></i>Ad Soyad
                            </label>
                            <input asp-for="FullName" class="form-premium-control" placeholder="Örn: Ahmet Yılmaz" />
                            <span asp-validation-for="FullName" class="field-validation-error"></span>
                        </div>

                        <div class="form-premium-group">
                            <label asp-for="Title" class="form-premium-label">
                                <i class="bi bi-briefcase me-1"></i>Ünvan
                            </label>
                            <input asp-for="Title" class="form-premium-control" placeholder="Örn: Kurum Müdürü veya Eğitmen" />
                            <span asp-validation-for="Title" class="field-validation-error"></span>
                        </div>

                        <div class="form-premium-group">
                            <label class="form-premium-label">
                                <i class="bi bi-camera me-1"></i>Yeni Profil Fotoğrafı Seç (Değiştirmek İstemiyorsanız Boş Bırakın)
                            </label>
                            <input type="file" name="imageFile" class="form-premium-control" accept="image/*" />
                            <span asp-validation-for="ImageUrl" class="field-validation-error"></span>
                            
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mt-2 text-muted" style="font-size: 0.85rem;">
                                    Mevcut Görsel: <a href="@Model.ImageUrl" target="_blank">Görüntüle</a>
                                </div>
                            }
                        </div>

                        <div class="form-premium-group">
                            <label asp-for="CourseId" class="form-premium-label">
                                <i class="bi bi-book me-1"></i>Hangi Kursun Hocası?
                            </label>
                            <select asp-for="CourseId" class="form-premium-control" asp-items="ViewBag.CourseId">
                                <option value="">--- Genel Görevli / İdare ---</option>
                            </select>
                            <span asp-validation-for="CourseId" class="field-validation-error"></span>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-premium btn-secondary-glass flex-fill justify-content-center">
                                <i class="bi bi-arrow-left"></i> Vazgeç
                            </a>
                            <button type="submit" class="btn btn-premium btn-primary-glow flex-fill justify-content-center">
                                <i class="bi bi-save"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
