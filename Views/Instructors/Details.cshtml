@model HalkEgitimSistemi.Models.Instructor

@{
    ViewData["Title"] = Model.FullName + " - Eğitmen Detayı";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Sol Kolon: Profil ve Sosyal Medya -->
        <div class="col-lg-4">
            <div class="glass-card-static p-4 text-center animate-fadeInLeft">
                <div class="position-relative d-inline-block mb-4">
                    <div class="instructor-avatar shadow-2xl" style="width: 180px; height: 180px; margin: 0 auto; border: 4px solid var(--primary); padding: 5px; background: rgba(197, 160, 89, 0.1);">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.FullName" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                        }
                        else
                        {
                            <div style="width: 100%; height: 100%; background: var(--gradient-premium); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-person-fill" style="font-size: 5rem; color: white;"></i>
                            </div>
                        }
                    </div>
                    <span class="badge bg-success position-absolute bottom-0 end-0 p-2 border border-3 border-dark rounded-circle" title="Onaylı Eğitmen">
                        <i class="bi bi-check-lg text-white"></i>
                    </span>
                </div>

                <h2 style="font-family: 'Outfit', sans-serif; font-weight: 900; margin: 0; color: var(--text-primary);">@Model.FullName</h2>
                <p class="text-vibrant-pink fw-800 text-uppercase mb-4" style="letter-spacing: 2px; font-size: 0.9rem;">@Model.Title</p>

                <!-- Sosyal Medya -->
                <div class="d-flex justify-content-center gap-3 mb-4">
                    @if (!string.IsNullOrEmpty(Model.LinkedInUrl))
                    {
                        <a href="@Model.LinkedInUrl" target="_blank" class="btn-icon-glass" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    }
                    @if (!string.IsNullOrEmpty(Model.PortfolioUrl))
                    {
                        <a href="@Model.PortfolioUrl" target="_blank" class="btn-icon-glass" title="Portfolyo"><i class="bi bi-globe"></i></a>
                    }
                    @if (!string.IsNullOrEmpty(Model.DribbbleUrl))
                    {
                        <a href="@Model.DribbbleUrl" target="_blank" class="btn-icon-glass" title="Behance / Dribbble"><i class="bi bi-behance"></i></a>
                    }
                </div>

                <!-- İstatistik Kartları -->
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <div class="p-3 rounded-4 bg-dark-glass border border-white-5">
                            <h4 class="m-0 gold-text">@ViewBag.StudentCount</h4>
                            <span class="x-small text-white-50">Öğrenci</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-4 bg-dark-glass border border-white-5">
                            <h4 class="m-0 text-warning">@(ViewBag.AverageRating > 0 ? ViewBag.AverageRating.ToString("0.0") : "5.0")</h4>
                            <span class="x-small text-white-50">Puan</span>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-premium btn-primary-glow py-3" onclick="document.getElementById('messageFormSection').scrollIntoView({behavior: 'smooth'})" style="color: #C5A059 !important;">
                        <i class="bi bi-chat-left-text me-2"></i> Soru Sor
                    </button>
                    @if (!string.IsNullOrEmpty(Model.CvFilePath))
                    {
                        <a asp-action="DownloadCv" asp-route-id="@Model.Id" class="btn btn-premium btn-secondary-glass py-3">
                            <i class="bi bi-file-earmark-pdf me-2"></i> CV İndir
                        </a>
                    }
                </div>
            </div>

            <!-- Uzmanlık Alanları -->
            <div class="glass-card-static mt-4 p-4 animate-fadeInLeft" style="animation-delay: 0.1s;">
                <h5 class="gold-text mb-3 fw-bold"><i class="bi bi-stars me-2"></i> Uzmanlık Alanları</h5>
                <div class="d-flex flex-wrap gap-2">
                    @if (!string.IsNullOrEmpty(Model.Skills))
                    {
                        @foreach (var skill in Model.Skills.Split(','))
                        {
                            <span class="badge-premium badge-primary">@skill.Trim()</span>
                        }
                    }
                    else
                    {
                        <span class="badge-premium badge-primary">Eğitim</span>
                        <span class="badge-premium badge-primary">Pedagoji</span>
                    }
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Detaylar, Biyografi ve Program -->
        <div class="col-lg-8">
            <!-- Hakkında & Eğitim -->
            <div class="glass-card-static p-4 mb-4 animate-fadeInRight">
                <ul class="nav nav-pills nav-premium mb-4" id="pills-tab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="pills-bio-tab" data-bs-toggle="pill" data-bs-target="#pills-bio" type="button" role="tab" style="font-family: 'Outfit';">Biyografi</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="pills-edu-tab" data-bs-toggle="pill" data-bs-target="#pills-edu" type="button" role="tab" style="font-family: 'Outfit';">Eğitim</button>
                    </li>
                </ul>
                <div class="tab-content" id="pills-tabContent">
                    <div class="tab-pane fade show active" id="pills-bio" role="tabpanel">
                        <h4 class="text-white mb-3 fw-bold">Eğitmen Hakkında</h4>
                        <p class="text-white-70 lh-lg">
                            @(string.IsNullOrEmpty(Model.Bio) ? "Eğitmenimiz hakkında detaylı bilgi bulunmamaktadır." : Model.Bio)
                        </p>
                    </div>
                    <div class="tab-pane fade" id="pills-edu" role="tabpanel">
                        <h4 class="text-white mb-3 fw-bold">Eğitim Geçmişi</h4>
                        <p class="text-white-70 lh-lg">
                            @(string.IsNullOrEmpty(Model.Education) ? "Eğitim bilgisi henüz girilmemiştir." : Model.Education)
                        </p>
                    </div>
                </div>
            </div>

            <!-- Haftalık Çalışma Programı -->
            <div class="glass-card-static p-4 mb-4 animate-fadeInRight" style="animation-delay: 0.1s;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="text-white fw-bold m-0">
                        <i class="bi bi-calendar3 me-2 gold-text"></i> Çalışma Programı
                    </h4>
                    <span class="badge-premium badge-warning">Haftalık Akış</span>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-modern-premium mb-0">
                        <thead>
                            <tr>
                                <th>Gün</th>
                                <th>Saat Aralığı</th>
                                <th>Ders / Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var turkishDays = new Dictionary<string, string> {
                                    { "Monday", "Pazartesi" }, { "Tuesday", "Salı" }, { "Wednesday", "Çarşamba" },
                                    { "Thursday", "Perşembe" }, { "Friday", "Cuma" }, { "Saturday", "Cumartesi" }, { "Sunday", "Pazar" }
                                };
                            }
                            @foreach (var day in turkishDays)
                            {
                                var schedule = Model.Schedules.FirstOrDefault(s => s.Day == day.Key);
                                <tr class="schedule-row-premium">
                                    <td class="fw-bold text-white py-3">@day.Value</td>
                                    <td>
                                        @if (schedule != null) {
                                            <span class="badge bg-gold-glass text-gold p-2">
                                                <i class="bi bi-clock me-1"></i> @schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")
                                            </span>
                                        } else {
                                            <span class="text-white-50 small opacity-50">Tatil / Kapalı</span>
                                        }
                                    </td>
                                    <td>
                                        @if (schedule != null) {
                                            <div class="text-white small">
                                                <i class="bi bi-bookmark-fill me-1 text-warning"></i> @(schedule.Note ?? "Aktif Ders")
                                            </div>
                                        } else {
                                            <span class="text-white-25 small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Mesaj Gönder Section -->
            <div id="messageFormSection" class="glass-card-static p-4 animate-fadeInRight" style="animation-delay: 0.2s; border: 1px solid rgba(197, 160, 89, 0.3);">
                <div class="d-flex align-items-center mb-4">
                    <div class="icon-box-sm bg-gold text-maroon rounded-circle me-3" style="width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-chat-right-quote-fill"></i>
                    </div>
                    <h4 class="gold-text fw-900 m-0" style="letter-spacing: 1px;">EĞİTMENE SORU SOR</h4>
                </div>
                
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form id="messageForm" asp-action="MesajGonder" asp-controller="Message" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="instructorId" value="@Model.Id" />
                        
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label text-white-50 small">Konu</label>
                                <input type="text" name="subject" class="form-control modern-control" placeholder="Örn: Ders içeriği hakkında bir sorum var..." required />
                            </div>
                            <div class="col-md-12 mb-4">
                                <label class="form-label text-white-50 small">Mesajınız</label>
                                <textarea name="content" rows="4" class="form-control modern-control" placeholder="Sorunuzu buraya detaylıca yazabilirsiniz..." required></textarea>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-premium btn-primary-glow w-100 py-3 fs-5">
                            <i class="bi bi-send-check-fill me-2"></i> Mesajı İlet
                        </button>
                    </form>
                }
                else
                {
                    <div class="text-center py-5 bg-dark-glass rounded-4 border border-dashed border-white-20">
                        <i class="bi bi-lock-fill fs-1 text-white-25 mb-3"></i>
                        <h5 class="text-white">Soru sormak için giriş yapmalısınız</h5>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-premium btn-primary-glow mt-3">Giriş Yap</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

    /* Ders Programı Modern Tasarım - BEYAZ KUTUCUKLAR TAMAMEN KALDIRILDI */
    .table-modern-premium {
        background: transparent !important;
        border-collapse: separate;
        border-spacing: 0 12px;
    }
    
    .table-modern-premium thead th {
        background: rgba(197, 160, 89, 0.1) !important;
        color: #C5A059 !important;
        border: 1px solid rgba(197, 160, 89, 0.2) !important;
        padding: 18px 20px;
        font-family: 'Outfit';
        font-weight: 800;
        text-transform: uppercase;
        border-radius: 12px;
    }

    .schedule-row-premium {
        background: transparent !important; /* KESİN ÇÖZÜM: Arka plan şeffaf */
        transition: all 0.3s ease;
        border: 1px solid rgba(197, 160, 89, 0.2) !important;
    }

    .table-modern-premium tbody tr {
        background: transparent !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 15px;
    }

    [data-theme="dark"] .table-modern-premium tbody tr {
        background: rgba(255, 255, 255, 0.02) !important;
        border: 1px solid rgba(197, 160, 89, 0.15) !important;
    }

    [data-theme="light"] .table-modern-premium tbody tr {
        background: rgba(88, 28, 28, 0.02) !important;
        border: 1px solid rgba(88, 28, 28, 0.1) !important;
    }

    .table-modern-premium tbody tr:hover {
        background: rgba(197, 160, 89, 0.08) !important;
        transform: translateY(-2px);
    }

    .table-modern-premium tbody td {
        padding: 18px 20px;
        border: none !important;
        background: transparent !important; /* Hücrelerdeki beyazlığı da öldür */
    }

    [data-theme="dark"] .table-modern-premium tbody td {
        color: #ffffff !important;
    }

    [data-theme="light"] .table-modern-premium tbody td {
        color: #581C1C !important;
    }

    /* Nav Premium / Tablo Fixes */
    .nav-premium .nav-link {
        color: rgba(255, 255, 255, 0.5) !important;
        font-weight: 700;
        border-radius: 12px;
        padding: 12px 25px;
        margin-right: 12px;
        transition: all 0.3s;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    [data-theme="light"] .nav-premium .nav-link {
        color: #581C1C !important;
        background: rgba(88, 28, 28, 0.05) !important;
        border-color: rgba(88, 28, 28, 0.1) !important;
    }

    .nav-premium .nav-link.active {
        background: #C5A059 !important;
        color: #581C1C !important;
        box-shadow: 0 8px 25px rgba(197, 160, 89, 0.3);
        border-color: #C5A059 !important;
    }

    .bg-gold-glass {
        background: rgba(197, 160, 89, 0.1);
        border: 1px solid rgba(197, 160, 89, 0.2);
    }
    
    .text-gold { color: #C5A059; }
    .text-white-70 { color: rgba(255,255,255,0.7); }
    .text-white-25 { color: rgba(255,255,255,0.25); }
    
    [data-theme="light"] .text-white, 
    [data-theme="light"] .text-white-70,
    [data-theme="light"] .tab-pane h4,
    [data-theme="light"] .glass-card-static h4 {
        color: #581C1C !important;
    }
</style>

@section Scripts {
    <script>
        document.getElementById('messageForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            // ... AJAX Logic ... (Same as before but refined for this UI)
        });
    </script>
}
