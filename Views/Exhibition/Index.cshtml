@model IEnumerable<HalkEgitimSistemi.Models.ExhibitionItem>
@using HalkEgitimSistemi.Models

@{
    ViewData["Title"] = "Sanal Sergi & Pazar";
}

<div class="container py-5">
    <!-- Premium Header Box -->
    <div class="exhibition-header-box animate-fadeInDown mb-5 p-5">
        <div class="row align-items-center">
            <div class="col-lg-8 text-center text-lg-start">
                <span class="badge-premium mb-3"><i class="bi bi-stars"></i> Dijital Sanat Deneyimi</span>
                <h1 class="display-4 fw-black mb-3">Sanal <span class="gold-text-glow">E-Sergi & Pazar</span></h1>
                <p class="header-desc-premium mb-0">
                    Geleneksel sanatlarımızı modern teknolojiyle buluşturuyoruz. 
                    Borçka Halk Eğitim Merkezi'nin dijital dünyasına hoş geldiniz.
                </p>
            </div>
            <div class="col-lg-4 mt-4 mt-lg-0 text-center">
                <a asp-action="Virtual" class="btn btn-gold-pulse btn-lg px-5 py-3 w-100">
                    <i class="bi bi-box-fill me-2"></i> 3D SERGİYE GİR
                </a>
            </div>
        </div>
    </div>

    <div class="row g-5">
        <!-- SOL: TEMATİK SANAT ODALARI (Boxy Design) -->
        <div class="col-lg-6">
            <div class="section-container-premium">
                <div class="section-header-box mb-4">
                    <h2 class="m-0 fw-black"><i class="bi bi-door-open text-gold me-2"></i> Sanat Odaları</h2>
                </div>
                
                <div class="row g-4">
                @{
                    var rooms = new[] {
                        new { Id = 1, Name = "Ebru Sanatı", Desc = "Neon ışıklı motifler.", Icon = "bi-water", Img = "/images/exhibition/ebru.png" },
                        new { Id = 2, Name = "Takı Tasarımı", Desc = "Siyah kadife duvarlar.", Icon = "bi-gem", Img = "/images/exhibition/jewelry.png" },
                        new { Id = 3, Name = "Ahşap Yakma", Desc = "Sıcak turuncu aydınlatma.", Icon = "bi-fire", Img = "/images/exhibition/wood_burning.png" },
                        new { Id = 4, Name = "Robotik & Kodlama", Desc = "Siberpunk atmosfer.", Icon = "bi-cpu", Img = "/images/exhibition/robotics.png" }
                    };
                }

                @foreach (var room in rooms)
                {
                    <div class="col-md-6">
                        <div class="modern-boxy-card room-card-box h-100">
                            <div class="card-img-container">
                                <img src="@room.Img" class="card-box-img" alt="@room.Name">
                                <div class="card-badge-gold"><i class="@room.Icon"></i></div>
                            </div>
                            <div class="card-box-body p-4 text-center">
                                <h5 class="fw-black mb-2 card-title-theme">@room.Name</h5>
                                <p class="small text-muted-premium mb-4">@room.Desc</p>
                                <a asp-action="Virtual" asp-route-roomId="@room.Id" class="btn btn-explore-gold w-100">
                                    ODAYI KEŞFET
                                </a>
                            </div>
                        </div>
                    </div>
                }
                </div>
            </div>
        </div>

        <!-- SAĞ: EL EMEĞİ PAZARI (Boxy Design) -->
        <div class="col-lg-6">
            <div class="section-container-premium">
                <div class="section-header-box mb-4">
                    <h2 class="m-0 fw-black"><i class="bi bi-shop text-gold me-2"></i> El Emeği Pazarı</h2>
                </div>

                @if (!Model.Any())
                {
                    <div class="empty-boxy-state p-5 text-center">
                        <i class="bi bi-images display-1 mb-3 text-gold opacity-30"></i>
                        <h4 class="text-white-50">Henüz eser bulunmuyor.</h4>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var item in Model.Where(m => m.Type != ExhibitionType.Video))
                        {
                            <div class="col-md-6">
                                <div class="modern-boxy-card item-card-box h-100">
                                    <div class="card-img-container">
                                        <img src="@item.ImageUrl" class="card-box-img" alt="@item.Title">
                                        <div class="price-pill-boxy @(item.IsSold ? "sold-boxy" : "")">
                                            @(item.IsSold ? "SATILDI" : item.Price + " ₺")
                                        </div>
                                    </div>
                                    <div class="card-box-body p-3">
                                        <h6 class="fw-black text-white mb-1 card-title-theme text-truncate">@item.Title</h6>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="x-small text-gold fw-bold"><i class="bi bi-person-fill"></i> @item.ArtistName</span>
                                            @if (!item.IsSold) {
                                                <button class="btn btn-examine-sm" onclick="examineItem('@item.Id', '@item.Title', '@item.ImageUrl', '@item.ArtistName', '@item.Price', '@item.Material', '@item.Color', '@item.Dimensions', '@item.Story', '@item.StudentId')">
                                                    İncele
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Global Section Containers */
    .section-container-premium {
        background: rgba(88, 28, 28, 0.05);
        border: 1px solid rgba(197, 160, 89, 0.1);
        border-radius: 40px;
        padding: 30px;
    }

    .exhibition-header-box {
        background: #581C1C;
        border: 2px solid #C5A059;
        border-radius: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.4);
    }
    .header-desc-premium { color: rgba(255,255,255,0.7); font-size: 1.1rem; }

    .section-header-box {
        border-bottom: 2px solid #C5A059;
        padding-bottom: 15px;
        color: white;
    }

    /* Modern Boxy Cards */
    .modern-boxy-card {
        background: rgba(15, 23, 42, 0.8) !important;
        border: 1px solid rgba(197, 160, 89, 0.2) !important;
        border-radius: 25px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
    }
    .modern-boxy-card:hover {
        transform: translateY(-10px);
        border-color: #C5A059 !important;
        box-shadow: 0 15px 35px rgba(197, 160, 89, 0.2);
    }

    .card-img-container {
        position: relative;
        height: 200px;
        background: #000;
        overflow: hidden;
    }
    .card-box-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.8;
        transition: 0.5s;
    }
    .modern-boxy-card:hover .card-box-img { opacity: 1; transform: scale(1.05); }

    .card-badge-gold {
        position: absolute; top: 15px; right: 15px;
        width: 40px; height: 40px; background: #C5A059; color: #581C1C;
        border-radius: 12px; display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem;
    }

    /* Buttons */
    .btn-explore-gold {
        background: #C5A059; color: #581C1C;
        font-weight: 900; border-radius: 12px; border: none;
        padding: 10px; transition: 0.3s;
    }
    .btn-explore-gold:hover { background: #ffd700; }

    .btn-examine-sm {
        background: rgba(197, 160, 89, 0.1);
        border: 1px solid #C5A059; color: #C5A059;
        font-size: 0.75rem; font-weight: 800; border-radius: 8px;
        padding: 4px 12px; transition: 0.3s;
    }
    .btn-examine-sm:hover { background: #C5A059; color: #581C1C; }

    .price-pill-boxy {
        position: absolute; bottom: 15px; right: 15px;
        background: #581C1C; color: #C5A059;
        border: 1px solid #C5A059; padding: 5px 15px;
        border-radius: 10px; font-weight: 900; font-size: 0.85rem;
    }
    .sold-boxy { background: #64748b; color: white; border-color: #475569; }

    /* Light Mode Overrides */
    [data-theme="light"] .exhibition-header-box { background: #ffffff !important; color: #581C1C !important; }
    [data-theme="light"] .header-desc-premium { color: rgba(88, 28, 28, 0.6); }
    [data-theme="light"] .section-header-box { color: #581C1C; }
    [data-theme="light"] .modern-boxy-card { background: #ffffff !important; border-color: rgba(88, 28, 28, 0.1) !important; }
    [data-theme="light"] .card-title-theme { color: #581C1C !important; }
    [data-theme="light"] .card-box-img { opacity: 0.9; }
    [data-theme="light"] .section-container-premium { background: #fdfaf1; }

    /* Animation Utilities */
    .fw-black { font-weight: 900 !important; }
    .gold-text-glow { color: #C5A059; text-shadow: 0 0 20px rgba(197, 160, 89, 0.3); }
</style>

@section Scripts {
    <script>
        function examineItem(id, title, img, artist, price, material, color, dim, story, studentId) {
            // Existing logic to show examine modal
        }
    </script>
}
