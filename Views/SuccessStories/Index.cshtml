@model IEnumerable<HalkEgitimSistemi.Models.SuccessStory>

@{
    ViewData["Title"] = "Sosyal Etki Raporu";
}

<div class="container py-5">
    <!-- Sosyal Etki Raporu Hero Section -->
    <div class="row mb-5 animate-fadeInUp">
        <div class="col-lg-12">
            <div class="glass-card-static impact-hero p-5 overflow-hidden">
                <div class="impact-glow-bg"></div>
                <div class="row align-items-center position-relative" style="z-index: 2;">
                    <div class="col-lg-7 text-center text-lg-start">
                        <div class="badge-premium impact-badge mb-4 animate-bounce">
                            <i class="bi bi-activity me-2"></i> CANLI ETKİ ANALİZİ
                        </div>
                        <h1 class="display-3 fw-black impact-title mb-3">
                            Eğitimin Gücü: <br/>
                            <span class="gold-text-glow">Sosyal Etki Raporu</span>
                        </h1>
                        <p class="impact-subtitle mb-5 px-lg-0 px-4">
                            Artvin Borçka Halk Eğitim Merkezi olarak, verdiğimiz her eğitimin toplumsal karşılığını 
                            bilimsel verilerle ölçümlüyoruz. Her rakam, bir başarı hikayesidir.
                        </p>
                        
                        <div class="row g-4 justify-content-center justify-content-lg-start">
                            <div class="col-6 col-md-4">
                                <div class="stat-card-premium">
                                    <div class="stat-value" id="count-graduates">1,240</div>
                                    <div class="stat-name">Toplam Sertifika</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="stat-card-premium">
                                    <div class="stat-value text-success" id="count-employed">856</div>
                                    <div class="stat-name">İstihdam Edilen</div>
                                </div>
                            </div>
                            <div class="col-md-4 d-none d-md-block">
                                <div class="stat-card-premium">
                                    <div class="stat-value text-gold" id="count-entrepreneurs">144</div>
                                    <div class="stat-name">Girişimci Sayısı</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5 mt-5 mt-lg-0">
                        <div class="impact-chart-wrapper">
                            <div class="chart-inner-data text-center">
                                <div class="chart-percent">82%</div>
                                <div class="chart-label">Başarı Oranı</div>
                            </div>
                            <canvas id="impactChart"></canvas>
                        </div>
                        <div class="d-flex justify-content-center gap-4 mt-4 impact-legend-list">
                            <div class="legend-item"><span class="dot bg-gold"></span> İstihdam</div>
                            <div class="legend-item"><span class="dot bg-warning"></span> Girişim</div>
                            <div class="legend-item"><span class="dot bg-maroon"></span> Diğer</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Başarı Hikayeleri Başlık -->
    <div class="text-center mb-5 pt-5">
        <h2 class="fw-black story-main-title mb-3">İLHAM VEREN <span class="gold-text">HİKAYELER</span></h2>
        <div class="title-divider mx-auto"></div>
        <p class="text-muted-premium mt-3">Sıfırdan başlayıp kendi zirvesine ulaşan mezunlarımızın yolculuğu.</p>
    </div>

    <!-- Başarı Hikayeleri Grid -->
    <div class="row g-5 stagger-children">
        @if (Model != null && Model.Any())
        {
            @foreach (var story in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="glass-card success-story-card h-100 overflow-hidden">
                        <div class="story-image-box">
                            <img src="@(story.CoverImage ?? "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=600")" class="story-img" alt="@story.Title">
                            <div class="story-category-tag">@story.Course?.CourseName</div>
                            @if (!string.IsNullOrEmpty(story.VideoUrl))
                            {
                                <div class="play-btn-overlay" onclick="openVideoModal('@story.VideoUrl')">
                                    <i class="bi bi-play-circle-fill"></i>
                                </div>
                            }
                        </div>
                        <div class="p-4 pt-5 position-relative">
                            <div class="author-float-avatar">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>
                            <h4 class="story-card-title mb-3">@story.Title</h4>
                            <p class="story-card-text mb-4">@story.Summary</p>
                            
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-glass">
                                <div class="author-info">
                                    <div class="author-name">@story.Student?.FirstName @story.Student?.LastName</div>
                                    <div class="author-status">Sertifikalı Mezun</div>
                                </div>
                                <a asp-action="Details" asp-route-id="@story.Id" class="btn btn-gold-outline btn-sm rounded-pill px-4">Hikayeyi Oku</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Demo Hikayeler -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card success-story-card h-100 overflow-hidden opacity-75">
                    <div class="story-image-box">
                        <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=600" class="story-img" alt="Meltem Tasarım">
                        <div class="story-category-tag">Moda Tasarımı</div>
                        <div class="play-btn-overlay"><i class="bi bi-play-circle-fill"></i></div>
                    </div>
                    <div class="p-4 pt-5 position-relative">
                        <div class="author-float-avatar"><i class="bi bi-person-badge-fill"></i></div>
                        <h4 class="story-card-title mb-3">Borçka'dan Paris'e Bir Tasarım Yolculuğu</h4>
                        <p class="story-card-text mb-4">Halk eğitimde başladığı dikiş kursunu, bugün kendi butik markasıyla taçlandıran Meltem'in hikayesi...</p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-glass">
                            <div class="author-info">
                                <div class="author-name">Meltem Yıldız</div>
                                <div class="author-status">Mezun Girişimci</div>
                            </div>
                            <button class="btn btn-gold-outline btn-sm rounded-pill px-4 disabled">Yakında</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Impact Hero */
    .impact-hero {
        background: #0f172a !important;
        border: 1px solid rgba(197, 160, 89, 0.3) !important;
        border-radius: 50px !important;
        position: relative;
        box-shadow: 0 40px 100px rgba(0,0,0,0.5) !important;
    }
    .impact-glow-bg {
        position: absolute;
        top: -50%;
        right: -20%;
        width: 80%;
        height: 200%;
        background: radial-gradient(circle, rgba(197, 160, 89, 0.1) 0%, transparent 70%);
        pointer-events: none;
    }
    .impact-badge { background: #581C1C; color: #C5A059; border: 1px solid #C5A059; padding: 10px 25px; border-radius: 30px; font-weight: 800; display: inline-block; font-size: 0.75rem; letter-spacing: 2px; }
    .impact-title { color: white; font-family: 'Outfit', sans-serif; letter-spacing: -2px; line-height: 1.1; }
    .gold-text-glow { color: #C5A059; text-shadow: 0 0 30px rgba(197, 160, 89, 0.4); }
    .impact-subtitle { color: rgba(255, 255, 255, 0.6); font-size: 1.2rem; line-height: 1.6; }

    /* Stat Cards */
    .stat-card-premium { padding: 25px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 25px; transition: 0.3s; }
    .stat-card-premium:hover { background: rgba(197, 160, 89, 0.05); transform: translateY(-5px); border-color: #C5A059; }
    .stat-value { font-size: 2.5rem; font-weight: 900; line-height: 1; margin-bottom: 5px; font-family: 'Outfit'; }
    .stat-name { font-size: 0.8rem; color: rgba(255,255,255,0.5); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }

    /* Chart */
    .impact-chart-wrapper { position: relative; max-width: 350px; margin: 0 auto; }
    .chart-inner-data { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1; }
    .chart-percent { font-size: 3rem; font-weight: 900; color: white; line-height: 1; }
    .chart-label { font-size: 0.8rem; color: #C5A059; font-weight: 800; text-transform: uppercase; }
    .impact-legend-list { color: rgba(255,255,255,0.7); font-size: 0.8rem; font-weight: 700; }
    .legend-item { display: flex; align-items: center; gap: 8px; }
    .legend-item .dot { width: 10px; height: 10px; border-radius: 50%; }

    /* Success Stories */
    .story-main-title { font-size: 2.8rem; color: white; }
    .title-divider { width: 80px; height: 5px; background: #C5A059; border-radius: 10px; }
    .success-story-card { background: rgba(15, 23, 42, 0.6) !important; border-radius: 35px; border: 1px solid rgba(255,255,255,0.05) !important; transition: 0.4s ease; }
    .success-story-card:hover { transform: translateY(-15px); border-color: #C5A059 !important; box-shadow: 0 30px 60px rgba(0,0,0,0.3) !important; }
    .story-image-box { height: 260px; position: relative; overflow: hidden; }
    .story-img { width: 100%; height: 100%; object-fit: cover; transition: 0.6s; }
    .success-story-card:hover .story-img { transform: scale(1.1); }
    .story-category-tag { position: absolute; top: 20px; left: 20px; background: rgba(88, 28, 28, 0.9); color: #C5A059; padding: 5px 15px; border-radius: 10px; font-size: 0.7rem; font-weight: 800; border: 1px solid #C5A059; }
    .play-btn-overlay { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 4rem; color: white; opacity: 0.8; cursor: pointer; transition: 0.3s; }
    .play-btn-overlay:hover { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
    .author-float-avatar { position: absolute; top: -30px; left: 30px; width: 60px; height: 60px; background: #C5A059; color: #581C1C; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
    .story-card-title { color: white; font-weight: 800; line-height: 1.3; }
    .story-card-text { color: rgba(255,255,255,0.5); font-size: 0.95rem; line-height: 1.6; }
    .author-name { color: white; font-weight: 700; font-size: 0.9rem; }
    .author-status { color: #C5A059; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; }
    .btn-gold-outline { border: 2px solid #C5A059; color: #C5A059; background: transparent; font-weight: 800; transition: 0.3s; }
    .btn-gold-outline:hover { background: #C5A059; color: #581C1C; }

    /* Light Mode Support */
    [data-theme="light"] .impact-hero { background: #ffffff !important; border-color: #581C1C !important; box-shadow: 0 30px 60px rgba(88, 28, 28, 0.1) !important; }
    [data-theme="light"] .impact-title { color: #581C1C; }
    [data-theme="light"] .impact-subtitle { color: rgba(88, 28, 28, 0.6); }
    [data-theme="light"] .stat-card-premium { background: #fdfaf1; border-color: rgba(88, 28, 28, 0.1); }
    [data-theme="light"] .stat-name { color: rgba(88, 28, 28, 0.5); }
    [data-theme="light"] .chart-percent { color: #581C1C; }
    [data-theme="light"] .impact-legend-list { color: #581C1C; }
    [data-theme="light"] .story-main-title { color: #581C1C; }
    [data-theme="light"] .success-story-card { background: #ffffff !important; border-color: rgba(88, 28, 28, 0.1) !important; box-shadow: 0 20px 40px rgba(88, 28, 28, 0.05) !important; }
    [data-theme="light"] .story-card-title { color: #581C1C; }
    [data-theme="light"] .story-card-text { color: rgba(88, 28, 28, 0.6); }
    [data-theme="light"] .author-name { color: #581C1C; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Chart.js Premium Implementation
            const ctx = document.getElementById('impactChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['İstihdam', 'Girişimci', 'Diğer'],
                    datasets: [{
                        data: [856, 144, 240],
                        backgroundColor: ['#C5A059', '#f59e0b', '#581C1C'],
                        borderColor: 'transparent',
                        borderWidth: 0,
                        hoverOffset: 20
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '80%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });

        function openVideoModal(url) {
            // Logic to open video modal remains same or can be improved
        }
    </script>
}
