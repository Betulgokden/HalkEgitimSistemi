@model IEnumerable<HalkEgitimSistemi.Models.SuccessStory>

@{
    ViewData["Title"] = "Başarı Hikayeleri";
}

<div class="container py-5">
    <!-- İstatistik Panosu (Modernize) -->
    <div class="row mb-5 animate-fadeInUp">
        <div class="col-lg-12">
            <div class="glass-card-static p-5" style="border-radius: 40px;">
                <div class="row align-items-center">
                    <div class="col-md-7">
                        <span class="badge-premium badge-primary mb-3"><i class="bi bi-graph-up-arrow me-2"></i> Canlı Sosyal Etki Verileri</span>
                        <h2 class="display-5 fw-bold text-white mb-4" style="font-family: 'Outfit', sans-serif; letter-spacing: -1px;">
                            Eğitimin Gücü: <span class="section-title-gradient">Sosyal Etki Raporu</span>
                        </h2>
                        <p class="text-muted-premium fs-5 mb-5">Kursiyerlerimizin mezuniyet sonrası başarılarını canlı verilerle takip ediyoruz. Her bir rakam, değişen bir hayatı temsil ediyor.</p>
                        
                        <div class="row mt-4 g-4">
                            <div class="col-md-4">
                                <div class="stat-box-modern">
                                    <div class="stat-number-modern">@ViewBag.TotalGraduates</div>
                                    <div class="stat-label-modern">Toplam Sertifika</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stat-box-modern">
                                    <div class="stat-number-modern" style="background: linear-gradient(135deg, #C5A059, #34d399); -webkit-background-clip: text;">@ViewBag.EmployedCount</div>
                                    <div class="stat-label-modern">İstihdam Edilen</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stat-box-modern">
                                    <div class="stat-number-modern" style="background: linear-gradient(135deg, #f59e0b, #fbbf24); -webkit-background-clip: text;">@ViewBag.BusinessCount</div>
                                    <div class="stat-label-modern">Girişimci Sayısı</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="chart-container-premium p-4 bg-glass rounded-circle" style="max-width: 380px; margin: 0 auto; border: 1px solid rgba(255,255,255,0.05); box-shadow: 0 0 50px rgba(197, 160, 89, 0.15);">
                            <canvas id="impactChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Başarı Hikayeleri Grid (Modernize) -->
    <div class="row g-5 stagger-children">
        @foreach (var story in Model)
        {
            <div class="col-md-4">
                <div class="glass-card story-card h-100 p-0 overflow-hidden" style="border-radius: 35px;">
                    <div class="position-relative">
                        <img src="@(story.CoverImage ?? "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=600")" class="img-fluid w-100" style="height: 240px; object-fit: cover;" alt="@story.Title">
                        <div class="card-image-overlay" style="position: absolute; bottom: 0; left: 0; right: 0; height: 50%; background: linear-gradient(to top, rgba(15, 23, 42, 0.9), transparent);"></div>
                        @if (!string.IsNullOrEmpty(story.VideoUrl))
                        {
                            <div class="video-play-btn" onclick="openVideoModal('@story.VideoUrl')">
                                <i class="bi bi-play-fill"></i>
                            </div>
                        }
                    </div>
                    <div class="p-5">
                        <span class="badge-premium badge-primary mb-3"><i class="bi bi-mortarboard me-2"></i> @story.Course?.CourseName</span>
                        <h4 class="fw-bold text-white mb-3" style="font-family: 'Outfit', sans-serif; font-size: 1.6rem; line-height: 1.3;">@story.Title</h4>
                        <p class="text-muted-premium small mb-4" style="line-height: 1.6;">@story.Summary</p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top border-glass">
                            <div class="d-flex align-items-center">
                                <div class="avatar-inner me-3" style="width: 40px; height: 40px; font-size: 1rem; border-radius: 12px;">
                                    <i class="bi bi-person-check"></i>
                                </div>
                                <span class="small fw-bold text-white">@story.Student?.FirstName @story.Student?.LastName</span>
                            </div>
                            <a asp-action="Details" asp-route-id="@story.Id" class="btn btn-premium btn-secondary-glass btn-sm px-4">İncele</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Video Modal -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark border-glass">
            <div class="modal-header border-0">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9">
                    <iframe id="videoIframe" src="" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .story-card {
        transition: all 0.3s ease;
    }
    .story-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(197, 160, 89, 0.2);
    }
    .video-play-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60px;
        height: 60px;
        background: var(--primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 20px rgba(197, 160, 89, 0.5);
    }
    .video-play-btn:hover {
        transform: translate(-50%, -50%) scale(1.1);
        background: var(--primary-light);
    }
    .stat-item {
        padding: 1rem;
        background: rgba(255,255,255,0.03);
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.05);
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Chart.js Implementasyonu
    const ctx = document.getElementById('impactChart').getContext('2d');
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['İstihdam', 'Girişimci', 'Diğer'],
            datasets: [{
                data: [@ViewBag.EmployedCount, @ViewBag.BusinessCount, @(ViewBag.TotalGraduates - ViewBag.EmployedCount - ViewBag.BusinessCount)],
                backgroundColor: ['#C5A059', '#f59e0b', '#581C1C'],
                borderWidth: 0,
                hoverOffset: 10
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { color: 'rgba(255,255,255,0.7)', font: { size: 10 } }
                }
            },
            cutout: '70%'
        }
    });

    function openVideoModal(url) {
        let embedUrl = url;
        if (url.includes("watch?v=")) embedUrl = url.replace("watch?v=", "embed/");
        else if (url.includes("youtu.be/")) embedUrl = url.replace("youtu.be/", "youtube.com/embed/");
        
        document.getElementById('videoIframe').src = embedUrl;
        var myModal = new bootstrap.Modal(document.getElementById('videoModal'));
        myModal.show();
    }

    document.getElementById('videoModal').addEventListener('hidden.bs.modal', function () {
        document.getElementById('videoIframe').src = '';
    });
</script>


