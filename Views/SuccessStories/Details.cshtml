@model HalkEgitimSistemi.Models.SuccessStory

@{
    ViewData["Title"] = Model.Title;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/img-comparison-slider@8/dist/styles.css" />
<script defer src="https://cdn.jsdelivr.net/npm/img-comparison-slider@8/dist/index.js"></script>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-primary-theme">Başarı Hikayeleri</a></li>
                    <li class="breadcrumb-item active text-white-50" aria-current="page">@Model.Title</li>
                </ol>
            </nav>

            <div class="glass-card-static p-4 p-md-5 animate-fadeInUp">
                <div class="mb-4 text-center">
                    <span class="badge-premium badge-primary mb-3">@Model.Course?.CourseName</span>
                    <h1 class="display-5 fw-bold text-primary-theme">@Model.Title</h1>
                    <p class="text-muted">Yayınlanma: @Model.CreatedAt.ToString("dd MMMM yyyy")</p>
                </div>

                <!-- Before / After Slider (Şov Başlasın) -->
                @if (!string.IsNullOrEmpty(Model.BeforeImage) && !string.IsNullOrEmpty(Model.AfterImage))
                {
                    <div class="mb-5">
                        <h4 class="text-primary-theme fw-bold mb-3"><i class="bi bi-magic me-2"></i>Değişimin Gücü (Öncesi / Sonrası)</h4>
                        <div class="slider-container rounded-4 overflow-hidden border-glass">
                            <img-comparison-slider>
                                <img slot="first" src="@Model.BeforeImage" style="width: 100%;" />
                                <img slot="second" src="@Model.AfterImage" style="width: 100%;" />
                            </img-comparison-slider>
                        </div>
                        <div class="d-flex justify-content-between mt-2 text-muted small px-2">
                            <span><i class="bi bi-arrow-left"></i> Kurs Öncesi</span>
                            <span>Kurs Sonrası <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </div>
                }

                <div class="story-content text-white-50 lead mb-5" style="white-space: pre-line;">
                    @Model.Content
                </div>

                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <div class="mb-5">
                        <h4 class="text-primary-theme fw-bold mb-3"><i class="bi bi-play-circle me-2"></i>Video Röportaj</h4>
                        <div class="ratio ratio-16x9 rounded-4 overflow-hidden border-glass shadow-lg">
                            <iframe src="@Model.VideoUrl" title="Başarı Hikayesi Videosu" allowfullscreen></iframe>
                        </div>
                    </div>
                }

                <div class="border-top border-glass pt-4 mt-5 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="avatar me-3" style="width: 60px; height: 60px; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem; font-weight: bold;">
                            @(Model.Student?.FirstName?[0])@(Model.Student?.LastName?[0])
                        </div>
                        <div>
                            <h6 class="mb-0 text-white">@Model.Student?.FirstName @Model.Student?.LastName</h6>
                            <small class="text-muted">@Model.Course?.CourseName Mezunu</small>
                        </div>
                    </div>
                    <div class="share-btns">
                        <button class="btn btn-icon-glass"><i class="bi bi-linkedin"></i></button>
                        <button class="btn btn-icon-glass ms-2"><i class="bi bi-twitter"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .slider-container img-comparison-slider {
        --divider-width: 4px;
        --divider-color: var(--primary);
        --default-handle-width: 50px;
        width: 100%;
        outline: none;
    }
    .story-content {
        line-height: 1.8;
    }
    .btn-icon-glass {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }
    .btn-icon-glass:hover {
        background: var(--primary);
        color: white;
        transform: translateY(-3px);
    }
</style>
