@{
    ViewData["Title"] = "Açık Veri & İstatistik";
}

<div class="container py-5 mt-5">
    <div class="row mb-5 text-center">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-white mb-3" style="font-family: 'Outfit', sans-serif;">Açık Veri Portalı</h1>
            <p class="text-white-50">Åeffaf yönetim anlayışımızla tüm eğitim verilerimizi toplumla paylaşıyoruz.</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="glass-stat-card p-4 text-center">
                <div class="fs-1 text-primary mb-2"><i class="bi bi-people-fill"></i></div>
                <h2 class="fw-bold text-white">45.2K</h2>
                <small class="text-white-50">Toplam Mezun</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-stat-card p-4 text-center">
                <div class="fs-1 text-success mb-2"><i class="bi bi-journal-check"></i></div>
                <h2 class="fw-bold text-white">1,240</h2>
                <small class="text-white-50">Aktif Kurs</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-stat-card p-4 text-center">
                <div class="fs-1 text-info mb-2"><i class="bi bi-geo-alt-fill"></i></div>
                <h2 class="fw-bold text-white">12</h2>
                <small class="text-white-50">Eğitim Merkezi</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-stat-card p-4 text-center">
                <div class="fs-1 text-warning mb-2"><i class="bi bi-star-fill"></i></div>
                <h2 class="fw-bold text-white">4.8</h2>
                <small class="text-white-50">Memnuniyet Oranı</small>
            </div>
        </div>
    </div>

    <div class="glass-card-static p-5 mb-5 border-glass">
        <h4 class="text-white fw-bold mb-4"><i class="bi bi-bar-chart-line me-2 text-primary"></i> Kurs Kategorisi Dağılımı</h4>
        <div class="progress-stack mb-4" style="height: 30px; display: flex; border-radius: 15px; overflow: hidden;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: 40%" title="Yazılım"></div>
            <div class="progress-bar bg-success" role="progressbar" style="width: 25%" title="Sanat"></div>
            <div class="progress-bar bg-info" role="progressbar" style="width: 20%" title="Dil"></div>
            <div class="progress-bar bg-warning" role="progressbar" style="width: 15%" title="Diğer"></div>
        </div>
        <div class="d-flex flex-wrap gap-4 small text-white-50 justify-content-center">
            <span><i class="bi bi-circle-fill text-primary me-1"></i> Yazılım %40</span>
            <span><i class="bi bi-circle-fill text-success me-1"></i> Sanat %25</span>
            <span><i class="bi bi-circle-fill text-info me-1"></i> Dil %20</span>
            <span><i class="bi bi-circle-fill text-warning me-1"></i> Diğer %15</span>
        </div>
    </div>
</div>

<style>
    .glass-stat-card { background: rgba(255,255,255,0.03); backdrop-filter: blur(15px); border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); transition: 0.3s; }
    .glass-stat-card:hover { transform: translateY(-5px); background: rgba(255,255,255,0.07); }
    .glass-card-static { background: rgba(255,255,255,0.03); backdrop-filter: blur(20px); border-radius: 24px; border: 1px solid rgba(255,255,255,0.1); }
    .border-glass { border: 1px solid rgba(255,255,255,0.1); }
</style>

