@{
    ViewData["Title"] = "Sertifika Doğrulama Sistemi";
}

<div class="container py-5" style="min-height: 75vh; display: flex; align-items: center; justify-content: center;">
    <div class="row w-100 justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div id="verifyCard" class="glass-card-static animate-fadeInUp p-5 text-center position-relative overflow-hidden">
                <!-- Decorative element -->
                <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: radial-gradient(circle, var(--success) 0%, transparent 70%); opacity: 0.1; filter: blur(20px);"></div>
                
                <div class="section-icon mx-auto mb-4" style="width: 80px; height: 80px; font-size: 2.5rem; background: rgba(16,185,129,0.15); color: var(--success); border: 2px solid rgba(16,185,129,0.3);">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                
                <h2 style="font-family: 'Outfit', sans-serif; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem;">
                    Sertifika <span style="background: var(--gradient-success); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Doğrulama</span>
                </h2>
                <p style="color: var(--text-muted); margin-bottom: 2.5rem;">
                    Kurumumuzdan aldığınız sertifikaların orijinalliğini e-Devlet benzeri altyapımızla ücretsiz sorgulayabilirsiniz.
                </p>

                <div id="errorAlert" style="display: none; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: var(--radius-lg); padding: 1rem; margin-bottom: 2rem; color: var(--danger);">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><span id="errorMessage"></span>
                </div>

                <form id="verifyForm">
                    <div class="form-premium-group mb-4" style="text-align: left;">
                        <label class="form-premium-label" style="text-align: center; display: block; margin-bottom: 1rem;">Sertifika Kodunu Giriniz</label>
                        <div style="position: relative;">
                            <i class="bi bi-qr-code position-absolute" style="top: 50%; left: 1.5rem; transform: translateY(-50%); color: var(--success); font-size: 1.5rem;"></i>
                            <input type="text" name="certificateCode" id="certCodeInput" class="form-premium-control text-center" style="padding-left: 4rem; font-size: 1.5rem; font-family: monospace; letter-spacing: 0.15rem; font-weight: 700; height: 70px; text-transform: uppercase;" placeholder="HE-2026-XXXX" required autofocus />
                        </div>
                        <div class="text-center mt-2" style="font-size: 0.8rem; color: var(--text-secondary);">Örnek format: HE-2026-0001</div>
                    </div>
                    
                    <button type="submit" class="btn btn-premium btn-success-glow btn-lg w-100" style="height: 60px; font-size: 1.1rem; letter-spacing: 0.05em;">
                        <i class="bi bi-shield-check me-2 fs-5"></i> Belgeyi Doğrula
                    </button>
                </form>
            </div>

            <!-- Terminal Illusion -->
            <div id="terminalBox" style="display: none; background: #0a0a0a; border: 1px solid #333; border-radius: 12px; padding: 20px; font-family: 'JetBrains Mono', monospace; color: #00ff00; font-size: 0.9rem; min-height: 200px; box-shadow: 0 20px 40px rgba(0,0,0,0.5); position: relative; overflow: hidden;">
                <div style="display: flex; gap: 6px; margin-bottom: 15px;">
                    <div style="width: 12px; height: 12px; background: #ff5f56; border-radius: 50%;"></div>
                    <div style="width: 12px; height: 12px; background: #ffbd2e; border-radius: 50%;"></div>
                    <div style="width: 12px; height: 12px; background: #27c93f; border-radius: 50%;"></div>
                </div>
                <div id="terminalContent"></div>
                <div class="cursor" style="display: inline-block; width: 8px; height: 15px; background: #00ff00; margin-left: 5px; animation: blink 1s infinite;"></div>
            </div>
            
            <!-- Information Footer -->
            <div id="infoFooter" class="text-center mt-4 p-3 animate-fadeInUp delay-200" style="background: var(--bg-glass); border-radius: var(--radius-md); border: 1px dashed var(--border-glass);">
                <div class="d-flex align-items-center justify-content-center gap-2" style="color: var(--text-secondary); font-size: 0.85rem;">
                    <i class="bi bi-info-circle-fill" style="color: var(--primary-light);"></i>
                    Sertifikanızın altındaki barkodun altında yer alan kodu eksiksiz giriniz.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes blink { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
    .terminal-line { margin-bottom: 8px; display: block; }
    .terminal-hash { color: #aaa; font-size: 0.8rem; word-break: break-all; }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#verifyForm').on('submit', function(e) {
                e.preventDefault();
                const code = $('#certCodeInput').val();
                
                $('#verifyCard').fadeOut(400, function() {
                    $('#terminalBox').fadeIn(400);
                    runTerminal(code);
                });
            });

            async function runTerminal(code) {
                const content = $('#terminalContent');
                const addLine = (text, cls = '') => {
                    content.append(`<span class="terminal-line ${cls}">${text}</span>`);
                };

                addLine("> INITIALIZING DEEP FORENSIC ANALYSIS...");
                await sleep(1200);
                
                addLine("> SCANNING FOR FAKE DOCUMENT MARKERS...");
                await sleep(1500);

                addLine("> BLOCKCHAIN LEDGER CROSS-REFERENCE IN PROGRESS...");
                
                $.ajax({
                    url: '/Certificate/Verify',
                    type: 'POST',
                    data: { certificateCode: code },
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: async function(response) {
                        if (response.success) {
                            await sleep(1000);
                            addLine("> RECORD LOCATED. GENERATING CRYPTOGRAPHIC PROOF...", "text-info");
                            await sleep(1200);
                            addLine("> DIGITAL SEAL IDENTIFIED:", "text-premium");
                            addLine(response.hash, "terminal-hash");
                            await sleep(1500);
                            addLine("> INTEGRITY CHECK PASSED! NO TAMPERING DETECTED.", "text-success fw-bold");
                            await sleep(800);
                            addLine("> REDIRECTING TO SECURE VIEW...", "text-warning");
                            await sleep(1000);
                            window.location.href = response.redirectUrl;
                        } else {
                            addLine("> CRITICAL ERROR: " + response.message, "text-danger fw-bold");
                            await sleep(3000);
                            resetForm(response.message);
                        }
                    },
                    error: function() {
                        addLine("> SYSTEM ERROR: CONNECTION FAILED.", "text-danger");
                        sleep(2000).then(() => resetForm("Sunucu hatası oluştu."));
                    }
                });
            }

            function sleep(ms) { return new Promise(resolve => setTimeout(resolve, ms)); }

            function resetForm(error) {
                $('#terminalBox').fadeOut(400, function() {
                    $('#terminalContent').empty();
                    $('#errorMessage').text(error);
                    $('#errorAlert').show();
                    $('#verifyCard').fadeIn(400);
                });
            }
        });
    </script>
}
