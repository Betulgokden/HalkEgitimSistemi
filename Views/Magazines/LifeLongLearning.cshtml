@{
    ViewData["Title"] = "Yaşam Boyu Öğrenme Dergisi";
    Layout = "_Layout";
}

<div class="magazine-container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold gradient-text">Yaşam Boyu Öğrenme</h1>
        <p class="lead text-muted">Halk Eğitim Merkezi Özel Sayısı</p>
    </div>

    <!-- Magazine FlipBook Wrapper -->
    <div class="flipbook-wrapper">
        <div class="magazine-book">
            <!-- Page 1: Cover -->
            <div class="magazine-page cover-page">
                <div class="page-content">
                    <img src="/images/magazine_cover_lifelong_learning_1778191714694.png" alt="Cover">
                </div>
            </div>

            <!-- Page 2: Computer & Kitchen -->
            <div class="magazine-page">
                <div class="page-content">
                    <img src="/images/magazine_panel_computer_kitchen_1778191739703.png" alt="Computer and Kitchen">
                    <div class="page-overlay">
                        <h2>Teknoloji ve Lezzet</h2>
                        <p>Bilgisayar Okuryazarlığı ve Mutfak Sanatları ile geleceğe adım atın.</p>
                    </div>
                </div>
            </div>

            <!-- Page 3: Traditional Music (Saz) -->
            <div class="magazine-page">
                <div class="page-content">
                    <img src="/images/magazine_panel_saz_music_1778191765113.png" alt="Saz Course">
                    <div class="page-overlay">
                        <h2>Geleneksel Müzik</h2>
                        <p>Saz kurslarımız ile özümüzden gelen ezgileri keşfedin.</p>
                    </div>
                </div>
            </div>

            <!-- Page 4: Wood Carving -->
            <div class="magazine-page">
                <div class="page-content">
                    <img src="/images/magazine_panel_wood_carving_1778191790537.png" alt="Wood Carving">
                    <div class="page-overlay">
                        <h2>Ahşap Oymacılığı</h2>
                        <p>Toprağın ve ağacın hikayesini ellerinizle yazın.</p>
                    </div>
                </div>
            </div>

            <!-- Page 5: Fashion and Textile -->
            <div class="magazine-page">
                <div class="page-content">
                    <img src="/images/magazine_panel_fashion_textile_1778191815376.png" alt="Fashion and Textile">
                    <div class="page-overlay">
                        <h2>Moda ve Tekstil</h2>
                        <p>Kendi stilinizi yaratın, tekstil dünyasında fark yaratın.</p>
                    </div>
                </div>
            </div>

            <!-- Page 6: Western Music -->
            <div class="magazine-page">
                <div class="page-content">
                    <img src="/images/magazine_panel_western_music_1778191843182.png" alt="Western Music">
                    <div class="page-overlay">
                        <h2>Batı Müziği</h2>
                        <p>Gitar ve keman ile müziğin evrensel dilini öğrenin.</p>
                    </div>
                </div>
            </div>

            <!-- Page 7: Healthy Living & Yoga -->
            <div class="magazine-page">
                <div class="page-content">
                    <img src="/images/magazine_panel_sport_yoga_1778191880090.png" alt="Yoga">
                    <div class="page-overlay">
                        <h2>Sağlıklı Yaşam</h2>
                        <p>Yoga ve spor ile zihninizi ve bedeninizi tazeleyin.</p>
                    </div>
                </div>
            </div>

            <!-- Page 8: Back Cover -->
            <div class="magazine-page back-page">
                <div class="page-content">
                    <img src="/images/magazine_back_cover_art_1778191924204.png" alt="Back Cover">
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Controls -->
    <div class="d-flex justify-content-center gap-4 mt-5">
        <button id="prevPage" class="btn btn-premium btn-dark-glass rounded-pill px-4">
            <i class="bi bi-chevron-left me-2"></i>Önceki Sayfa
        </button>
        <button id="nextPage" class="btn btn-premium btn-primary-glow rounded-pill px-4">
            Sonraki Sayfa <i class="bi bi-chevron-right ms-2"></i>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const pages = document.querySelectorAll('.magazine-page');
            let currentPage = 0;

            function updatePages() {
                pages.forEach((page, index) => {
                    if (index < currentPage) {
                        page.classList.add('flipped');
                    } else {
                        page.classList.remove('flipped');
                    }
                });
            }

            document.getElementById('nextPage').addEventListener('click', () => {
                if (currentPage < pages.length - 1) {
                    currentPage++;
                    updatePages();
                }
            });

            document.getElementById('prevPage').addEventListener('click', () => {
                if (currentPage > 0) {
                    currentPage--;
                    updatePages();
                }
            });
        });
    </script>
}

<style>
    .magazine-container {
        min-height: 90vh;
        background: var(--bg-primary);
    }

    .flipbook-wrapper {
        perspective: 1500px;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 600px;
    }

    .magazine-book {
        width: 400px;
        height: 550px;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.5s ease;
    }

    .magazine-page {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        transform-origin: left center;
        transition: transform 0.8s cubic-bezier(0.645, 0.045, 0.355, 1);
        transform-style: preserve-3d;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        cursor: pointer;
        z-index: calc(10 - var(--index));
    }

    .magazine-page.flipped {
        transform: rotateY(-180deg);
        z-index: var(--index);
    }

    .page-content {
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .page-content img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .page-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0,0,0,0.8));
        padding: 30px 20px;
        color: white;
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .magazine-page:not(.flipped) .page-overlay {
        opacity: 1;
    }

    .page-overlay h2 { font-size: 1.5rem; font-weight: 800; margin-bottom: 10px; }
    .page-overlay p { font-size: 0.9rem; opacity: 0.8; }

    .cover-page { border-radius: 0 15px 15px 0; }
    .back-page { border-radius: 15px 0 0 15px; }

    .gradient-text {
        background: linear-gradient(135deg, #581C1C, #f59e0b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>


