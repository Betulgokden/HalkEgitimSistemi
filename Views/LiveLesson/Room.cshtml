<div class="live-lesson-wrapper">
    <!-- Premium Header -->
    <div class="lesson-header d-flex justify-content-between align-items-center px-4 py-3">
        <div class="d-flex align-items-center gap-3">
            <div class="classroom-badge">
                <i class="bi bi-mortarboard-fill"></i>
                <span>SANAL SINIF</span>
            </div>
            <div class="h-separator"></div>
            <h5 class="mb-0 fw-bold text-white" style="letter-spacing: 0.5px;">@ViewData["Title"]</h5>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="live-timer-container">
                <span class="live-dot"></span>
                <span id="lessonTimer">00:00:00</span>
            </div>
            <div id="connectionStatus" class="connection-status">
                <i class="bi bi-reception-4 text-success"></i>
                <small>BAĞLANTI STABİL</small>
            </div>
        </div>
    </div>

    <div class="container-fluid h-calc p-4">
        <div class="row h-100 g-4">
            <!-- Sol Panel: Katılımcılar -->
            <div class="col-lg-2">
                <div class="glass-card-static h-100 p-3 d-flex flex-column border-glass">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-white-10">
                        <h6 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary-light"></i>Katılımcılar</h6>
                        <span class="badge bg-primary-light text-dark rounded-pill" id="participantCount">0</span>
                    </div>
                    <div id="student-list" class="flex-grow-1 overflow-auto custom-scrollbar">
                        <!-- Katılımcılar SignalR ile buraya dolacak -->
                    </div>
                </div>
            </div>

            <!-- Orta Panel: Ana Ekran -->
            <div class="col-lg-10">
                <div class="main-stage glass-card-static h-100 overflow-hidden position-relative border-glass shadow-glow-lg">
                    <div id="jitsi-container" style="height: 100%; width: 100%; display: none;"></div>
                    
                    <!-- Floating Instructor Preview (Top-Right) -->
                    <div id="floating-instructor" class="instructor-preview-floating animate-scaleIn" style="display: none;">
                        <div class="instructor-video-wrapper shadow-glow-sm">
                            <video id="selfView" autoplay muted playsinline class="w-100 h-100 object-fit-cover"></video>
                            <div class="instructor-label">
                                <span class="badge bg-danger rounded-pill me-1 small" style="font-size: 0.6rem;">CANLI</span>
                                <span class="text-white small">@ViewBag.DisplayName</span>
                            </div>
                        </div>
                    </div>

                    <!-- Beyaz Tahta (Canvas) -->
                    <canvas id="whiteboard" class="position-absolute top-0 start-0 w-100 h-100" style="z-index: 5; display: none; background: white; cursor: crosshair;"></canvas>

                    <!-- Başlangıç Ekranı -->
                    <div id="start-screen" class="d-flex flex-column align-items-center justify-content-center h-100 text-center animate-fadeIn">
                        <div class="broadcast-glow-wrap mb-4">
                            <div class="glow-circle"></div>
                            <i class="bi bi-broadcast"></i>
                        </div>
                        <h1 class="text-white mb-3 fw-900 tracking-wider">CANLI YAYIN PLATFORMU</h1>
                        
                        @if (ViewBag.IsInstructor)
                        {
                            <p class="text-white-50 mb-4 fs-5 mx-auto" style="max-width: 500px;">Görüntünüz sağ üst köşede, ana ekranınız ise paylaşımınız için hazır olacaktır. Yayını başlatarak derse başlayabilirsiniz.</p>
                            <button id="btnStartLesson" class="btn btn-premium btn-success-glow px-5 py-3 fs-5 rounded-pill pulse-animation">
                                <i class="bi bi-play-circle-fill me-2"></i> YAYINI BAŞLAT
                            </button>
                        }
                        else
                        {
                            <p class="text-white-50 mb-4 fs-5 mx-auto" style="max-width: 500px;">Eğitmeniniz dersi başlattığında ekran otomatik olarak açılacaktır.</p>
                            <button id="btnStartLesson" class="btn btn-premium btn-primary-glow px-5 py-3 fs-5 rounded-pill">
                                <i class="bi bi-box-arrow-in-right me-2"></i> SINIFA KATIL
                            </button>
                        }
                    </div>

                    <!-- Floating Controls -->
                    <div class="stage-controls p-3" id="jitsi-controls" style="display: none;">
                        <div class="control-group">
                            <button class="btn btn-lesson-action" id="btnMute" title="Sesi Aç/Kapat"><i class="bi bi-mic-fill"></i></button>
                            <button class="btn btn-lesson-action" id="btnVideo" title="Görüntüyü Aç/Kapat"><i class="bi bi-camera-video-fill"></i></button>
                        </div>
                        
                        <div class="control-group">
                            <button class="btn btn-lesson-action" id="btnRaiseHand" title="El Kaldır"><i class="bi bi-hand-index-thumb"></i></button>
                            @if (ViewBag.IsInstructor)
                            {
                                <button class="btn btn-lesson-action btn-share-special" id="btnShare" title="EKRAN PAYLAŞ" style="background: #C5A059; color: #000; font-weight: bold; width: auto; padding: 0 15px; gap: 8px;">
                                    <i class="bi bi-display"></i> <span>EKRAN PAYLAŞ</span>
                                </button>
                                <button class="btn btn-lesson-action btn-warning-glow" id="btnWhiteboard" title="Beyaz Tahta"><i class="bi bi-brush"></i></button>
                                <button class="btn btn-lesson-action btn-info-glow" id="btnAttendance" title="Yoklama Al"><i class="bi bi-clipboard-check"></i></button>
                            }
                        </div>
                        
                        <button class="btn btn-danger-glow rounded-pill px-4" id="btnEnd"><i class="bi bi-telephone-x-fill me-2"></i>AYRIL</button>
                    </div>
                </div>
            </div>

            <!-- Sağ Panel: Chat -->
            <div class="col-lg-2">
                <div class="h-100 d-flex flex-column">
                    <!-- Sohbet -->
                    <div class="chat-mini flex-grow-1 glass-card-static p-3 d-flex flex-column border-glass h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-white-10">
                            <h6 class="fw-bold mb-0 x-small text-uppercase">Ders Sohbeti</h6>
                            <span class="pulse-active-badge">CANLI</span>
                        </div>
                        <div id="lessonChatHistory" class="chat-history flex-grow-1 overflow-auto custom-scrollbar pe-2">
                            <div class="system-bot-msg mb-2">
                                <i class="bi bi-robot me-1"></i>
                                <span>Sanal sınıfa hoş geldiniz!</span>
                            </div>
                        </div>
                        <div class="chat-input-wrapper mt-3">
                            <div class="input-group">
                                <input type="text" id="lessonChatInput" class="form-control glass-input" placeholder="Mesajınızı yazın...">
                                <button id="btnSendChat" class="btn btn-primary-glow"><i class="bi bi-send-fill"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --classroom-bg: #0f1021;
        --glass-border: rgba(255, 255, 255, 0.08);
    }
    .live-lesson-wrapper { height: 100vh; background: var(--classroom-bg); overflow: hidden; font-family: 'Outfit', sans-serif; }
    .h-calc { height: calc(100vh - 80px); }
    .lesson-header { background: rgba(0,0,0,0.4); border-bottom: 1px solid var(--glass-border); backdrop-filter: blur(20px); }
    
    .classroom-badge { background: var(--gradient-premium); padding: 6px 15px; border-radius: 10px; color: white; font-weight: 800; font-size: 0.8rem; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(197, 160, 89, 0.3); }
    .h-separator { width: 1px; height: 25px; background: var(--glass-border); }
    
    .live-timer-container { background: rgba(0,0,0,0.5); padding: 5px 15px; border-radius: 30px; border: 1px solid var(--glass-border); color: #C5A059; font-family: 'Courier New', monospace; font-weight: bold; display: flex; align-items: center; gap: 10px; }
    .live-dot { width: 8px; height: 8px; background: #ef4444; border-radius: 50%; box-shadow: 0 0 10px #ef4444; animation: pulse-red 2s infinite; }
    @@keyframes pulse-red { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }

    .main-stage { background: #000; border: 1px solid var(--glass-border); }
    .broadcast-glow-wrap { position: relative; width: 120px; height: 120px; display: flex; align-items: center; justify-content: center; }
    .broadcast-glow-wrap i { font-size: 4rem; color: #C5A059; z-index: 2; filter: drop-shadow(0 0 15px #C5A059); }
    .glow-circle { position: absolute; width: 100%; height: 100%; background: radial-gradient(circle, rgba(197, 160, 89, 0.2) 0%, transparent 70%); border-radius: 50%; animation: grow-pulse 3s infinite; }
    @@keyframes grow-pulse { 0% { transform: scale(0.8); opacity: 0.5; } 50% { transform: scale(1.3); opacity: 0.2; } 100% { transform: scale(0.8); opacity: 0.5; } }

    .stage-controls { position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 20px; z-index: 100; background: rgba(10, 10, 25, 0.9); backdrop-filter: blur(20px); padding: 15px 30px !important; border-radius: 100px; border: 1px solid var(--glass-border); box-shadow: 0 15px 50px rgba(0,0,0,0.8); }
    .control-group { display: flex; gap: 10px; padding-right: 20px; border-right: 1px solid var(--glass-border); }
    .control-group:last-of-type { border-right: none; }
    
    .btn-lesson-action { width: 48px; height: 48px; border-radius: 14px; background: rgba(255,255,255,0.05); color: white; border: 1px solid var(--glass-border); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    .btn-lesson-action:hover { background: #C5A059; color: #000; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(197, 160, 89, 0.3); }
    
    .pulse-active-badge { font-size: 0.65rem; background: rgba(46, 213, 115, 0.1); color: #2ed573; border: 1px solid rgba(46, 213, 115, 0.3); padding: 2px 8px; border-radius: 20px; font-weight: 800; animation: pulse-opacity 1.5s infinite; }
    
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    
    .participant-mini { background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: 12px; transition: all 0.3s; }
    .participant-mini:hover { background: rgba(255,255,255,0.08); border-color: #C5A059; }
    .avatar-sm { width: 35px; height: 35px; background: var(--gradient-premium); color: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.8rem; }
    
    .system-bot-msg { background: rgba(197, 160, 89, 0.1); border-left: 3px solid #C5A059; padding: 8px 12px; border-radius: 0 8px 8px 0; font-size: 0.85rem; color: #C5A059; }

    /* Floating Instructor Preview */
    .instructor-preview-floating {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 240px;
        z-index: 1000;
        border-radius: 20px;
        overflow: hidden;
        border: 2px solid #C5A059;
        background: #000;
    }
    .instructor-video-wrapper { position: relative; width: 100%; aspect-ratio: 16/9; }
    .instructor-label {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 5px 10px;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(5px);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
</style>

<script src="https://meet.jit.si/external_api.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

<script>
    const roomId = "@ViewBag.RoomId";
    const displayName = "@ViewBag.DisplayName";
    const isInstructor = "@ViewBag.IsInstructor" === "True";
    
    // --- SignalR Connection ---
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/liveLessonHub")
        .build();

    // 1. El Kaldırma Dinleyici
    connection.on("ReceiveHandRaise", (user) => {
        const history = document.getElementById('lessonChatHistory');
        history.innerHTML += `<div class="mb-1"><i class="bi bi-hand-index-thumb-fill text-warning"></i> <span class="text-warning fw-bold">${user}</span> el kaldırdı!</div>`;
        history.scrollTop = history.scrollHeight;
        
        // Katılımcı listesinde el ikonunu göster
        const p = Array.from(document.querySelectorAll('.participant-mini')).find(el => el.innerText.includes(user));
        if(p) {
            let hand = p.querySelector('.hand-icon');
            if(!hand) {
                hand = document.createElement('i');
                hand.className = 'bi bi-hand-index-thumb-fill text-warning hand-icon ms-2';
                p.appendChild(hand);
                setTimeout(() => hand.remove(), 5000);
            }
        }
    });

    // 2. Beyaz Tahta Dinleyici
    connection.on("ReceiveDraw", (data) => {
        drawOnCanvas(data);
    });
    
    connection.on("ClearBoard", () => {
        const canvas = document.getElementById('whiteboard');
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
    });

    // 3. Sohbet Dinleyici
    connection.on("ReceiveMessage", (user, msg, time, isCensored) => {
        const history = document.getElementById('lessonChatHistory');
        const color = user === displayName ? 'text-primary-light' : 'text-success';
        
        const censoredClass = isCensored ? 'text-danger fw-bold opacity-75' : '';
        history.innerHTML += `<div class="mb-1 ${isCensored ? 'border-start border-danger ps-2' : ''}"><small class="text-muted">${time}</small> <span class="${color} fw-bold">${user}:</span> <span class="${censoredClass}">${msg}</span></div>`;
        history.scrollTop = history.scrollHeight;
    });

    // 4. Sistem Uyarı Dinleyicisi
    connection.on("ReceiveSystemWarning", (msg) => {
        const history = document.getElementById('lessonChatHistory');
        history.innerHTML += `<div class="system-bot-msg"><i class="bi bi-robot me-2"></i>${msg}</div>`;
        history.scrollTop = history.scrollHeight;

        // Glitch efekti tetikle
        const chatBox = document.querySelector('.chat-mini');
        chatBox.classList.add('glitch-active');
        setTimeout(() => chatBox.classList.remove('glitch-active'), 500);
    });

    // Katılımcı Listesi Güncelleme
    connection.on("UpdateUserList", (users) => {
        const list = document.getElementById('student-list');
        const countBadge = document.getElementById('participantCount');
        if (countBadge) countBadge.innerText = users.length;
        
        list.innerHTML = '';
        users.forEach(u => {
            const initials = u.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
            list.innerHTML += `
                <div class="participant-mini mb-2 p-2 rounded d-flex align-items-center gap-2 animate-fadeIn">
                    <div class="avatar-sm">${initials}</div>
                    <span class="small text-white-50">${u}</span>
                    <div class="ms-auto"><span class="status-dot-sm bg-success"></span></div>
                </div>`;
        });
    });

    connection.start().then(() => {
        connection.invoke("JoinRoom", roomId, displayName);
    });

    // --- Timer Logic ---
    let seconds = 0;
    function updateTimer() {
        seconds++;
        const hrs = Math.floor(seconds / 3600);
        const mins = Math.floor((seconds % 3600) / 60);
        const secs = seconds % 60;
        const formatted = 
            (hrs < 10 ? "0" + hrs : hrs) + ":" + 
            (mins < 10 ? "0" + mins : mins) + ":" + 
            (secs < 10 ? "0" + secs : secs);
        const timerEl = document.getElementById('lessonTimer');
        if (timerEl) timerEl.innerText = formatted;
    }
    let timerInterval;

    // --- UI Logic ---
    const btnStart = document.getElementById('btnStartLesson');
    const startScreen = document.getElementById('start-screen');
    const jitsiContainer = document.getElementById('jitsi-container');
    const whiteboard = document.getElementById('whiteboard');
    const jitsiControls = document.getElementById('jitsi-controls');
    
    // El Kaldır
    document.getElementById('btnRaiseHand').onclick = function() {
        connection.invoke("RaiseHand", roomId, displayName);
        this.classList.add('hand-raised');
        setTimeout(() => this.classList.remove('hand-raised'), 3000);
    };

    // Chat Gönder
    const chatInput = document.getElementById('lessonChatInput');
    const btnSendChat = document.getElementById('btnSendChat');
    
    function sendMsg() {
        const msg = chatInput.value.trim();
        if(msg) {
            connection.invoke("SendMessage", roomId, displayName, msg);
            chatInput.value = '';
        }
    }
    btnSendChat.onclick = sendMsg;
    chatInput.onkeypress = (e) => { if(e.key === 'Enter') sendMsg(); };

    // --- Whiteboard Logic ---
    let drawing = false;
    let ctx = whiteboard.getContext('2d');
    
    function resizeCanvas() {
        whiteboard.width = whiteboard.offsetWidth;
        whiteboard.height = whiteboard.offsetHeight;
    }
    
    if(isInstructor) {
        document.getElementById('btnWhiteboard').onclick = function() {
            const active = whiteboard.style.display === 'block';
            whiteboard.style.display = active ? 'none' : 'block';
            this.classList.toggle('active');
            if(!active) resizeCanvas();
        };

        whiteboard.onmousedown = (e) => { drawing = true; draw(e, 'start'); };
        whiteboard.onmousemove = (e) => { if(drawing) draw(e, 'move'); };
        whiteboard.onmouseup = () => { drawing = false; };
        
        function draw(e, type) {
            const rect = whiteboard.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const data = { x, y, type, color: 'black', width: 2 };
            drawOnCanvas(data);
            connection.invoke("Draw", roomId, data);
        }
        
        // Yoklama Al
        document.getElementById('btnAttendance').onclick = () => {
            fetch('/LiveLesson/TakeAttendance?roomId=' + roomId, { method: 'POST' })
                .then(r => r.json())
                .then(d => {
                    Swal.fire({
                        title: 'Yoklama Alındı',
                        text: d.message,
                        icon: 'success',
                        background: 'rgba(15, 23, 42, 0.95)',
                        color: '#fff'
                    });
                });
        };
    }

    function drawOnCanvas(data) {
        ctx.lineWidth = data.width;
        ctx.lineCap = 'round';
        ctx.strokeStyle = data.color;
        
        if(data.type === 'start') {
            ctx.beginPath();
            ctx.moveTo(data.x, data.y);
        } else if(data.type === 'move') {
            ctx.lineTo(data.x, data.y);
            ctx.stroke();
        }
    }

    // --- Jitsi Logic ---
    let jitsiApi = null;

    document.getElementById('btnEnd').onclick = () => {
        const confirmMsg = isInstructor ? "Dersi sonlandırıp paneline dönmek istediğine emin misin?" : "Dersten ayrılmak istediğine emin misin?";
        if(confirm(confirmMsg)) {
            if (jitsiApi) jitsiApi.executeCommand('hangup');
            
            if (isInstructor) {
                fetch('/Teacher/ToggleLive?start=false', { method: 'POST' })
                    .then(() => {
                        window.location.href = '/Teacher/Dashboard';
                    });
            } else {
                window.location.href = '/Student/Dashboard';
            }
        }
    };

    async function startLocalVideo() {
        const video = document.getElementById('selfView');
        const container = document.getElementById('floating-instructor');
        
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
            video.srcObject = stream;
            container.style.display = 'block';
            console.log("Local camera started successfully");
        } catch (err) {
            console.error("Error accessing camera: ", err);
            // Fallback: If camera blocked, show static placeholder or alert
            Swal.fire({
                title: 'Kamera Hatası',
                text: 'Kameranıza erişilemedi. Lütfen izin verdiğinizden emin olun.',
                icon: 'warning',
                background: 'rgba(15, 23, 42, 0.95)',
                color: '#fff'
            });
        }
    }

    btnStart.addEventListener('click', () => {
        startScreen.style.display = 'none';
        jitsiContainer.style.display = 'block';
        jitsiControls.style.display = 'flex';
        
        // Start Local Preview if instructor
        if(isInstructor) {
            startLocalVideo();
        }

        // Start Timer
        timerInterval = setInterval(updateTimer, 1000);

        const options = {
            roomName: 'HalkEgitim_Room_' + roomId.replace(/[^a-zA-Z0-9]/g, ''),
            width: '100%', height: '100%',
            parentNode: jitsiContainer,
            userInfo: { displayName: displayName },
            configOverwrite: { 
                prejoinPageEnabled: false, 
                disableDeepLinking: true,
                startWithAudioMuted: false,
                startWithVideoMuted: isInstructor // We hide instructor video in main Jitsi view to keep center empty
            },
            interfaceConfigOverwrite: { 
                SHOW_JITSI_WATERMARK: false, 
                SHOW_WATERMARK_FOR_GUESTS: false,
                TOOLBAR_BUTTONS: [
                   'microphone', 'camera', 'closedcaptions', 'desktop', 'fullscreen',
                   'fittowindow', 'chat', 'recording', 'livestreaming', 'etherpad', 'sharedvideo',
                   'settings', 'raisehand', 'videoquality', 'filmstrip', 'invite', 'feedback',
                   'stats', 'shortcuts', 'tileview', 'videobackgroundblur', 'download', 'help', 'mute-everyone',
                   'e2ee'
                ]
            }
        };

        jitsiApi = new JitsiMeetExternalAPI('meet.jit.si', options);
        
        document.getElementById('btnMute').onclick = () => jitsiApi.executeCommand('toggleAudio');
        document.getElementById('btnVideo').onclick = () => jitsiApi.executeCommand('toggleVideo');
        if(isInstructor) {
            document.getElementById('btnShare').onclick = () => {
                jitsiApi.executeCommand('toggleShareScreen');
                // Screen share started - center will be filled by Jitsi automatically
            };
        }
    });
</script>


