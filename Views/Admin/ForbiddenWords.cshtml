@model IEnumerable<HalkEgitimSistemi.Models.ForbiddenWord>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yasaklı Kelime Yönetimi";
}

<div class="container-fluid p-4">
    <div class="glass-card-static p-4 mb-4 animate-fadeInUp">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 style="font-family:'Outfit';font-weight:800;margin:0;">
                    <i class="bi bi-shield-slash me-2 text-danger"></i>Filtre Yönetimi
                </h2>
                <p class="text-muted-premium mb-0">Otomatik denetim için yasaklı kelime listesini yönetin</p>
            </div>
            <button class="btn btn-premium btn-primary-glow" data-bs-toggle="modal" data-bs-target="#addWordModal">
                <i class="bi bi-plus-lg me-1"></i>Yeni Kelime Ekle
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="glass-card-static p-0 overflow-hidden animate-fadeInUp" style="animation-delay: 0.1s;">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="color: white;">
                        <thead style="background: rgba(255,255,255,0.05);">
                            <tr>
                                <th class="ps-4">Yasaklı Kelime</th>
                                <th>Ekleyen</th>
                                <th>Eklenme Tarihi</th>
                                <th class="text-end pe-4">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var word in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2">
                                            @word.Word
                                        </span>
                                    </td>
                                    <td><small class="text-muted-premium">@word.CreatedBy</small></td>
                                    <td><small class="text-muted-premium">@word.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small></td>
                                    <td class="text-end pe-4">
                                        <form asp-action="DeleteForbiddenWord" method="post" onsubmit="return confirm('Bu kelimeyi filtre listesinden kaldırmak istediğinize emin misiniz?');">
                                            <input type="hidden" name="id" value="@word.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="glass-card-static p-4 animate-fadeInUp" style="animation-delay: 0.2s;">
                <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Nasıl Çalışır?</h5>
                <ul class="text-muted-premium small list-unstyled">
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Sistem, burada eklenen kelimeleri hem yorumlarda hem de canlı sohbetlerde anlık olarak tarar.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Yakalanan kelimeler <strong>***</strong> şeklinde sansürlenir.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Kullanıcıya otomatik ihlal puanı eklenir ve sistem botu tarafından uyarılır.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>3 ihlalde 1 saat, 5 ihlalde 1 yıl kısıtlama uygulanır.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Add Word Modal -->
<div class="modal fade" id="addWordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="background: #1a1a2e; border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-800 text-white">Yasaklı Kelime Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddForbiddenWord" method="post">
                <div class="modal-body p-4">
                    <div class="form-premium-group">
                        <label class="form-premium-label">Kelime / Öbek</label>
                        <input type="text" name="word" class="form-premium-control" placeholder="Örn: küfürlü_kelime" required autofocus />
                    </div>
                    <p class="text-muted extra-small mt-2">Büyük/küçük harf duyarlılığı yoktur.</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary-glass" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary-glow">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

