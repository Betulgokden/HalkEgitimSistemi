@model IEnumerable<HalkEgitimSistemi.Models.Course>

@{
    ViewData["Title"] = "Canlı Ders İzleme";
}

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="page-header-content">
            <div>
                <h1 class="page-header-title"><i class="bi bi-broadcast me-2"></i> Canlı Ders Denetimi</h1>
                <p class="page-header-subtitle">Åu an yayında olan interaktif sınıfları takip edin.</p>
            </div>
            <div class="live-indicator">
                <span class="pulse-dot"></span> <span class="fw-bold">@Model.Count()</span> Aktif Yayın
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-4">
    @if (!Model.Any())
    {
        <div class="glass-card-static p-5 text-center">
            <div class="display-1 text-primary-light opacity-25 mb-4"><i class="bi bi-camera-video-off"></i></div>
            <h3 class="fw-bold">Åu An Aktif Canlı Ders Bulunmuyor</h3>
            <p class="text-muted">Eğitmenler ders başlattığında burada listelenecektir.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var course in Model)
            {
                <div class="col-xl-4 col-md-6">
                    <div class="glass-card-static h-100 overflow-hidden lesson-card animate-fadeIn">
                        <div class="position-relative">
                            <img src="@(course.ImageUrl ?? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600")" class="img-fluid w-100" style="height: 180px; object-fit: cover;" alt="@course.CourseName">
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-record-fill me-1 animate-pulse"></i> CANLI</span>
                            </div>
                        </div>
                        <div class="p-4">
                            <h5 class="fw-bold text-primary-theme mb-2">@course.CourseName</h5>
                            <div class="d-flex align-items-center gap-3 mb-4 text-white-50 small">
                                <span><i class="bi bi-person-badge me-1"></i> @course.Instructor?.FullName</span>
                                <span><i class="bi bi-people me-1"></i> @course.Applications?.Count(a => a.Status == ApplicationStatus.Approved) Öğrenci</span>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <a href="/LiveLesson/Room?roomId=@course.LiveRoomId" target="_blank" class="btn btn-glow-premium">
                                    <i class="bi bi-eye-fill me-2"></i> İzle & Katıl
                                </a>
                                <form asp-action="EndLiveLesson" asp-controller="Admin" method="post" onsubmit="return confirm('Bu canlı dersi sonlandırmak istediğinize emin misiniz?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@course.Id" />
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-stop-circle me-1"></i> Yayını Durdur
                                    </button>
                                </form>
                                <button class="btn btn-secondary-glass btn-sm" onclick="alert('Ders ID: @course.LiveRoomId')">
                                    <i class="bi bi-info-circle me-1"></i> Teknik Detaylar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .lesson-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(255,255,255,0.05) !important;
    }
    .lesson-card:hover {
        transform: translateY(-5px);
        border-color: var(--primary) !important;
        box-shadow: 0 15px 40px rgba(0,0,0,0.4);
    }
    .animate-pulse {
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.3; }
        100% { opacity: 1; }
    }
</style>

