@model IEnumerable<HalkEgitimSistemi.Models.Idea>

@{
    ViewData["Title"] = "Fikir Kumbarası";
}

<div class="page-header">
    <div class="container">
        <div class="page-header-content">
            <div>
                <h1 class="page-header-title"><i class="bi bi-piggy-bank me-2"></i> Fikir Kumbarası</h1>
                <p class="page-header-subtitle">Kurumumuzun geleceğini senin fikirlerinle şekillendiriyoruz.</p>
            </div>
            <button class="btn btn-glow-premium" onclick="$('#submitIdeaModal').modal('show')">
                <i class="bi bi-plus-circle me-1"></i> Yeni Fikir Gönder
            </button>
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Quick Stats (Modernize) -->
    <div class="row g-4 mb-5 animate-fadeInUp">
        <div class="col-md-4">
            <div class="stat-box-modern">
                <div class="stat-number-modern">@Model.Count()</div>
                <div class="stat-label-modern">Toplam Fikir</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-box-modern">
                <div class="stat-number-modern">@Model.Sum(i => i.Likes)</div>
                <div class="stat-label-modern">Toplam Etkileşim</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-box-modern">
                <div class="stat-number-modern">@Model.GroupBy(i => i.Category).Count()</div>
                <div class="stat-label-modern">Farklı Kategori</div>
            </div>
        </div>
    </div>

    <!-- Ideas Grid (Modernize) -->
    <div class="row g-4 stagger-children" id="ideasGrid">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 idea-card-wrapper">
                <div class="glass-card h-100 p-4 d-flex flex-column idea-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge-premium idea-badge">@item.Category</span>
                        <div class="idea-date"><i class="bi bi-clock me-1"></i> @item.CreatedAt.ToString("dd MMM yyyy")</div>
                    </div>
                    <h3 class="fw-bold mb-2 idea-title">@item.Title</h3>
                    <p class="flex-grow-1 idea-desc">@item.Description</p>
                    <div class="mt-4 pt-3 border-top idea-footer">
                        <div class="d-flex align-items-center">
                            <div class="author-avatar-modern me-3">
                                @item.AuthorName.Substring(0, 1)
                            </div>
                            <span class="small fw-bold idea-author">@item.AuthorName</span>
                        </div>
                        <button class="btn p-1 px-3 rounded-pill idea-like-btn" onclick="likeIdea(@item.Id, this)">
                            <i class="bi bi-heart-fill me-2"></i> <span class="like-count fw-bold">@item.Likes</span>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* --- DARK MODE (GOLD) DEFAULT --- */
    .stat-box-modern {
        background: rgba(197, 160, 89, 0.1);
        border: 2px solid rgba(197, 160, 89, 0.4);
        border-radius: 25px;
        padding: 2rem;
        text-align: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    .stat-box-modern:hover {
        transform: translateY(-5px) scale(1.02);
        background: rgba(197, 160, 89, 0.2);
        border-color: #C5A059;
        box-shadow: 0 15px 40px rgba(197, 160, 89, 0.15);
    }
    .stat-number-modern {
        color: #C5A059;
        font-size: 3rem;
        font-weight: 900;
        text-shadow: 0 0 20px rgba(197, 160, 89, 0.4);
    }
    .stat-label-modern {
        color: #d4b57e; /* Light Gold */
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .idea-card {
        border-radius: 30px !important;
        background: rgba(30, 41, 59, 0.5) !important;
        border: 1px solid rgba(197, 160, 89, 0.3) !important;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .idea-card:hover {
        transform: translateY(-8px);
        background: rgba(30, 41, 59, 0.8) !important;
        border-color: #C5A059 !important;
        box-shadow: 0 20px 50px rgba(197, 160, 89, 0.2);
    }
    .idea-badge {
        background: rgba(197, 160, 89, 0.15) !important;
        color: #C5A059 !important;
        border: 1px solid rgba(197, 160, 89, 0.4);
        padding: 6px 15px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }
    .idea-date { color: #d4b57e; font-size: 0.85rem; font-weight: 600; opacity: 0.9; }
    .idea-title { font-family: 'Outfit', sans-serif; font-size: 1.4rem; color: #C5A059; text-shadow: 0 2px 10px rgba(197, 160, 89, 0.2); }
    .idea-desc { font-size: 0.95rem; line-height: 1.6; color: #e6d2a8; margin-bottom: 0; }
    .idea-footer { border-color: rgba(197, 160, 89, 0.3) !important; display: flex; justify-content: space-between; align-items: center; }
    
    .author-avatar-modern {
        width: 35px; height: 35px;
        background: rgba(197, 160, 89, 0.2);
        color: #C5A059;
        display: flex; align-items: center; justify-content: center;
        border-radius: 10px; font-weight: 900;
        border: 1px solid rgba(197, 160, 89, 0.4);
    }
    .idea-author { color: #d4b57e; letter-spacing: 0.5px; }
    
    .idea-like-btn {
        background: rgba(197, 160, 89, 0.1);
        color: #C5A059;
        border: 1px solid rgba(197, 160, 89, 0.3);
        transition: all 0.3s;
    }
    .idea-like-btn:hover { background: rgba(197, 160, 89, 0.2); transform: scale(1.05); border-color: #C5A059; }
    .idea-like-btn i { color: #C5A059; }

    /* --- LIGHT MODE (MAROON/GOLD) --- */
    [data-theme="light"] .stat-box-modern {
        background: rgba(197, 160, 89, 0.15);
        border-color: #C5A059;
        box-shadow: 0 5px 20px rgba(88, 28, 28, 0.05);
    }
    [data-theme="light"] .stat-box-modern:hover {
        background: rgba(197, 160, 89, 0.25);
        box-shadow: 0 10px 25px rgba(197, 160, 89, 0.15);
    }
    [data-theme="light"] .stat-number-modern { color: #581C1C; text-shadow: none; }
    [data-theme="light"] .stat-label-modern { color: #581C1C; }
    
    [data-theme="light"] .idea-card {
        background: rgba(255, 255, 255, 0.8) !important;
        border-color: rgba(197, 160, 89, 0.4) !important;
        box-shadow: 0 4px 15px rgba(88, 28, 28, 0.05);
    }
    [data-theme="light"] .idea-card:hover {
        background: #ffffff !important;
        box-shadow: 0 15px 30px rgba(197, 160, 89, 0.15);
    }
    [data-theme="light"] span.idea-badge { background: #581C1C !important; color: #fdfaf1 !important; border: none; }
    [data-theme="light"] .idea-date { color: #581C1C; opacity: 0.8; }
    [data-theme="light"] .idea-title { color: #581C1C; text-shadow: none; }
    [data-theme="light"] .idea-desc { color: #581C1C; opacity: 0.9; }
    [data-theme="light"] .idea-footer { border-color: rgba(88, 28, 28, 0.1) !important; }
    [data-theme="light"] .author-avatar-modern { background: #581C1C; color: #fdfaf1; border: none; }
    [data-theme="light"] .idea-author { color: #581C1C; }
</style>

<!-- Submit Idea Modal -->
<div class="modal fade" id="submitIdeaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-glass border-glass shadow-lg" style="backdrop-filter: blur(25px);">
            <div class="modal-header border-glass">
                <h5 class="modal-title fw-bold text-primary">Kumbaraya Fikir At</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-premium-group">
                    <label class="form-premium-label">Fikir Başlığı</label>
                    <input type="text" id="ideaTitle" class="form-premium-control" placeholder="Örn: Akıllı Bahçe Projesi">
                </div>
                <div class="form-premium-group">
                    <label class="form-premium-label">Kategori</label>
                    <select id="ideaCategory" class="form-premium-control">
                        <option>Dijitalleşme</option>
                        <option>Sanat & Kültür</option>
                        <option>Sosyal Sorumluluk</option>
                        <option>Eğitim Teknolojileri</option>
                        <option>Kurumsal Gelişim</option>
                        <option>Diğer</option>
                    </select>
                </div>
                <div class="form-premium-group">
                    <label class="form-premium-label">Detaylı Açıklama</label>
                    <textarea id="ideaDescription" class="form-premium-control" rows="4" placeholder="Fikrini detaylandır..."></textarea>
                </div>
                <div class="form-premium-group">
                    <label class="form-premium-label">İsminiz (Opsiyonel)</label>
                    <input type="text" id="ideaAuthor" class="form-premium-control" placeholder="Anonim kalsın istiyorsan boş bırak">
                </div>
            </div>
            <div class="modal-footer border-glass">
                <button type="button" class="btn btn-secondary-glass" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-glow-premium" onclick="submitIdea()">Fikri Gönder</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function likeIdea(id, btn) {
            $(btn).addClass('animate-pulse');
            $.post('/IdeaBank/LikeIdea', { id: id }, function(res) {
                if(res.success) {
                    $(btn).find('.like-count').text(res.newLikes);
                    setTimeout(() => $(btn).removeClass('animate-pulse'), 1000);
                }
            });
        }

        function submitIdea() {
            const data = {
                title: $('#ideaTitle').val(),
                category: $('#ideaCategory').val(),
                description: $('#ideaDescription').val(),
                author: $('#ideaAuthor').val()
            };

            if(!data.title || !data.description) {
                alert("Lütfen tüm alanları doldurun.");
                return;
            }

            $.post('/IdeaBank/SubmitIdea', data, function(res) {
                if(res.success) {
                    $('#submitIdeaModal').modal('hide');
                    location.reload(); // Simple reload for perfection in this context
                } else {
                    alert(res.message);
                }
            });
        }
    </script>
}


