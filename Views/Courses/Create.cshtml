@model HalkEgitimSistemi.Models.Course

@{
    ViewData["Title"] = "Yeni Kurs Tanımla";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="glass-card-static animate-scaleIn overflow-hidden">
                <!-- Header -->
                <div style="padding: 2rem 2rem 1.5rem; border-bottom: 1px solid var(--border-glass); background: var(--gradient-card);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="page-header-icon" style="width: 50px; height: 50px; font-size: 1.3rem; background: var(--gradient-purple);">
                            <i class="bi bi-plus-circle-fill"></i>
                        </div>
                        <div>
                            <h2 style="font-family: 'Outfit', sans-serif; font-weight: 800; margin: 0; color: var(--text-primary); font-size: 1.5rem;">Yeni Kurs Oluştur</h2>
                            <p style="color: var(--text-muted); margin: 0; font-size: 0.85rem;">Eğitim kataloğuna yeni bir kurs ekleyin.</p>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <div style="padding: 2rem;">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-premium-group">
                            <label asp-for="CourseName" class="form-premium-label">
                                <i class="bi bi-mortarboard me-1"></i>Kurs Adı
                            </label>
                            <input asp-for="CourseName" class="form-premium-control" placeholder="Örn: Python Programlama" />
                            <span asp-validation-for="CourseName" class="field-validation-error"></span>
                        </div>

                        <div class="form-premium-group">
                            <label asp-for="Description" class="form-premium-label">
                                <i class="bi bi-text-paragraph me-1"></i>Açıklama
                            </label>
                            <textarea asp-for="Description" class="form-premium-control" rows="4" placeholder="Kurs hakkında detaylı bilgi veriniz..."></textarea>
                            <span asp-validation-for="Description" class="field-validation-error"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label class="form-premium-label">
                                        <i class="bi bi-image me-1"></i>Görsel (Dosya Yükle)
                                    </label>
                                    <input type="file" name="courseImage" class="form-premium-control" accept="image/*" />
                                    <input type="hidden" asp-for="ImageUrl" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="CategoryId" class="form-premium-label">
                                        <i class="bi bi-tag me-1"></i>Kurs Kategorisi
                                    </label>
                                    <select asp-for="CategoryId" class="form-premium-control" asp-items="ViewBag.CategoryId">
                                        <option value="">Lütfen Kategori Seçiniz</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-premium-group">
                                    <label asp-for="Quota" class="form-premium-label"><i class="bi bi-people me-1"></i>Kontenjan</label>
                                    <input asp-for="Quota" type="number" class="form-premium-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-premium-group">
                                    <label asp-for="DurationHours" class="form-premium-label"><i class="bi bi-clock me-1"></i>Süre (Saat)</label>
                                    <input asp-for="DurationHours" type="number" class="form-premium-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-premium-group">
                                    <label asp-for="MaxAbsenceLimit" class="form-premium-label"><i class="bi bi-person-x me-1"></i>Devamsızlık Sınırı</label>
                                    <input asp-for="MaxAbsenceLimit" type="number" class="form-premium-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-premium-group">
                                    <label asp-for="StartDate" class="form-premium-label"><i class="bi bi-calendar-event me-1"></i>Başlangıç Tarihi</label>
                                    <input asp-for="StartDate" type="date" class="form-premium-control" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-premium-group">
                                    <label asp-for="EndDate" class="form-premium-label"><i class="bi bi-calendar-check me-1"></i>Bitiş Tarihi</label>
                                    <input asp-for="EndDate" type="date" class="form-premium-control" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-premium-group">
                                    <label asp-for="ExamDate" class="form-premium-label"><i class="bi bi-journal-check me-1"></i>Sınav Tarihi</label>
                                    <input asp-for="ExamDate" type="date" class="form-premium-control" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-premium-group">
                                    <label asp-for="Price" class="form-premium-label"><i class="bi bi-cash-stack me-1"></i>Kurs Ücreti (₺)</label>
                                    <input asp-for="Price" type="number" step="0.01" class="form-premium-control" placeholder="0.00" />
                                    <small class="text-muted" style="font-size: 0.7rem;">Ücretsiz ise 0 yazın.</small>
                                </div>
                            </div>
                        </div>

                        <div class="form-premium-group">
                            <label asp-for="LearningOutcomes" class="form-premium-label">
                                <i class="bi bi-stars me-1"></i>Neler Öğreneceksiniz? (Her satıra bir madde)
                            </label>
                            <textarea asp-for="LearningOutcomes" class="form-premium-control" rows="3" placeholder="Örn: Temel seviye Python bilgisi&#10;Veri yapılarını anlama"></textarea>
                        </div>

                        <div class="form-premium-group">
                            <label asp-for="Curriculum" class="form-premium-label">
                                <i class="bi bi-list-columns-reverse me-1"></i>Eğitim Müfredatı
                            </label>
                            <textarea asp-for="Curriculum" class="form-premium-control" rows="5" placeholder="Haftalık veya modül bazlı planı buraya yazınız..."></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="Requirements" class="form-premium-label"><i class="bi bi-info-square me-1"></i>Gereksinimler</label>
                                    <textarea asp-for="Requirements" class="form-premium-control" rows="2"></textarea>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="WhoIsItFor" class="form-premium-label"><i class="bi bi-person-bounding-box me-1"></i>Kimler İçin?</label>
                                    <textarea asp-for="WhoIsItFor" class="form-premium-control" rows="2"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-premium btn-secondary-glass flex-fill justify-content-center">
                                <i class="bi bi-arrow-left"></i> Listeye Geri Dön
                            </a>
                            <button type="submit" class="btn btn-premium btn-primary-glow flex-fill justify-content-center">
                                <i class="bi bi-rocket-takeoff"></i> Kursu Yayınla
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Footer -->
                <div style="padding: 1rem 2rem; border-top: 1px solid var(--border-glass); text-align: center;">
                    <p style="color: var(--text-muted); font-size: 0.82rem; margin: 0;">
                        <i class="bi bi-info-circle me-1" style="color: var(--info);"></i>
                        Kurs eklendikten sonra ana sayfada görünür hale gelecektir.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
