@model HalkEgitimSistemi.Models.Course
@{
    ViewData["Title"] = Model.CourseName + " - Kaynak Yönetimi";
}

<div class="container py-5">
    <div class="page-header animate-fadeInDown">
        <div class="page-header-content">
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn-icon btn-icon-secondary me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-header-title">@Model.CourseName</h1>
                    <p class="page-header-subtitle">Dijital kaynak ve ders materyali yönetimi</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Dosya Yükleme Formu -->
        <div class="col-lg-4">
            <div class="glass-card-static p-4 animate-fadeInLeft">
                <h5 style="color: var(--text-primary); font-weight: 700; margin-bottom: 1.5rem;">Yeni Kaynak Ekle</h5>
                <form asp-action="UploadResource" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="courseId" value="@Model.Id" />
                    
                    <div class="form-premium-group mb-3">
                        <label class="form-premium-label">Dosya Başlığı</label>
                        <input type="text" name="title" class="form-premium-control" placeholder="Örn: Hafta 1 Sunumu" required />
                    </div>

                    <div class="form-premium-group mb-4">
                        <label class="form-premium-label">Dosya Seç (PDF, DOCX, ZIP vb.)</label>
                        <input type="file" name="file" class="form-premium-control" required />
                    </div>

                    <button type="submit" class="btn btn-premium btn-primary-glow w-100 justify-content-center">
                        <i class="bi bi-cloud-upload"></i> Dosyayı Yükle
                    </button>
                </form>

                <div class="mt-4 p-3" style="background: rgba(255,255,255,0.02); border-radius: 12px; border: 1px dashed var(--border-glass);">
                    <small style="color: var(--text-muted);"><i class="bi bi-info-circle me-1"></i> İpucu</small>
                    <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 0; margin-top: 5px;">
                        Yüklediğiniz dosyalar kurs detay sayfasında öğrenciler tarafından görüntülenebilir ve indirilebilir olacaktır.
                    </p>
                </div>
            </div>
        </div>

        <!-- Mevcut Dosyalar -->
        <div class="col-lg-8">
            <div class="glass-card-static p-4 animate-fadeInRight">
                <h5 style="color: var(--text-primary); font-weight: 700; margin-bottom: 1.5rem;">Yüklü Kaynaklar</h5>
                
                @if (Model.Resources != null && Model.Resources.Any())
                {
                    <div class="table-responsive">
                        <table class="table-premium w-100">
                            <thead>
                                <tr>
                                    <th>Başlık</th>
                                    <th>Tür</th>
                                    <th>Tarih</th>
                                    <th class="text-end">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var res in Model.Resources)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-file-earmark-text text-info"></i>
                                                <span style="font-weight: 600;">@res.Title</span>
                                            </div>
                                        </td>
                                        <td><span class="badge-premium badge-glass">@res.FileType</span></td>
                                        <td style="color: var(--text-muted);">@res.UploadDate.ToShortDateString()</td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a href="@res.FilePath" target="_blank" class="btn-icon btn-icon-secondary" title="Görüntüle">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <form asp-action="DeleteResource" asp-route-id="@res.Id" method="post" onsubmit="return confirm('Bu dosyayı silmek istediğinize emin misiniz?')">
                                                    <button type="submit" class="btn-icon btn-icon-danger" title="Sil">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="section-icon section-icon-secondary mx-auto mb-3">
                            <i class="bi bi-folder-x"></i>
                        </div>
                        <p style="color: var(--text-muted);">Henüz hiç kaynak yüklenmemiş.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
