                                        </div>
                                        <button type="submit" class="btn btn-premium btn-primary-glow btn-lg w-100 py-3 rounded-pill fs-5 fw-900" style="background: #C5A059 !important; color: #581C1C !important;">
                                            <i class="bi bi-check2-circle me-2"></i> BAŞVURUYU TAMAMLA
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- Right: Course Fee & Halkbot Code -->
                        <div class="col-lg-5">
                            <div class="p-4 rounded-4 h-100" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(197, 160, 89, 0.2); backdrop-filter: blur(10px);">
                                <h5 class="fw-bold text-white mb-4"><i class="bi bi-wallet2 text-gold me-2"></i> Kurs Ücreti</h5>
                                
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <span class="text-white-50">Eğitim Bedeli:</span>
                                    <span class="text-white fw-bold fs-5" id="originalFeeText">@(Model.Price > 0 ? Model.Price.ToString("N2") + " ₺" : "750,00 ₺")</span>
                                </div>

                                <hr style="border-color: rgba(255, 255, 255, 0.1);" />

                                <div class="mb-4">
                                    <label class="form-label small fw-bold text-gold">HALKBOT KODU (VARSA)</label>
                                    <div class="input-group">
                                        <input type="text" id="uiHalkbotCode" class="form-premium-control modal-input-fix" style="border-radius: 12px 0 0 12px !important;" placeholder="HALKBOT-XXX" />
                                        <button type="button" class="btn btn-gold-vibrant" style="border-radius: 0 12px 12px 0; background: #C5A059; color: #581C1C; font-weight: 800; border: none; padding: 0 15px;" onclick="applyHalkbotCode()">Uygula</button>
                                    </div>
                                    <small class="text-gold opacity-75 mt-2 d-block" style="font-size: 0.75rem;">
                                        <i class="bi bi-info-circle me-1"></i> Kod doğruysa ücret tamamen sıfırlanacaktır.
                                    </small>
                                </div>

                                <div class="p-4 mt-4 text-center" style="background: rgba(197, 160, 89, 0.1); border-radius: 20px; border: 1px solid rgba(197, 160, 89, 0.2);">
                                    <div class="small text-white-50 mb-1">ÖDENECEK TOPLAM TUTAR</div>
                                    <div class="text-gold fw-900 display-6" id="finalFeeText">@(Model.Price > 0 ? Model.Price.ToString("N2") + " ₺" : "750,00 ₺")</div>
                                    <div id="freeSuccessMessage" class="mt-2 text-success fw-bold" style="display: none; font-size: 0.9rem;">
