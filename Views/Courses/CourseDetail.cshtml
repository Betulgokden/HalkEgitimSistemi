                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-gold">ADINIZ</label>
                                         <input type="text" id="firstName" name="FirstName" class="form-premium-control modal-input-fix" placeholder="Adınız" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-gold">SOYADINIZ</label>
                                         <input type="text" id="lastName" name="LastName" class="form-premium-control modal-input-fix" placeholder="Soyadınız" required />
                                    </div>
