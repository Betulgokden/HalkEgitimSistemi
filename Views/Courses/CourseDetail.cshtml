                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-shield-exclamation display-1 text-danger mb-4"></i>
                        <h3 class="text-white fw-bold">YETKİSİZ ERİŞİM</h3>
                        <p class="text-white-50">Kurs başvuruları sadece <strong>Kursiyer (Student)</strong> hesapları tarafından yapılabilmektedir.</p>
                        <button class="btn btn-outline-light mt-4 rounded-pill px-5" data-bs-dismiss="modal">Kapat</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function applyHalkbotCode() {
        const code = document.getElementById('uiHalkbotCode').value.trim();
        if(!code) {
            Swal.fire({ icon: 'warning', title: 'Hata', text: 'Lütfen bir kod giriniz!', background: '#111827', color: '#fff' });
            return;
        }
        
        document.getElementById('hiddenPromoCode').value = code;
        document.getElementById('originalFeeText').style.textDecoration = "line-through";
        document.getElementById('originalFeeText').style.opacity = "0.5";
        
        const finalFee = document.getElementById('finalFeeText');
        finalFee.innerText = "0,00 ₺";
        finalFee.style.color = "#10B981";
        
        document.getElementById('freeSuccessMessage').style.display = "block";
        
        Swal.fire({
            icon: 'success',
            title: 'Kod Uygulandı!',
            text: 'Tebrikler! Kurs sizin için ücretsiz hale getirildi.',
            background: '#0f172a',
            color: '#fff',
            confirmButtonColor: '#C5A059'
        });
    }

    function setRating(val) {
        document.getElementById('ratingValue').value = val;
        const stars = document.querySelectorAll('.star-icon');
        stars.forEach((star, index) => {
            if (index < val) {
                star.classList.add('active');
            } else {
                star.classList.remove('active');
            }
        });
    }

    function unlockCourse() {
        if (!confirm('500 Halk Point harcanarak başarı kilidi açılacaktır. Onaylıyor musunuz?')) return;

        fetch('/Courses/UnlockWithPoints/@Model.Id', {
            method: 'POST',
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('btnUnlock').style.display = 'none';
                document.getElementById('unlockResult').style.display = 'block';
                document.getElementById('promoCodeVal').innerText = data.code;
                
                var uiCodeInput = document.getElementById('uiHalkbotCode');
                if(uiCodeInput) {
                    uiCodeInput.value = data.code;
                    applyHalkbotCode();
                }

                Swal.fire({
                    title: 'Kilit Açıldı!',
                    text: 'Halkbot kodunuz oluşturuldu ve başvuru formuna otomatik olarak eklendi!',
                    icon: 'success',
                    background: '#0f172a',
                    color: '#fff',
                    confirmButtonText: 'Başvuru Yap',
                    confirmButtonColor: '#C5A059'
                }).then((result) => {
                    if (result.isConfirmed) {
                        var myModal = new bootstrap.Modal(document.getElementById('applicationModal'));
                        myModal.show();
                    }
                });
            } else {
                Swal.fire({ icon: 'error', title: 'Hata', text: data.message, background: '#111827', color: '#fff' });
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        const stars = document.querySelectorAll('.star-icon');
        stars.forEach(star => {
            star.addEventListener('mouseover', function() {
                const val = this.getAttribute('data-value');
                stars.forEach((s, i) => { if (i < val) s.style.color = '#f59e0b'; });
            });
            star.addEventListener('mouseout', function() {
                stars.forEach((s, i) => { if (!s.classList.contains('active')) s.style.color = ''; });
            });
        });
    });
</script>

<style>
    .bg-gold-pulse {
        animation: goldPulse 2s infinite;
    }
    @@keyframes goldPulse {
        0% { box-shadow: 0 0 0 0 rgba(197, 160, 89, 0.4); }
