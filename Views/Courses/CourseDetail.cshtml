                                        <label class="form-label small fw-bold text-gold">T.C. KİMLİK NO</label>
                                         <input type="text" id="tcNo" name="TcNo" class="form-premium-control modal-input-fix" maxlength="11" placeholder="11 Haneli TC No" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-gold">TELEFON</label>
                                         <input type="tel" id="phoneNumber" name="PhoneNumber" class="form-premium-control modal-input-fix" placeholder="05XX XXX XX XX" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-gold">E-POSTA</label>
                                         <input type="email" id="email" name="Email" class="form-premium-control modal-input-fix" placeholder="E-posta adresiniz" required />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-bold text-gold">BAŞVURU NOTUNUZ</label>
                                         <textarea id="notes" name="Notes" class="form-premium-control modal-input-fix" rows="3" placeholder="Eklemek istediğiniz notlar (opsiyonel)..."></textarea>
                                    </div>
                                    <div class="col-12 mt-4">
