                    <i class="bi bi-rocket-takeoff-fill fs-3"></i>
                </div>
                <h3 class="modal-title fw-900 gold-text" style="letter-spacing: 2px; font-family: 'Outfit';">KURSA BAŞVURU FORMU</h3>
                <p class="text-white-50 small mt-2">Borçka Halk Eğitim Merkezi - Dijital Kayıt Sistemi</p>
            </div>
            <div class="modal-body p-4 p-md-5" style="position: relative; z-index: 1070;">
                @if (User.Identity.IsAuthenticated && User.IsInRole("Student"))
                {
