        100% { box-shadow: 0 0 0 0 rgba(197, 160, 89, 0); }
    }
    .rating-input-modern { display: flex; gap: 8px; }
    .rating-input-modern .star-icon { 
        color: var(--text-muted); 
        opacity: 0.6;
        transition: all 0.3s ease; 
        cursor: pointer; 
        font-size: 2.5rem;
    }
    .rating-input-modern .star-icon.active { color: #f59e0b !important; opacity: 1; }
    .avatar-circle {
        width: 45px; height: 45px; border-radius: 50%;
        background: linear-gradient(135deg, #C5A059 0%, #581C1C 100%);
        display: flex; align-items: center; justify-content: center;
        color: white !important; font-weight: 800;
    }
    .form-check-input:checked { background-color: #C5A059; border-color: #C5A059; }
    
    /* Modal İçi Giriş Alanları Fix */
    .modal-input-fix {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(197, 160, 89, 0.3) !important;
        color: #ffffff !important;
    }
    .modal-input-fix:focus {
        background: rgba(255, 255, 255, 0.1) !important;
        border-color: #C5A059 !important;
        box-shadow: 0 0 15px rgba(197, 160, 89, 0.2) !important;
