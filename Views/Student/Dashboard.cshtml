@model HalkEgitimSistemi.Models.Student
@{
    ViewData["Title"] = "Kursiyer Paneli";
    Layout = "_Layout";
}

<div class="container py-5 student-dashboard">
    <!-- Header Section -->
    <div class="row align-items-center mb-5 animate-fadeInDown">
        <div class="col-md-8">
            <h1 class="fw-black m-0" style="font-family: 'Outfit', sans-serif; font-size: 3.2rem; color: var(--text-primary);">Hoş Geldin, @Model.FirstName!</h1>
            <p class="text-muted-premium fs-5">Eğitim yolculuğunu buradan yönetebilirsin.</p>
            <a asp-action="Profile" class="btn btn-premium-sm btn-secondary-glass rounded-pill px-4 mt-2">
                <i class="bi bi-person-gear me-2"></i> Profil Düzenle
            </a>
        </div>
    </div>

    <!-- Quick Access Icons Row -->
    <div class="row g-4 mb-5 justify-content-center text-center animate-fadeInUp" style="animation-delay: 0.1s;">
        <div class="col-4 col-md-2">
            <a asp-action="MyCourses" class="dashboard-icon-link">
                <div class="icon-circle-premium bg-maroon-soft"><i class="bi bi-folder2-open"></i></div>
                <span class="d-block mt-2 fw-bold">Kurslarım</span>
            </a>
        </div>
        <div class="col-4 col-md-2">
            <a asp-action="MyAttendance" class="dashboard-icon-link">
                <div class="icon-circle-premium bg-green-soft"><i class="bi bi-clock-history"></i></div>
                <span class="d-block mt-2 fw-bold">Devamsızlık</span>
            </a>
        </div>
        <div class="col-4 col-md-2">
            <a asp-action="MyCertificates" class="dashboard-icon-link">
                <div class="icon-circle-premium bg-gold-soft"><i class="bi bi-lightbulb"></i></div>
                <span class="d-block mt-2 fw-bold">Sertifikalar</span>
            </a>
        </div>
        <div class="col-4 col-md-2">
            <a asp-action="MyCV" class="dashboard-icon-link">
                <div class="icon-circle-premium bg-blue-soft"><i class="bi bi-file-earmark-person"></i></div>
                <span class="d-block mt-2 fw-bold">Dijital CV</span>
            </a>
        </div>
        <div class="col-4 col-md-2">
            <a asp-action="SkillTree" class="dashboard-icon-link">
                <div class="icon-circle-premium bg-maroon-soft-alt"><i class="bi bi-diagram-3"></i></div>
                <span class="d-block mt-2 fw-bold">Yetenek Ağacı</span>
            </a>
        </div>
        <div class="col-4 col-md-2">
            <a asp-action="Messages" class="dashboard-icon-link">
                <div class="icon-circle-premium bg-gray-soft"><i class="bi bi-chat-dots"></i></div>
                <span class="d-block mt-2 fw-bold">Mesajlarım</span>
            </a>
        </div>
    </div>

    <!-- Announcement Banner -->
    <div class="campaign-banner-modern p-4 mb-5 animate-fadeInUp" style="animation-delay: 0.2s;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center">
                <div class="banner-icon-bg me-3"><i class="bi bi-journal-text"></i></div>
                <div>
                    <h5 class="m-0 fw-bold gold-text">Büyük Konu Anlatımı Yarışması!</h5>
                    <p class="m-0 small text-white-75">Ayın en çok yıldızını alan not sahibine 1 Adet Ücretsiz Kurs Hediyeli <span class="badge bg-gold-premium text-dark ms-1">KAÇIRMA</span></p>
                </div>
            </div>
            <a asp-action="UploadNote" class="btn btn-gold-premium px-4 py-2 fw-bold rounded-pill">HEMEN NOT YÜKLE</a>
        </div>
    </div>

    <!-- Stat Cards Row -->
    <div class="row g-4 mb-5 animate-fadeInUp" style="animation-delay: 0.3s;">
        <div class="col-md-3">
            <div class="stat-card-modern">
                <div class="stat-card-glow-bar bg-gold"></div>
                <div class="stat-icon-small"><i class="bi bi-star-fill"></i></div>
                <div class="stat-value gold-text">@Model.Points</div>
                <div class="stat-label">Halk Point (HP)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-modern">
                <div class="stat-icon-small"><i class="bi bi-calendar-check"></i></div>
                <div class="stat-value">@ViewBag.ApprovedCount</div>
                <div class="stat-label">Aktif Kurslar</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-modern">
                <div class="stat-icon-small"><i class="bi bi-award"></i></div>
                <div class="stat-value">@ViewBag.CompletedCount</div>
                <div class="stat-label">Sertifikalar</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-modern">
                <div class="stat-icon-small"><i class="bi bi-hourglass-split"></i></div>
                <div class="stat-value">@ViewBag.PendingCount</div>
                <div class="stat-label">Bekleyen Başvurular</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Applications Table -->
        <div class="col-lg-8">
            <div class="glass-card-static p-4 h-100 animate-fadeInUp" style="animation-delay: 0.4s;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold m-0"><i class="bi bi-list-task me-2 gold-text"></i> Başvurularım</h5>
                    <a asp-controller="Courses" asp-action="Browse" class="btn btn-premium-sm btn-secondary-glass rounded-pill px-3">
                        <i class="bi bi-plus me-1"></i> Yeni Kurs Bul
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table-modern-premium w-100">
                        <thead>
                            <tr>
                                <th>KURS ADI</th>
                                <th>TARİH</th>
                                <th>DURUM</th>
                                <th>İŞLEM</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.Applications.OrderByDescending(a => a.ApplyDate))
                            {
                                <tr>
                                    <td class="fw-bold">@app.Course?.CourseName</td>
                                    <td class="text-muted small">@app.ApplyDate.ToShortDateString()</td>
                                    <td>
                                        @if (app.Status == ApplicationStatus.Approved) { <span class="badge-status bg-success-soft">Onaylandı</span> }
                                        else if (app.Status == ApplicationStatus.Waiting) { <span class="badge-status bg-warning-soft">Yedek</span> }
                                        else { <span class="badge-status bg-blue-soft">Bekliyor</span> }
                                    </td>
                                    <td>
                                        <a asp-controller="Courses" asp-action="CourseDetail" asp-route-id="@app.CourseId" class="text-gold-hover"><i class="bi bi-eye-fill"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Digital CV Card -->
        <div class="col-lg-4">
            <div class="glass-card-static p-4 h-100 animate-fadeInUp" style="animation-delay: 0.5s;">
                <h5 class="fw-bold mb-4"><i class="bi bi-file-person me-2 gold-text"></i> Dijital CV</h5>
                <div class="cv-preview-box p-4 text-center mb-4">
                    <div class="cv-initials">@Model.FirstName[0]@Model.LastName[0]</div>
                    <h5 class="fw-bold mt-3 mb-1">@Model.FirstName @Model.LastName</h5>
                    <p class="text-muted-premium small">@Model.Email</p>
                </div>
                <p class="small text-muted-premium mb-4">Sistemdeki eğitimlerinizi ve sertifikalarınızı tek bir dökümanda birleştirin.</p>
                <a asp-action="MyCV" class="btn btn-premium-sm btn-secondary-glass w-100 py-2 rounded-pill">
                    <i class="bi bi-eye me-2"></i> CV'mi Görüntüle
                </a>
            </div>
        </div>
    </div>

    <!-- Bottom Actions Row -->
    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <div class="glass-card-static p-4 animate-fadeInUp" style="animation-delay: 0.6s;">
                <div class="d-flex align-items-center mb-3">
                    <div class="action-icon-circle"><i class="bi bi-palette"></i></div>
                    <h5 class="fw-bold m-0 ms-3">Sanal Sergiye Eser Yükle</h5>
                </div>
                <p class="small text-muted-premium mb-4">Eserlerinizi veya videolarınızı sanal galerimize yükleyin, isminize tıklandığında CV'niz görünsün.</p>
                <a asp-action="UploadArtwork" class="btn btn-premium-sm btn-secondary-glass w-100 rounded-pill py-2">
                    <i class="bi bi-eye me-2"></i> Eser Paylaş
                </a>
            </div>
        </div>
        <div class="col-md-6">
            <div class="cta-card-modern p-4 animate-fadeInUp" style="animation-delay: 0.7s;">
                <div class="text-center">
                    <div class="cta-icon-float"><i class="bi bi-cloud-upload-fill"></i></div>
                    <h4 class="fw-black mt-3 mb-2">NOT YÜKLE</h4>
                    <p class="small text-white-50 mb-4">En çok yıldızı topla, ücretsiz kursu kap!</p>
                    <a asp-action="UploadNote" class="btn btn-gold-premium rounded-pill px-5 py-2 fw-black">HEMEN BAŞLA</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .student-dashboard {
        --icon-size: 64px;
        --card-radius: 24px;
    }

    /* Icon Styles */
    .icon-circle-premium {
        width: var(--icon-size);
        height: var(--icon-size);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 1.5rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(197, 160, 89, 0.1);
    }
    .bg-maroon-soft { background: rgba(88, 28, 28, 0.08); color: #581C1C; }
    .bg-green-soft { background: rgba(16, 185, 129, 0.08); color: #10b981; }
    .bg-gold-soft { background: rgba(197, 160, 89, 0.08); color: #C5A059; }
    .bg-blue-soft { background: rgba(6, 182, 212, 0.08); color: #06b6d4; }
    .bg-maroon-soft-alt { background: rgba(88, 28, 28, 0.05); color: #882b2b; }
    .bg-gray-soft { background: rgba(107, 114, 128, 0.08); color: #6b7280; }

    .dashboard-icon-link:hover .icon-circle-premium {
        transform: translateY(-8px) scale(1.05);
        box-shadow: 0 10px 20px rgba(197, 160, 89, 0.1);
        background: var(--primary);
        color: white;
    }

    /* Banner */
    .campaign-banner-modern {
        background: #0a0a0a;
        border-radius: var(--card-radius);
        border: 1px solid rgba(197, 160, 89, 0.3);
        box-shadow: 0 0 30px rgba(197, 160, 89, 0.1);
    }
    .banner-icon-bg {
        width: 48px; height: 48px; border-radius: 12px;
        background: rgba(197, 160, 89, 0.2);
        display: flex; align-items: center; justify-content: center;
        color: #C5A059; font-size: 1.3rem;
    }

    /* Stat Cards */
    .stat-card-modern {
        background: var(--bg-glass);
        padding: 2rem 1.5rem;
        border-radius: var(--card-radius);
        border: 1px solid var(--border-glass);
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .stat-card-modern:hover { transform: translateY(-5px); border-color: var(--primary); }
    .stat-card-glow-bar { position: absolute; top: 0; left: 15%; right: 15%; height: 3px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }
    .stat-icon-small { font-size: 1.2rem; color: var(--text-muted); margin-bottom: 0.5rem; }
    .stat-value { font-size: 2.8rem; font-weight: 900; line-height: 1; margin-bottom: 0.5rem; }
    .stat-label { font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }

    /* Table */
    .table-dashboard-modern th { font-size: 0.75rem; color: var(--text-muted); padding: 12px 0; border-bottom: 1px solid var(--border-glass); }
    .table-dashboard-modern td { padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.02); }
    .badge-status { padding: 6px 12px; border-radius: 10px; font-size: 0.75rem; font-weight: 700; }

    /* CV Box */
    .cv-preview-box { background: rgba(197, 160, 89, 0.03); border-radius: 20px; }
    .cv-initials {
        width: 100px; height: 100px; border-radius: 50%;
        background: #fdfaf1; color: #581C1C;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto; font-size: 2.5rem; font-weight: 900;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }

    /* CTA Card */
    .cta-card-modern {
        background: #0a0a0a;
        border-radius: var(--card-radius);
        border: 1px solid rgba(197, 160, 89, 0.2);
        display: flex; align-items: center; justify-content: center;
    }
    .cta-icon-float { font-size: 3rem; color: #C5A059; animation: float 3s ease-in-out infinite; }
    @@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

    /* Theme Adaptation */
    [data-theme="dark"] .stat-card-modern, [data-theme="dark"] .glass-card-static {
        background: rgba(15, 15, 20, 0.7) !important;
        box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    }
    [data-theme="light"] .cv-initials { background: #581C1C; color: #fdfaf1; }
    [data-theme="light"] .stat-card-modern { background: #ffffff !important; box-shadow: 0 10px 30px rgba(88,28,28,0.05) !important; }
    [data-theme="light"] .campaign-banner-modern, [data-theme="light"] .cta-card-modern { background: #fdfaf1; border-color: #C5A059; }
</style>
