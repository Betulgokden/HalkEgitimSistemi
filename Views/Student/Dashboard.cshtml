@model HalkEgitimSistemi.Models.Student
@{
    ViewData["Title"] = "Kursiyer Paneli";
}

<div class="container-fluid student-dashboard px-4 py-5">
    <!-- Welcome Section -->
    <div class="welcome-banner glass-card-main p-5 mb-5 animate-fadeInDown" style="border-radius: 35px; background: linear-gradient(135deg, rgba(88, 28, 28, 0.4) 0%, rgba(15, 23, 42, 0.4) 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center mb-3">
                    <span class="badge bg-gold-soft text-gold px-3 py-2 rounded-pill fw-bold animate-pulse-slow">AKTİF ÖĞRENCİ</span>
                    <span class="ms-3 text-white-50"><i class="bi bi-calendar3 me-2"></i> @DateTime.Now.ToString("dd MMMM yyyy")</span>
                </div>
                <h1 class="display-3 fw-black mb-3">Hoş Geldin, <span class="gold-text">@Model.FirstName!</span></h1>
                <p class="lead text-white-70 mb-0">Eğitim yolculuğunda yeni başarılar elde etmeye hazır mısın? Bugün 3 yeni ders notu paylaşıldı.</p>
            </div>
            <div class="col-lg-4 text-center text-lg-end mt-4 mt-lg-0">
                <div class="points-circle-lg">
                    <div class="points-value">@Model.Points</div>
                    <div class="points-label">HALK PUAN</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card-modern animate-fadeInUp" style="animation-delay: 0.1s;">
                <div class="stat-card-glow-bar bg-maroon-soft"></div>
                <i class="bi bi-journal-check stat-icon-small"></i>
                <div class="stat-value">@ViewBag.ApprovedCount</div>
                <div class="stat-label">Aktif Kurslar</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-modern animate-fadeInUp" style="animation-delay: 0.2s;">
                <div class="stat-card-glow-bar bg-green-soft"></div>
                <i class="bi bi-patch-check stat-icon-small"></i>
                <div class="stat-value">@ViewBag.CompletedCount</div>
                <div class="stat-label">Sertifikalar</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-modern animate-fadeInUp" style="animation-delay: 0.3s;">
                <div class="stat-card-glow-bar bg-gold-soft"></div>
                <i class="bi bi-star stat-icon-small"></i>
                <div class="stat-value">@Model.SuccessScore</div>
                <div class="stat-label">Yetenek Skoru</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-modern animate-fadeInUp" style="animation-delay: 0.4s;">
                <div class="stat-card-glow-bar bg-blue-soft"></div>
                <i class="bi bi-hourglass-split stat-icon-small"></i>
                <div class="stat-value">@ViewBag.PendingCount</div>
                <div class="stat-label">Bekleyenler</div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Box -->
    <div class="glass-card-static p-4 mb-5 animate-fadeInUp" style="border-radius: 30px; animation-delay: 0.5s; background: rgba(88, 28, 28, 0.1); border: 1px solid rgba(197, 160, 89, 0.2) !important;">
        <div class="row g-4 text-center justify-content-center">
            <div class="col-4 col-md-2">
                <a asp-action="MyCourses" class="dashboard-icon-link text-decoration-none">
                    <div class="icon-circle-premium bg-maroon-soft-alt"><i class="bi bi-folder2-open"></i></div>
                    <div class="mt-2 small fw-bold text-white-70">Kurslarım</div>
                </a>
            </div>
            <div class="col-4 col-md-2">
                <a asp-action="MyAttendance" class="dashboard-icon-link text-decoration-none">
                    <div class="icon-circle-premium bg-green-soft"><i class="bi bi-clock-history"></i></div>
                    <div class="mt-2 small fw-bold text-white-70">Devamsızlık</div>
                </a>
            </div>
            <div class="col-4 col-md-2">
                <a asp-action="MyCertificates" class="dashboard-icon-link text-decoration-none">
                    <div class="icon-circle-premium bg-gold-soft"><i class="bi bi-patch-check"></i></div>
                    <div class="mt-2 small fw-bold text-white-70">Sertifikalar</div>
                </a>
            </div>
            <div class="col-4 col-md-2">
                <a asp-action="MyCV" class="dashboard-icon-link text-decoration-none">
                    <div class="icon-circle-premium bg-blue-soft"><i class="bi bi-file-earmark-person"></i></div>
                    <div class="mt-2 small fw-bold text-white-70">Dijital CV</div>
                </a>
            </div>
            <div class="col-4 col-md-2">
                <a asp-action="SkillTree" class="dashboard-icon-link text-decoration-none">
                    <div class="icon-circle-premium bg-maroon-soft"><i class="bi bi-tree"></i></div>
                    <div class="mt-2 small fw-bold text-white-70">Yetenek Ağacı</div>
                </a>
            </div>
            <div class="col-4 col-md-2">
                <a asp-action="Messages" class="dashboard-icon-link text-decoration-none">
                    <div class="icon-circle-premium bg-gray-soft"><i class="bi bi-chat-dots"></i></div>
                    <div class="mt-2 small fw-bold text-white-70">Mesajlarım</div>
                </a>
            </div>
        </div>
    </div>
        <!-- Main Content Area -->
        <div class="col-lg-8">
            <!-- Modern Action Cards -->
            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <div class="glass-card p-4 h-100 border-0 shadow-lg animate-fadeInLeft" style="background: rgba(255, 255, 255, 0.03); border-radius: 24px; border: 1px solid rgba(255,255,255,0.05) !important;">
                        <div class="d-flex align-items-center mb-4">
                            <div class="icon-box-lg bg-vibrant-orange me-3 rounded-4 shadow-sm">
                                <i class="bi bi-controller fs-3 text-white"></i>
                            </div>
                            <div>
                                <h4 class="fw-black mb-0">ÖDEVLER VE SINAVLAR</h4>
                                <p class="text-white-50 small mb-0">Kurs başarılarını takip et</p>
                            </div>
                        </div>
                        <p class="text-white-50 mb-4">Eğitim sürecindeki aktif ödevlerini gör, sınav tarihlerini kaçırma ve başarı puanlarını takip et.</p>
                        <div class="mt-auto">
                            <a asp-action="MyAssignments" class="btn btn-gold-premium rounded-pill px-5 py-3 fw-bold w-100">
                                <i class="bi bi-lightning-charge-fill me-2"></i> HEMEN BAŞLA
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="glass-card p-4 h-100 border-0 shadow-lg animate-fadeInRight" style="background: rgba(255, 255, 255, 0.03); border-radius: 24px; border: 1px solid rgba(255,255,255,0.05) !important;">
                        <div class="d-flex align-items-center mb-4">
                            <div class="icon-box-lg bg-vibrant-purple me-3 rounded-4 shadow-sm">
                                <i class="bi bi-book-half fs-3 text-white"></i>
                            </div>
                            <div>
                                <h4 class="fw-black mb-0">SANAL KÜTÜPHANE</h4>
                                <p class="text-white-50 small mb-0">Notlarını paylaş, puan kazan</p>
                            </div>
                        </div>
                        <p class="text-white-50 mb-4">Hazırladığın ders notlarını sisteme yükleyerek diğer öğrencilerle paylaşabilir ve Halk Puan kazanabilirsin.</p>
                        <div class="mt-auto">
                            <a asp-action="UploadNote" class="btn btn-gold-premium rounded-pill px-5 py-3 fw-bold w-100">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i> HEMEN NOT YÜKLE
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Courses Table -->
            <div class="glass-card-static p-5 mb-5 animate-fadeInUp" style="border-radius: 30px; background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255,255,255,0.05);">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-black m-0"><i class="bi bi-play-circle me-2 gold-text"></i> SON AKTİVİTELER</h4>
                    <a asp-action="MyCourses" class="btn btn-premium-sm btn-secondary-glass">Hepsini Gör</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-dashboard-modern">
                        <thead>
                            <tr>
                                <th>KURS ADI</th>
                                <th>BAŞVURU TARİHİ</th>
                                <th>DURUM</th>
                                <th>İŞLEM</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.Applications.OrderByDescending(a => a.ApplyDate).Take(3))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-white">@app.Course?.CourseName</div>
                                        <div class="small text-white-50">@app.Course?.Category?.CategoryName</div>
                                    </td>
                                    <td class="text-white-50">@app.ApplyDate.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <span class="badge-status @(app.Status == ApplicationStatus.Approved ? "bg-green-soft text-success" : "bg-gold-soft text-gold")">
                                            @(app.Status == ApplicationStatus.Approved ? "AKTİF" : "BEKLEMEDE")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@app.CourseId" class="btn btn-icon-glass btn-sm"><i class="bi bi-chevron-right"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Career Opportunities Section (NEW) -->
            <div class="career-opportunities-box glass-card-static p-5 animate-fadeInUp" style="border-radius: 30px; background: linear-gradient(135deg, rgba(197, 160, 89, 0.05) 0%, rgba(88, 28, 28, 0.1) 100%); border: 1.5px solid rgba(197, 160, 89, 0.3);">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-black m-0"><i class="bi bi-briefcase me-2 gold-text"></i> SANA ÖZEL İŞ İLANLARI</h4>
                        <p class="text-white-50 small mb-0">Yeteneklerine uygun en yeni kariyer fırsatları</p>
                    </div>
                    <a asp-controller="JobPostings" asp-action="Index" class="btn btn-gold-premium rounded-pill px-4">Tümünü Gör</a>
                </div>
                
                <div class="row g-3">
                    <div class="col-12">
                        <div class="job-item-mini p-3 rounded-4 mb-2 d-flex align-items-center justify-content-between" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                            <div class="d-flex align-items-center gap-3">
                                <div class="job-icon-sm bg-maroon-soft-alt rounded-3 p-2"><i class="bi bi-laptop fs-5"></i></div>
                                <div>
                                    <div class="fw-bold text-white small">Mobilya Tasarım Ustası</div>
                                    <div class="text-white-50 x-small">Artvin Ahşap Dünyası • 35.000₺ - 45.000₺</div>
                                </div>
                            </div>
                            <a asp-controller="JobPostings" asp-action="Details" asp-route-id="-1" class="btn btn-premium-sm btn-secondary-glass py-2 px-3">İncele</a>
                        </div>
                        <div class="job-item-mini p-3 rounded-4 mb-2 d-flex align-items-center justify-content-between" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                            <div class="d-flex align-items-center gap-3">
                                <div class="job-icon-sm bg-green-soft rounded-3 p-2"><i class="bi bi-code-slash fs-5"></i></div>
                                <div>
                                    <div class="fw-bold text-white small">Full Stack Web Geliştirici</div>
                                    <div class="text-white-50 x-small">Borçka Yazılım • 45.000₺ - 65.000₺</div>
                                </div>
                            </div>
                            <a asp-controller="JobPostings" asp-action="Details" asp-route-id="-2" class="btn btn-premium-sm btn-secondary-glass py-2 px-3">İncele</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Area -->
        <div class="col-lg-4">
            <!-- CV Profile Card -->
            <div class="glass-card-static p-4 mb-4 animate-fadeInUp" style="border-radius: 30px; animation-delay: 0.5s;">
                <h5 class="fw-bold mb-4"><i class="bi bi-file-person me-2 gold-text"></i> Dijital CV</h5>
                <div class="cv-preview-box p-4 text-center mb-4">
                    <div class="cv-initials">@Model.FirstName[0]@Model.LastName[0]</div>
                    <h5 class="fw-bold mt-3 mb-1">@Model.FirstName @Model.LastName</h5>
                    <p class="text-muted-premium small">@Model.Email</p>
                </div>
                <p class="small text-muted-premium mb-4 text-center">Sistemdeki eğitimlerinizi ve sertifikalarınızı profesyonel bir portfolyoda birleştirin.</p>
                <a asp-action="MyCV" class="btn btn-premium-sm btn-secondary-glass w-100 py-3 rounded-pill fw-bold">
                    <i class="bi bi-eye me-2"></i> CV'Mİ GÖRÜNTÜLE
                </a>
            </div>

            <!-- Sanal Sergi Link -->
            <div class="glass-card-static p-4 animate-fadeInUp" style="border-radius: 30px; animation-delay: 0.6s; background: linear-gradient(135deg, rgba(197, 160, 89, 0.05) 0%, rgba(0,0,0,0.2) 100%);">
                <div class="d-flex align-items-center mb-3">
                    <div class="action-icon-circle bg-gold-soft"><i class="bi bi-palette text-gold"></i></div>
                    <h5 class="fw-bold m-0 ms-3">Sanal Sergi</h5>
                </div>
                <p class="small text-muted-premium mb-4">Ürettiğiniz eserleri galerimizde sergileyin, yeteneğinizi dünyaya gösterin.</p>
                <a asp-action="UploadArtwork" class="btn btn-premium-sm btn-gold-premium w-100 rounded-pill py-3 fw-bold">
                    <i class="bi bi-plus-circle me-2"></i> ESER YÜKLE
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .student-dashboard {
        --card-radius: 30px;
    }

    .icon-box-lg {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
    }

    .bg-vibrant-orange { background: linear-gradient(135deg, #FF8C00, #FF4500); }
    .bg-vibrant-purple { background: linear-gradient(135deg, #8A2BE2, #4B0082); }

    .points-circle-lg {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        border: 4px solid #C5A059;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(197, 160, 89, 0.1);
        box-shadow: 0 0 30px rgba(197, 160, 89, 0.2);
    }
    .points-value { font-size: 3rem; font-weight: 900; color: #C5A059; line-height: 1; }
    .points-label { font-size: 0.7rem; font-weight: 800; letter-spacing: 2px; color: #ffffff; margin-top: 5px; }

    .cv-initials {
        width: 80px; height: 80px; margin: 0 auto;
        background: linear-gradient(135deg, #C5A059, #581C1C);
        border-radius: 50%; display: flex; align-items: center;
        justify-content: center; font-size: 2rem; font-weight: 900; color: white;
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }

    .action-icon-circle {
        width: 45px; height: 45px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem;
    }

    .stat-card-modern {
        background: rgba(15, 23, 42, 0.6);
        padding: 2.5rem 1.5rem;
        border-radius: var(--card-radius);
        border: 1px solid rgba(255,255,255,0.05);
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .stat-card-modern:hover { transform: translateY(-8px); border-color: #C5A059; }
    .stat-card-glow-bar { position: absolute; top: 0; left: 15%; right: 15%; height: 4px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }
    .stat-value { font-size: 2.5rem; font-weight: 900; margin-bottom: 0.2rem; }
    .stat-label { font-size: 0.75rem; font-weight: 800; letter-spacing: 1px; color: rgba(255,255,255,0.4); text-transform: uppercase; }

    [data-theme="light"] .stat-card-modern {
        background: white;
        box-shadow: 0 10px 30px rgba(88,28,28,0.05);
    }
    [data-theme="light"] .stat-value { color: #581C1C; }
    [data-theme="light"] .stat-label { color: #8a2e2e; }

    .badge-status { padding: 6px 12px; border-radius: 10px; font-size: 0.7rem; font-weight: 800; }

    .icon-circle-premium {
        width: 55px;
        height: 55px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 1.4rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255,255,255,0.05);
    }
    
    .dashboard-icon-link:hover .icon-circle-premium {
        transform: translateY(-8px) scale(1.1);
        box-shadow: 0 10px 20px rgba(197, 160, 89, 0.2);
        background: #C5A059 !important;
        color: #3B0F0F !important;
    }

    .bg-maroon-soft { background: rgba(88, 28, 28, 0.15); color: #FF8787; }
    .bg-maroon-soft-alt { background: rgba(88, 28, 28, 0.1); color: #ff5555; }
    .bg-green-soft { background: rgba(16, 185, 129, 0.1); color: #10b981; }
    .bg-gold-soft { background: rgba(197, 160, 89, 0.1); color: #C5A059; }
    .bg-blue-soft { background: rgba(6, 182, 212, 0.1); color: #06b6d4; }
    .bg-gray-soft { background: rgba(255, 255, 255, 0.05); color: #cbd5e1; }
</style>
