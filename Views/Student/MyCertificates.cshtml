@model List<HalkEgitimSistemi.Models.Application>
@using HalkEgitimSistemi.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "E-Sertifikalarım";
}

<div class="container py-4">
    <div class="glass-card-static p-4 mb-4 animate-fadeInUp">
        <h2 style="font-family:'Outfit';font-weight:800;margin:0;">
            <i class="bi bi-patch-check me-2" style="color:var(--info);"></i>E-Sertifikalarım
        </h2>
        <p class="mb-0" style="color:var(--text-muted);">Başarıyla tamamladığınız kursların dijital sertifikaları</p>
    </div>

    @if (!Model.Any(a => a.IsCompleted))
    {
        <div class="glass-card-static p-5 text-center animate-scaleIn">
            <i class="bi bi-award mb-3" style="font-size:3rem;color:var(--text-muted);opacity:0.5;"></i>
            <h5>Henüz kazanılmış bir sertifikanız yok</h5>
            <p style="color:var(--text-muted);">Kursları başarıyla tamamladığınızda sertifikalarınız burada görünecektir.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var app in Model.Where(a => a.IsCompleted))
            {
                <div class="col-md-6">
                    <div class="glass-card-static p-4 h-100 animate-fadeInUp d-flex align-items-center">
                        <div class="certificate-icon me-4" style="width:70px;height:70px;background:var(--gradient-info);border-radius:15px;display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-glow-sm);">
                            <i class="bi bi-patch-check-fill" style="font-size:2rem;color:white;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="mb-1" style="font-weight:700;">@app.Course?.CourseName</h5>
                            <div class="text-muted small mb-3">Tamamlanma Tarihi: @app.Course?.EndDate.ToString("dd.MM.yyyy")</div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Certificates" asp-action="Verify" asp-route-code="@app.CertificateCode" class="btn btn-sm btn-premium btn-primary-glow px-3">
                                    <i class="bi bi-eye me-1"></i>Görüntüle
                                </a>
                                <button onclick="window.print()" class="btn btn-sm btn-premium btn-secondary-glass px-3">
                                    <i class="bi bi-printer me-1"></i>Yazdır
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>