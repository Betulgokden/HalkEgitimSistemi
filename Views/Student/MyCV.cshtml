@model HalkEgitimSistemi.Models.Student
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CV - @Model.FirstName @Model.LastName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #2563eb;
            --dark: #0f172a;
            --gray: #64748b;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            color: #1e293b;
        }
        .cv-container {
            max-width: 900px;
            margin: 40px auto;
            background: white;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            border-radius: 16px;
            overflow: hidden;
            display: flex;
        }
        .sidebar {
            width: 300px;
            background: var(--dark);
            color: white;
            padding: 40px 30px;
        }
        .main-content {
            flex: 1;
            padding: 40px 50px;
        }
        .profile-img {
            width: 150px;
            height: 150px;
            border-radius: 20px;
            object-fit: cover;
            margin-bottom: 25px;
            border: 4px solid rgba(255,255,255,0.1);
        }
        .section-title {
            font-family: 'Outfit';
            font-weight: 800;
            font-size: 1.2rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 20px;
            padding-bottom: 8px;
            border-bottom: 2px solid rgba(255,255,255,0.1);
        }
        .main-content .section-title {
            color: var(--dark);
            border-bottom-color: #f1f5f9;
            font-size: 1.4rem;
        }
        .contact-item {
            margin-bottom: 15px;
            font-size: 0.9rem;
            color: rgba(255,255,255,0.7);
        }
        .contact-item i {
            width: 25px;
            color: white;
        }
        .skill-badge {
            background: rgba(255,255,255,0.1);
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 0.8rem;
            margin-right: 5px;
            margin-bottom: 8px;
            display: inline-block;
        }
        .cert-card {
            border-left: 3px solid var(--primary);
            padding-left: 20px;
            margin-bottom: 30px;
            position: relative;
        }
        .cert-card::before {
            content: '';
            position: absolute;
            left: -7px;
            top: 0;
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: var(--primary);
        }
        .cert-title {
            font-weight: 700;
            color: var(--dark);
            margin: 0;
        }
        .cert-date {
            font-size: 0.85rem;
            color: var(--gray);
            margin-bottom: 5px;
        }
        .cert-verify {
            font-size: 0.75rem;
            color: #C5A059;
            font-weight: 600;
        }
        @@media print {
            body { background: white; }
            .cv-container { box-shadow: none; margin: 0; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>
    <div class="container no-print py-3 text-center">
        <button onclick="window.print()" class="btn btn-dark btn-sm px-4">
            <i class="bi bi-printer me-2"></i> PDF Olarak Yazdır / Kaydet
        </button>
    </div>

    <div class="cv-container">
        <div class="sidebar">
            @if (!string.IsNullOrEmpty(Model.ProfilePicture))
            {
                <img src="@Model.ProfilePicture" class="profile-img" />
            }
            else
            {
                <div class="profile-img d-flex align-items-center justify-content-center bg-primary text-white" style="font-size: 4rem;">
                    @Model.FirstName[0]@Model.LastName[0]
                </div>
            }
            
            <h2 style="font-family: 'Outfit'; font-weight: 800; font-size: 1.8rem; margin-bottom: 5px;">@Model.FirstName</h2>
            <h2 style="font-family: 'Outfit'; font-weight: 300; font-size: 1.8rem; color: rgba(255,255,255,0.6);">@Model.LastName</h2>
            
            <div class="mt-5">
                <div class="section-title">İletişim</div>
                <div class="contact-item"><i class="bi bi-envelope"></i> @Model.Email</div>
                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                {
                    <div class="contact-item"><i class="bi bi-telephone"></i> @Model.PhoneNumber</div>
                }
                @if (!string.IsNullOrEmpty(Model.TcNo) && ViewBag.IsPublicView != true)
                {
                    <div class="contact-item"><i class="bi bi-shield-check"></i> T.C.: @(Model.TcNo.Substring(0, 3))******@(Model.TcNo.Substring(Model.TcNo.Length - 2))</div>
                }
                @if (Model.BirthDate.HasValue)
                {
                    <div class="contact-item"><i class="bi bi-calendar-event"></i> @Model.BirthDate.Value.ToString("dd.MM.yyyy")</div>
                }
                @if (!string.IsNullOrEmpty(Model.BirthPlace))
                {
                    <div class="contact-item"><i class="bi bi-geo-alt"></i> @Model.BirthPlace</div>
                }
                
                @if (!string.IsNullOrEmpty(Model.LinkedInUrl))
                {
                    <div class="contact-item">
                        <i class="bi bi-linkedin"></i> 
                        <a href="@Model.LinkedInUrl" target="_blank" style="color: inherit; text-decoration: none;">LinkedIn Profili</a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.GithubUrl))
                {
                    <div class="contact-item">
                        <i class="bi bi-github"></i> 
                        <a href="@Model.GithubUrl" target="_blank" style="color: inherit; text-decoration: none;">GitHub Portfolyo</a>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Skills))
            {
                <div class="mt-5">
                    <div class="section-title">Yetenekler</div>
                    @foreach (var skill in Model.Skills.Split(','))
                    {
                        <span class="skill-badge">@skill.Trim()</span>
                    }
                </div>
            }
        </div>

        <div class="main-content">
            <div class="section-title">Hakkımda</div>
            <p style="color: #475569; line-height: 1.7; margin-bottom: 40px;">
                @(string.IsNullOrEmpty(Model.Summary) ? "Henüz bir özet bilgi eklenmemiş." : Model.Summary)
            </p>

            <div class="section-title">Eğitim ve Sertifikalar</div>
            @{
                var certificates = Model.Applications.Where(a => a.Status == ApplicationStatus.Approved || a.IsCompleted).OrderByDescending(a => a.ApplyDate);
            }

            @if (certificates.Any())
            {
                @foreach (var cert in certificates)
                {
                    <div class="cert-card">
                        <div class="cert-date">@cert.ApplyDate.ToString("MMMM yyyy")</div>
                        <h5 class="cert-title">@cert.Course?.CourseName</h5>
                        <div class="cert-verify">
                            <i class="bi bi-patch-check-fill"></i> Halk Eğitim Merkezi Onaylı 
                            @if(cert.IsCompleted) { <span class="badge bg-success ms-2" style="font-size: 10px;">Tamamlandı</span> }
                        </div>
                        <p class="mt-2 small text-muted">Bu eğitim, Halk Eğitim Merkezi bünyesinde @(cert.Course?.DurationHours) saatlik müfredat ile başarıyla @(cert.IsCompleted ? "tamamlanmıştır" : "devam etmektedir").</p>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">Henüz onaylanmış bir eğitim bulunmamaktadır.</p>
            }

            <div class="mt-5 pt-5 text-center" style="border-top: 1px solid #f1f5f9;">
                <p class="small text-muted" style="letter-spacing: 0.1em;">BU BELGE HALK EĞİTİM MERKEZİ SİSTEMİ TARAFINDAN DİJİTAL OLARAK ÜRETİLMİŞTİR.</p>
            </div>
        </div>
    </div>
</body>
</html>

