@model List<HalkEgitimSistemi.Models.AcademicNote>
@{
    ViewData["Title"] = "Konu Anlatımı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var courses = ViewBag.Courses as List<HalkEgitimSistemi.Models.Course>;
    int? selectedCourse = ViewBag.SelectedCourse;
}

<div class="container-fluid py-5">
    <div class="d-flex align-items-center justify-content-between mb-5 animate-fadeIn">
        <div>
            <h1 class="h2 fw-bold text-gradient-primary mb-1">
                <i class="bi bi-book-half me-2"></i>Konu Anlatımı
            </h1>
            <p class="text-muted-premium">Derslerinize ait müfredat içerikleri ve çalışma notları.</p>
        </div>
        
        <div class="d-flex gap-3 align-items-center">
            <form method="get" class="d-flex gap-2">
                <select name="courseId" class="form-select bg-glass border-glass text-white rounded-pill px-4" onchange="this.form.submit()">
                    <option value="">Tüm Dersler</option>
                    @foreach (var c in courses)
                    {
                        <!option value="@c.Id" @(selectedCourse == c.Id ? "selected" : "")>@c.CourseName</!option>
                    }
                </select>
            </form>
            @if (User.IsInRole("Admin") || User.IsInRole("Instructor"))
            {
                <button class="btn btn-primary-glow rounded-pill px-4 text-white" data-bs-toggle="modal" data-bs-target="#addNoteModal" style="color: white !important;">
                    <i class="bi bi-plus-lg me-2" style="color: white !important;"></i> İçerik Ekle
                </button>
            }
        </div>
    </div>

    <div class="row g-4 stagger-children">
        @foreach (var note in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="glass-card-static h-100 p-4 transition-all hover-translate-y border-glass">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-info-soft text-info rounded-pill px-3">@note.Course?.CourseName</span>
                        <small class="text-muted-premium">@note.CreatedAt.ToString("dd MMM yyyy")</small>
                    </div>
                    <h4 class="fw-bold mb-3 text-white">@note.Title</h4>
                    <p class="text-muted-premium small mb-4 line-clamp-3">@note.Content</p>
                    
                    <div class="mt-auto d-flex gap-2">
                        <button class="btn btn-secondary-glass btn-sm rounded-pill px-3 w-100" onclick="alert('Detaylı içerik yükleniyor...')">
                            <i class="bi bi-eye me-2"></i> İncele
                        </button>
                        @if (!string.IsNullOrEmpty(note.PdfUrl))
                        {
                            <a href="@note.PdfUrl" class="btn btn-danger-soft btn-sm rounded-circle" target="_blank">
                                <i class="bi bi-file-earmark-pdf"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- GÜNCEL/HAZIRLANAN İÇERİK PLACEHOLDER -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card-static h-100 p-4 border-glass border-dashed animate-pulse" style="border-style: dashed !important; opacity: 0.8;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="badge bg-warning-soft text-warning rounded-pill px-3">HAZIRLANIYOR</span>
                    <i class="bi bi-clock-history text-warning"></i>
                </div>
                <h4 class="fw-bold mb-3 text-white">Yeni Konu Anlatımı</h4>
                <p class="text-muted-premium small mb-4">Müfredat güncellemeleri doğrultusunda hazırlanan yeni konu anlatımı yakında sisteme yüklenecektir.</p>
                
                <div class="mt-auto">
                    <button class="btn btn-dark-glass btn-sm rounded-pill px-3 w-100 disabled" style="cursor: not-allowed;">
                        <i class="bi bi-cloud-arrow-down me-2"></i> Henüz Yüklenmedi
                    </button>
                </div>
            </div>
        </div>
        
        @if (!Model.Any() && false) @* Modifying logic slightly to always show the placeholder if list is empty *@
        {
            <div class="col-12 text-center py-5 opacity-50">
                <i class="bi bi-journal-x display-1"></i>
                <h4 class="mt-3">Henüz bu kategoride içerik bulunmamaktadır.</h4>
            </div>
        }
    </div>
</div>

<!-- Add Note Modal -->
<div class="modal fade" id="addNoteModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-glass-strong border-glass text-white">
            <div class="modal-header border-white-10">
                <h5 class="modal-title fw-bold">Yeni Konu Anlatımı Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddNote" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Ders Seçimi</label>
                            <select name="CourseId" class="form-select bg-glass border-glass text-white" required>
                                @foreach (var c in courses) { <option value="@c.Id">@c.CourseName</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Başlık</label>
                            <input name="Title" class="form-control bg-glass border-glass text-white" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-muted">İçerik Özeti</label>
                            <textarea name="Content" class="form-control bg-glass border-glass text-white" rows="4" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-muted">PDF Kaynak Linki (Opsiyonel)</label>
                            <input name="PdfUrl" class="form-control bg-glass border-glass text-white" placeholder="https://..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-white-10">
                    <button type="button" class="btn btn-secondary-glass rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary-glow rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

