@model HalkEgitimSistemi.Models.AcademicTest
@{
    ViewData["Title"] = Model.TestTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="test-header mb-5 animate-fadeIn">
        <div class="d-flex align-items-center gap-3 mb-2">
            <span class="badge bg-secondary-glow rounded-pill px-3">@Model.Course?.CourseName</span>
            <span class="text-muted-premium small"><i class="bi bi-clock me-1"></i> @DateTime.Now.ToShortDateString()</span>
        </div>
        <h1 class="fw-bold text-white display-5">@Model.TestTitle</h1>
        <p class="text-muted-premium">Lütfen tüm soruları dikkatlice yanıtlayın. Başarılar dileriz!</p>
    </div>

    <div class="test-container" id="testApp">
        <div class="row g-4 stagger-children">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                <div class="col-12 question-card" id="q-@i">
                    <div class="glass-card-static p-5 border-glass position-relative overflow-hidden">
                        <div class="q-number position-absolute top-0 end-0 p-4 opacity-10 display-1 fw-bold">@(i + 1)</div>
                        
                        <h4 class="fw-bold text-white mb-4 position-relative z-1">
                            <span class="text-secondary me-2">Soru @(i + 1):</span> @q.QuestionText
                        </h4>
                        
                        <div class="options-grid row g-3 position-relative z-1">
                            <div class="col-md-6">
                                <div class="option-btn p-3 glass-card border-glass cursor-pointer" onclick="selectOption(@i, 'A')">
                                    <span class="opt-label fw-bold me-2">A)</span> @q.OptionA
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="option-btn p-3 glass-card border-glass cursor-pointer" onclick="selectOption(@i, 'B')">
                                    <span class="opt-label fw-bold me-2">B)</span> @q.OptionB
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="option-btn p-3 glass-card border-glass cursor-pointer" onclick="selectOption(@i, 'C')">
                                    <span class="opt-label fw-bold me-2">C)</span> @q.OptionC
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="option-btn p-3 glass-card border-glass cursor-pointer" onclick="selectOption(@i, 'D')">
                                    <span class="opt-label fw-bold me-2">D)</span> @q.OptionD
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <button class="btn btn-primary-glow btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg transform-hover" onclick="finishTest()">
                <i class="bi bi-check2-circle me-2"></i> Testi Tamamla
            </button>
        </div>
    </div>

    <!-- Result Modal -->
    <div id="resultOverlay" class="result-overlay d-none">
        <div class="result-card glass-card-strong p-5 text-center animate-scaleIn">
            <div class="mb-4">
                <i class="bi bi-trophy display-1 text-warning"></i>
            </div>
            <h2 class="fw-bold text-white mb-2">Tebrikler!</h2>
            <p class="text-muted-premium mb-4">Testi başarıyla tamamladınız.</p>
            
            <div class="d-flex justify-content-center gap-5 mb-5">
                <div class="stat-item">
                    <div class="h1 fw-bold text-success" id="correctCount">0</div>
                    <small class="text-muted text-uppercase fw-bold">Doğru</small>
                </div>
                <div class="stat-item">
                    <div class="h1 fw-bold text-danger" id="wrongCount">0</div>
                    <small class="text-muted text-uppercase fw-bold">Yanlış</small>
                </div>
            </div>
            
            <button class="btn btn-secondary-glow rounded-pill px-5" onclick="window.location.href='/Academic/Tests'">
                Hub'a Geri Dön
            </button>
        </div>
    </div>
</div>

<style>
    .option-btn {
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        background: rgba(255,255,255,0.02) !important;
    }
    .option-btn:hover {
        background: rgba(197, 160, 89, 0.1) !important;
        border-color: var(--primary) !important;
        transform: translateX(10px);
    }
    .option-btn.selected {
        background: var(--gradient-primary) !important;
        border-color: transparent !important;
        color: white !important;
        transform: scale(1.02) translateX(15px);
        box-shadow: 0 10px 30px rgba(197, 160, 89, 0.3);
    }
    .result-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 17, 26, 0.9);
        backdrop-filter: blur(15px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .result-card {
        max-width: 500px;
        width: 90%;
        border-radius: 30px;
    }
</style>

<script>
    const userAnswers = {};
    const correctAnswers = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Questions.Select(q => q.CorrectAnswer)));

    function selectOption(qIdx, opt) {
        // UI Update
        const card = document.getElementById('q-' + qIdx);
        card.querySelectorAll('.option-btn').forEach(btn => btn.classList.remove('selected'));
        event.currentTarget.classList.add('selected');
        
        // Save Answer
        userAnswers[qIdx] = opt;
    }

    function finishTest() {
        let correct = 0;
        let wrong = 0;
        
        correctAnswers.forEach((ans, idx) => {
            if(userAnswers[idx] === ans) correct++;
            else wrong++;
        });

        document.getElementById('correctCount').innerText = correct;
        document.getElementById('wrongCount').innerText = wrong;
        document.getElementById('resultOverlay').classList.remove('d-none');
        
        // Confetti effect
        if(correct > wrong) {
            // Simulate confetti
            console.log("Confetti triggered!");
        }
    }
</script>


