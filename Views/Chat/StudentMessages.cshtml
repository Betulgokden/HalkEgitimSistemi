@model IEnumerable<HalkEgitimSistemi.Models.Employer>
@{
    Layout = "_Layout";
    ViewData["Title"] = "İş Teklifleri & Mesajlar";
}

<div class="container py-5">
    <div class="page-header mb-5 animate-fadeInDown">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar-lg bg-gold rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 70px; height: 70px; color: #581C1C;">
                <i class="bi bi-chat-heart-fill fs-2"></i>
            </div>
            <div>
                <h1 class="text-white fw-bold mb-0">İş Teklifleri</h1>
                <p class="text-white-50">Sizinle iletişime geçen işverenleri buradan takip edebilirsiniz.</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var emp in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <a href="/Chat/StudentChat?employerId=@emp.Id" class="text-decoration-none">
                        <div class="glass-card p-4 border-glass shadow-hover h-100 transition-all hover-translate-y">
                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div class="bg-vibrant-dark p-3 rounded-4 border border-info border-opacity-25">
                                    <i class="bi bi-building text-info fs-3"></i>
                                </div>
                                <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill x-small fw-bold">YENİ MESAJ</span>
                            </div>
                            <h4 class="text-white fw-bold mb-1">@emp.CompanyName</h4>
                            <p class="text-white-50 small mb-4">@emp.Email</p>
                            
                            <div class="d-flex align-items-center gap-2 text-info small fw-bold">
                                SOHBETE GİT <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 glass-card d-inline-block border-glass" style="border-radius: 40px; border: 2px dashed rgba(255,255,255,0.1);">
                    <i class="bi bi-envelope-x text-white-50 fs-1 mb-4 d-block opacity-25"></i>
                    <h2 class="text-white fw-bold mb-2">Henüz Bir Teklif Yok</h2>
                    <p class="text-white-50 fs-5 mb-0">İşverenler sizinle iletişime geçtiğinde burada görünecektir.</p>
                </div>
            </div>
        }
    </div>
</div>
