@using System.Security.Claims
@model List<HalkEgitimSistemi.Models.ContactViewModel>
@{
    ViewData["Title"] = "Mesaj Merkezi";
    Layout = "_Layout";
    var targetEmail = ViewBag.TargetEmail as string;
    var targetName = ViewBag.TargetName as string;
    var myEmail = User.FindFirstValue(ClaimTypes.Email);
}

<div class="container-fluid py-4" style="height: calc(100vh - 120px); overflow: hidden;">
    <div class="row h-100 g-3">
        <!-- Sidebar: Kişiler & Arama -->
        <div class="col-lg-4 col-xl-3 h-100">
            <div class="glass-card-static h-100 d-flex flex-column p-0 overflow-hidden shadow-glow">
                <!-- Search & Header -->
                <div class="p-4 border-bottom-glass bg-glass-dark">
                    <h4 class="fw-800 mb-3" style="font-family:'Outfit'; color:var(--text-primary);">
                        <i class="bi bi-chat-heart-fill text-danger me-2"></i>Mesajlar
                    </h4>
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input type="text" id="userSearch" class="form-premium-control ps-5" placeholder="İsim veya e-posta ara...">
                        <div id="searchResults" class="position-absolute w-100 mt-2 glass-card-static p-0 shadow-lg d-none" style="z-index: 1000; max-height: 250px; overflow-y: auto;"></div>
                    </div>
                </div>

                <!-- Contact List -->
                <div class="flex-grow-1 overflow-y-auto custom-scrollbar p-2" id="contactList">
                    @if (ViewBag.Contacts != null)
                    {
                        @foreach (var contact in ViewBag.Contacts as List<HalkEgitimSistemi.Models.ContactViewModel>)
                        {
                            <div class="contact-item p-3 mb-2 rounded-3 cursor-pointer d-flex align-items-center gap-3 transition-all @(contact.Email == targetEmail ? "active" : "")" 
                                 onclick="loadChat('@contact.Email', '@contact.Name')">
                                <div class="avatar-circle-sm" style="background: var(--gradient-card); color: var(--primary-light);">@contact.Name[0]</div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 fw-bold text-white text-truncate">@contact.Name</h6>
                                        <span class="small text-muted">@contact.Role</span>
                                    </div>
                                    <p class="mb-0 small text-white-50 text-truncate">Son mesaj veya e-posta...</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center p-5 text-muted">
                            <i class="bi bi-people-fill d-block mb-2 fs-2"></i>
                            <p>Henüz kimseyle mesajlaşmadınız.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-lg-8 col-xl-9 h-100">
            <div id="chatPlaceholder" class="glass-card-static h-100 d-flex flex-column align-items-center justify-content-center animate-fadeInUp @(string.IsNullOrEmpty(targetEmail) ? "" : "d-none")">
                <div class="text-center">
                    <div class="p-4 rounded-circle bg-glass-dark mb-4 d-inline-block shadow-glow">
                        <i class="bi bi-chat-right-text" style="font-size: 4rem; color: var(--primary-light);"></i>
                    </div>
                    <h3 class="fw-800 text-white" style="font-family:'Outfit';">Sohbet Başlatın</h3>
                    <p class="text-white-50 px-5">Soldaki listeden birini seçin veya yeni birini aratın.</p>
                </div>
            </div>

            <div id="chatMain" class="glass-card-static h-100 d-flex flex-column p-0 overflow-hidden animate-fadeInUp @(string.IsNullOrEmpty(targetEmail) ? "d-none" : "")">
                <!-- Chat Header -->
                <div class="p-3 border-bottom-glass bg-glass-dark d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-circle-sm" id="activeChatAvatar" style="background: var(--gradient-premium); color: white;">?</div>
                        <div>
                            <h5 class="mb-0 fw-bold text-white" id="activeChatName">@targetName</h5>
                            <span class="small text-success"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Çevrimiçi</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-premium btn-secondary-glass" title="Bilgi"><i class="bi bi-info-circle"></i></button>
                        @if (User.IsInRole("Admin"))
                        {
                            <button class="btn btn-sm btn-premium btn-danger-glow" title="Kısıtla"><i class="bi bi-shield-lock"></i></button>
                        }
                    </div>
                </div>

                <!-- Messages -->
                <div class="flex-grow-1 overflow-y-auto p-4 d-flex flex-column gap-3 custom-scrollbar" id="messageContainer">
                    <!-- Messages will load here -->
                </div>

                <!-- Input Area -->
                <div class="p-4 bg-glass-dark border-top-glass">
                    <div class="d-flex align-items-end gap-3 bg-glass p-2 rounded-4 border-glass shadow-glow-sm">
                        <div class="d-flex gap-1 ps-2">
                            <button class="btn-icon-chat" onclick="document.getElementById('imgUpload').click()" title="Görsel">
                                <i class="bi bi-image text-info"></i>
                                <input type="file" id="imgUpload" class="d-none" accept="image/*" onchange="handleFileUpload(this, 'Image')">
                            </button>
                            <button class="btn-icon-chat" onclick="document.getElementById('vidUpload').click()" title="Video">
                                <i class="bi bi-play-circle text-warning"></i>
                                <input type="file" id="vidUpload" class="d-none" accept="video/*" onchange="handleFileUpload(this, 'Video')">
                            </button>
                            <button class="btn-icon-chat" onclick="document.getElementById('fileUpload').click()" title="Belge">
                                <i class="bi bi-file-earmark-arrow-up text-primary-light"></i>
                                <input type="file" id="fileUpload" class="d-none" onchange="handleFileUpload(this, 'File')">
                            </button>
                        </div>
                        <textarea id="messageInput" class="form-control bg-transparent border-0 text-white custom-scrollbar" 
                                  placeholder="Bir mesaj yazın..." rows="1" style="resize:none; padding-top:10px;"></textarea>
                        <button id="sendBtn" class="btn btn-premium btn-primary-glow px-4 py-2 rounded-pill me-1">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .contact-item { border: 1px solid transparent; }
    .contact-item:hover { background: rgba(255,255,255,0.05); }
    .contact-item.active { background: rgba(88, 28, 28, 0.15); border-color: rgba(88, 28, 28, 0.3); }
    .border-bottom-glass { border-bottom: 1px solid rgba(255,255,255,0.05); }
    .border-top-glass { border-top: 1px solid rgba(255,255,255,0.05); }
    .bg-glass-dark { background: rgba(15, 23, 42, 0.4); }
    
    .btn-icon-chat {
        width: 40px; height: 40px; border-radius: 50%; border: none;
        background: transparent; display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem; transition: all 0.2s;
    }
    .btn-icon-chat:hover { background: rgba(255,255,255,0.1); transform: translateY(-2px); }

    .msg-bubble {
        max-width: 75%; padding: 12px 18px; border-radius: 20px;
        position: relative; animation: slideIn 0.3s ease;
    }
    .msg-mine {
        align-self: flex-end; background: var(--gradient-premium); color: white;
        border-bottom-right-radius: 4px; box-shadow: 0 5px 15px rgba(88, 28, 28, 0.2);
    }
    .msg-other {
        align-self: flex-start; background: rgba(255,255,255,0.08); color: white;
        border-bottom-left-radius: 4px; border: 1px solid rgba(255,255,255,0.1);
    }
    
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    
    @@keyframes slideIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script>
    let activeReceiver = '@targetEmail';
    const myEmail = '@myEmail';
    
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/privateChatHub")
        .withAutomaticReconnect()
        .build();

    connection.on("ReceivePrivateMessage", (msg) => {
        if (msg.senderEmail === activeReceiver || msg.senderEmail === myEmail) {
            renderMessage(msg, msg.senderEmail === myEmail);
            scrollToBottom();
        } else {
            // New message from someone else - show notification in sidebar
            showNotification(msg.senderEmail);
        }
    });

    connection.start().then(() => {
        console.log("Connected to Private Chat Hub");
        if (activeReceiver) {
            loadChat(activeReceiver, '@targetName');
        }
    });

    async function loadChat(email, name) {
        activeReceiver = email;
        document.getElementById('chatPlaceholder').classList.add('d-none');
        document.getElementById('chatMain').classList.remove('d-none');
        document.getElementById('activeChatName').innerText = name;
        document.getElementById('activeChatAvatar').innerText = name[0];
        
        // Mark active contact
        document.querySelectorAll('.contact-item').forEach(el => el.classList.remove('active'));
        const activeItem = [...document.querySelectorAll('.contact-item')].find(el => el.innerHTML.includes(email));
        if (activeItem) activeItem.classList.add('active');

        // Join SignalR group
        await connection.invoke("JoinPrivateChat", email);

        // Load history
        const response = await fetch(`/Chat/GetMessages?otherEmail=${encodeURIComponent(email)}`);
        const messages = await response.json();
        
        const container = document.getElementById('messageContainer');
        container.innerHTML = '';
        messages.forEach(m => renderMessage(m, m.isMine));
        scrollToBottom();
    }

    function renderMessage(msg, isMine) {
        const container = document.getElementById('messageContainer');
        const div = document.createElement('div');
        div.className = `msg-bubble ${isMine ? 'msg-mine' : 'msg-other'}`;
        
        let content = msg.content;
        if (msg.type === "Image") {
            content = `<img src="${msg.content}" class="img-fluid rounded-3 mb-1 cursor-pointer shadow-glow-sm" onclick="window.open(this.src)" style="max-height:300px;">`;
        } else if (msg.type === "Video") {
            content = `<video controls class="img-fluid rounded-3 shadow-glow-sm" style="max-height:300px;"><source src="${msg.content}"></video>`;
        } else if (msg.type === "File") {
            content = `<div class="d-flex align-items-center gap-2 p-2 bg-glass rounded-3">
                        <i class="bi bi-file-earmark-text fs-4"></i>
                        <div class="overflow-hidden">
                            <div class="small fw-bold text-truncate">${msg.content.split('/').pop()}</div>
                            <a href="${msg.content}" target="_blank" class="small text-info text-decoration-none">İndir</a>
                        </div>
                       </div>`;
        } else {
            content = `<div>${msg.content}</div>`;
        }

        div.innerHTML = `
            ${content}
            <div class="text-end mt-1" style="font-size: 0.65rem; opacity: 0.6;">${msg.sentAt}</div>
        `;
        container.appendChild(div);
    }

    document.getElementById('sendBtn').onclick = () => sendMessage();
    document.getElementById('messageInput').onkeypress = (e) => { if(e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } };

    async function sendMessage(contentOverride = null, type = "Text") {
        const input = document.getElementById('messageInput');
        const content = contentOverride || input.value.trim();
        if (!content || !activeReceiver) return;

        await connection.invoke("SendPrivateMessage", activeReceiver, content, type);
        if (!contentOverride) input.value = '';
    }

    async function handleFileUpload(input, type) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];
        const formData = new FormData();
        formData.append("file", file);

        // Reuse existing upload endpoint
        const response = await fetch("/CourseChat/UploadChatFile", { method: "POST", body: formData });
        if (response.ok) {
            const url = await response.text();
            sendMessage(url, type);
        }
    }

    function scrollToBottom() {
        const container = document.getElementById('messageContainer');
        container.scrollTop = container.scrollHeight;
    }

    // User Search Logic
    const searchInput = document.getElementById('userSearch');
    const searchResults = document.getElementById('searchResults');

    searchInput.oninput = async (e) => {
        const term = e.target.value.trim();
        if (term.length < 2) {
            searchResults.classList.add('d-none');
            return;
        }

        const response = await fetch(`/Chat/SearchUsers?term=${encodeURIComponent(term)}`);
        const users = await response.json();

        if (users.length > 0) {
            searchResults.innerHTML = users.map(u => `
                <div class="p-3 border-bottom-glass cursor-pointer hover-bg-glass d-flex align-items-center gap-3" 
                     onclick="loadChat('${u.email}', '${u.name}'); document.getElementById('searchResults').classList.add('d-none'); document.getElementById('userSearch').value='';">
                    <div class="avatar-circle-sm" style="background:var(--gradient-card);"> ${u.name[0]} </div>
                    <div>
                        <div class="fw-bold text-white">${u.name}</div>
                        <div class="small text-white-50">${u.email}</div>
                    </div>
                </div>
            `).join('');
            searchResults.classList.remove('d-none');
        } else {
            searchResults.classList.add('d-none');
        }
    };
</script>


