@{
    ViewData["Title"] = "Başvuru Başarılı";
}

<div class="success-container">
    <div class="success-card animate-scaleIn">
        <!-- Animated Success Icon -->
        <div class="success-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <h2 style="font-family: 'Outfit', sans-serif; font-weight: 900; color: var(--text-primary); font-size: 2rem; margin-bottom: 1rem;">
            Başvurunuz <span style="color: var(--success);">Alındı!</span>
        </h2>

        <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.8; margin-bottom: 2rem;">
            Kurs başvurunuz başarıyla sisteme kaydedilmiştir. 
            En kısa sürede sizinle iletişime geçeceğiz. 🎉
        </p>

        <!-- Info Box -->
        <div style="background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.2); border-radius: var(--radius-lg); padding: 1.2rem; margin-bottom: 2rem; text-align: left;">
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-info-circle-fill" style="color: var(--success); font-size: 1.2rem; margin-top: 2px;"></i>
                <div>
                    <strong style="color: var(--text-primary); font-size: 0.9rem;">Sonraki Adımlar:</strong>
                    <ul style="color: var(--text-muted); font-size: 0.85rem; margin: 0.5rem 0 0; padding-left: 1.2rem;">
                        <li>Başvurunuz değerlendirilecektir</li>
                        <li>Telefon veya e-posta ile bilgilendirileceksiniz</li>
                        <li>Kurs başlangıç tarihi size bildirilecektir</li>
                        <li><strong class="gold-text">Önemli:</strong> Başvurunuz onaylandığında ödemelerinizi Ziraat Bankası üzerinden gerçekleştirebilirsiniz.</li>
                    </ul>
                </div>
            </div>
        </div>

        <hr class="divider-premium" />

        <div class="d-grid gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-premium btn-primary-glow justify-content-center">
                <i class="bi bi-house-heart"></i> Ana Sayfaya Dön
            </a>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-premium btn-secondary-glass justify-content-center">
                <i class="bi bi-search"></i> Diğer Kurslara Göz At
            </a>
        </div>
    </div>
</div>