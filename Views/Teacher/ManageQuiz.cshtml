@model List<HalkEgitimSistemi.Models.QuizQuestion>
@{
    ViewData["Title"] = "Eğitmen Soru Bankası";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold text-gradient-primary">
                <i class="bi bi-patch-question-fill me-2 float-slow"></i>Eğitmen Soru Bankası
            </h1>
            <p class="text-muted-premium mb-0">Öğrencileriniz için yeni bilgi yarışması soruları ekleyin.</p>
        </div>
        <button class="btn btn-secondary-glow rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addQuestionModal">
            <i class="bi bi-plus-lg me-2"></i> Yeni Soru Öner
        </button>
    </div>

    <div class="glass-card-static border-0 shadow-lg p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead class="bg-glass">
                    <tr>
                        <th class="ps-4">KATEGORİ</th>
                        <th>SORU METNİ</th>
                        <th>ZORLUK</th>
                        <th>DOÄRU CEVAP</th>
                        <th class="text-end pe-4">İÅLEMLER</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-secondary-soft text-secondary">@q.Category</span>
                            </td>
                            <td style="max-width: 400px;" class="text-truncate">@q.QuestionText</td>
                            <td>
                                @for(int i=0; i<q.Difficulty; i++){ <i class="bi bi-star-fill text-warning small"></i> }
                            </td>
                            <td>
                                <span class="badge bg-success-soft text-success">@q.CorrectAnswer</span>
                            </td>
                            <td class="text-end pe-4">
                                <form asp-action="DeleteQuizQuestion" method="post" onsubmit="return confirm('Bu soruyu silmek istediğinize emin misiniz?')">
                                    <input type="hidden" name="id" value="@q.Id" />
                                    <button type="submit" class="btn btn-link text-danger p-0">
                                        <i class="bi bi-trash fs-5"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal remains the same but posts to Teacher controller -->
<div class="modal fade" id="addQuestionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-glass-strong border-glass text-white">
            <div class="modal-header border-white-10">
                <h5 class="modal-title fw-bold">Yeni Quiz Sorusu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddQuizQuestion" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small text-muted">Soru Metni</label>
                            <textarea name="QuestionText" class="form-control bg-glass border-glass text-white" rows="3" required></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">Kategori</label>
                            <select name="Category" class="form-select bg-glass border-glass text-white">
                                <option>Yazılım</option>
                                <option>Ağ Teknolojileri</option>
                                <option>El Sanatları</option>
                                <option>Gastronomi</option>
                                <option>Genel Kültür</option>
                            </select>
                            <label class="form-label small text-muted mt-3">Zorluk Seviyesi</label>
                            <select name="Difficulty" class="form-select bg-glass border-glass text-white">
                                <option value="1">Kolay</option>
                                <option value="2">Orta</option>
                                <option value="3">Zor</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">A Åıkkı</label>
                            <input name="OptionA" class="form-control bg-glass border-glass text-white" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">B Åıkkı</label>
                            <input name="OptionB" class="form-control bg-glass border-glass text-white" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">C Åıkkı</label>
                            <input name="OptionC" class="form-control bg-glass border-glass text-white" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">D Åıkkı</label>
                            <input name="OptionD" class="form-control bg-glass border-glass text-white" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-muted">Doğru Cevap</label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="CorrectAnswer" value="A" id="cA" checked>
                                    <label class="form-check-label" for="cA">A</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="CorrectAnswer" value="B" id="cB">
                                    <label class="form-check-label" for="cB">B</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="CorrectAnswer" value="C" id="cC">
                                    <label class="form-check-label" for="cC">C</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="CorrectAnswer" value="D" id="cD">
                                    <label class="form-check-label" for="cD">D</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-white-10">
                    <button type="button" class="btn btn-secondary-glass rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-secondary-glow rounded-pill px-4">Soru Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

