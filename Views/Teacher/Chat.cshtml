@model List<HalkEgitimSistemi.Models.TeacherChatMessage>
@{
    Layout = null;
    ViewData["Title"] = "Öğretmenler Odası";
    string senderName = ViewBag.SenderName ?? "Öğretmen";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — Halk Eğitim Sistemi</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <style>
        :root {
            --bg-dark: #050510;
            --glass-card: rgba(88, 28, 28, 0.05);
            --primary: #C5A059;
            --secondary: #581C1C;
            --accent: #C5A059;
            --text-primary: #ffffff;
            --text-muted: #94a3b8;
            --border-glass: rgba(197, 160, 89, 0.2);
            --gradient-vibrant: linear-gradient(135deg, #581C1C 0%, #C5A059 100%);
        }

        
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            background-color: var(--bg-dark);
            background-image: 
                radial-gradient(at 0% 0%, hsla(253,16%,7%,1) 0, transparent 50%), 
                radial-gradient(at 50% 0%, hsla(225,39%,30%,1) 0, transparent 50%), 
                radial-gradient(at 100% 0%, hsla(339,49%,30%,1) 0, transparent 50%);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* --- Layout --- */
        .app-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
            backdrop-filter: blur(20px);
        }

        /* --- Header --- */
        .chat-header {
            background: rgba(10, 10, 25, 0.8);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--border-glass);
            padding: 1.2rem 2.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 10;
        }

        .header-brand { display: flex; align-items: center; gap: 15px; }
        .brand-icon { 
            width: 50px; height: 50px; 
            background: var(--gradient-vibrant);
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; color: white;
            box-shadow: 0 0 25px rgba(197, 160, 89, 0.4);
        }
        .brand-title { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 1.2rem; }
        .brand-status { font-size: 0.75rem; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 6px; }
        .status-dot { width: 8px; height: 8px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 10px var(--accent); animation: pulse 2s infinite; }

        /* --- Main Content --- */
        .chat-layout { display: flex; flex: 1; overflow: hidden; }

        /* --- Sidebar --- */
        .chat-sidebar {
            width: 300px;
            background: rgba(10, 10, 25, 0.4);
            border-right: 1px solid var(--border-glass);
            display: flex;
            flex-direction: column;
        }
        .sidebar-header { padding: 1.5rem; border-bottom: 1px solid var(--border-glass); }
        .sidebar-title { font-family: 'Outfit'; font-weight: 700; font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1.5px; }
        
        .user-list { flex: 1; overflow-y: auto; padding: 1rem; }
        .user-item { 
            display: flex; align-items: center; gap: 12px; 
            padding: 12px; border-radius: 14px;
            margin-bottom: 8px;
            transition: all 0.3s;
            cursor: pointer;
        }
        .user-item:hover { background: rgba(255,255,255,0.05); }
        .user-avatar { 
            width: 40px; height: 40px; 
            border-radius: 12px; 
            background: var(--glass-card);
            border: 1px solid var(--border-glass);
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: var(--primary);
            font-family: 'Outfit';
        }
        .user-info .name { font-size: 0.9rem; font-weight: 600; color: white; }
        .user-info .title { font-size: 0.75rem; color: var(--text-muted); }

        /* --- Messages Area --- */
        .chat-main { flex: 1; display: flex; flex-direction: column; background: rgba(0,0,0,0.1); }
        #messages-container { 
            flex: 1; overflow-y: auto; 
            padding: 2rem; 
            display: flex; flex-direction: column; gap: 1.5rem;
            background-image: radial-gradient(rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 30px 30px;
        }

        .msg-row { display: flex; gap: 15px; }
        .msg-row.me { flex-direction: row-reverse; }
        
        .msg-bubble { max-width: 70%; position: relative; }
        .sender-name { font-size: 0.75rem; font-weight: 700; margin-bottom: 5px; color: var(--text-muted); }
        .msg-row.me .sender-name { text-align: right; }
        
        .bubble-content {
            padding: 14px 20px;
            border-radius: 20px;
            font-size: 0.95rem;
            line-height: 1.6;
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-glass);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        .msg-row:not(.me) .bubble-content { background: var(--glass-card); border-bottom-left-radius: 4px; }
        .msg-row.me .bubble-content { background: var(--gradient-vibrant); color: white; border-bottom-right-radius: 4px; border: none; }
        
        .bubble-time { font-size: 0.65rem; color: var(--text-muted); margin-top: 6px; }
        .msg-row.me .bubble-time { text-align: right; }

        /* --- Input Area --- */
        .chat-input-area {
            padding: 2rem 2.5rem;
            background: rgba(10, 10, 25, 0.8);
            border-top: 1px solid var(--border-glass);
            display: flex; gap: 15px; align-items: center;
        }
        .input-wrapper {
            flex: 1;
            position: relative;
        }
        #message-input {
            width: 100%;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border-glass);
            border-radius: 18px;
            padding: 15px 25px;
            color: white;
            font-family: inherit;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s;
            resize: none;
        }
        #message-input:focus { border-color: var(--primary); background: rgba(255,255,255,0.06); box-shadow: 0 0 20px rgba(197, 160, 89, 0.2); }
        
        .send-btn {
            width: 55px; height: 55px;
            background: var(--gradient-vibrant);
            border: none; border-radius: 18px;
            color: white; font-size: 1.3rem;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.3);
        }
        .send-btn:hover { transform: scale(1.1) rotate(5deg); box-shadow: 0 15px 30px rgba(197, 160, 89, 0.5); }

        /* --- Utils --- */
        .nav-btn {
            padding: 8px 20px;
            border-radius: 12px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-glass);
            color: white;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s;
        }
        .nav-btn:hover { background: rgba(255,255,255,0.1); border-color: white; }

        @@keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    </style>
</head>
<body>

<div class="app-container">
    <div class="chat-header" style="background: rgba(88, 28, 28, 0.05); border-bottom: 1px solid var(--border-glass);">
        <div class="header-brand">
            <div class="brand-icon" style="background: var(--maroon); border: 1px solid var(--gold);"><i class="bi bi-mortarboard-fill" style="color: var(--gold);"></i></div>
            <div>
                <div class="brand-title" style="color: var(--gold); font-weight: 900;">Öğretmenler Odası</div>
                <div class="brand-status"><span class="status-dot"></span> <span style="color: var(--gold); opacity: 0.8;">Akademik Etkileşim Aktif</span></div>
            </div>
        </div>
        <div class="header-actions">
            <a href="/Teacher/Dashboard" class="nav-btn" style="border-color: var(--gold); color: var(--gold);"><i class="bi bi-arrow-left me-2"></i> Panele Dön</a>
        </div>
    </div>

    <div class="chat-layout">
        <div class="chat-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-title">Kollokyum Üyeleri</div>
            </div>
            <div class="user-list custom-scrollbar">
                @if (ViewBag.Instructors != null)
                {
                    foreach (var ins in (dynamic)ViewBag.Instructors)
                    {
                        <div class="user-item">
                            <div class="user-avatar">@ins.FullName.Substring(0, 1)</div>
                            <div class="user-info">
                                <div class="name">@ins.FullName</div>
                                <div class="title">@ins.Title</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="chat-main">
            <div id="messages-container" class="custom-scrollbar">
                @foreach (var msg in Model)
                {
                    bool isMe = msg.SenderName == senderName;
                    <div class="msg-row @(isMe ? "me" : "")">
                        <div class="msg-bubble">
                            @if (!isMe) { <div class="sender-name">@msg.SenderName</div> }
                            <div class="bubble-content">
                                @msg.Message
                            </div>
                            <div class="bubble-time">@msg.SentAt.ToString("HH:mm")</div>
                        </div>
                    </div>
                }
            </div>

            <div class="chat-input-area">
                <div class="input-wrapper">
                    <textarea id="message-input" rows="1" placeholder="Meslektaşlarınıza bir mesaj gönderin..." maxlength="500"></textarea>
                </div>
                <button class="send-btn" id="send-btn"><i class="bi bi-send-fill"></i></button>
            </div>
        </div>
    </div>
</div>

<script>
    const senderName = "@senderName";
    const container = document.getElementById("messages-container");
    container.scrollTop = container.scrollHeight;

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/teacherChatHub")
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveMessage", (sender, message, time, isCensored) => {
        addMessage(sender, message, time, isCensored, sender === senderName);
    });

    connection.on("UpdateUserList", (users) => {
        const userList = document.querySelector(".user-list");
        userList.innerHTML = "";
        users.forEach(u => {
            const isAdmin = u.role === "Yönetici";
            const item = document.createElement("div");
            item.className = "user-item";
            item.innerHTML = `
                <div class="user-avatar" style="background: ${isAdmin ? 'linear-gradient(135deg, #ef4444, #991b1b)' : 'var(--glass-card)'}; color: ${isAdmin ? 'white' : 'var(--primary)'}">
                    ${u.name.substring(0, 1)}
                </div>
                <div class="user-info">
                    <div class="name">${u.name}</div>
                    <div class="title">${u.role}</div>
                </div>
            `;
            userList.appendChild(item);
        });
    });

    connection.on("UserJoined", (name) => {
        const toast = document.createElement("div");
        toast.className = "text-center my-2 small text-muted-premium animate-fadeIn";
        toast.innerHTML = `<span class="px-3 py-1 rounded-pill bg-glass border-glass">${name} odaya katıldı.</span>`;
        container.appendChild(toast);
        container.scrollTop = container.scrollHeight;
    });

    connection.on("UserLeft", (name) => {
        const toast = document.createElement("div");
        toast.className = "text-center my-2 small text-muted-premium animate-fadeIn";
        toast.innerHTML = `<span class="px-3 py-1 rounded-pill bg-glass border-glass">${name} odadan ayrıldı.</span>`;
        container.appendChild(toast);
        container.scrollTop = container.scrollHeight;
    });

    connection.start().catch(err => console.error("SignalR hatası:", err));

    document.getElementById("send-btn").onclick = sendMessage;
    document.getElementById("message-input").onkeydown = e => {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    };

    async function sendMessage() {
        const input = document.getElementById("message-input");
        const msg = input.value.trim();
        if (!msg) return;
        input.value = "";
        input.style.height = "auto";
        await connection.invoke("SendMessage", msg);
    }

    function addMessage(sender, message, time, isCensored, isMe) {
        const row = document.createElement("div");
        row.className = `msg-row ${isMe ? "me" : ""}`;
        row.innerHTML = `
            <div class="msg-bubble">
                ${!isMe ? `<div class="sender-name">${sender}</div>` : ""}
                <div class="bubble-content">${escapeHtml(message)}</div>
                <div class="bubble-time">${time}</div>
            </div>
        `;
        container.appendChild(row);
        container.scrollTop = container.scrollHeight;
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Auto resize
    const ta = document.getElementById("message-input");
    ta.oninput = () => { ta.style.height = "auto"; ta.style.height = Math.min(ta.scrollHeight, 100) + "px"; };
</script>
</body>
</html>


