@{
    Layout = "_Layout";
    ViewData["Title"] = "Materyal Talebi";
}

<div class="container py-4" style="max-width:640px;">
    @if (TempData["Success"] != null)
    {
        <div class="alert animate-fadeIn mb-4" style="background:rgba(16,185,129,0.1);color:var(--success);border:1px solid rgba(16,185,129,0.2);border-radius:var(--radius-md);padding:1rem 1.5rem;">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="glass-card-static overflow-hidden animate-scaleIn">
        <div style="padding:2rem;border-bottom:1px solid var(--border-glass);background:linear-gradient(135deg,rgba(99,102,241,0.08),rgba(139,92,246,0.04));text-align:center;">
            <div style="width:70px;height:70px;display:inline-flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#581C1C,#C5A059);border-radius:var(--radius-xl);margin-bottom:1rem;">
                <i class="bi bi-tools" style="font-size:1.8rem;color:white;"></i>
            </div>
            <h2 style="font-family:'Outfit';font-weight:800;margin:0;color:var(--text-primary);">Materyal / Ekipman Talebi</h2>
            <p style="color:var(--text-muted);margin:0.3rem 0 0;font-size:0.85rem;">Talebiniz yöneticiye iletilecektir.</p>
        </div>

        <div style="padding:2rem;">
            <form asp-action="SubmitMaterialRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="form-premium-group">
                            <label class="form-premium-label"><i class="bi bi-box me-1"></i>Malzeme / Ekipman Adı</label>
                            <input type="text" name="itemName" class="form-premium-control" placeholder="Örn: Kil, Boya seti, Projeksiyon..." required />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-premium-group">
                            <label class="form-premium-label"><i class="bi bi-123 me-1"></i>Miktar / Adet</label>
                            <input type="number" name="quantity" class="form-premium-control" min="1" value="1" required />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-premium-group">
                            <label class="form-premium-label"><i class="bi bi-exclamation-triangle me-1"></i>Aciliyet</label>
                            <select name="urgency" class="form-premium-control">
                                <option>Normal (1-2 hafta içinde)</option>
                                <option>Orta (Bu hafta)</option>
                                <option>Acil (Bu gün / Yarın)</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-premium-group">
                            <label class="form-premium-label"><i class="bi bi-chat-text me-1"></i>Gerekçe / Açıklama</label>
                            <textarea name="reason" class="form-premium-control" rows="4"
                                placeholder="Bu malzeme neden gerekli? Hangi ders için kullanılacak?..." required></textarea>
                        </div>
                    </div>
                </div>

                <!-- Sık Talep Edilen -->
                <div class="mt-3 mb-4">
                    <p style="color:var(--text-muted);font-size:0.8rem;margin-bottom:0.5rem;">⚡ Sık Talep Edilenler:</p>
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var item in new[] { "Kil (5kg)", "Ahşap boyası seti", "Projeksiyon perdesi", "A4 kağıt (1 koli)", "Makas seti", "Tekstil boyası" })
                        {
                            <button type="button" class="btn btn-sm btn-secondary-glass py-1 px-2"
                                onclick="document.querySelector('[name=itemName]').value='@item'">@item</button>
                        }
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <a asp-action="Dashboard" class="btn btn-premium btn-secondary-glass flex-fill justify-content-center">
                        <i class="bi bi-arrow-left"></i> Geri
                    </a>
                    <button type="submit" class="btn btn-premium btn-primary-glow flex-fill justify-content-center">
                        <i class="bi bi-send-fill"></i> Talebi Gönder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

