@{
    ViewData["Title"] = "Modern Eğitim Takvimi";
}

<!-- FullCalendar.js Dependencies -->
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css' rel='stylesheet' />
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js'></script>
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/tr.js'></script>
<script src="https://unpkg.com/@@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>

<div class="container-fluid py-5 px-lg-5">
    
    <div class="row g-4">
        <!-- Sidebar: Günlük Akış -->
        <div class="col-xl-3 animate-fadeInLeft">
            <div class="glass-card h-100 p-4 d-flex flex-column" style="position: sticky; top: 100px; min-height: 80vh;">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="date-badge-neon">
                        <span id="side-day" class="d-block h2 fw-900 mb-0">--</span>
                        <span id="side-month" class="text-uppercase small fw-bold">---</span>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-primary-theme">Günlük Ajanda</h4>
                        <p class="text-muted small mb-0" id="side-full-date">Tarih seçiniz...</p>
                    </div>
                </div>

                <!-- Filtreleme (Benim Takvimim Åovu) -->
                <div class="filter-box glass-card-sm mb-4 p-3">
                    <div class="form-check form-switch d-flex justify-content-between align-items-center p-0">
                        <label class="form-check-label text-muted small" for="myCalendarToggle">Sadece Benim Kurslarım</label>
                        <input class="form-check-input ms-0" type="checkbox" id="myCalendarToggle" onchange="toggleMyCalendar()">
                    </div>
                </div>

                <div id="daily-events-list" class="flex-grow-1 overflow-auto pe-2">
                    <div class="text-center py-5 text-muted opacity-50">
                        <i class="bi bi-calendar2-event display-4 d-block mb-3"></i>
                        <p>Bugün için planlanan bir etkinlik bulunmuyor.</p>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-glass">
                    <h6 class="text-white-50 small fw-bold text-uppercase mb-3">Renk Anahtarı</h6>
                    <div class="d-flex flex-wrap gap-3">
                        <div class="legend-dot"><span class="dot" style="background: #C5A059;"></span> <span class="small text-white-50">Kurs</span></div>
                        <div class="legend-dot"><span class="dot" style="background: #ef4444;"></span> <span class="small text-white-50">Tatil / Özel Gün</span></div>
                        <div class="legend-dot"><span class="dot" style="background: #ef4444; box-shadow: 0 0 8px #ef4444;"></span> <span class="small text-white-50">Resmi Tatil</span></div>
                        <div class="legend-dot"><span class="dot" style="background: #f59e0b;"></span> <span class="small text-white-50">Arife / Yarım Gün</span></div>
                        <div class="legend-dot"><span class="dot" style="background: #3b82f6;"></span> <span class="small text-white-50">Kayıt</span></div>
                        <div class="legend-dot"><span class="dot" style="background: #C5A059;"></span> <span class="small text-white-50">Etkinlik</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main: Takvim -->
        <div class="col-xl-9 animate-fadeInRight">
            <div class="glass-card p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 gap-3">
                    <div>
                        <h2 class="section-title-gradient fw-900 mb-0">Eğitim Takvimi</h2>
                        <p class="text-white-50 small mb-0">Otomatik çakışma kontrollü akıllı ajanda sistemi.</p>
                    </div>
                    <div class="d-flex align-items-center gap-4">
                        <div class="calendar-nav-badges">
                            <span class="badge bg-glass text-white px-4 py-2 rounded-pill" id="calendar-title">---</span>
                        </div>
                    </div>
                </div>
                
                <div id='calendar' class="modern-calendar"></div>
            </div>
        </div>
    </div>
</div>

<style>
    /* FullCalendar Modern Overrides */
    .modern-calendar { background: transparent; color: var(--text-primary); border: none; }
    .fc { --fc-border-color: var(--border-glass); --fc-today-bg-color: var(--primary-glow); }
    .fc .fc-toolbar-title { font-family: 'Outfit'; font-weight: 900; color: var(--text-primary); }
    .fc .fc-button-primary { background: var(--bg-glass); border: 1px solid var(--border-glass); color: var(--text-primary); border-radius: 12px; font-weight: 600; text-transform: capitalize; padding: 8px 16px; }
    .fc .fc-button-primary:hover { background: var(--primary); border-color: var(--primary); color: white !important; }
    .fc .fc-button-active { background: var(--primary) !important; border-color: var(--primary) !important; box-shadow: var(--shadow-glow-sm) !important; color: white !important; }
    
    /* Event Dots (Yeşil barlar yerine şık noktalar) */
    .fc-daygrid-event { background: transparent !important; border: none !important; padding: 2px 5px !important; }
    .fc-event-title { font-size: 0.75rem !important; font-weight: 600 !important; color: rgba(255,255,255,0.8) !important; }
    .fc-daygrid-event-dot { border-width: 4px !important; border-radius: 50% !important; margin-right: 8px !important; }
    
    .fc-col-header-cell { padding: 15px 0 !important; background: rgba(255,255,255,0.02); }
    .fc-col-header-cell-cushion { color: rgba(255,255,255,0.5); font-weight: 700; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 1px; }
    
    .fc-daygrid-day-number { color: rgba(255,255,255,0.3); font-family: 'Outfit'; font-weight: 800; padding: 10px !important; }
    .fc-day-today .fc-daygrid-day-number { color: var(--primary); font-size: 1.2rem; }

    /* Sidebar Badge */
    .date-badge-neon { 
        width: 75px; height: 75px; background: linear-gradient(135deg, var(--primary), #d946ef); 
        border-radius: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;
        box-shadow: 0 10px 20px rgba(197, 160, 89, 0.4); border: 2px solid rgba(255,255,255,0.2);
    }

    .event-item-glass {
        background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);
        border-radius: 18px; padding: 15px; margin-bottom: 12px; transition: all 0.3s ease; cursor: pointer;
    }
    .event-item-glass:hover { background: rgba(255,255,255,0.08); transform: scale(1.02); border-color: rgba(255,255,255,0.2); }

    .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    
    /* Tippy Tooltip Customization */
    .tippy-box { background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: white; padding: 5px; }

    .btn-ical { background: rgba(197, 160, 89, 0.2); color: var(--primary-light); border: 1px dashed var(--primary); padding: 5px 12px; border-radius: 10px; font-size: 0.7rem; font-weight: 700; transition: all 0.2s; }
    .btn-ical:hover { background: var(--primary); color: white; border-style: solid; }

    /* Holiday / Special Day Styling */
    .fc-event-holiday .fc-daygrid-event-dot {
        border-width: 5px !important;
        box-shadow: 0 0 8px rgba(239, 68, 68, 0.6);
    }
    .fc-event-holiday .fc-event-title {
        color: #f87171 !important;
        font-weight: 800 !important;
    }
</style>

<script>
    let calendar;
    let onlyMine = false;

    document.addEventListener('DOMContentLoaded', function() {
        initCalendar();
    });

    function initCalendar() {
        var calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            initialDate: '2026-05-01',
            locale: 'tr',
            height: 'auto',
            editable: @(User.IsInRole("Admin") ? "true" : "false"),
            selectable: true,
            dayMaxEvents: true,
            eventDisplay: 'dot', // Barlar yerine noktalar!
            headerToolbar: {
                left: 'prev,next today',
                center: '',
                right: 'dayGridMonth,timeGridWeek,listMonth'
            },
            events: function(info, successCallback, failureCallback) {
                fetch(`/Events/GetEvents?onlyMine=${onlyMine}`)
                    .then(res => res.json())
                    .then(data => successCallback(data))
                    .catch(err => failureCallback(err));
            },
            eventClassNames: function(info) {
                if (info.event.extendedProps.type === 'holiday') {
                    return ['fc-event-holiday'];
                }
                return [];
            },
            eventDidMount: function(info) {
                // Tarih formatlama
                let dateOptions = { day: 'numeric', month: 'long' };
                let dateStr = info.event.start.toLocaleDateString('tr-TR', dateOptions);
                
                if (info.event.end && info.event.allDay) {
                    let endDate = new Date(info.event.end);
                    endDate.setDate(endDate.getDate() - 1);
                    if (endDate > info.event.start) {
                        dateStr += " - " + endDate.toLocaleDateString('tr-TR', dateOptions);
                    }
                }

                // Tippy.js Tooltip Åovu
                tippy(info.el, {
                    content: `
                        <div class="p-2" style="min-width: 180px;">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="dot" style="background:${info.event.backgroundColor}"></span>
                                <strong class="text-white">${info.event.title}</strong>
                            </div>
                            <div class="text-primary-light small mb-1">
                                <i class="bi bi-calendar-check me-1"></i> ${dateStr}
                            </div>
                            <div class="text-white-50 small" style="line-height: 1.4;">
                                ${info.event.extendedProps.description}
                            </div>
                        </div>
                    `,
                    allowHTML: true,
                    theme: 'glass',
                    placement: 'top',
                    animation: 'shift-away'
                });
            },
            eventDrop: function(info) {
                // Drag & Drop Algoritma Åovu
                updateEventOnServer(info.event);
            },
            dateClick: function(info) {
                const events = calendar.getEvents().filter(e => e.startStr.split('T')[0] === info.dateStr);
                updateSidebar(info.date, events);
            },
            datesSet: function(info) {
                document.getElementById('calendar-title').innerText = info.view.title;
            }
        });
        calendar.render();
    }

    function toggleMyCalendar() {
        onlyMine = document.getElementById('myCalendarToggle').checked;
        calendar.refetchEvents();
    }

    function updateEventOnServer(event) {
        const formData = new FormData();
        formData.append('id', event.id);
        formData.append('start', event.start.toISOString());
        if(event.end) formData.append('end', event.end.toISOString());

        fetch('/Events/UpdateEvent', { method: 'POST', body: formData })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    alert('Etkinlik tarihi başarıyla güncellendi ve ilgili kişilere bildirim gönderildi!');
                }
            });
    }

    function updateSidebar(date, events) {
        const months = ['Oca', 'Åub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'];
        document.getElementById('side-day').innerText = date.getDate();
        document.getElementById('side-month').innerText = months[date.getMonth()];
        document.getElementById('side-full-date').innerText = date.toLocaleDateString('tr-TR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        const list = document.getElementById('daily-events-list');
        list.innerHTML = '';

        if (events.length === 0) {
            list.innerHTML = `<div class="text-center py-5 text-white-50 opacity-50"><i class="bi bi-calendar2-x display-4 d-block mb-3"></i><p>Seçilen günde etkinlik yok.</p></div>`;
            return;
        }

        events.forEach(ev => {
            const item = document.createElement('div');
            item.className = 'event-item-glass animate-fadeInLeft';
            const timeStr = ev.allDay ? 'Tüm Gün' : new Date(ev.start).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
            
            item.innerHTML = `
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="fw-bold text-white">${ev.title}</span>
                    <span class="dot" style="background:${ev.backgroundColor}"></span>
                </div>
                <p class="small text-white-50 mb-3">${ev.extendedProps.description}</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="badge bg-glass text-white-50">${timeStr}</span>
                    <a href="/Events/ExportIcal?id=${ev.id}" class="btn-ical">
                        <i class="bi bi-calendar-plus me-1"></i> Takvime Ekle
                    </a>
                </div>
            `;
            list.appendChild(item);
        });
    }

    // İlk açılışta bugünü göster
    setTimeout(() => {
        const today = new Date();
        const todayEvents = calendar.getEvents().filter(e => e.startStr.split('T')[0] === today.toISOString().split('T')[0]);
        updateSidebar(today, todayEvents);
    }, 1000);
</script>


