@model IEnumerable<HalkEgitimSistemi.Models.News>

@{
    ViewData["Title"] = "Haberler & Duyurular | Medya Merkezi";
    var stories = ViewBag.Stories as IEnumerable<HalkEgitimSistemi.Models.NewsStory>;
}

<div class="container py-5">
    <!-- Premium Header -->
    <div class="news-hero-box animate-fadeInDown mb-5 p-5">
        <div class="row align-items-center">
            <div class="col-lg-8 text-center text-lg-start">
                <span class="badge-premium mb-3"><i class="bi bi-megaphone"></i> GÜNCEL HABERLER</span>
                <h1 class="display-3 fw-black mb-2 news-main-title">Haberler & <span class="gold-text-glow">Duyurular</span></h1>
                <p class="news-hero-subtitle mx-auto ms-lg-0">Halk Eğitim Merkezimizdeki tüm etkinlikler, duyurular ve başarı hikayelerinden anında haberdar olun.</p>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                @if (User.IsInRole("Admin") || User.IsInRole("Instructor"))
                {
                    <a asp-action="Create" class="btn btn-gold-pulse px-4 py-3 w-100">
                        <i class="bi bi-plus-circle me-2"></i> YENİ HABER YAYINLA
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Instagram Style Stories (Modernized) -->
    @if (stories != null && stories.Any())
    {
        <div class="stories-wrapper mb-5 animate-fadeInUp">
            <h5 class="fw-black text-gold mb-4 ms-2"><i class="bi bi-collection-play me-2"></i> Öne Çıkan Hikayeler</h5>
            <div class="d-flex gap-4 overflow-auto pb-3 no-scrollbar ps-2">
                @foreach (var story in stories)
                {
                    <div class="story-box" onclick="viewStory('@story.ImageUrl', '@story.Title')">
                        <div class="story-ring-premium">
                            <img src="@story.ImageUrl" alt="@story.Title" />
                            <div class="story-play-icon"><i class="bi bi-play-fill"></i></div>
                        </div>
                        <span class="story-box-name">@story.Title</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Haberler Grid (Gold Boxy Transparent Design) -->
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 animate-fadeInUp">
                <div class="news-card-premium h-100">
                    <div class="news-img-box">
                        <img src="@(item.ImageUrl ?? "https://images.unsplash.com/photo-1504711432869-5d39a130f48b?w=600")" class="news-img" alt="@item.Title">
                        <div class="news-date-pill">
                            <i class="bi bi-calendar-event me-1"></i> @item.PublishDate.ToString("dd MMM")
                        </div>
                    </div>
                    <div class="p-4 news-body">
                        <h4 class="news-title-theme fw-black mb-3">@item.Title</h4>
                        <p class="news-desc-theme mb-4">@(item.Content.Length > 110 ? item.Content.Substring(0, 110) + "..." : item.Content)</p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top border-glass">
                            <div class="d-flex gap-3">
                                <span class="news-stat"><i class="bi bi-heart-fill me-1 text-danger"></i> @item.Likes.Count</span>
                                <span class="news-stat"><i class="bi bi-chat-dots-fill me-1 text-gold"></i> @item.Comments.Count</span>
                            </div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-gold-vibrant-sm rounded-pill">
                                Haberi Oku
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Hero Section */
    .news-hero-box {
        background: #581C1C;
        border: 2px solid #C5A059;
        border-radius: 40px;
        box-shadow: 0 30px 60px rgba(88, 28, 28, 0.4);
        transition: all 0.3s ease;
    }
    .news-main-title { color: white; font-family: 'Outfit'; }
    .gold-text-glow { color: #C5A059; }
    .news-hero-subtitle { color: rgba(255,255,255,0.7); max-width: 600px; font-size: 1.1rem; }

    [data-theme="light"] .news-hero-box {
        background: #fdfaf1;
        border-color: #581C1C;
        box-shadow: 0 15px 40px rgba(88, 28, 28, 0.1);
    }
    [data-theme="light"] .news-main-title { color: #581C1C; }
    [data-theme="light"] .news-hero-subtitle { color: rgba(88, 28, 28, 0.7); }
    [data-theme="light"] .gold-text-glow { color: #C5A059; }

    /* News Card - Transparent Maroon Boxy Design */
    .news-card-premium {
        background: rgba(88, 28, 28, 0.15) !important; /* ŞEFFAF BORDO */
        border: 1.5px solid rgba(197, 160, 89, 0.3) !important;
        border-radius: 35px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(15px);
    }
    .news-card-premium:hover {
        transform: translateY(-12px);
        border-color: #C5A059 !important;
        background: rgba(88, 28, 28, 0.3) !important; /* DAHA KOYU ŞEFFAF BORDO HOVER */
        box-shadow: 0 25px 50px rgba(197, 160, 89, 0.2);
    }

    .news-img-box { height: 240px; position: relative; overflow: hidden; }
    .news-img { width: 100%; height: 100%; object-fit: cover; transition: 0.6s; }
    .news-card-premium:hover .news-img { transform: scale(1.1); }
    
    .news-date-pill {
        position: absolute; top: 20px; left: 20px;
        background: #581C1C !important; 
        color: #C5A059 !important; /* HER ZAMAN ALTIN OLMALI */
        padding: 6px 16px; border-radius: 12px; font-weight: 900;
        font-size: 0.75rem; border: 1px solid #C5A059 !important;
        z-index: 5;
    }

    .news-title-theme { color: white !important; font-size: 1.35rem; line-height: 1.3; }
    .news-desc-theme { color: rgba(255,255,255,0.6) !important; font-size: 0.9rem; line-height: 1.6; }
    .news-stat { font-size: 0.8rem; font-weight: 700; color: rgba(255,255,255,0.6); }

    /* High Visibility Gold Button */
    .btn-gold-vibrant-sm {
        background: transparent;
        border: 2px solid #C5A059 !important;
        color: #C5A059 !important;
        padding: 8px 25px;
        font-weight: 900;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: 0.3s;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 5px 15px rgba(197, 160, 89, 0.1);
    }
    .btn-gold-vibrant-sm:hover {
        background: #C5A059 !important;
        color: #581C1C !important;
        box-shadow: 0 10px 25px rgba(197, 160, 89, 0.4);
        transform: scale(1.05);
    }

    /* Dark Mode Fixes */
    [data-theme="dark"] .news-main-title {
        color: #ffffff !important;
        background: none !important;
        -webkit-text-fill-color: #ffffff !important;
    }

    /* Light Mode Support */
    [data-theme="light"] .news-card-premium {
        background: #ffffff !important;
        border-color: rgba(88, 28, 28, 0.1) !important;
    }
    [data-theme="light"] .news-title-theme { color: #581C1C !important; }
    [data-theme="light"] .news-desc-theme { color: rgba(88, 28, 28, 0.6) !important; }
    [data-theme="light"] .news-stat { color: #581C1C; }
</style>
