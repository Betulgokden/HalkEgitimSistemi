@model HalkEgitimSistemi.Models.News

@{
    ViewData["Title"] = "Yeni Haber Ekle";
}

<!-- KURS ALETLERI YAGMURU -->
<div class="rain-container" id="rainContainer"></div>

<div class="container py-5" style="position: relative; z-index: 10;">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="glass-card-static animate-scaleIn overflow-hidden">
                <!-- Header -->
                <div style="padding: 2rem 2rem 1.5rem; border-bottom: 1px solid var(--border-glass); background: linear-gradient(135deg, rgba(16,185,129,0.1) 0%, rgba(5,150,105,0.05) 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="page-header-icon" style="width: 50px; height: 50px; font-size: 1.3rem; background: var(--gradient-success);">
                            <i class="bi bi-newspaper"></i>
                        </div>
                        <div>
                            <h2 style="font-family: 'Outfit', sans-serif; font-weight: 800; margin: 0; color: var(--text-primary); font-size: 1.5rem;">Yeni Haber / Duyuru Ekle</h2>
                            <p style="color: var(--text-muted); margin: 0; font-size: 0.85rem;">Haber ve duyurularınızı ana sayfada yayınlayın.</p>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <div style="padding: 2rem;">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-premium-group">
                            <label asp-for="Title" class="form-premium-label">
                                <i class="bi bi-type-h1 me-1"></i>Haber Başlığı
                            </label>
                            <input asp-for="Title" class="form-premium-control" placeholder="Haberin başlığını yazın..." />
                            <span asp-validation-for="Title" class="field-validation-error"></span>
                        </div>

                        <div class="form-premium-group">
                            <label asp-for="Content" class="form-premium-label">
                                <i class="bi bi-text-paragraph me-1"></i>Haber İçeriği
                            </label>
                            <textarea asp-for="Content" class="form-premium-control" rows="5" placeholder="Haber detaylarını buraya yazın..."></textarea>
                            <span asp-validation-for="Content" class="field-validation-error"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="Date" class="form-premium-label">
                                        <i class="bi bi-calendar3 me-1"></i>Tarih
                                    </label>
                                    <input asp-for="Date" class="form-premium-control" type="date" />
                                    <span asp-validation-for="Date" class="field-validation-error"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="PublishDate" class="form-premium-label">
                                        <i class="bi bi-calendar-check me-1"></i>Yayın Tarihi
                                    </label>
                                    <input asp-for="PublishDate" class="form-premium-control" type="date" />
                                    <span asp-validation-for="PublishDate" class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-premium-group">
                            <label class="form-premium-label">
                                <i class="bi bi-image me-1"></i>Görsel Yükle (Bilgisayardan)
                            </label>
                            <input type="file" name="imageFile" class="form-premium-control" accept="image/*" />
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-premium btn-secondary-glass flex-fill justify-content-center">
                                <i class="bi bi-arrow-left"></i> Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-premium btn-success-glow flex-fill justify-content-center">
                                <i class="bi bi-broadcast"></i> Haberi Yayınla
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
