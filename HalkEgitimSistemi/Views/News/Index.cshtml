@model IEnumerable<HalkEgitimSistemi.Models.News>

@{
    ViewData["Title"] = "Haber Yönetimi";
}

<!-- KURS ALETLERI YAGMURU -->
<div class="rain-container" id="rainContainer"></div>

<div class="container py-5" style="position: relative; z-index: 10;">
    <!-- Page Header -->
    <div class="page-header animate-fadeInDown">
        <div class="page-header-content">
            <div class="d-flex align-items-center">
                <div class="page-header-icon" style="background: var(--gradient-success);">
                    <i class="bi bi-newspaper"></i>
                </div>
                <div>
                    <h1 class="page-header-title">Haber &amp; Duyuru Yönetimi</h1>
                    <p class="page-header-subtitle">Haberleri ve duyuruları ekleyin, düzenleyin veya silin.</p>
                </div>
            </div>
            @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-premium btn-success-glow">
                    <i class="bi bi-plus-lg"></i> Yeni Haber Ekle
                </a>
            }
        </div>
    </div>

    <!-- Table Card -->
    <div class="glass-card-static animate-fadeInUp delay-200" style="padding: 1.5rem;">
        <div class="table-responsive">
            <table class="table-premium w-100">
                <thead>
                    <tr>
                        <th style="padding-left: 1.5rem;">Haber Başlığı</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th class="text-end" style="padding-right: 1.5rem;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="padding-left: 1.5rem;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="section-icon section-icon-success" style="width: 42px; height: 42px; font-size: 1.1rem;">
                                        <i class="bi bi-megaphone-fill"></i>
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; color: var(--text-primary);">@item.Title</div>
                                        <small style="color: var(--text-muted);">@(item.Content?.Length > 60 ? item.Content.Substring(0, 60) + "..." : item.Content)</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge-premium badge-secondary">
                                    <i class="bi bi-calendar3"></i> @item.Date.ToShortDateString()
                                </span>
                            </td>
                            <td>
                                <span class="badge-premium badge-success">
                                    <i class="bi bi-broadcast"></i> Yayında
                                </span>
                            </td>
                            <td class="text-end" style="padding-right: 1.5rem;">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon btn-icon-info" data-tooltip="Detay">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon btn-icon-primary" data-tooltip="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icon btn-icon-danger" data-tooltip="Sil">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>