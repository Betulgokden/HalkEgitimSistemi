@model HalkEgitimSistemi.Models.News

@{
    ViewData["Title"] = "Haber Düzenle";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="glass-card-static animate-scaleIn overflow-hidden">
                <!-- Header -->
                <div style="padding: 2rem 2rem 1.5rem; border-bottom: 1px solid var(--border-glass); background: var(--gradient-card);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="page-header-icon" style="width: 50px; height: 50px; font-size: 1.3rem; background: var(--gradient-info);">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <h2 style="font-family: 'Outfit', sans-serif; font-weight: 800; margin: 0; color: var(--text-primary); font-size: 1.5rem;">Haberi Düzenle</h2>
                            <p style="color: var(--text-muted); margin: 0; font-size: 0.85rem;">Haber bilgilerini güncelleyin.</p>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <div style="padding: 2rem;">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageUrl" />

                        <div class="form-premium-group">
                            <label asp-for="Title" class="form-premium-label">
                                <i class="bi bi-type-h1 me-1"></i>Haber Başlığı
                            </label>
                            <input asp-for="Title" class="form-premium-control" />
                            <span asp-validation-for="Title" class="field-validation-error"></span>
                        </div>

                        <div class="form-premium-group">
                            <label asp-for="Content" class="form-premium-label">
                                <i class="bi bi-text-paragraph me-1"></i>Haber İçeriği
                            </label>
                            <textarea asp-for="Content" class="form-premium-control" rows="5"></textarea>
                            <span asp-validation-for="Content" class="field-validation-error"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="Date" class="form-premium-label">
                                        <i class="bi bi-calendar3 me-1"></i>Tarih
                                    </label>
                                    <input asp-for="Date" class="form-premium-control" type="date" />
                                    <span asp-validation-for="Date" class="field-validation-error"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="PublishDate" class="form-premium-label">
                                        <i class="bi bi-calendar-check me-1"></i>Yayın Tarihi
                                    </label>
                                    <input asp-for="PublishDate" class="form-premium-control" type="date" />
                                    <span asp-validation-for="PublishDate" class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-premium-group">
                            <label class="form-premium-label">
                                <i class="bi bi-image me-1"></i>Mevcut Görsel
                            </label>
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-2">
                                    <img src="@Model.ImageUrl" alt="Current Image" style="max-height: 100px; border-radius: 8px;" />
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(Model.PosterUrl))
                            {
                                <div class="mb-2">
                                    <img src="@Model.PosterUrl" alt="Current Image (URL)" style="max-height: 100px; border-radius: 8px;" />
                                </div>
                            }
                            else
                            {
                                <div class="text-muted mb-2">Görsel yok.</div>
                            }
                            <label class="form-premium-label mt-2">
                                <i class="bi bi-upload me-1"></i>Yeni Görsel Yükle (Değiştirmek için seçin)
                            </label>
                            <input type="file" name="imageFile" class="form-premium-control" accept="image/*" />
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-premium btn-secondary-glass flex-fill justify-content-center">
                                <i class="bi bi-arrow-left"></i> Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-premium btn-success-glow flex-fill justify-content-center">
                                <i class="bi bi-check-lg"></i> Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
