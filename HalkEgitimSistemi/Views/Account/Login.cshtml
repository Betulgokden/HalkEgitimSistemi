@model dynamic
@{
    Layout = "_Layout";
    ViewData["Title"] = "Yönetici Girişi";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold">Yönetici Paneli</h4>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Login" asp-controller="Account" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Kullanıcı Adı</label>
                            <input type="text" name="username" class="form-control" placeholder="admin" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Şifre</label>
                            <input type="password" name="password" class="form-control" placeholder="123" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2">Giriş Yap</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>