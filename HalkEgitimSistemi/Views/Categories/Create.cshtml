@model HalkEgitimSistemi.Models.Category

@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0">Yeni Eğitim Kategorisi Ekle</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Kategori Adı</label>
                            <input asp-for="CategoryName" class="form-control" placeholder="Örn: Bilişim Teknolojileri" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Bu kategori altındaki kurslar hakkında kısa bilgi..." required></textarea>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Listeye Dön</a>
                            <button type="submit" class="btn btn-primary px-4">Kategoriyi Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}