@model IEnumerable<HalkEgitimSistemi.Models.Category>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary fw-bold">Eğitim Kategorileri</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle"></i> Yeni Kategori Ekle
    </a>
</div>

<table class="table table-hover mt-3">
    <thead class="table-light">
        <tr>
            <th>Kategori Adı</th>
            <th>Açıklama</th>
            <th class="text-center">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.CategoryName</td>
                <td>@item.Description</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning mx-1">Düzenle</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info mx-1">Detaylar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger mx-1">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>