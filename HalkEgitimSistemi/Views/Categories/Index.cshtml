@model IEnumerable<HalkEgitimSistemi.Models.Category>

@{
    ViewData["Title"] = "Eğitim Branşları";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="page-header animate-fadeInDown">
        <div class="page-header-content">
            <div class="d-flex align-items-center">
                <div class="page-header-icon">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </div>
                <div>
                    <h1 class="page-header-title">Kategori Yönetimi</h1>
                    <p class="page-header-subtitle">Eğitim branşlarını tanımlayın ve yönetin.</p>
                </div>
            </div>
            <a asp-action="Create" class="btn btn-premium btn-warning-glow">
                <i class="bi bi-plus-circle"></i> Yeni Kategori
            </a>
        </div>
    </div>

    <!-- Table Card -->
    <div class="glass-card-static animate-fadeInUp delay-200" style="padding: 1.5rem;">
        <div class="table-responsive">
            <table class="table-premium w-100">
                <thead>
                    <tr>
                        <th style="padding-left: 1.5rem;">Kategori Adı</th>
                        <th class="text-center">Kurs Sayısı</th>
                        <th class="text-end" style="padding-right: 1.5rem;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td style="padding-left: 1.5rem;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="section-icon section-icon-primary" style="width: 42px; height: 42px; font-size: 1.1rem;">
                                        <i class="bi bi-tag-fill"></i>
                                    </div>
                                    <span style="font-weight: 600; font-size: 1rem;">@Html.DisplayFor(modelItem => item.CategoryName)</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge-premium badge-primary">
                                    <i class="bi bi-journal-bookmark"></i> @(item.Courses?.Count() ?? 0) Kurs
                                </span>
                            </td>
                            <td class="text-end" style="padding-right: 1.5rem;">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon btn-icon-primary" data-tooltip="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icon btn-icon-danger" data-tooltip="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>