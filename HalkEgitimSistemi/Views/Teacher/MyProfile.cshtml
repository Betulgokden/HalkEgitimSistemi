@model HalkEgitimSistemi.Models.Instructor
@{
    Layout = "_Layout";
    ViewData["Title"] = "Profilimi Düzenle";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="glass-card-static animate-scaleIn overflow-hidden">
                <!-- Header -->
                <div style="padding: 2.5rem; border-bottom: 1px solid var(--border-glass); background: linear-gradient(135deg, rgba(99,102,241,0.1) 0%, rgba(236,72,153,0.05) 100%); text-align: center;">
                    <div class="instructor-avatar mx-auto mb-3" style="width: 100px; height: 100px; border: 3px solid var(--primary-light); padding: 3px;">
                        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://ui-avatars.com/api/?name=" + Model.FullName + "&background=6366f1&color=fff&size=128" : Model.ImageUrl)" 
                             alt="@Model.FullName" 
                             style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                    </div>
                    <h2 style="font-family: 'Outfit', sans-serif; font-weight: 800; margin: 0; color: var(--text-primary);">Profil Bilgilerim</h2>
                    <p style="color: var(--text-muted); margin: 0.5rem 0 0;">Panel giriş bilgilerinizi ve profil detaylarınızı güncelleyin.</p>
                </div>

                <!-- Form -->
                <div style="padding: 2.5rem;">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success animate-fadeIn" role="alert" style="background: rgba(16,185,129,0.1); color: var(--success); border: 1px solid rgba(16,185,129,0.2); border-radius: var(--radius-md); margin-bottom: 2rem;">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                        </div>
                    }

                    <form asp-action="MyProfile" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="FullName" class="form-premium-label"><i class="bi bi-person me-1"></i> Ad Soyad</label>
                                    <input asp-for="FullName" class="form-premium-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="Title" class="form-premium-label"><i class="bi bi-briefcase me-1"></i> Ünvan</label>
                                    <input asp-for="Title" class="form-premium-control" required />
                                </div>
                            </div>
                            
                            <div class="col-12 mt-3">
                                <div class="divider-premium mb-4"></div>
                                <h6 class="mb-3" style="font-family: 'Outfit'; font-weight: 700; color: var(--primary-light);">Panel Giriş Bilgileri</h6>
                            </div>

                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="Username" class="form-premium-label"><i class="bi bi-at me-1"></i> Kullanıcı Adı</label>
                                    <input asp-for="Username" class="form-premium-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label class="form-premium-label"><i class="bi bi-key me-1"></i> Şifre (Değiştirmek için yazın)</label>
                                    <input type="password" name="Password" class="form-premium-control" placeholder="••••••••" />
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-premium-group">
                                    <label asp-for="ImageUrl" class="form-premium-label"><i class="bi bi-camera me-1"></i> Profil Fotoğrafı URL</label>
                                    <input asp-for="ImageUrl" class="form-premium-control" placeholder="https://..." />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <a asp-action="Dashboard" class="btn btn-premium btn-secondary-glass flex-fill justify-content-center">
                                <i class="bi bi-arrow-left"></i> Panele Dön
                            </a>
                            <button type="submit" class="btn btn-premium btn-primary-glow flex-fill justify-content-center">
                                <i class="bi bi-save"></i> Profili Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
