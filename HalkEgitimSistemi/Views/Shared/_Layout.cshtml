<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Halk Eğitim Merkezi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body { background-color: #f8f9fa; }
        .navbar { box-shadow: 0 2px 4px rgba(0,0,0,.1); } /* CSS uyarısı için box-shadow eklendi */
        .nav-link { font-weight: 500; transition: 0.3s; }
        .nav-link:hover { color: #0d6efd !important; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill"></i> HalkEgitimSistemi
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Categories" asp-action="Index">Kategoriler</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Courses" asp-action="Index">Kurslar</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Instructors" asp-action="Index">Eğitmenler</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="News" asp-action="Index">Haberler</a></li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (User?.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link text-success fw-bold me-2">
                                    <i class="bi bi-person-check-fill"></i> Hoş geldin, Admin
                                </span>
                                <a class="btn btn-sm btn-outline-danger fw-bold" asp-controller="Account" asp-action="Logout">Çıkış Yap</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-shield-lock"></i> Yönetici Girişi
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-5">
        <div class="container text-center">
            &copy; 2026 - HalkEgitimSistemi - <a asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>