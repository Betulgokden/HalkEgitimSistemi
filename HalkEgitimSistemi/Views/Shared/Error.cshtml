@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="container py-5" style="min-height: 60vh; display: flex; align-items: center; justify-content: center;">
    <div class="text-center animate-scaleIn">
        <!-- Error Icon -->
        <div style="width: 120px; height: 120px; border-radius: 50%; margin: 0 auto 2rem; display: flex; align-items: center; justify-content: center; background: rgba(239,68,68,0.1); border: 2px solid var(--danger);">
            <i class="bi bi-exclamation-triangle-fill" style="font-size: 3.5rem; color: var(--danger);"></i>
        </div>

        <h1 style="font-family: 'Outfit', sans-serif; font-weight: 900; font-size: 2.5rem; color: var(--danger); margin-bottom: 0.5rem;">Hata Oluştu</h1>
        <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 500px; margin: 0 auto 2rem;">
            İsteğiniz işlenirken beklenmeyen bir hata meydana geldi. Lütfen daha sonra tekrar deneyin.
        </p>

        @if (Model.ShowRequestId)
        {
            <div style="background: var(--bg-glass); border: 1px solid var(--border-glass); border-radius: var(--radius-lg); padding: 1rem 1.5rem; display: inline-block; margin-bottom: 2rem;">
                <small style="color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">İstek Kimliği</small>
                <div style="color: var(--primary-light); font-family: monospace; font-weight: 600;">@Model.RequestId</div>
            </div>
        }

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Home" asp-action="Index" class="btn btn-premium btn-primary-glow">
                <i class="bi bi-house-heart"></i> Ana Sayfaya Dön
            </a>
            <button onclick="history.back()" class="btn btn-premium btn-secondary-glass">
                <i class="bi bi-arrow-counterclockwise"></i> Geri Git
            </button>
        </div>
    </div>
</div>
