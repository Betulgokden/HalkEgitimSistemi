@model IEnumerable<HalkEgitimSistemi.Models.Instructor>

@{
    ViewData["Title"] = "Eğitmen Kadromuz";
}

<!-- KURS ALETLERI YAGMURU -->
<div class="rain-container" id="rainContainer"></div>

<div class="container py-5" style="position: relative; z-index: 10;">
    <!-- Hero Header -->
    <div class="glass-card-static animate-fadeInDown" style="padding: 3rem; margin-bottom: 3rem; background: linear-gradient(135deg, rgba(139,92,246,0.1) 0%, rgba(99,102,241,0.05) 100%); text-align: center;">
        <span class="badge-premium badge-primary mb-3"><i class="bi bi-stars"></i> Uzman Kadro</span>
        <h1 style="font-family: 'Outfit', sans-serif; font-size: 2.8rem; font-weight: 900; margin-bottom: 0.8rem;">
            <span class="section-title-gradient">Uzman Eğitmenlerimiz</span>
        </h1>
        <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto 1.5rem; font-size: 1.05rem;">
            Geleceği şekillendiren, alanında uzman eğitim kadromuzla tanışın. Her biri alanının en iyisi!
        </p>
        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-premium btn-warning-glow">
                <i class="bi bi-person-plus-fill"></i> Yeni Eğitmen Ekle
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state glass-card-static p-5 reveal-on-scroll">
            <div class="empty-state-icon">
                <i class="bi bi-people"></i>
            </div>
            <h3 style="color: var(--text-primary); font-weight: 700;">Henüz bir eğitmen kaydı bulunamadı.</h3>
            <p style="color: var(--text-muted);">Yöneticilerimiz eğitmen eklediğinde burada en güncel bilgileri göreceksiniz.</p>
        </div>
    }
    else
    {
        <div class="row g-4 stagger-children">
            @foreach (var item in Model) {
                <div class="col-md-6 col-lg-4">
                    <div class="instructor-card tilt-card h-100">
                        <!-- Avatar -->
                        <div class="instructor-avatar">
                            <i class="bi bi-person-hearts"></i>
                        </div>

                        <h4 style="font-weight: 700; color: var(--text-primary); margin-bottom: 0.3rem;">@item.FullName</h4>
                        <p style="color: var(--primary-light); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1.5rem;">@item.Title</p>

                        <hr class="divider-premium" />

                        <div style="margin-bottom: 1.5rem;">
                            <span class="badge-premium badge-secondary" style="font-size: 0.82rem; padding: 0.5rem 1rem;">
                                <i class="bi bi-book-fill me-1" style="color: var(--primary-light);"></i>
                                @(item.Course?.CourseName ?? "Genel İdare / Branş Belirtilmedi")
                            </span>
                        </div>

                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon btn-icon-primary" data-tooltip="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icon btn-icon-danger" data-tooltip="Sil">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>