@model HalkEgitimSistemi.Models.Instructor

@{
    ViewData["Title"] = "Eğitmen Detayı";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="glass-card-static animate-scaleIn overflow-hidden">
                <!-- Header / Photo -->
                <div style="padding: 3rem 2rem 2rem; border-bottom: 1px solid var(--border-glass); background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(236, 72, 153, 0.05) 100%); text-align: center;">
                    <div class="instructor-avatar" style="width: 120px; height: 120px; margin: 0 auto 1.5rem; border: 3px solid var(--primary);">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.FullName" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                        }
                        else
                        {
                            <i class="bi bi-person-circle" style="font-size: 4rem; color: var(--primary-light);"></i>
                        }
                    </div>
                    <h2 style="font-family: 'Outfit', sans-serif; font-weight: 800; margin: 0; color: var(--text-primary); font-size: 1.8rem;">@Model.FullName</h2>
                    <p style="color: var(--primary-light); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; margin-top: 0.3rem;">@Model.Title</p>
                </div>

                <!-- Info Details -->
                <div style="padding: 2rem;">
                    <div class="detail-row">
                        <div class="detail-label">Atandığı Kurs</div>
                        <div class="detail-value">
                            @if (Model.Course != null)
                            {
                                <span class="badge-premium badge-primary">
                                    <i class="bi bi-journal-bookmark me-1"></i> @Model.Course.CourseName
                                </span>
                            }
                            else
                            {
                                <span class="badge-premium badge-secondary">Genel Görevli / İdare</span>
                            }
                        </div>
                    </div>
                    
                    <div class="detail-row">
                        <div class="detail-label">Kayıt ID</div>
                        <div class="detail-value">#@Model.Id</div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-premium btn-secondary-glass flex-fill justify-content-center">
                            <i class="bi bi-arrow-left"></i> Listeye Dön
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-premium btn-primary-glow flex-fill justify-content-center">
                            <i class="bi bi-pencil-square"></i> Düzenle
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
