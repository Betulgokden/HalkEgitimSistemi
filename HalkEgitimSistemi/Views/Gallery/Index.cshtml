@model List<HalkEgitimSistemi.Controllers.GalleryItemViewModel>

@{
    ViewData["Title"] = "Etkinlik Galerisi";
}

<!-- KURS ALETLERI YAGMURU -->
<div class="rain-container" id="rainContainer"></div>

<!-- Hero Section -->
<div class="glass-card-static animate-fadeInDown" style="padding: 3rem; margin-bottom: 2rem; background: linear-gradient(135deg, rgba(139,92,246,0.08) 0%, rgba(99,102,241,0.05) 100%); text-align: center; border-radius: 0 0 var(--radius-2xl) var(--radius-2xl); position: relative; z-index: 10;">
    <span class="badge-premium badge-info mb-3"><i class="bi bi-camera"></i> Anılarımız</span>
    <h1 style="font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 900; margin-bottom: 0.8rem;">
        Etkinlik <span class="section-title-gradient">Galerisi</span>
    </h1>
    <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto; font-size: 1.05rem;">
        Merkezimizde gerçekleştirilen eğitimlerden, sergilerden ve mezuniyet törenlerinden kareler.
    </p>
</div>

<div class="container py-4 mb-5" style="position: relative; z-index: 10;">
    
    <!-- YÖNETİCİYE ÖZEL: RESİM EKLEME BUTONU -->
    @if (User.Identity!.IsAuthenticated && User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-end mb-4 animate-fadeInDown">
            <button type="button" class="btn btn-premium btn-success-glow" data-bs-toggle="modal" data-bs-target="#addPhotoModal">
                <i class="bi bi-cloud-arrow-up-fill me-2"></i>Yeni Görsel Ekle
            </button>
        </div>
        
        <!-- Dosya Yükleme Modalı (Sadece Tasarım) -->
        <div class="modal fade" id="addPhotoModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content glass-card-static">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title" style="font-family:'Outfit'; font-weight:800; color:var(--text-primary);">
                            <i class="bi bi-folder-plus text-success me-2"></i>Galeriyi Güncelle
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" style="font-weight:600; color:var(--text-secondary);">Görsel Dosyası</label>
                            <input class="form-control form-premium-control" type="file" id="formFile" accept="image/*">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight:600; color:var(--text-secondary);">Başlık</label>
                            <input type="text" class="form-control form-premium-control" placeholder="Örn: Seramik Atölyesi">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight:600; color:var(--text-secondary);">Açıklama</label>
                            <textarea class="form-control form-premium-control" rows="2" placeholder="Görsel hakkında kısa bilgi..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary-glass" data-bs-dismiss="modal">İptal</button>
                        <button type="button" class="btn btn-premium btn-success-glow" data-bs-dismiss="modal"><i class="bi bi-upload me-2"></i>Yükle ve Kaydet</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Masonry CSS Grid Layout -->
    <div class="gallery-masonry stagger-children">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            <div class="gallery-item animate-fadeInUp" data-bs-toggle="modal" data-bs-target="#lightboxModal" data-img="@item.Url" data-title="@item.Title" data-desc="@item.Description">
                <div class="card-image-container glass-card" style="height: auto; border:none; position: relative; overflow: hidden; border-radius: var(--radius-md);">
                    <img src="@item.Url" alt="@item.Title" class="w-100 gallery-img" style="display: block; transition: transform 0.5s ease;" />
                    
                    <!-- Permanent gradient overlay for text readability -->
                    <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(15,23,42,0.9) 0%, rgba(15,23,42,0) 100%); padding: 3rem 1.5rem 1rem 1.5rem; pointer-events: none;">
                        <h4 style="color: white; font-family: 'Outfit'; font-weight: 700; margin-bottom: 0.2rem; font-size: 1.15rem; text-shadow: 0 2px 4px rgba(0,0,0,0.8);">@item.Title</h4>
                        <p style="color: rgba(255,255,255,0.85); font-size: 0.85rem; margin: 0; text-shadow: 0 1px 2px rgba(0,0,0,0.8);">@item.Description</p>
                    </div>

                    <!-- Hover action overlay -->
                    <div class="card-image-overlay d-flex align-items-center justify-content-center">
                        <div class="text-white text-center">
                            <i class="bi bi-arrows-fullscreen fs-2 mb-2" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));"></i>
                            <div style="font-weight: 600; font-family: 'Outfit'; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">Büyüt</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Lightbox Modal -->
<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content" style="background: transparent; border: none;">
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" style="z-index: 1060; font-size: 1.5rem; filter: drop-shadow(0 2px 5px rgba(0,0,0,0.8));"></button>
            <div class="modal-body p-0 text-center position-relative">
                <img id="lightboxImage" src="" class="img-fluid" style="border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); max-height: 85vh; object-fit: contain; width: 100%;" />
                <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem 1.5rem; background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 100%); border-radius: 0 0 var(--radius-lg) var(--radius-lg); text-align: left;">
                    <h3 id="lightboxTitle" style="color: white; font-family: 'Outfit'; font-weight: 800; margin-bottom: 0.3rem;"></h3>
                    <p id="lightboxDesc" style="color: rgba(255,255,255,0.9); font-size: 1rem; margin: 0;"></p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .gallery-masonry {
        column-count: 3;
        column-gap: 1.5rem;
    }
    
    .gallery-item {
        break-inside: avoid;
        margin-bottom: 1.5rem;
        cursor: pointer;
    }

    .gallery-item:hover .gallery-img {
        transform: scale(1.05);
    }

    @@media (max-width: 991px) {
        .gallery-masonry { column-count: 2; }
    }
    @@media (max-width: 576px) {
        .gallery-masonry { column-count: 1; }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var lightboxModal = document.getElementById('lightboxModal');
            var lightboxImage = document.getElementById('lightboxImage');
            var lightboxTitle = document.getElementById('lightboxTitle');
            var lightboxDesc = document.getElementById('lightboxDesc');
            
            lightboxModal.addEventListener('show.bs.modal', function (event) {
                var trigger = event.relatedTarget;
                var imgSrc = trigger.getAttribute('data-img');
                var imgTitle = trigger.getAttribute('data-title');
                var imgDesc = trigger.getAttribute('data-desc');
                
                lightboxImage.src = imgSrc;
                lightboxTitle.textContent = imgTitle;
                lightboxDesc.textContent = imgDesc;
            });
        });
    </script>
}
