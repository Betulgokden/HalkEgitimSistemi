@model HalkEgitimSistemi.Models.Course

@{
    ViewData["Title"] = "Kurs Düzenle";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="glass-card-static animate-scaleIn overflow-hidden">
                <!-- Header -->
                <div style="padding: 2rem 2rem 1.5rem; border-bottom: 1px solid var(--border-glass); background: var(--gradient-card);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="page-header-icon" style="width: 50px; height: 50px; font-size: 1.3rem; background: var(--gradient-info);">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <h2 style="font-family: 'Outfit', sans-serif; font-weight: 800; margin: 0; color: var(--text-primary); font-size: 1.5rem;">Kurs Düzenle</h2>
                            <p style="color: var(--text-muted); margin: 0; font-size: 0.85rem;">Kurs bilgilerini güncelleyin.</p>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <div style="padding: 2rem;">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-premium-group">
                            <label asp-for="CourseName" class="form-premium-label">
                                <i class="bi bi-mortarboard me-1"></i>Kurs Adı
                            </label>
                            <input asp-for="CourseName" class="form-premium-control" />
                            <span asp-validation-for="CourseName" class="field-validation-error"></span>
                        </div>

                        <div class="form-premium-group">
                            <label asp-for="Description" class="form-premium-label">
                                <i class="bi bi-text-paragraph me-1"></i>Açıklama
                            </label>
                            <textarea asp-for="Description" class="form-premium-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="field-validation-error"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="ImageUrl" class="form-premium-label">
                                        <i class="bi bi-image me-1"></i>Görsel URL
                                    </label>
                                    <input asp-for="ImageUrl" class="form-premium-control" />
                                    <span asp-validation-for="ImageUrl" class="field-validation-error"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-premium-group">
                                    <label asp-for="CategoryId" class="form-premium-label">
                                        <i class="bi bi-tag me-1"></i>Kategori
                                    </label>
                                    <select asp-for="CategoryId" class="form-premium-control" asp-items="ViewBag.CategoryId"></select>
                                    <span asp-validation-for="CategoryId" class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-premium btn-secondary-glass flex-fill justify-content-center">
                                <i class="bi bi-arrow-left"></i> Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-premium btn-success-glow flex-fill justify-content-center">
                                <i class="bi bi-check-lg"></i> Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
