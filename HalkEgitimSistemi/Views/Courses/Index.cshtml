@model IEnumerable<HalkEgitimSistemi.Models.Course>

@{
    ViewData["Title"] = "Eğitim Kataloğu";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">Eğitim Katalog ve Ön Kayıt</h2>
        <p class="text-muted">Kendine uygun kursu seç, hemen ön başvurunu tamamla!</p>
    </div>

    @* Admin girişi yapıldıysa Yeni Kurs Ekle butonu görünür *@
    @if (User.Identity.IsAuthenticated)
    {
        <div class="mb-4 text-center">
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-circle me-2"></i>Yeni Kurs Ekle (Yönetici)
            </a>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="alert alert-info rounded-4 shadow-sm">
                    <h4 class="alert-heading"><i class="bi bi-info-circle me-2"></i>Henüz Kurs Eklenmemiş</h4>
                    <p class="mb-0">Sistemde şu an gösterilecek aktif bir kurs bulunmuyor.</p>
                    <hr>
                    <p class="small mb-0">Lütfen önce <strong>Kategoriler</strong> eklediğinizden ve ardından <strong>Kurslar</strong> sayfasından yeni kurs oluşturduğunuzdan emin olun.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow border-0 rounded-4 overflow-hidden course-card">
                        <div class="card-header bg-primary text-white py-3 text-center">
                            <h5 class="mb-0 fw-bold">@item.CourseName</h5>
                        </div>
                        <div class="card-body text-center p-4">
                            <div class="display-5 mb-3 text-primary"><i class="bi bi-mortarboard"></i></div>
                            <div class="d-flex justify-content-between align-items-center border-top pt-3">
                                <span class="text-secondary">Kontenjan</span>
                                <span class="badge bg-light text-primary fs-6">@item.Quota Kişi</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 p-3">
                            <a href="/Applications/Create?courseId=@item.Id" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm">
                                Hemen Kayıt Ol
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .course-card { transition: all 0.3s ease; }
    .course-card:hover { transform: translateY(-10px); box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important; }
</style>