@model IEnumerable<HalkEgitimSistemi.Models.Course>

@{
    ViewData["Title"] = "Kurs Kataloğu";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="page-header animate-fadeInDown">
        <div class="page-header-content">
            <div class="d-flex align-items-center">
                <div class="page-header-icon" style="background: var(--gradient-purple);">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <div>
                    <h1 class="page-header-title">Kurs Kataloğu</h1>
                    <p class="page-header-subtitle">Tüm eğitim programlarını yönetin ve düzenleyin.</p>
                </div>
            </div>
            <a asp-action="Create" class="btn btn-premium btn-warning-glow">
                <i class="bi bi-plus-lg"></i> Yeni Kurs Ekle
            </a>
        </div>
    </div>

    <!-- Table Card -->
    <div class="glass-card-static animate-fadeInUp delay-200" style="padding: 1.5rem;">
        <div class="table-responsive">
            <table class="table-premium w-100">
                <thead>
                    <tr>
                        <th style="padding-left: 1.5rem;">Görsel</th>
                        <th>@Html.DisplayNameFor(model => model.CourseName)</th>
                        <th>@Html.DisplayNameFor(model => model.Category)</th>
                        <th>Durum</th>
                        <th class="text-end" style="padding-right: 1.5rem;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td style="padding-left: 1.5rem;">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=100&q=80" : item.ImageUrl)" 
                                     alt="@item.CourseName" class="img-thumbnail-premium">
                            </td>
                            <td>
                                <div style="font-weight: 600; color: var(--text-primary); font-size: 0.95rem;">@Html.DisplayFor(modelItem => item.CourseName)</div>
                                <small style="color: var(--text-muted);">ID: @item.Id</small>
                            </td>
                            <td>
                                <span class="badge-premium badge-primary">
                                    <i class="bi bi-tag-fill"></i> @Html.DisplayFor(modelItem => item.Category.CategoryName)
                                </span>
                            </td>
                            <td>
                                <span class="badge-premium badge-success">
                                    <i class="bi bi-check-circle-fill"></i> Aktif
                                </span>
                            </td>
                            <td class="text-end" style="padding-right: 1.5rem;">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon btn-icon-primary" data-tooltip="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon btn-icon-info" data-tooltip="Detay">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icon btn-icon-danger" data-tooltip="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>