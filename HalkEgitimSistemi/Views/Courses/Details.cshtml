@model HalkEgitimSistemi.Models.Course

@{
    ViewData["Title"] = "Kurs Detayları";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="detail-card animate-scaleIn">
                <!-- Header with Image -->
                <div style="position: relative; overflow: hidden;">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=800&q=80" : Model.ImageUrl)"
                         alt="@Model.CourseName"
                         style="width: 100%; height: 250px; object-fit: cover; display: block;">
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(180deg, transparent 30%, rgba(15,15,35,0.95) 100%);"></div>
                    <div style="position: absolute; bottom: 1.5rem; left: 2rem; right: 2rem;">
                        <span class="badge-premium badge-primary mb-2">
                            <i class="bi bi-tag-fill"></i> @Html.DisplayFor(model => model.Category.CategoryName)
                        </span>
                        <h2 style="font-family: 'Outfit', sans-serif; font-weight: 800; color: white; margin: 0; font-size: 1.8rem;">
                            @Html.DisplayFor(model => model.CourseName)
                        </h2>
                    </div>
                </div>

                <!-- Details -->
                <div class="detail-row">
                    <div class="detail-label"><i class="bi bi-hash me-1"></i>Kurs Adı</div>
                    <div class="detail-value">@Html.DisplayFor(model => model.CourseName)</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label"><i class="bi bi-text-paragraph me-1"></i>Açıklama</div>
                    <div class="detail-value">@Html.DisplayFor(model => model.Description)</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label"><i class="bi bi-image me-1"></i>Görsel URL</div>
                    <div class="detail-value" style="word-break: break-all;">@Html.DisplayFor(model => model.ImageUrl)</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label"><i class="bi bi-tag me-1"></i>Kategori</div>
                    <div class="detail-value">
                        <span class="badge-premium badge-primary">@Html.DisplayFor(model => model.Category.CategoryName)</span>
                    </div>
                </div>

                <!-- Actions -->
                <div style="padding: 1.5rem 2rem; border-top: 1px solid var(--border-glass); display: flex; gap: 0.8rem;">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-premium btn-primary-glow flex-fill justify-content-center">
                        <i class="bi bi-pencil"></i> Düzenle
                    </a>
                    <a asp-action="Index" class="btn btn-premium btn-secondary-glass flex-fill justify-content-center">
                        <i class="bi bi-arrow-left"></i> Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
